                then
                    < OID : NuITP | ATS, wild: true, internal: internalize(INTMOD | INTHPS | INTLOCAL | INTEQP, getCLA(getGoal(GOALS, '0)), comm), log: (LOG [ nil : STR + "\n" ]), goals: GOALS >
                    printMsg(stdout, OID, ATS, "Unproved goal has been internalized as comm axiom.")
                else --- Unable to internalize: Original theory may become non-executable.
                    printErr(< OID : NuITP | ATS, wild: WILD, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS >, error(92), STR, true)
                fi
            else --- Unable to internalize: Unexpected error.
                printErr(< OID : NuITP | ATS, wild: WILD, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS >, error(93), STR, true)
            fi
        else
            printErr(< OID : NuITP | ATS, wild: WILD, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS >, checkInternalizeAxiom(INTMOD, GOALS, getGID(TGID), assoc, true), STR, true)
        fi .

    --- trust internalize GID as assoc comm .
    eq < OID : NuITP | ATS, wild: WILD, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'trust`internalize`as`assoc`comm`.['token[TGID]]) =
        if checkInternalizeAxiom(INTMOD, GOALS, getGID(TGID), assoc comm, true) == noError
        then
            if (internalize(INTMOD | INTHPS | INTLOCAL | INTEQP, getCLA(getGoal(GOALS, '0)), assoc comm) :: Internal)
            then
                if checkExec(internalize(INTMOD | INTHPS | INTLOCAL | INTEQP, getCLA(getGoal(GOALS, '0)), comm))
                then
                    < OID : NuITP | ATS, wild: true, internal: internalize(INTMOD | INTHPS | INTLOCAL | INTEQP, getCLA(getGoal(GOALS, '0)), assoc comm), log: (LOG [ nil : STR + "\n" ]), goals: GOALS >
                    printMsg(stdout, OID, ATS, "Unproved goal has been internalized as both assoc and comm axioms.")
                else --- Unable to internalize: Original theory may become non-executable.
                    printErr(< OID : NuITP | ATS, wild: WILD, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS >, error(92), STR, true)
                fi
            else --- Unable to internalize: Unexpected error.
                printErr(< OID : NuITP | ATS, wild: WILD, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS >, error(93), STR, true)
            fi
        else
            printErr(< OID : NuITP | ATS, wild: WILD, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS >, checkInternalizeAxiom(INTMOD, GOALS, getGID(TGID), assoc comm, true), STR, true)
        fi .
    
    --- undo GID .
    eq < OID : NuITP | ATS, verbose: VERBOSE, log: LOG, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS > parse(STR, 'undo_.['token[TGID]]) =
        if getGoal(GOALS, getGID(TGID)) :: Goal
        then
            if isProved(getGoal(GOALS, getGID(TGID)))
            then --- Unable to undo: Goal GID is proved.
                printErr(< OID : NuITP | ATS, verbose: VERBOSE, log: LOG, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(60, join(getGID(TGID))), STR, false)
            else
                if isDisproved(getGoal(GOALS, getGID(TGID)))
                then --- Unable to undo: Goal GID is disproved.
                    printErr(< OID : NuITP | ATS, verbose: VERBOSE, log: LOG, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(61, join(getGID(TGID))), STR, false)
                else
                    if (getChildren(GOALS, getGID(TGID)) == mt)
                    then --- Unable to undo: Goal GID is in the frontier.
                        printErr(< OID : NuITP | ATS, verbose: VERBOSE, log: LOG, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(62, join(getGID(TGID))), STR, false)
                    else
                        < OID : NuITP | ATS, verbose: VERBOSE, log: (LOG [ getGID(TGID) : "undo " + join(getGID(TGID)) + " .\n" ]), internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: undoGoal(GOALS, getGID(TGID)) >
                        write(stdout, OID, printCommand(ATS, STR) + CYAN + "  Goal " + join(getGID(TGID)) + " undone. All its children have been deleted." + "\n\n" + RED + "  Unproved goals:\n\n" + BW + toString(INTMOD, getFrontier(undoGoal(GOALS, getGID(TGID))), VERBOSE) + RED + "  Total unproved goals: " + string(size(getFrontier(undoGoal(GOALS, getGID(TGID)))), 10) + "\n\n" + BW)
                    fi
                fi
            fi
        else --- Goal does not exist.
            printErr(< OID : NuITP | ATS, verbose: VERBOSE, log: LOG, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(41), STR, false)
        fi .

    --- strat NAME is STRATEGY .
    ceq < OID : NuITP | ATS, strats: SSL, log: LOG > parse(STR, 'strat_is_.['token[ARG],'bubble[ARG1]]) =
        if (string(downTerm(ARG, 'nil.QidList))) == "NuITP"
        then --- Default simplification strategy NuITP can not be redefined.
            printErr(< OID : NuITP | ATS, strats: SSL, log: LOG >, error(133), STR, true)
        else
            if checkStrategy(setStrategies(upModule('NuITP-SIMPLIFICATION-STRATEGIES, false), SSL, true), STA)
            then 
                < OID : NuITP | ATS, strats: addStrategy(SSL, string(downTerm(ARG, 'nil.QidList)), STA), log: (LOG [ nil : STR + "\n" ]) > 
                write(stdout, OID, printCommand(ATS, STR) + CYAN + "  Simplification strategy " + string(downTerm(ARG, 'nil.QidList)) + " added successfully.\n\n" + BW)
            else --- Strategy not valid (see strategy requirements in the manual).
                printErr(< OID : NuITP | ATS, strats: SSL, log: LOG >, error(131), STR, true)
            fi
        fi
        if QL := downTerm(ARG1, 'nil.QidList)
        /\ STA := metaParseStrategy(setStrategies(upModule('NuITP-SIMPLIFICATION-STRATEGIES, false), SSL, true), none, QL) .
    eq < OID : NuITP | ATS > parse(STR, 'strat_is_.['token[ARG],'bubble[ARG1]]) = printErr(< OID : NuITP | ATS >, error(130), STR, true) [ owise ] . --- Error parsing strategy.
        
    --- set default strat STRAT_ID .
    eq < OID : NuITP | ATS, strats: SSL, log: LOG > parse(STR, 'set`default`strat_.['token[ARG]]) =
        if (getStrat(SSL, string(downTerm(ARG, 'nil.QidList))) == empty)
        then --- Simplification strategy STRAT not found.
            printErr(< OID : NuITP | ATS, strats: SSL, log: LOG >, error(134, string(downTerm(ARG, 'nil.QidList))), STR, true)
        else
            < OID : NuITP | ATS, strats: setDefaultStrat(SSL, string(downTerm(ARG, 'nil.QidList))), log: (LOG [ nil : STR + "\n" ]) >
            write(stdout, OID, printCommand(ATS, STR) + CYAN + "  Simplification strategy " + string(downTerm(ARG, 'nil.QidList)) + " is now default.\n\n" + BW)
        fi .

    --- show strats .
    eq < OID : NuITP | ATS, strats: nil > parse(STR, 'show`strats`..NuITP-Command) = printErr(< OID : NuITP | ATS, strats: nil >, error(132), STR, false) . --- No simplification strategies defined.
    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, strats: SSL > parse(STR, 'show`strats`..NuITP-Command) =
        < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, strats: SSL >
        write(stdout, OID, printCommand(ATS, STR) + toString(SSL))
        [ owise ] .

    --- genset NAME for TYPE is TERMSET .
    ceq < OID : NuITP | ATS, modname: MODNAME, internal: INTMOD | INTHPS | INTLOCAL | INTEQP > parse(STR, 'genset_for_is_.['token[ARG],'token[ARG1],'bubble[ARG2]]) =
        --- Could not find sort TYPE in module MODNAME.
        printErr(< OID : NuITP | ATS, modname: MODNAME, internal: INTMOD | INTHPS | INTLOCAL | INTEQP >, error(106, string(TY), string(MODNAME)), STR, true)
        if TY := downTerm(ARG1, 'nil.QidList)
        /\ not(TY inS getSorts(INTMOD)) .

    ceq < OID : NuITP | ATS, gensets: GENSETS > parse(STR, 'genset_for_is_.['token[ARG],'token[ARG1],'bubble[ARG2]]) =
        --- Generator set GENSET already defined for a different sort.
        printErr(< OID : NuITP | ATS, gensets: GENSETS >, error(107, string(Q)), STR, true) 
        if Q := downTerm(ARG, 'nil.QidList)
        /\ TY := downTerm(ARG1, 'nil.QidList)
        /\ not(checkGenSetId(GENSETS, TY, string(Q))) .

    ceq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, log: LOG > parse(STR, 'genset_for_is_.['token[ARG],'token[ARG1],'bubble[ARG2]]) =
        if (PARSED-GENSET :: TermSet) and-then (PARSED-GENSET =/= mt)
        then
            < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: addGenSet(GENSETS, string(Q), TY, PARSED-GENSET), log: (LOG [ nil : STR + "\n" ]) >
            write(stdout, OID, printCommand(ATS, STR) + toString(INTMOD, getGenSet(addGenSet(GENSETS, string(Q), TY, PARSED-GENSET), string(Q)), 'new))
        else --- Generator set for sort " + TYPE + " not valid.
            printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, log: LOG >, error(106, string(TY)), STR, true)
        fi
        if Q := downTerm(ARG, 'nil.QidList)
        /\ TY := downTerm(ARG1, 'nil.QidList)
        /\ (TY ; SS) := getSorts(INTMOD)
        /\ PARSED-GENSET := parseGenSet(INTMOD, TY, downTerm(ARG2,'nil.QidList)) [ owise ] .

    --- set default genset GENSET_ID .
    eq < OID : NuITP | ATS, gensets: GENSETS, log: LOG > parse(STR, 'set`default`genset_.['token[ARG]]) =
        if (getGenSet(GENSETS, string(downTerm(ARG, 'nil.QidList))) == mt)
        then --- Generator set GENSET not found.
            printErr(< OID : NuITP | ATS, gensets: GENSETS, log: LOG >, error(112, string(downTerm(ARG, 'nil.QidList))), STR, true)
        else
            < OID : NuITP | ATS, gensets: setDefault(GENSETS, string(downTerm(ARG, 'nil.QidList))), log: (LOG [ nil : STR + "\n" ]) >
            write(stdout, OID, printCommand(ATS, STR) + CYAN + "  Generator set " + string(downTerm(ARG, 'nil.QidList)) + " is now default.\n\n" + BW)
        fi .

    op getRuleMsg : QidList -> String .
    --- Simplification Rules
    eq getRuleMsg('eps) = "Equality Predicate Simplification (EPS)" .
    eq getRuleMsg('eeps) = "Explicit Equality Predicate Simplification (EEPS)" .
    eq getRuleMsg('deq) = "Decompose Equivalence (DEQ)" .
    eq getRuleMsg('cbeql) = "Clause Boolean Equivalence Left (CBEQL)" .
    eq getRuleMsg('cbeqr) = "Clause Boolean Equivalence Right (CBEQR)" .
    eq getRuleMsg('cvul) = "Constructor Variant Unification Left (CVUL)" .
    eq getRuleMsg('cvufr) = "Constructor Variant Unification Failure Right (CVUFR)" .
    eq getRuleMsg('subl) = "Substitution Left (SUBL)" .
    eq getRuleMsg('subr) = "Substitution Right (SUBR)" .
    eq getRuleMsg('ns) = "Narrowing Simplification (NS)" .
    eq getRuleMsg('ins) = "Narrowing Simplification (NS)" .
    eq getRuleMsg('cs) = "Clause Subsumption (CS)" .
    eq getRuleMsg('icc) = "Inductive Congruence Closure (ICC)" .
    eq getRuleMsg('varsat) = "Variant Satisfiability (VARSAT)" .
    eq getRuleMsg('gnd) = "Grounding (GND)" .
    eq getRuleMsg('ufree) = "Unity Free (UFREE)" .
    eq getRuleMsg('rst) = "Restart (RST)" .
    eq getRuleMsg('eq) = "Equality (EQ)" .
    eq getRuleMsg('es) = "Equality Proof Search (ES)" .
    eq getRuleMsg('trust) = "Trust (TRUST)" .

    --- Inductive Rules
    eq getRuleMsg('gsi) = "Generator Set Induction (GSI)" .
    eq getRuleMsg('gsi+) = "Generator Set Induction (GSI)" .
    eq getRuleMsg('ni) = "Narrowing Induction (NI)" .
    eq getRuleMsg('le) = "Lemma Enrichment (LE)" .
    eq getRuleMsg('sp) = "Split (SP)" .
    eq getRuleMsg('cas) = "Case (CAS)" .
    eq getRuleMsg('cas1) = "Case (CAS)" .
    eq getRuleMsg('cas+) = "Case (CAS)" .
    eq getRuleMsg('va) = "Variable Abstraction (VA)" .
    eq getRuleMsg('cut) = "Cut (CUT)" .

    eq getRuleMsg('!) = " with Equality Predicate Simplification" .
    eq getRuleMsg('try-eps) = " with Equality Predicate Simplification" .
    eq getRuleMsg('NuITP) = " with NuITP Default Simplification Strategy" .
    eq getRuleMsg(Q) = " with " + string(Q) + " Simplification Strategy" [ owise ] .
    
    eq getRuleMsg(Q NQL) = getRuleMsg(Q) + getRuleMsg(NQL) .

    sort QidList? .
    subsort QidList < QidList? .

    op checkRules : Qid Qid -> Bool .
    ceq checkRules('apply_to_., RULE) = true 
        if (RULE == 'trust) or-else (RULE == 'eps) or-else (RULE == 'es) or-else (RULE == 'deq) or-else (RULE == 'cbeql) or-else (RULE == 'cbeqr) or-else (RULE == 'cvul) or-else (RULE == 'cvufr) or-else (RULE == 'subl) or-else (RULE == 'subr) or-else (RULE == 'ns) or-else 
           (RULE == 'cs) or-else (RULE == 'icc) or-else (RULE == 'varsat) or-else (RULE == 'gnd) or-else (RULE == 'ufree) or-else (RULE == 'rst) or-else 
           (RULE == 'gsi) or-else (RULE == 'cas) .
    ceq checkRules('apply_to_on_., RULE) = true 
        if (RULE == 'eeps) or-else (RULE == 'ns) or-else (RULE == 'gsi) or-else (RULE == 'cas) or-else (RULE == 'ni) or-else (RULE == 'va) .
    ceq checkRules('apply_to_on_with_., RULE) = true 
        if (RULE == 'gsi) or-else (RULE == 'cas) .
    ceq checkRules('apply_to_with_., RULE) = true 
        if (RULE == 'eq) or-else (RULE == 'es) or-else (RULE == 'gsi) or-else (RULE == 'cas) or-else (RULE == 'le) or-else (RULE == 'sp) or-else (RULE == 'cut) .
    ceq checkRules('apply_to_with_in_., RULE) = true 
        if (RULE == 'eq) .
    ceq checkRules('apply_to_with_in_sub_., RULE) = true 
        if (RULE == 'eq) .
    ceq checkRules('apply_to_with_sub_., RULE) = true 
        if (RULE == 'eq) or-else (RULE == 'sp) .
    
    eq < OID : NuITP | ATS, strats: SSL > parse(STR, 'trust_.['token[GOAL]]) = checkGoal(< OID : NuITP | ATS, strats: SSL >, STR, 'trust, 'apply_to_., GOAL, empty) .
    ceq < OID : NuITP | ATS, strats: SSL > parse(STR, 'apply_to_.['bubble[RULES?],'token[GOAL]]) = checkGoal(< OID : NuITP | ATS, strats: SSL >, STR, (if (RULE == 'gsi) then 'gsi+ else if (RULE == 'cas) then 'cas+ else RULE fi fi) STRAT, 'apply_to_., GOAL, empty)
        if RULE STRAT := unfoldStrat(downQidTermList(RULES?), SSL)
        /\ checkRules('apply_to_., RULE) .
    ceq < OID : NuITP | ATS, strats: SSL > parse(STR, 'apply_to_on_.['bubble[RULES?],'token[GOAL],'bubble[ARG]]) = checkGoal(< OID : NuITP | ATS, strats: SSL >, STR, RULE STRAT, 'apply_to_on_., GOAL, ARG)
        if RULE STRAT := unfoldStrat(downQidTermList(RULES?), SSL)
        /\ checkRules('apply_to_on_., RULE) .
    ceq < OID : NuITP | ATS, strats: SSL > parse(STR, 'apply_to_on_with_.['bubble[RULES?],'token[GOAL],'bubble[ARG1],'bubble[ARG2]]) = checkGoal(< OID : NuITP | ATS, strats: SSL >, STR, RULE STRAT, 'apply_to_on_with_., GOAL, (ARG1,ARG2))
        if RULE STRAT := unfoldStrat(downQidTermList(RULES?), SSL)
        /\ checkRules('apply_to_on_with_., RULE) .
    ceq < OID : NuITP | ATS, strats: SSL > parse(STR, 'apply_to_with_.['bubble[RULES?],'token[GOAL],'bubble[ARG]]) = checkGoal(< OID : NuITP | ATS, strats: SSL >, STR, RULE STRAT, 'apply_to_with_., GOAL, ARG)
        if RULE STRAT := unfoldStrat(downQidTermList(RULES?), SSL)
        /\ checkRules('apply_to_with_., RULE) .
    ceq < OID : NuITP | ATS, strats: SSL > parse(STR, 'apply_to_with_in_.['bubble[RULES?],'token[GOAL],'bubble[ARG1],'bubble[ARG2]]) = checkGoal(< OID : NuITP | ATS, strats: SSL >, STR, RULE STRAT, 'apply_to_with_in_., GOAL, (ARG1,ARG2))
        if RULE STRAT := unfoldStrat(downQidTermList(RULES?), SSL)
        /\ checkRules('apply_to_with_in_., RULE) .
    ceq < OID : NuITP | ATS, strats: SSL > parse(STR, 'apply_to_with_in_sub_.['bubble[RULES?],'token[GOAL],'bubble[ARG1],'bubble[ARG2],'bubble[ARG3]]) = checkGoal(< OID : NuITP | ATS, strats: SSL >, STR, RULE STRAT, 'apply_to_with_in_sub_., GOAL, (ARG1,ARG2,ARG3))
        if RULE STRAT := unfoldStrat(downQidTermList(RULES?), SSL)
        /\ checkRules('apply_to_with_in_sub_., RULE) .
    ceq < OID : NuITP | ATS, strats: SSL > parse(STR, 'apply_to_with_sub_.['bubble[RULES?],'token[GOAL],'bubble[ARG1],'bubble[ARG2]]) = checkGoal(< OID : NuITP | ATS, strats: SSL >, STR, RULE STRAT, 'apply_to_with_sub_., GOAL, (ARG1,ARG2))
        if RULE STRAT := unfoldStrat(downQidTermList(RULES?), SSL)
        /\ checkRules('apply_to_with_sub_., RULE) .

    eq < OID : NuITP | ATS > parse(STR, 'apply_to_.[NTL]) = < OID : NuITP | ATS > parse(STR, getTerm(noParse(1))) [ owise ] .
    eq < OID : NuITP | ATS > parse(STR, 'apply_to_with_.[NTL]) = < OID : NuITP | ATS > parse(STR, getTerm(noParse(1))) [ owise ] .
    eq < OID : NuITP | ATS > parse(STR, 'apply_to_with_sub_.[NTL]) = < OID : NuITP | ATS > parse(STR, getTerm(noParse(1))) [ owise ].
    eq < OID : NuITP | ATS > parse(STR, 'apply_to_on_.[NTL]) = < OID : NuITP | ATS > parse(STR, getTerm(noParse(1))) [ owise ] .
    eq < OID : NuITP | ATS > parse(STR, 'apply_to_on_with_.[NTL]) = < OID : NuITP | ATS > parse(STR, getTerm(noParse(1))) [ owise ] .

    eq < OID : NuITP | ATS > parse(STR, 'simplify_.['token[GOAL]]) = checkGoal(< OID : NuITP | ATS >, STR, nil, 'simplify_using_., GOAL, empty) .
    eq < OID : NuITP | ATS > parse(STR, 'simplify_using_.['token[GOAL],'token[STRAT]]) = checkGoal(< OID : NuITP | ATS >, STR, STRAT, 'simplify_using_., GOAL, empty) .
    
    eq < OID : NuITP | ATS > parse(STR, 'assert`..NuITP-Command) = assertGoal(< OID : NuITP | ATS >, STR, 'assert`..NuITP-Command, ''0.Qid) .
    eq < OID : NuITP | ATS > parse(STR, 'assert_.['token[GOAL]]) = assertGoal(< OID : NuITP | ATS >, STR, 'assert_., GOAL) .

    op assertGoal : Configuration String Qid Term -> Configuration .
    eq assertGoal(< OID : NuITP | ATS, goals: GOALS >, STR, 'assert`..NuITP-Command, GOAL) = 
        if (getGoal(GOALS, getGID(GOAL)) == mt)
        then --- Assertion failed: Goal GID does not exist. 
            printErr(< OID : NuITP | ATS, goals: GOALS >, error(70, join(getGID(GOAL))), STR, true)
        else
            if areProved(getChildren(GOALS, getGID(GOAL)) getGoal(GOALS, getGID(GOAL)))
            then 
                < OID : NuITP | ATS, goals: GOALS >
                write(stdout, OID, printCommand(ATS, STR) + GREEN + "  Assertion checked successfully." + BW + "\n\n")
            else --- Assertion failed: Initial goal is not proved.
                printErr(< OID : NuITP | ATS, goals: GOALS >, error(71), STR, true)
            fi
        fi .
    eq assertGoal(< OID : NuITP | ATS, goals: GOALS >, STR, 'assert_., GOAL) = 
        if (getGoal(GOALS, getGID(GOAL)) == mt)
        then --- Assertion failed: Goal GID does not exist.  
            printErr(< OID : NuITP | ATS, goals: GOALS >, error(70, join(getGID(GOAL))), STR, true)
        else 
            if areProved(getChildren(GOALS, getGID(GOAL)) getGoal(GOALS, getGID(GOAL)))
            then 
                < OID : NuITP | ATS, goals: GOALS >
                write(stdout, OID, printCommand(ATS, STR) + GREEN + "  Assertion checked successfully." + BW + "\n\n")
            else --- Assertion failed: Goal GID is not proved.
                printErr(< OID : NuITP | ATS, goals: GOALS >, error(72, join(getGID(GOAL))), STR, true)
            fi
        fi .
    
    op checkGoal : Configuration String QidList Qid Term TermList -> Configuration .
    eq checkGoal(< OID : NuITP | ATS, goals: GOALS >, STR, STRAT, CMD, GOAL, ARGS) =
        if (getGoal(GOALS, getGID(GOAL)) == mt)
        then --- Goal does not exist.
            printErr(< OID : NuITP | ATS, goals: GOALS >, error(41, join(getGID(GOAL))), STR, true)
        else 
            checkFrontier(< OID : NuITP | ATS, goals: GOALS >, STR, STRAT, CMD, getGID(GOAL), ARGS)
        fi .

    op checkFrontier : Configuration String QidList Qid QidList TermList -> Configuration .
    eq checkFrontier(< OID : NuITP | ATS, goals: GOALS >, STR, STRAT, CMD, GID, ARGS) =
        if (getProofState(GOALS) == true)
        then --- Initial goal has been proved. Frontier is closed.
            printErr(< OID : NuITP | ATS, goals: GOALS >, error(80), STR, true)
        else
            if (getProofState(GOALS) == false)
            then --- Initial goal has been disproved. Frontier is closed.
                printErr(< OID : NuITP | ATS, goals: GOALS >, error(81), STR, true)
            else
                if isFrontier(getGoal(GOALS, GID))
                then 
                    checkArgs(< OID : NuITP | ATS, goals: GOALS >, STR, STRAT, CMD, GID, ARGS)
                else --- Goal is not in the frontier.
                    printErr(< OID : NuITP | ATS, goals: GOALS >, error(82, join(GID)), STR, true)
                fi
            fi
        fi .

    op checkArgs : Configuration String QidList Qid QidList TermList -> Configuration .
    eq checkArgs(CONF, STR, STRAT, 'apply_to_., GID, empty) = checkApply(CONF, STR, STRAT, GID, none) .
    eq checkArgs(CONF, STR, STRAT, 'simplify_using_., GID, empty) = checkSimplify(CONF, STR, STRAT, GID, none) .

    ceq checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), 'apply_to_., GID, LABELS) =
        checkApply(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), GID, 'ARG1:QidList <- 'nil.QidList)
        if (RULE == 'es) .

    ceq checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), 'apply_to_with_., GID, LABELS) =
        if PARSED-LABELS :: QidList
        then 
            checkApply(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), GID, 'ARG1:QidList <- upTerm(PARSED-LABELS))
        else --- Equality not valid.
            printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(100), STR, true)
        fi
        if (RULE == 'es) 
        /\ PARSED-LABELS := downQidTermList(LABELS) .

    op reverse : Term -> [Term] .
    eq reverse('_->_[GAMMA,'_=>_[LHS,RHS]]) = '_->_[GAMMA,'_=>_[RHS,LHS]] .
    
    --- Equality (EQ) for Hypotheses/Equations (with label)
    ceq checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), CMD, GID, (LABEL,TL)) =
        if PARSED-EQUALITY :: Term
        then 
            checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), CMD, GID, (PARSED-EQUALITY,TL))
        else --- Equality not found.
            printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(115), STR, true)
        fi
        if (RULE == 'eq)
        /\ LABEL :: Qid
        /\ REVERSED := startsWith(string(LABEL), "'<") 
        /\ LABEL' := if REVERSED then qid("'" + substr(string(LABEL), 2, length(string(LABEL)))) else LABEL fi
        /\ (T ;; TS:[TermSet]) := (toOrientedClauses(INTMOD, getEquation(INTMOD, downTerm(LABEL', 'nil.QidList))) ;; (getHypothesis(INTMOD, INTHPS, INTLOCAL, INTEQP, getGoal(GOALS, GID), substr(string(downTerm(LABEL', (nil).QidList)), 0, length(string(downTerm(LABEL', (nil).QidList)))))))
        /\ PARSED-EQUALITY := 
            if REVERSED 
            then reverse(T)
            else T
            fi .

    op getEquality : Module Term -> Term .
    eq getEquality(M, '_->_[GAMMA,'_=>_[LHS,RHS]]) = '_->_[GAMMA,'_=>_[LHS,RHS]] .
    eq getEquality(M, '_=>_[LHS,RHS]) = '_->_['true.NuITP-Bool,'_=>_[LHS,RHS]] .
    eq getEquality(M, EQUALITY) = parseEquality(M, downTerm(EQUALITY, 'nil.QidList)) [ owise ] .
    
    --- Equality (EQ) for Hypotheses/Equations (explicit orientation)
    --- ARG1 EQ/HP label
    --- ARG2 Substitution
    --- ARG3 true = reversed orientation (for label mode only, default false)
    --- ARG4 Solution number (for interactive mode only, default 1)
    --- ARG5 Context (for interactive mode only, default [])
    ceq checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), 'apply_to_with_., GID, EQUALITY) =
        if PARSED-EQUALITY :: Term
        then 
            checkApplyInt(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), GID, ('ARG1:Term <- upTerm(PARSED-EQUALITY) ; 'ARG2:Substitution <- 'none.Substitution ; 'ARG3:Bool <- 'false.Bool ; 'ARG4:Nat <- 's_['0.Zero] ; 'ARG5:Context <- '`[`].Context))
        else --- Equality not valid. 
            printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(100), STR, true)
        fi
        if (RULE == 'eq) 
        /\ not(EQUALITY :: Qid)
        /\ SKO-MODULE := addOps(INTMOD, toOps(getSKO(getGoal(GOALS, GID))))
        /\ PARSED-EQUALITY := getEquality(SKO-MODULE, EQUALITY) .
    
    ceq checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), 'apply_to_with_sub_., GID, (EQUALITY, SUB)) =
        if PARSED-EQUALITY :: Term
        then
            if PARSED-SUB :: Substitution
            then 
                checkApplyInt(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), GID, ('ARG1:Term <- upTerm(PARSED-EQUALITY) ; 'ARG2:Substitution <- upTerm(PARSED-SUB) ; 'ARG3:Bool <- 'false.Bool ; 'ARG4:Nat <- 's_['0.Zero] ; 'ARG5:Context <- '`[`].Context))
            else --- Substitution not valid. 
                printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(101), STR, true)
            fi
        else --- Equality not valid. 
            printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(100), STR, true)
        fi
        if (RULE == 'eq) 
        /\ not(EQUALITY :: Qid)
        /\ SKO-MODULE := addOps(INTMOD, toOps(getSKO(getGoal(GOALS, GID))))
        /\ PARSED-EQUALITY := getEquality(SKO-MODULE, EQUALITY)
        /\ PARSED-SUB := parseSubstitution(SKO-MODULE, downTerm(SUB, 'nil.QidList)) .
    
    ceq checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), 'apply_to_with_in_., GID, (EQUALITY, CONTEXT)) =
        if PARSED-EQUALITY :: Term
        then
            if PARSED-CONTEXT :: Context
            then 
                checkApplyInt(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), GID, ('ARG1:Term <- upTerm(PARSED-EQUALITY) ; 'ARG2:Substitution <- 'none.Substitution ; 'ARG3:Bool <- 'false.Bool ; 'ARG4:Nat <- 's_['0.Zero] ; 'ARG5:Context <- upTerm(PARSED-CONTEXT)))
            else --- Context not valid.
                printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(116), STR, true)
            fi
        else --- Equality not valid.
            printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(100), STR, true)
        fi
        if (RULE == 'eq) 
        /\ not(EQUALITY :: Qid)
        /\ SKO-MODULE := addOps(INTMOD, toOps(getSKO(getGoal(GOALS, GID))))
        /\ PARSED-EQUALITY := getEquality(SKO-MODULE, EQUALITY)
        /\ PARSED-CONTEXT := parseContext(SKO-MODULE, downTerm(CONTEXT, 'nil.QidList)) .
    
    ceq checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), 'apply_to_with_in_sub_., GID, (EQUALITY, CONTEXT, SUB)) =
        if PARSED-EQUALITY :: Term
        then
            if PARSED-CONTEXT :: Context
            then
                if PARSED-SUB :: Substitution
                then 
                    checkApplyInt(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), GID, ('ARG1:Term <- upTerm(PARSED-EQUALITY) ; 'ARG2:Substitution <- upTerm(PARSED-SUB) ; 'ARG3:Bool <- 'false.Bool ; 'ARG4:Nat <- 's_['0.Zero] ; 'ARG5:Context <- upTerm(PARSED-CONTEXT)))
                else --- Substitution not valid.
                    printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(101), STR, true)
                fi
            else --- Context not valid.
                printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(116), STR, true)
            fi 
        else --- Equality not valid.
            printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(100), STR, true)
        fi
        if (RULE == 'eq) 
        /\ not(EQUALITY :: Qid)
        /\ SKO-MODULE := addOps(INTMOD, toOps(getSKO(getGoal(GOALS, GID))))
        /\ PARSED-EQUALITY := getEquality(SKO-MODULE, EQUALITY)
        /\ PARSED-CONTEXT := parseContext(SKO-MODULE, downTerm(CONTEXT, 'nil.QidList)) 
        /\ PARSED-SUB := parseSubstitution(SKO-MODULE, downTerm(SUB, 'nil.QidList)) .
    
    --- Generator Set Induction (GSI) & Case (CAS)
    --- 1..n variables with default Generator Sets.
    ceq checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, goals: GOALS >, STR, (RULE STRAT), 'apply_to_on_., GID, VAR) =
        if (PARSED-VARS :: TermList)
        then
            if ((RULE == 'gsi) and-then (PARSED-VARS in getCLA(getGoal(GOALS, GID)))) or-else ((RULE == 'cas) and-then (PARSED-VARS in unfreeze(getCLA(getGoal(GOALS, GID)))))
            then
                if hasGeneratorSet?(PARSED-VARS, GENSETS)
                then 
                    checkApply(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, goals: GOALS >, STR, (RULE STRAT), GID, ('ARG1:TermList <- upTerm(freeze(PARSED-VARS, getSKO(getGoal(GOALS, GID))))))
                else --- Generator set not valid.
                    printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, goals: GOALS >, error(106), STR, true)
                fi
            else --- Variable not found in the clause.
                printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, goals: GOALS >, error(109), STR, true)
            fi --- Variable not valid.
        else printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, goals: GOALS >, error(108), STR, true)
        fi
        if (RULE == 'gsi) or-else (RULE == 'cas) 
        /\ SKO-MODULE := addOps(INTMOD, toOps(getSKO(getGoal(GOALS, GID))))
        /\ PARSED-VARS := parseVariables(SKO-MODULE, downTerm(VAR, 'nil.QidList), if (RULE == 'cas) then getVars(unfreeze(getCLA(getGoal(GOALS, GID)))) else getVars(getCLA(getGoal(GOALS, GID))) fi) .

    --- 1..n variables with explicit Generator Sets (previously saved, except for the single variable case).
    ceq checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, goals: GOALS >, STR, (RULE STRAT), 'apply_to_on_with_., GID, (VAR,GENSET)) =
        if (PARSED-VARS :: TermList)
        then
            if ((RULE == 'gsi) and-then (PARSED-VARS in getCLA(getGoal(GOALS, GID)))) or-else ((RULE == 'cas) and-then (PARSED-VARS in unfreeze(getCLA(getGoal(GOALS, GID)))))
            then 
                if (PARSED-GENSETS :: GenSetList) and-then (PARSED-GENSETS =/= nil)
                then 
                    checkApply(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, goals: GOALS >, STR, (RULE STRAT), GID, ('ARG1:TermList <- upTerm(freeze(PARSED-VARS, getSKO(getGoal(GOALS, GID)))) ; 'ARG2:GenSetList <- upTerm(PARSED-GENSETS)))
                else --- Generator set not valid.
                    printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, goals: GOALS >, error(106), STR, true)
                fi
            else --- Variable not found in the clause.
                printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, goals: GOALS >, error(109), STR, true)
            fi
        else --- Variable not valid.
            printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, goals: GOALS >, error(108), STR, true)
        fi
        if (RULE == 'gsi) or-else (RULE == 'cas) 
        /\ SKO-MODULE := addOps(INTMOD, toOps(getSKO(getGoal(GOALS, GID))))
        /\ PARSED-VARS := parseVariables(SKO-MODULE, downTerm(VAR, 'nil.QidList), if (RULE == 'cas) then getVars(unfreeze(getCLA(getGoal(GOALS, GID)))) else getVars(getCLA(getGoal(GOALS, GID))) fi)
        /\ PARSED-GENSETS := parseGenSets(SKO-MODULE, GENSETS, PARSED-VARS, downTerm(GENSET,'nil.QidList)) .
    
    --- All variables with explicit Generator Sets (previously saved, except for the single variable case).
    ceq checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, goals: GOALS >, STR, (RULE STRAT), 'apply_to_with_., GID, (GENSET)) =
        if (PARSED-GENSETS :: GenSetList) and-then (PARSED-GENSETS =/= nil)
        then 
            checkApply(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, goals: GOALS >, STR, (RULE STRAT), GID, ('ARG1:TermList <- upTerm(if (RULE == 'cas) then getVars(unfreeze(getCLA(getGoal(GOALS, GID)))) else getVars(getCLA(getGoal(GOALS, GID))) fi) ; 'ARG2:GenSetList <- upTerm(PARSED-GENSETS)))
        else --- Generator set not valid.
            printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, goals: GOALS >, error(106), STR, true)
        fi
        if (RULE == 'gsi) or-else (RULE == 'cas) 
        /\ SKO-MODULE := addOps(INTMOD, toOps(getSKO(getGoal(GOALS, GID))))
        /\ PARSED-GENSETS := parseGenSets(SKO-MODULE, GENSETS, getVars(unfreeze(getCLA(getGoal(GOALS, GID)))), downTerm(GENSET,'nil.QidList)) .

    --- Explicit Equality Simplification (EEPS)
    ceq checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), 'apply_to_on_., GID, NAWEX) =
        if PARSED-TERM :: Term
        then 
            checkApply(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, 'eeps, GID, ('ARG1:Term <- upTerm(PARSED-TERM)))
        else --- Narrowex not valid.
            printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(104), STR, true)
        fi
        if (RULE == 'eeps) 
        /\ SKO-MODULE := addOps(INTMOD, toOps(getSKO(getGoal(GOALS, GID))))
        /\ PARSED-TERM := parseTerm(SKO-MODULE, downTerm(NAWEX, 'nil.QidList)) .

    --- Narrowing Induction (NI)
    ceq checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), 'apply_to_on_., GID, NAWEX) =
        if PARSED-TERM :: Term
        then 
            checkApply(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, ((if (RULE == 'ns) then 'ins else RULE fi) STRAT), GID, ('ARG1:Term <- upTerm(PARSED-TERM)))
        else --- Narrowex not valid. 
            printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(104), STR, true)
        fi
        if (RULE == 'ns) or-else (RULE == 'ni)
        /\ SKO-MODULE := addOps(INTMOD, toOps(getSKO(getGoal(GOALS, GID))))
        /\ PARSED-TERM := parseTerm(SKO-MODULE, downTerm(NAWEX, 'nil.QidList)) .
    
    --- Lemma Enrichment (LE)
    ceq checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), 'apply_to_with_., GID, LEMMA) =
        if PARSED-LEMMA :: Term
        then 
            checkApply(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), GID, ('ARG1:Term <- upTerm(PARSED-LEMMA)))
        else --- Lemma not valid.
            printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(102), STR, true)
        fi
        if (RULE == 'le) 
        /\ SKO-MODULE := addOps(INTMOD, toOps(getSKO(getGoal(GOALS, GID))))
        /\ PARSED-LEMMA := parseClause(SKO-MODULE, downTerm(LEMMA, 'nil.QidList)) .
    
    --- Split (SP)
    ceq checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), 'apply_to_with_., GID, DISJ) =
        if PARSED-DISJ :: Term
        then 
            checkApply(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), GID, ('ARG1:Term <- upTerm(PARSED-DISJ) ; 'ARG2:Substitution <- 'none.Substitution))
        else --- Disjunction not valid.
            printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(103), STR, true)
        fi
        if (RULE == 'sp) 
        /\ SKO-MODULE := addOps(INTMOD, toOps(getSKO(getGoal(GOALS, GID))))
        /\ PARSED-DISJ := parseDisjunction(SKO-MODULE, downTerm(DISJ, 'nil.QidList)) .
        
    ceq checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), 'apply_to_with_sub_., GID, (DISJ,SUB)) =
        if PARSED-DISJ :: Term
        then
            if PARSED-SUB :: Substitution
            then 
                checkApply(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), GID, ('ARG1:Term <- upTerm(PARSED-DISJ) ; 'ARG2:Substitution <- upTerm(PARSED-SUB)))
            else --- Substitution not valid.
                printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(101), STR, true)
            fi
        else --- Disjunction not valid. 
            printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(103), STR, true)
        fi
        if (RULE == 'sp) 
        /\ SKO-MODULE := addOps(INTMOD, toOps(getSKO(getGoal(GOALS, GID))))
        /\ PARSED-DISJ := parseDisjunction(SKO-MODULE, downTerm(DISJ, 'nil.QidList))
        /\ PARSED-SUB := parseSubstitution(SKO-MODULE, downTerm(SUB, 'nil.QidList)) .
    
    --- Variable Abstraction (VA)
    ceq checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), 'apply_to_on_., GID, TERM) =
        if PARSED-TERM :: Term
        then 
            checkApply(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), GID, ('ARG1:Term <- upTerm(PARSED-TERM)))
        else --- Term not valid.
            printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(105), STR, true)
        fi
        if (RULE == 'va) 
        /\ SKO-MODULE := addOps(INTMOD, toOps(getSKO(getGoal(GOALS, GID))))
        /\ PARSED-TERM := parseTerm(SKO-MODULE, downTerm(TERM, 'nil.QidList)) .

    --- Cut (CUT)
    ceq checkArgs(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), 'apply_to_with_., GID, TERM) =
        if PARSED-CONJ :: Term
        then 
            if (getVars(PARSED-CONJ) in getVars(getCLA(getGoal(GOALS, GID))))
            then 
                checkApply(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, STR, (RULE STRAT), GID, ('ARG1:Term <- upTerm(PARSED-CONJ)))
            else --- Conjunction has fresh variables.
                printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(114), STR, true)
            fi --- Conjunction not valid.
        else printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, goals: GOALS >, error(113), STR, true)
        fi
        if (RULE == 'cut) 
        /\ SKO-MODULE := addOps(INTMOD, toOps(getSKO(getGoal(GOALS, GID))))
        /\ PARSED-CONJ := parseConjunction(SKO-MODULE, downTerm(TERM, 'nil.QidList)) .
    
    op checkApply : Configuration String QidList QidList Substitution -> Configuration .
    eq checkApply(< OID : NuITP | ATS >, STR, STRAT, GID, SB) = checkApply(< OID : NuITP | ATS >, STR, STRAT, GID, SB, false)  .

    op checkApply : Configuration String QidList QidList Substitution Bool -> Configuration .
    ceq checkApply(< OID : NuITP | ATS, verbose: VERBOSE, log: LOG, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, strats: SSL, goals: GOALS >, STR, STRAT, GID, SB, NEWLINE) =
        < OID : NuITP | ATS', goals: GOALS'' >
        write(stdout, OID, (if NEWLINE then "\n" else "" fi) + printCommand(ATS, STR) + CYAN + "  " + getRuleMsg(STRAT) + " applied to goal " + join(GID) + "." + BW + "\n\n" +
            toStringApply(INTMOD, getFrontier(GOALS''), getChildren(GOALS'', GID), getFrontierChildren(GOALS'', GID), getNewLocallyProved(getProved(GOALS { (GID '. '1), RID, INTER, FRO, SFRO, VC, SKO, HPS, CLA | DATA } GOALS'), getProved(GOALS'')), VERBOSE))
        if { (GID '. '1), RID, INTER, FRO, SFRO, VC, SKO, HPS, CLA | DATA } GOALS' := applyRule(getLocalModule(INTMOD, INTLOCAL), STRAT, SB, GENSETS, SSL, toClauses(INTMOD) ;; INTLOCAL, getGoal(GOALS,GID))
        /\ < OID : NuITP | ATS', goals: GOALS'' > := checkLocalInt(< OID : NuITP | ATS, verbose: VERBOSE, log: (LOG [ GID : STR + "\n" ]), internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, strats: SSL, goals: (closeGoal(GOALS, GID) { (GID '. '1), RID, INTER, FRO, SFRO, VC, SKO, HPS, CLA | DATA } GOALS') >) .
    --- Failure applying rule RID to goal GID .
    eq checkApply(< OID : NuITP | ATS >, STR, RULE, GID, SB, NEWLINE) = printErr(< OID : NuITP | ATS >, error(200, getRuleMsg(RULE), join(GID)), STR, true)  [ owise ] .
    --- Failure applying rule RID to goal GID .
    eq checkApply(< OID : NuITP | ATS >, STR, RULE Q STRAT, GID, SB, NEWLINE) = printErr(< OID : NuITP | ATS >, error(200, getRuleMsg(RULE Q STRAT), join(GID)), STR, true)  [ owise ] .

    op checkApplyInt : Configuration String QidList QidList Substitution -> Configuration .
    ceq checkApplyInt(< OID : NuITP | ATS, io: IOL, verbose: VERBOSE, log: LOG, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, strats: SSL, goals: GOALS >, STR, RULE STRAT, GID, SB ; 'ARG4:Nat <- 's_['0.Zero]) = 
        checkApplyInt'(< OID : NuITP | ATS, io: IOL, verbose: VERBOSE, log: LOG, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, strats: SSL, goals: GOALS >, STR, RULE STRAT, GID, SB, 0)
        write(stdout, OID, (if IOL == nil then "\n" else printCommand(ATS, STR) fi) + RED + "  Multiple matches found for EQ application. Please select one.\n\n" + BW)
        < OID : NuITP | solutions: mt >
        if { (GID '. '1), RID, INTER, FRO, SFRO, VC, SKO, HPS, CLA | DATA } GOALS' := applyRule(getLocalModule(INTMOD, INTLOCAL), RULE STRAT, SB ; 'ARG4:Nat <- 's_['0.Zero], GENSETS, SSL, toClauses(INTMOD) ;; INTLOCAL, getGoal(GOALS,GID)) .
    eq checkApplyInt(< OID : NuITP | ATS >, STR, STRAT, GID, SB ; 'ARG4:Nat <- 's_['0.Zero]) = checkApply(< OID : NuITP | ATS >, STR, STRAT, GID, SB ; 'ARG4:Nat <- '0.Zero) [ owise ] .

    op checkApplyInt' : Configuration String QidList QidList Substitution Nat -> Configuration .
    ceq checkApplyInt'(< OID : NuITP | ATS, verbose: VERBOSE, log: LOG, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, strats: SSL, goals: GOALS >, STR, STRAT, GID, SB, N) < OID : NuITP | solutions: SOLS > wrote(OID, stdout) =
        write(stdout, OID, toStringOption(addOps(INTMOD, SKO), downTerm(TCO, nil), downTerm(TLHS, nil), downTerm(TSB, none), downTerm(TN, nil)) + "\n")
        checkApplyInt'(< OID : NuITP | ATS, verbose: VERBOSE, log: LOG, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, strats: SSL, goals: GOALS >, STR, STRAT, GID, SB, N + 1)
        < OID : NuITP | solutions: SOLS ;; ('<_:_|_>['console.Oid, 'NuITP.Cid, '_`,_['module:_[upTerm(addOps(INTMOD, SKO))], 'context:_[TCO], 'term:_[TLHS], 'subs:_[TSB], 'sol:_[TN]]]) >
        if { (GID '. '1), RID, INTER, FRO, SFRO, VC, SKO, HPS, CLA | '<_:_|_>['console.Oid, 'NuITP.Cid, '_`,_['context:_[TCO], 'term:_[TLHS], 'subs:_[TSB], 'sol:_[TN]]] } GOALS' := applyRule(getLocalModule(INTMOD, INTLOCAL), STRAT, SB ; 'ARG4:Nat <- upTerm(N), GENSETS, SSL, toClauses(INTMOD) ;; INTLOCAL, getGoal(GOALS,GID)) .
    eq checkApplyInt'(< OID : NuITP | ATS >, STR, STRAT, GID, SB, N) wrote(OID, stdout) = checkApplyInt''(< OID : NuITP | ATS >, STR, STRAT, GID, SB, N) getLine(stdin, OID, "  Select valid matching number or q(uit): ") [ owise ] .

    op extendCommand : Module String Term Term Term -> String .
    eq extendCommand(M, STR, TLHS, TCO, TSB) = extendCommand'(M, trim(substr(STR, 0, find(STR, "with ", 0) + 5)) + " ", parseCommand(STR), TLHS, TCO, TSB) .
    
    op extendCommand' : Module String Term Term Term Term -> String .
    eq extendCommand'(M, STR, 'apply_to_with_.['bubble[RULES?],'token[GOAL],'bubble[ARG]], TLHS, TCO, TSB) = STR + toStringEQ(M, downTerm(ARG, (nil).QidList)) + " in " + toString(M, downTerm(TCO, []), downTerm(TLHS, nil)) + extendCommand''(M, downTerm(TSB, (none).Substitution)) .
    eq extendCommand'(M, STR, 'apply_to_with_in_.['bubble[RULES?],'token[GOAL],'bubble[ARG1],'bubble[ARG2]], TLHS, TCO, TSB) = STR + toStringEQ(M, downTerm(ARG1, (nil).QidList)) + " in " + toString(M, downTerm(TCO, []), downTerm(TLHS, nil)) + extendCommand''(M, downTerm(TSB, (none).Substitution)) .
    eq extendCommand'(M, STR, 'apply_to_with_in_sub_.['bubble[RULES?],'token[GOAL],'bubble[ARG1],'bubble[ARG2],'bubble[ARG3]], TLHS, TCO, TSB) = STR + toStringEQ(M, downTerm(ARG1, (nil).QidList)) + " in " + toString(M, downTerm(TCO, []), downTerm(TLHS, nil)) + extendCommand''(M, downTerm(TSB, (none).Substitution)) .
    eq extendCommand'(M, STR, 'apply_to_with_sub_.['bubble[RULES?],'token[GOAL],'bubble[ARG1],'bubble[ARG2]], TLHS, TCO, TSB) = STR + toStringEQ(M, downTerm(ARG1, (nil).QidList)) + " in " + toString(M, downTerm(TCO, []), downTerm(TLHS, nil)) + extendCommand''(M, downTerm(TSB, (none).Substitution)) .

    op extendCommand'' : Module Substitution -> String .
    eq extendCommand''(M, none) = " ." .
    eq extendCommand''(M, SB) = " sub " + toString(M, SB) + " ." .

    op checkApplyInt'' : Configuration String QidList QidList Substitution Nat -> Configuration .
    ceq checkApplyInt''(< OID : NuITP | ATS, io: IOL >, STR, RULE STRAT, GID, SB ; 'ARG2:Substitution <- TSB' ; 'ARG5:Context <- '`[`].Context, N) < OID : NuITP | solutions: (SOLS ;; ('<_:_|_>['console.Oid, 'NuITP.Cid, '_`,_['module:_[TMOD],'context:_[TCO], 'term:_[TLHS], 'subs:_[TSB], 'sol:_[TN]]])) > gotLine(OID, stdin, STR') = 
        checkApply(< OID : NuITP | ATS, io: IOL >, extendCommand(downTerm(TMOD, upModule('BOOL, true)), STR, TLHS, TCO, TSB), RULE STRAT, GID, SB ; 'ARG2:Substitution <- TSB ; 'ARG4:Nat <- upTerm(0) ; 'ARG5:Context <- TCO, IOL =/= nil) 
        if N' := rat(trim(STR'), 10)
        /\ downTerm(TN, nil) == N' .
    --- Failure applying rule RID (cancelled by user).
    ceq checkApplyInt''(< OID : NuITP | ATS, io: IOL >, STR, RULE STRAT, GID, SB, N) < OID : NuITP | solutions: SOLS > gotLine(OID, stdin, STR') = printErr(< OID : NuITP | ATS, io: IOL >, error(202, getRuleMsg(RULE)), "", true)
        if trim(STR') == "q" or-else trim(STR') == "quit" .
    eq checkApplyInt''(< OID : NuITP | ATS >, STR, STRAT, GID, SB, N) < OID : NuITP | solutions: SOLS > gotLine(OID, stdin, STR') = checkApplyInt''(< OID : NuITP | ATS >, STR, STRAT, GID, SB, N) < OID : NuITP | solutions: SOLS > getLine(stdin, OID, "  Select valid matching number or q(uit): ") [ owise ] .

    op checkSimplify : Configuration String QidList QidList Substitution -> Configuration .
    ceq checkSimplify(< OID : NuITP | ATS, verbose: VERBOSE, log: LOG, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, strats: SSL, goals: GOALS >, STR, STRAT, GID, SB) =
        < OID : NuITP | ATS', goals: GOALS'' >
        write(stdout, OID, printCommand(ATS, STR) + CYAN + "  " + "Simplification Strategy " + if (STRAT == nil) then getDefaultStratId(SSL) else string(downTerm(STRAT, nil)) fi + " applied to goal " + join(GID) + "." + BW + "\n\n" +
            toStringApply(INTMOD, getFrontier(GOALS''), getChildren(GOALS'', GID), getFrontierChildren(GOALS'', GID), getNewLocallyProved(getProved(GOALS { (GID '. '1), RID, INTER, FRO, SFRO, VC, SKO, HPS, CLA | DATA } GOALS'), getProved(GOALS'')), VERBOSE))
        if ((STRAT == nil) or-else getStrat(SSL, string(downTerm(STRAT, nil))) =/= empty)
        /\ { (GID '. '1), RID, INTER, FRO, SFRO, VC, SKO, HPS, CLA | DATA } GOALS' := applyStrat(getLocalModule(INTMOD, INTLOCAL), downTerm(STRAT, nil), GENSETS, SSL, toClauses(INTMOD) ;; INTLOCAL, getGoal(GOALS,GID)) 
        /\ < OID : NuITP | ATS', goals: GOALS'' > := checkLocalInt(< OID : NuITP | ATS, verbose: VERBOSE, log: (LOG [ GID : STR + "\n" ]), internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, strats: SSL, goals: (closeGoal(GOALS, GID) { (GID '. '1), RID, INTER, FRO, SFRO, VC, SKO, HPS, CLA | DATA } GOALS') >) .
    eq checkSimplify(< OID : NuITP | ATS, strats: SSL >, STR, STRAT, GID, SB) = 
        if getStrat(SSL, string(downTerm(STRAT, nil))) == empty
        then 
            printErr(< OID : NuITP | ATS, strats: SSL >, error(134, if (STRAT == nil) then getDefaultStratId(SSL) else string(downTerm(STRAT, nil)) fi), STR, true)  
        else 
            printErr(< OID : NuITP | ATS, strats: SSL >, error(201, if (STRAT == nil) then getDefaultStratId(SSL) else string(downTerm(STRAT, nil)) fi, join(GID)), STR, true)  
        fi [ owise ] .
    eq checkSimplify(< OID : NuITP | ATS, strats: SSL >, STR, RULE Q STRAT, GID, SB) = 
        if getStrat(SSL, string(downTerm(STRAT, nil))) == empty
        then --- Simplification strategy STRAT not found.
            printErr(< OID : NuITP | ATS, strats: SSL >, error(134, string(downTerm(STRAT, nil))), STR, true)  
        else --- Failure applying strategy RID to goal GID .
            printErr(< OID : NuITP | ATS, strats: SSL >, error(201, printTokens(downTerm(RULE Q STRAT, nil)), join(GID)), STR, true)  
        fi [ owise ] .

    op checkLocalInt : Configuration -> Configuration .
    eq checkLocalInt(< OID : NuITP | ATS, local: false >) = < OID : NuITP | ATS, local: false > .
    eq checkLocalInt(< OID : NuITP | ATS, local: true, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, goals: GOALS >) = 
        checkUpdateInternal(< OID : NuITP | ATS, local: true, internal: internalizeLocal(INTMOD | INTHPS | INTLOCAL | INTEQP, getClauses(getLocalInt(GOALS))), gensets: GENSETS,
        goals: updateInternal(internalizeLocal(INTMOD | INTHPS | INTLOCAL | INTEQP, getClauses(getLocalInt(GOALS))), getGoals(getLocalInt(GOALS))) >) .
    
    op checkUpdateInternal : Configuration -> Configuration .
    ceq checkUpdateInternal(< OID : NuITP | ATS, verbose: VERBOSE, local: LOCAL, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, strats: SSL, goals: GOALS >) =
        (< OID : NuITP | ATS, verbose: VERBOSE, local: LOCAL, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, gensets: GENSETS, strats: SSL, goals: GOALS' >)
        if GOALS' := applyStrat(getLocalModule(INTMOD, INTLOCAL), 'default-update-internal, GENSETS, SSL, toClauses(INTMOD) ;; INTLOCAL, GOALS) .
    eq checkUpdateInternal(CONF) = CONF [ owise ] .

    op getNewLocallyProved : GoalSet GoalSet -> GoalSet .
    eq getNewLocallyProved(({ GID, RID, INTER, FRO, SFRO, VC, SKO, HPS, CLA | DATA } GOALS), ({ GID, RID, INTER', FRO, SFRO, VC, SKO, HPS, CLA | DATA } GOALS')) = getNewLocallyProved(GOALS, GOALS') .
    eq getNewLocallyProved(mt, GOALS') = GOALS' [ owise ] .
endm

mod NuITP-EXT is
    pr NuITP .

    var M INTMOD : Module .
    var NTL : NeTermList .
    var TL : TermList .
    vars T GAMMA DELTA : Term .
    var INTHPS INTLOCAL INTEQP : TermSet .
    var LEMMAS : NeTermSet .
    var GOAL : Goal .
    var GOALS : GoalSet .
    var QL : QidList .
    var STA : Strategy .
    var STR : String .
    var GCS : GenSetCollectionSet .
    
    op metaNuITPCheck : Module Term -> [GoalSet] .
    eq metaNuITPCheck(M, T) = metaNuITPCheck(M, T, NuITPDefaultStrategy, mt, mt) .

    op metaNuITPCheck : Module Term String -> [GoalSet] .
    ceq metaNuITPCheck(M, T, STR) = metaNuITPCheck(M, T, STA, mt, mt) 
        if STA := metaParseStrategy(setStrategies(upModule('NuITP-SIMPLIFICATION-STRATEGIES, false), [ "NuITP" : NuITPDefaultStrategy ], true), none, tokenize(STR)) .

    op metaNuITPCheck : Module Term NeTermSet -> [GoalSet] .
    eq metaNuITPCheck(M, T, LEMMAS) = metaNuITPCheck(M, T, NuITPDefaultStrategy, LEMMAS, mt) .

    op metaNuITPCheck : Module Term String NeTermSet -> [GoalSet] .
    ceq metaNuITPCheck(M, T, STR, LEMMAS) = metaNuITPCheck(M, T, STA, LEMMAS, mt) 
        if STA := metaParseStrategy(setStrategies(upModule('NuITP-SIMPLIFICATION-STRATEGIES, false), [ "NuITP" : NuITPDefaultStrategy ], true), none, tokenize(STR)) .

    op metaNuITPCheck : Module Term Strategy TermSet GenSetCollectionSet -> [GoalSet] .
    ceq metaNuITPCheck(M, '_->_[GAMMA,DELTA], STA, mt, GCS) = getProofState(GOAL GOALS)
        if (GOAL GOALS) := applyStrat(extModule(M), 'NuITP, GCS, [ "NuITP" : STA ], mt, { '0, 'init, false, true, true, 1 + size(getVars('_->_[GAMMA,DELTA])), mt, mt, normalizeVars('_->_[GAMMA,DELTA]) | 'none.Configuration }) .
    ceq metaNuITPCheck(M, T, STA, mt, GCS) = getProofState(GOAL GOALS)
        if (GOAL GOALS) := applyStrat(extModule(M), 'NuITP, GCS, [ "NuITP" : STA ], mt, { '0, 'init, false, true, true, 1 + size(getVars(T)), mt, mt, normalizeVars('_->_['true.NuITP-Bool,T]) | 'none.Configuration }) [ owise ] .
    ceq metaNuITPCheck(M, '_->_[GAMMA,DELTA], STA, LEMMAS, GCS) = getProofState(GOAL GOALS)
        if (INTMOD | INTHPS | INTLOCAL | INTEQP) := internalize(extModule(M) | mt | mt | mt, normalizeVarsInternal(LEMMAS, "H", 0))
        /\ (GOAL GOALS) := applyStrat(INTMOD, 'NuITP, GCS, [ "NuITP" : STA ], mt, { '0, 'init, false, true, true, 1 + size(getVars('_->_[GAMMA,DELTA])), mt, hsimp(INTMOD, mt, INTHPS), normalizeVars('_->_[GAMMA,DELTA]) | 'none.Configuration }) .
    ceq metaNuITPCheck(M, T, STA, LEMMAS, GCS) = getProofState(GOAL GOALS)
        if (INTMOD | INTHPS | INTLOCAL | INTEQP) := internalize(extModule(M) | mt | mt | mt, normalizeVarsInternal(LEMMAS, "H", 0))
        /\ (GOAL GOALS) := applyStrat(INTMOD, 'NuITP, GCS, [ "NuITP" : STA ], mt, { '0, 'init, false, true, true, 1 + size(getVars(T)), mt, hsimp(INTMOD, mt, INTHPS), normalizeVars('_->_['true.NuITP-Bool,T]) | 'none.Configuration }) [ owise ] .
endm

set show command off . 

--- smt.maude (loaded above) leaves "set include BOOLEAN on"; restore the default
set include BOOLEAN off .
