    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'trust`internalize_only`as`disequality`.['token[TGID]]) = < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize_as`disequality`.['token[TGID]], true, true) .

    eq < OID : NuITP | ATS, wild: WILD, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize_as`disequality`.['token[TGID]], TRUSTED, ONLY) =
        if checkInternalizePredicate(GOALS, getGID(TGID), false, TRUSTED) == noError
        then 
            if (internalizeDisequality(INTMOD | INTHPS | INTLOCAL | INTEQP, getCLA(getGoal(GOALS, '0)), empty, ONLY) :: Internal)
            then
                < OID : NuITP | ATS, internal: internalize(INTMOD | INTHPS | INTLOCAL | INTEQP, getCLA(getGoal(GOALS, '0))), log: (LOG [ nil : STR + "\n" ]), goals: GOALS >
                printMsg(stdout, OID, ATS, (if TRUSTED then "Potentially unproved" else "Proved" fi) + " goal has been internalized as a disequality.")
            else --- Unable to internalize: Unexpected error.
                printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS >, error(93), STR, true)
            fi
        else
            printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS >, checkInternalizePredicate(GOALS, getGID(TGID), false, TRUSTED), STR, true)
        fi .

    --- internalize <GID> <only> as disequality with EQ .
    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize`as`disequality`for_.['bubble[ARG1]]) = < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize_as`disequality`for_.['token[''0.Qid],'bubble[ARG1]], false, false) .
    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize_as`disequality`for_.['token[TGID],'bubble[ARG1]]) = < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize_as`disequality`for_.['token[TGID],'bubble[ARG1]], false, false) .
