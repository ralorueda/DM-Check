    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'trust`internalize_as`disequality`for_.['token[TGID],'bubble[ARG1]]) = < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize_as`disequality`for_.['token[TGID],'bubble[ARG1]], true, false) .
    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'trust`internalize`only`as`disequality`for_.['bubble[ARG1]]) = < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize_as`disequality`for_.['token[''0.Qid],'bubble[ARG1]], true, true) .
    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'trust`internalize_only`as`disequality`for_.['token[TGID],'bubble[ARG1]]) = < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize_as`disequality`for_.['token[TGID],'bubble[ARG1]], true, true) .

    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize_as`disequality`for_.['token[TGID],'bubble[ARG1]], TRUSTED, ONLY) =
        if checkInternalizePredicate(GOALS, getGID(TGID), false, TRUSTED) == noError
        then 
            if (parseGammaEquality(INTMOD, downTerm(ARG1, 'nil.QidList))) :: Term
            then 
                if (internalizeDisequality(INTMOD | INTHPS | INTLOCAL | INTEQP, getCLA(getGoal(GOALS, '0)), parseGammaEquality(INTMOD, downTerm(ARG1, 'nil.QidList)), ONLY) :: Internal)
                then
