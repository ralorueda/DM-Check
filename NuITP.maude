    --- trust internalize as assoc .
    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'trust`internalize`as`assoc`..NuITP-Command) =
       < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'trust`internalize`as`assoc`.['token[''0.Qid]]) .
    --- trust internalize as comm .
    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'trust`internalize`as`comm`..NuITP-Command) =
       < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'trust`internalize`as`comm`.['token[''0.Qid]]) .
    --- trust internalize as assoc comm .
    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'trust`internalize`as`assoc`comm`..NuITP-Command) =
       < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'trust`internalize`as`assoc`comm`.['token[''0.Qid]]) .
    --- trust internalize as comm assoc .
    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'trust`internalize`as`comm`assoc`..NuITP-Command) =
       < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'trust`internalize`as`assoc`comm`.['token[''0.Qid]]) .

    --- trust internalize GID as assoc .
    eq < OID : NuITP | ATS, wild: WILD, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'trust`internalize`as`assoc`.['token[TGID]]) =
        if checkInternalizeAxiom(INTMOD, GOALS, getGID(TGID), assoc, true) == noError
        then
            if (internalize(INTMOD | INTHPS | INTLOCAL | INTEQP, getCLA(getGoal(GOALS, '0)), assoc) :: Internal)
            then
                if checkExec(internalize(INTMOD | INTHPS | INTLOCAL | INTEQP, getCLA(getGoal(GOALS, '0)), assoc))
                then
                    < OID : NuITP | ATS, wild: true, internal: internalize(INTMOD | INTHPS | INTLOCAL | INTEQP, getCLA(getGoal(GOALS, '0)), assoc), log: (LOG [ nil : STR + "\n" ]), goals: GOALS >
                    printMsg(stdout, OID, ATS, "Unproved goal has been internalized as assoc axiom.")
                else --- Unable to internalize: Original theory may become non-executable.
                    printErr(< OID : NuITP | ATS, wild: WILD, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS >, error(92), STR, true)
                fi
            else --- Unable to internalize: Unexpected error.
                printErr(< OID : NuITP | ATS, wild: WILD, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS >, error(93), STR, true)
            fi
        else
            printErr(< OID : NuITP | ATS, wild: WILD, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS >, checkInternalizeAxiom(INTMOD, GOALS, getGID(TGID), assoc, true), STR, true)
        fi .

    --- trust internalize GID as comm .
    eq < OID : NuITP | ATS, wild: WILD, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'trust`internalize`as`comm`.['token[TGID]]) =
        if checkInternalizeAxiom(INTMOD, GOALS, getGID(TGID), comm, true) == noError
        then
            if (internalize(INTMOD | INTHPS | INTLOCAL | INTEQP, getCLA(getGoal(GOALS, '0)), comm) :: Internal)
            then
