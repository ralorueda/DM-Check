    --- internalize as assoc comm .
    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize`as`assoc`comm`..NuITP-Command) =
        < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize`as`assoc`comm`.['token[''0.Qid]]) .
    --- internalize as comm assoc .
    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize`as`comm`assoc`..NuITP-Command) =
        < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize`as`assoc`comm`.['token[''0.Qid]]) .

    --- internalize GID as assoc .
    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize`as`assoc`.['token[TGID]]) =
        if checkInternalizeAxiom(INTMOD, GOALS, getGID(TGID), assoc, false) == noError
        then
            if (internalize(INTMOD | INTHPS | INTLOCAL | INTEQP, getCLA(getGoal(GOALS, '0)), assoc) :: Internal)
            then
                if checkExec(internalize(INTMOD | INTHPS | INTLOCAL | INTEQP, getCLA(getGoal(GOALS, '0)), assoc))
                then
                    < OID : NuITP | ATS, internal: internalize(INTMOD | INTHPS | INTLOCAL | INTEQP, getCLA(getGoal(GOALS, '0)), assoc), log: (LOG [ nil : STR + "\n" ]), goals: GOALS >
                    printMsg(stdout, OID, ATS, "Proved goal has been internalized as assoc axiom.")
                else --- Unable to internalize: Original theory may become non-executable.
                    printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS >, error(92), STR, true)
                fi
            else --- Unable to internalize: Unexpected error.
                printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS >, error(93), STR, true)
            fi
        else
            printErr(< OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS >, checkInternalizeAxiom(INTMOD, GOALS, getGID(TGID), assoc, false), STR, true)
        fi .

    --- internalize GID as comm .
    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize`as`comm`.['token[TGID]]) =
        if checkInternalizeAxiom(INTMOD, GOALS, getGID(TGID), comm, false) == noError
        then
            if (internalize(INTMOD | INTHPS | INTLOCAL | INTEQP, getCLA(getGoal(GOALS, '0)), comm) :: Internal)
