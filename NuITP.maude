        fi .

    ---------------------------------
    --- Internalization as Axioms ---
    ---------------------------------
    op checkInternalizeAxiom : Module GoalSet QidList AttrSet Bool -> Error . --- Proof goals, goal id, (assoc/comm/assoc comm), trust
    eq checkInternalizeAxiom(INTMOD, GOALS, GID, AXIOMS, TRUSTED) = 
        if (GOALS =/= mt)
        then
            if getGoal(GOALS, GID) :: Goal
            then
                if isAxiom(INTMOD, getCLA(getGoal(GOALS, GID)), AXIOMS)
                then noError
                else error(91) --- Unable to internalize: Initial goal does not match the axiom pattern.
                fi
            else error(98) --- Unable to internalize: Goal does not exist.
            fi
        else error(99) --- Unable to internalize: No goals found.
        fi .

    --- internalize as assoc .
    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize`as`assoc`..NuITP-Command) =
        < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize`as`assoc`.['token[''0.Qid]]) .
    --- internalize as comm .
    eq < OID : NuITP | ATS, internal: INTMOD | INTHPS | INTLOCAL | INTEQP, log: LOG, goals: GOALS > parse(STR, 'internalize`as`comm`..NuITP-Command) =
