                then
                    < OID : NuITP | ATS, internal: internalize(INTMOD | INTHPS | INTLOCAL | INTEQP, getCLA(getGoal(GOALS, '0)), assoc comm), log: (LOG [ nil : STR + "\n" ]), goals: GOALS >
                    printMsg(stdout, OID, ATS, "Proved goal has been internalized as both assoc and comm axioms.")
                else --- Unable to internalize: Original theory may become non-executable.
