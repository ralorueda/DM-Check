--- Select the module
set module CHC .

--- Check the invariant
check ind-invariant \
     (while (val x:Name > 0) { \
        (r:Name := (val r:Name + val x:Name)) ; \
        (x:Name := pred(val x:Name)) \
      } \
      | (x:Name |-> (X:iNat ++ Z:iNat)) : \
        (r:Name |-> R:iNat)) | true \
  \/ (skip \
      | (x:Name |-> 0) : \
        (r:Name |-> R:iNat)) | true .