    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2)), vaSelect: true, varAbs: {ID, (CHILDREN3, [ ID', T', CTR', ACSB', ML', N', ORIGIN' ], CHILDREN4)} > parse('select`variable`abstraction_.['token[ARG1]]) = 
        < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, CHILDREN2, applyVarAbs(M, [ ID', T', CTR', ACSB', ML', N', ORIGIN' ], PARENTS, none, LEMMAS))) > 
        showAux(OID, aux('va, ID, idmaxOf(ATS), 1), "")
