        if ID == rat(string(downTerm(ARG3, 'nil.QidList)),10)
        /\ PARSED-VAR := parseVariables(M, ARG2, getVars(T))
        /\ PARSED-SUBTERM := parseTerm(M, ARG1) .

    eq finishVariableAbstraction(
           < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2)) >,
           VABSPAIR)
        = if countChildren(getChildren(VABSPAIR)) == 1
          then
              < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, CHILDREN2, applyVarAbs(M, getChildren(VABSPAIR), PARENTS, none, LEMMAS))) >
              showAux(OID, aux('va, ID, idmaxOf(ATS), 1), "")
          else
              < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2)), vaSelect: true, varAbs: VABSPAIR >
              write(stdout, OID, "\n\033[1;36m  Possible variable abstractions:\033[0m\n  " + toStringCtxs(M, VABSPAIR) + "\n\n  Choose one with select va <n> . (any other command cancels the choice)\n\n")
          fi .

    eq finishVariableAbstraction(
           < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) >,
