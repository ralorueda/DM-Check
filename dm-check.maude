    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)), vaSelect: true, varAbs: {ID, (CHILDREN3, [ ID', PID', T', CTR', RL', SB', ACSB', ML', N', ORIGIN' ], CHILDREN4)} > parse('select`variable`abstraction_.['token[ARG1]]) = 
        < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant), lastRes: (PARENTS || (CHILDREN1, CHILDREN2, applyVarAbs(M, [ ID', PID', T', CTR', RL', SB', ACSB', ML', N', ORIGIN' ], PARENTS, none, LEMMAS))) > 
        showAux(OID, aux('va, ID, idmaxOf(ATS), 1), "")
        if ID' == rat(string(downTerm(ARG1, 'nil.QidList)),10) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)), vaSelect: true, varAbs: {ID, (CHILDREN3, [ ID', PID', T', CTR', RL', SB', ACSB', ML', N', ORIGIN' ], CHILDREN4)} > parse('select`variable`abstraction_.['token[ARG1]]) = 
        < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, CHILDREN2, applyVarAbs(M, [ ID', PID', T', CTR', RL', SB', ACSB', ML', N', ORIGIN' ], PARENTS, none, LEMMAS))) > 
        showAux(OID, aux('va, ID, idmaxOf(ATS), 1), "")
        if ID' == rat(string(downTerm(ARG1, 'nil.QidList)),10) .
    eq < OID : CID | ATS > parse('select`va_.['token[ARG1]]) = < OID : CID | ATS > parse('select`variable`abstraction_.['token[ARG1]]) .
    ceq < OID : CID | ATS > parse('select`variable`abstraction_.['token[ARG1]]) = < OID : CID | ATS > write(stdout, oid, errorMsg(41))
        if not hasVaSel(ATS) .

    --- substitution to CHILD on VARIABLE with TERM .
    eq < OID : CID | ATS, module: noModule > parse('substitution`to_on_with_.['token[ARG1],'token[ARG2],'bubble[ARG3]]) = < OID : CID | ATS, module: noModule > write(stdout, oid, errorMsg(1)) .
    eq < OID : CID | ATS, module: M, lastCmd: (CMD | 'intersect), tmpCmd: TMP > parse('substitution`to_on_with_.['token[ARG1],'token[ARG2],'bubble[ARG3]]) = < OID : CID | ATS, module: M, lastCmd: (CMD | 'intersect), tmpCmd: TMP > write(stdout, oid, errorMsg(9)) .
    eq < OID : CID | ATS, module: M, lastCmd: ("" | 'noType) > parse('substitution`to_on_with_.['token[ARG1],'token[ARG2],'bubble[ARG3]]) = < OID : CID | ATS, module: M, lastCmd: ("" | 'noType) > write(stdout, oid, errorMsg(5)) .
    ceq < OID : CID | ATS, module: M, lastCmd: (CMD | LSTCMD), lastRes: OUTPUT > parse('substitution`to_on_with_.['token[ARG1],'token[ARG2],'bubble[ARG3]]) = < OID : CID | ATS, module: M, lastCmd: (CMD | LSTCMD), lastRes: OUTPUT > write(stdout, oid, errorMsg(6))
        if (LSTCMD == 'invariant or-else LSTCMD == 'generate or-else LSTCMD == 'subsumption)
        /\ ID := rat(string(downTerm(ARG1, 'nil.QidList)),10)
        /\ notFound(OUTPUT, ID) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2)) > parse('substitution`to_on_with_.['token[ARG1],'token[ARG2],'bubble[ARG3]]) =
        if (PARSED-VAR :: Variable)
        then
            if (subTerm?(M, PARSED-VAR, T) or subTerm?(extModule(M), PARSED-VAR, CTR))
            then
                if (PARSED-SUBTERM :: Term)
                then
                    if sortLeq(M, leastSort(M, PARSED-SUBTERM), getType(PARSED-VAR))
                    then
                        if PARSED-VAR in getVars(PARSED-SUBTERM)
                        then < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(15))
                        else if getVars(PARSED-SUBTERM) in getVars((T, CTR))
                        then subsStep(OID, CID, ATS, M, LEMMAS, POS, CMD, 'subsumption, PARENTS, CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2,
                                      PARSED-VAR, PARSED-SUBTERM, ID, subsObligation(M, CTR, PARSED-VAR, PARSED-SUBTERM, LEMMAS))
                        else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(35))
                        fi fi
                    else
                        < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(30))
                    fi
                else
                    < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(13))
                fi
            else
                < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(20))
            fi
        else
            < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(10))
        fi
        if ID == rat(string(downTerm(ARG1, 'nil.QidList)),10)
        /\ PARSED-VAR := parseVariables(M, ARG2, mt) 
        /\ PARSED-SUBTERM := parseTerm(M, ARG3) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > parse('substitution`to_on_with_.['token[ARG1],'token[ARG2],'bubble[ARG3]]) = 
        if (PARSED-VAR :: Variable)
        then
            if (subTerm?(M, PARSED-VAR, T) or subTerm?(extModule(M), PARSED-VAR, CTR))
            then
                if (PARSED-SUBTERM :: Term)
                then
                    if sortLeq(M, leastSort(M, PARSED-SUBTERM), getType(PARSED-VAR))
                    then
                        if PARSED-VAR in getVars(PARSED-SUBTERM)
                        then < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(15))
                        else if getVars(PARSED-SUBTERM) in getVars((T, CTR))
                        then subsStep(OID, CID, ATS, M, LEMMAS, POS, CMD, 'invariant, PARENTS, CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2,
                                      PARSED-VAR, PARSED-SUBTERM, ID, subsObligation(M, CTR, PARSED-VAR, PARSED-SUBTERM, LEMMAS))
                        else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(35))
                        fi fi
                    else
                        < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(30))
                    fi
                else
                    < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(13))
                fi
            else
                < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(20))
            fi
        else
            < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(10))
        fi
        if ID == rat(string(downTerm(ARG1, 'nil.QidList)),10)
        /\ PARSED-VAR := parseVariables(M, ARG2, mt) 
        /\ PARSED-SUBTERM := parseTerm(M, ARG3) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > parse('substitution`to_on_with_.['token[ARG1],'token[ARG2],'bubble[ARG3]]) = 
        if (PARSED-VAR :: Variable)
        then
            if (subTerm?(M, PARSED-VAR, T) or subTerm?(extModule(M), PARSED-VAR, CTR))
            then
                if (PARSED-SUBTERM :: Term)
                then
                    if sortLeq(M, leastSort(M, PARSED-SUBTERM), getType(PARSED-VAR))
                    then
                        if PARSED-VAR in getVars(PARSED-SUBTERM)
                        then < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(15))
                        else if getVars(PARSED-SUBTERM) in getVars((T, CTR))
                        then subsStep(OID, CID, ATS, M, LEMMAS, POS, CMD, 'generate, PARENTS, CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2,
                                      PARSED-VAR, PARSED-SUBTERM, ID, subsObligation(M, CTR, PARSED-VAR, PARSED-SUBTERM, LEMMAS))
                        else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(35))
                        fi fi
                    else
                        < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(30))
                    fi
                else
                    < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(13))
                fi
            else
                < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(20))
            fi
        else
            < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(10))
        fi
        if ID == rat(string(downTerm(ARG1, 'nil.QidList)),10)
        /\ PARSED-VAR := parseVariables(M, ARG2, mt) 
        /\ PARSED-SUBTERM := parseTerm(M, ARG3) .
    --- Rename a pattern apart before checking it
    op renamePattern : TermList Nat -> TermList .
    eq renamePattern(T, N) = applySub(T, rename(getVars(T), N)) .

    --- Sort of a term (also in constraints)
    op termSort : Module Term -> [Type] .
    ceq termSort(M, T) = leastSort(M, T) if leastSort(M, T) :: Type .
    eq termSort(M, T) = leastSort(extModule(M), T) [owise] .

    --- Sort checks for variable abstraction and case
    op vaSortOk : Module Term Term -> Bool .
    eq vaSortOk(M, T, V) = (termSort(M, T) :: Sort) and-then (termSort(M, T) == getType(V)) .

    --- Error for a rejected generator set
    op genSetErr : Module Term QidList Nat -> Nat .
    eq genSetErr(GM:Module, GV:Term, GQL:QidList, GN:Nat)
        = if genFullOk(GM:Module, getType(GV:Term), GQL:QidList, nil, 0) then 39 else GN:Nat fi .
    --- Does every piece of the generator set parse with the right sort?
    op genFullOk : Module Type QidList QidList Nat -> Bool .
    eq genFullOk(GM:Module, GT:Type, nil, GACC:QidList, GD:Nat) = genPieceOk(GM:Module, GT:Type, GACC:QidList) .
    eq genFullOk(GM:Module, GT:Type, ';; GQL:QidList, GACC:QidList, 0)
        = genPieceOk(GM:Module, GT:Type, GACC:QidList) and-then genFullOk(GM:Module, GT:Type, GQL:QidList, nil, 0) .
    eq genFullOk(GM:Module, GT:Type, '`( GQL:QidList, GACC:QidList, GD:Nat)
        = genFullOk(GM:Module, GT:Type, GQL:QidList, GACC:QidList '`(, s GD:Nat) .
    eq genFullOk(GM:Module, GT:Type, '`) GQL:QidList, GACC:QidList, s GD:Nat)
        = genFullOk(GM:Module, GT:Type, GQL:QidList, GACC:QidList '`), GD:Nat) .
    eq genFullOk(GM:Module, GT:Type, GQ:Qid GQL:QidList, GACC:QidList, GD:Nat)
        = genFullOk(GM:Module, GT:Type, GQL:QidList, GACC:QidList GQ:Qid, GD:Nat) [ owise ] .
    --- Does one piece parse with the right sort?
    op genPieceOk : Module Type QidList -> Bool .
    eq genPieceOk(GM:Module, GT:Type, nil) = false .
    eq genPieceOk(GM:Module, GT:Type, GQ:Qid GQL:QidList)
        = (metaParse(GM:Module, GQ:Qid GQL:QidList, anyType) :: ResultPair)
          and-then sortLeq(GM:Module, getType(metaParse(GM:Module, GQ:Qid GQL:QidList, anyType)), GT:Type) .

    --- Do the generators have the sort of the variable or a subsort?
    op genSetSortOk : Module Term TermSet -> Bool .
    eq genSetSortOk(M, V, mt) = true .
    eq genSetSortOk(M, V, (T ;; TS))
        = (termSort(M, T) :: Sort) and-then sortLeq(M, termSort(M, T), getType(V))
          and-then genSetSortOk(M, V, TS) .

    --- Justification of a substitution (obligation if not proved)
    op subsObligation : Module Term Term Term TermSet -> TermSet .
    eq subsObligation(M, CTR, T1, T2, LEMMAS)
        = if isSat(callNuITP(M, '_->_[CTR, '_=_[T1, T2]], LEMMAS))
          then mt
          else '_->_[CTR, '_=_[T1, T2]]
          fi .

    --- Warning for a substitution added as an obligation
    op subsNotice : Module TermSet Nat -> String .
    eq subsNotice(M, mt, ID) = "" .
    eq subsNotice(M, IMPLICATION, ID)
        = "\n\033[1;33m  Warning:\033[0m NuITP could not prove that the constraint of node "
          + string(ID, 10) + " implies the substitution.\n  The substitution was applied and this implication was added to the proof\n  obligations:\n\n"
          + toStringLemmas(M, IMPLICATION) + "\n" .

    --- Verdict after an auxiliary command, by type of result
    op subsToString : Module Qid DMCOutput TermSet String -> String .
    eq subsToString(M, 'subsumption, OUTPUT, LEMMAS, POS) = toStringSub(M, OUTPUT, LEMMAS) .
    eq subsToString(M, 'invariant, OUTPUT, LEMMAS, POS) = toStringInv(M, OUTPUT, LEMMAS, POS) .
    eq subsToString(M, 'generate, OUTPUT, LEMMAS, POS) = toStringGen(M, OUTPUT, LEMMAS, POS) .

    --- Apply a substitution and report it
    op subsStep : Oid Cid AttributeSet Module TermSet String String Qid ParentNodeList ChildNodeList ChildNode ChildNodeList
                  Variable Term Nat TermSet -> Configuration .
    eq subsStep(OID, CID, ATS, M, LEMMAS, POS, CMD, TYPE, PARENTS, CHILDREN1, SCH:ChildNode, CHILDREN2, V, T, ID, SOBL:[TermSet])
        = subsStep'(OID, CID, ATS, M, (LEMMAS ;; markObl(SOBL:[TermSet])), POS, CMD, TYPE,
                    (PARENTS || (CHILDREN1,
                                 subsCommand(M, PARENTS, SCH:ChildNode, V, T,
                                             getNextIndex((CHILDREN1, SCH:ChildNode, CHILDREN2), idmaxOf(ATS)),
                                             getNextVar((CHILDREN1, SCH:ChildNode, CHILDREN2), 0), none,
                                             (LEMMAS ;; markObl(SOBL:[TermSet]))),
                                 CHILDREN2)),
                    aux('subst, ID, idmaxOf(ATS), 1), subsNotice(M, SOBL:[TermSet], ID)) .

    --- Apply a variant unification and report it
    op vunifyStep : Oid Cid AttributeSet Module TermSet String String Qid ParentNodeList ChildNodeList ChildNode ChildNodeList
                    Term Term Nat Nat Nat TermSet -> Configuration .
    eq vunifyStep(OID, CID, ATS, M, LEMMAS, POS, CMD, TYPE, PARENTS, CHILDREN1, SCH:ChildNode, CHILDREN2, T1, T2, ID,
                  VIDX:Nat, VVAR:Nat, SOBL:[TermSet])
        = subsStep'(OID, CID, ATS, M, (LEMMAS ;; markObl(SOBL:[TermSet])), POS, CMD, TYPE,
                    (PARENTS || (CHILDREN1, CHILDREN2,
                                 vunify(M, PARENTS, SCH:ChildNode, T1, T2, VIDX:Nat, VVAR:Nat, none,
                                        (LEMMAS ;; markObl(SOBL:[TermSet]))))),
                    aux('vunify, ID, idmaxOf(ATS), vunifyCount(M, T1, T2)), vunifyNotice(M, SOBL:[TermSet], ID)) .

    --- Coverage obligations of a case split
    sort CaseObl .
    --- Obligations and uncovered patterns of a case split
    op cobl : TermSet String -> CaseObl [ ctor ] .
    op coblObls : CaseObl -> TermSet .
    eq coblObls(cobl(CO:TermSet, CS:String)) = CO:TermSet .
    op coblPats : CaseObl -> String .
    eq coblPats(cobl(CO:TermSet, CS:String)) = CS:String .

    --- Obligations of the uncovered patterns
    op caseObligations : Module Term Variable TermSet TermSet -> CaseObl .
    eq caseObligations(M, CTR, V, mt, LEMMAS) = cobl(mt, "") .
    eq caseObligations(M, CTR, V, (CP:Term ;; CPS:TermSet), LEMMAS)
        = caseOblJoin(M, CP:Term,
                      if isSat(callNuITP(M, '_->_[applySub(CTR, V <- CP:Term), 'false.NuITP-Bool], LEMMAS))
                      then mt
                      else (if V in getVars(CTR)
                            then '_->_[applySub(CTR, V <- CP:Term), 'false.NuITP-Bool]
                            else '_->_[simpCtr('_/\_[CTR, '_=_[V, CP:Term]]), 'false.NuITP-Bool]
                            fi)
                      fi,
                      caseObligations(M, CTR, V, CPS:TermSet, LEMMAS)) .

    --- Rename the variables of the uncovered patterns
    op renameCov : TermSet Nat -> TermSet .
    eq renameCov(mt, N) = mt .
    eq renameCov((CP:Term ;; CPS:TermSet), N) = applySub(CP:Term, rename(getVars(CP:Term), N)) ;; renameCov(CPS:TermSet, N) .
    --- Add one uncovered pattern to the result
    op caseOblJoin : Module Term TermSet CaseObl -> CaseObl .
    eq caseOblJoin(M, CP:Term, mt, CR:CaseObl) = CR:CaseObl .
    eq caseOblJoin(M, CP:Term, CC:Term, cobl(CO:TermSet, CS:String))
        = cobl(CC:Term ;; CO:TermSet, "    " + toString(M, CP:Term) + "\n" + CS:String) .

    --- Warning for uncovered patterns of a case split
    op caseNotice : Module CaseObl Nat Variable -> String .
    eq caseNotice(M, cobl(mt, CS:String), ID, V) = "" .
    eq caseNotice(M, cobl(CO:NeTermSet, CS:String), ID, V)
        = "\n\033[1;33m  Warning:\033[0m the generator set may not cover every value of\n  " + toString(M, V)
          + " in node " + string(ID, 10) + ". Not covered:\n" + CS:String
          + "  The case split was applied and this implication was added\n  to the proof obligations for each pattern not covered:\n\n"
          + toStringLemmas(M, CO:NeTermSet) + "\n" .

    --- Apply a case split and report it
    op caseStep : Oid Cid AttributeSet Module TermSet String String Qid ParentNodeList ChildNodeList ChildNode ChildNodeList
                  Variable TermSet Nat Nat Nat CaseObl -> Configuration .
    eq caseStep(OID, CID, ATS, M, LEMMAS, POS, CMD, TYPE, PARENTS, CHILDREN1, SCH:ChildNode, CHILDREN2, V, CG:TermSet, ID,
                VIDX:Nat, VVAR:Nat, COB:[CaseObl])
        = subsStep'(OID, CID, ATS, M, (LEMMAS ;; markObl(coblObls(COB:[CaseObl]))), POS, CMD, TYPE,
                    (PARENTS || (CHILDREN1, CHILDREN2,
                                 case(M, PARENTS, SCH:ChildNode, V, CG:TermSet, VIDX:Nat, VVAR:Nat, none,
                                      (LEMMAS ;; markObl(coblObls(COB:[CaseObl])))))),
                    aux('case, ID, idmaxOf(ATS), tsSize(CG:TermSet)), caseNotice(M, COB:[CaseObl], ID, V)) .

    --- Warning for a variant unification added as an obligation
    op vunifyNotice : Module TermSet Nat -> String .
    eq vunifyNotice(M, mt, ID) = "" .
    eq vunifyNotice(M, IMPLICATION, ID)
        = "\n\033[1;33m  Warning:\033[0m NuITP could not prove that the constraint of node "
          + string(ID, 10) + " implies the equation.\n  The variant unification was applied and this implication was added to the\n  proof obligations:\n\n"
          + toStringLemmas(M, IMPLICATION) + "\n" .

    op subsStep' : Oid Cid AttributeSet Module TermSet String String Qid DMCOutput AuxSpec String -> Configuration .
    eq subsStep'(OID, CID, ATS, M, SLEM:[TermSet], POS, CMD, TYPE, OUTPUT', SPEC:AuxSpec, SNOTE:[String])
        = < OID : CID | ATS, module: M, lemmasui: SLEM:[TermSet], pos: POS, lastCmd: (CMD | TYPE), lastRes: OUTPUT' >
          showAux(OID, SPEC:AuxSpec, SNOTE:[String]) .

    --- Report of an auxiliary command
    sort AuxSpec .
    --- Summary of an auxiliary command (kind, source ids, last id, generated)
    op aux : Qid NatList Nat Nat -> AuxSpec [ ctor ] .
    op showAux : Oid AuxSpec String -> Msg [ ctor ] .
    ceq < OID : CID | module: M, lemmasui: SLEM:[TermSet], pos: POS, lastCmd: (CMD | TYPE), lastRes: SOUT:[DMCOutput], ATS >
       showAux(OID, SPEC:AuxSpec, SNOTE:[String])
        = < OID : CID | module: M, lemmasui: SLEM:[TermSet], pos: POS, lastCmd: (CMD | TYPE), lastRes: SOUT:[DMCOutput], ATS >
          write(stdout, OID, SSUM:String + SNOTE:[String]
                             + "\n  " + subsToString(M, TYPE, SOUT:[DMCOutput], SLEM:[TermSet], POS) + "\n\n")
        if SSUM:String := auxSummary(TYPE, SPEC:AuxSpec, SOUT:[DMCOutput]) .
    eq < OID : CID | module: M, lemmasui: SLEM:[TermSet], pos: POS, lastCmd: (CMD | TYPE), lastRes: SOUT:[DMCOutput], ATS >
       showAux(OID, SPEC:AuxSpec, SNOTE:[String])
        = < OID : CID | module: M, lemmasui: SLEM:[TermSet], pos: POS, lastCmd: (CMD | TYPE), lastRes: SOUT:[DMCOutput], ATS >
          write(stdout, OID, SNOTE:[String] + "\n  " + subsToString(M, TYPE, SOUT:[DMCOutput], SLEM:[TermSet], POS) + "\n\n") [owise] .

    --- Summary line of an auxiliary command
    op auxSummary : Qid AuxSpec DMCOutput -> String .
    eq auxSummary(TYPE, aux(AK:Qid, ASRC:NatList, ALIM:Nat, AGEN:Nat), PARENTS || CHILDREN)
        = "\n\033[1;32m  " + auxPhrase(AK:Qid) + " " + nodeWord(TYPE, nlLen(ASRC:NatList)) + " "
          + nlText(ASRC:NatList) + ": "
          + auxResult(TYPE, newChildIds(CHILDREN, ALIM:Nat), AGEN:Nat) + ".\033[0m\n" .

    --- Name of an auxiliary command in its summary
    op auxPhrase : Qid -> String .
    eq auxPhrase('case) = "Case split on" .
    eq auxPhrase('subst) = "Substitution in" .
    eq auxPhrase('gen) = "Generalization of" .
    eq auxPhrase('vunify) = "Variant unification in" .
    eq auxPhrase('va) = "Variable abstraction in" .
    eq auxPhrase('narrow) = "Narrowing of a subterm in" .
    eq auxPhrase('split) = "Boolean split of" .

    --- Child or term, as in each output
    op nodeWord : Qid Nat -> String .
    eq nodeWord(TYPE, AN:Nat) = if TYPE == 'subsumption then (if AN:Nat == 1 then "term" else "terms" fi)
                                else (if AN:Nat == 1 then "child" else "children" fi) fi .

    --- Nodes obtained by an auxiliary command, as a phrase
    op auxResult : Qid NatList Nat -> String .
    eq auxResult(TYPE, nil, AGEN:Nat) = "every resulting case is closed" .
    eq auxResult(TYPE, ANL:NeNatList, AGEN:Nat)
        = "new " + nodeWord(TYPE, nlLen(ANL:NeNatList)) + " " + nlText(ANL:NeNatList)
          + (if AGEN:Nat > nlLen(ANL:NeNatList)
             then " (" + string(sd(AGEN:Nat, nlLen(ANL:NeNatList)), 10)
                  + (if sd(AGEN:Nat, nlLen(ANL:NeNatList)) == 1 then " case" else " cases" fi) + " closed)"
             else "" fi) .

    --- Ids of the children above the session counter before the command
    op newChildIds : ChildNodeList Nat -> NatList .
    eq newChildIds(noChildren, ALIM:Nat) = nil .
    eq newChildIds(([ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN), ALIM:Nat)
        = (if ID > ALIM:Nat then ID else nil fi) newChildIds(CHILDREN, ALIM:Nat) .
    eq newChildIds(([ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN), ALIM:Nat)
        = (if ID > ALIM:Nat then ID else nil fi) newChildIds(CHILDREN, ALIM:Nat) .

    --- Length of a list of naturals
    op nlLen : NatList -> Nat .
    eq nlLen(nil) = 0 .
    eq nlLen(AN:Nat ANL:NatList) = s(nlLen(ANL:NatList)) .

    --- 7, "7 and 8", "7, 8 and 9"
    op nlText : NatList -> String .
    eq nlText(nil) = "" .
    eq nlText(AN:Nat) = string(AN:Nat, 10) .
    eq nlText(AN:Nat AM:Nat) = string(AN:Nat, 10) + " and " + string(AM:Nat, 10) .
    eq nlText(AN:Nat AM:Nat ANL:NeNatList) = string(AN:Nat, 10) + ", " + nlText(AM:Nat ANL:NeNatList) .

    --- Number of terms in a set
    op tsSize : TermSet -> Nat .
    eq tsSize(mt) = 0 .
    eq tsSize((AT:Term ;; ATS':TermSet)) = s(tsSize(ATS':TermSet)) .

    --- Line printed by empty, lemma and contained
    op closeMsg : Qid Nat String -> String .
    eq closeMsg(TYPE, ID, CS:String)
        = "\n\033[1;32m  " + (if TYPE == 'subsumption or-else TYPE == 'intersect then "Term " else "Child " fi) + string(ID, 10)
          + " " + CS:String + ".\033[0m\n" .

    eq < OID : CID | ATS > parse('sb`to_on_with_.['token[ARG1],'token[ARG2],'bubble[ARG3]]) = < OID : CID | ATS > parse('substitution`to_on_with_.['token[ARG1],'token[ARG2],'bubble[ARG3]]) .

    --- variant unify to CHILD with TERM1 =? TERM2 .
    eq < OID : CID | ATS, module: noModule > parse('variant`unify_=?_in_.['bubble[ARG1],'bubble[ARG2],'token[ARG3]]) = < OID : CID | ATS, module: noModule > write(stdout, oid, errorMsg(1)) .
    eq < OID : CID | ATS, module: M, lastCmd: (CMD | 'intersect), tmpCmd: TMP > parse('variant`unify_=?_in_.['bubble[ARG1],'bubble[ARG2],'token[ARG3]]) = < OID : CID | ATS, module: M, lastCmd: (CMD | 'intersect), tmpCmd: TMP > write(stdout, oid, errorMsg(9)) .
    eq < OID : CID | ATS, module: M, lastCmd: ("" | 'noType) > parse('variant`unify_=?_in_.['bubble[ARG1],'bubble[ARG2],'token[ARG3]]) = < OID : CID | ATS, module: M, lastCmd: ("" | 'noType) > write(stdout, oid, errorMsg(5)) .
    ceq < OID : CID | ATS, module: M, lastCmd: (CMD | LSTCMD), lastRes: OUTPUT > parse('variant`unify_=?_in_.['bubble[ARG1],'bubble[ARG2],'token[ARG3]]) = < OID : CID | ATS, module: M, lastCmd: (CMD | LSTCMD), lastRes: OUTPUT > write(stdout, oid, errorMsg(6))
        if (LSTCMD == 'invariant or-else LSTCMD == 'generate or-else LSTCMD == 'subsumption)
        /\ ID := rat(string(downTerm(ARG3, 'nil.QidList)),10)
        /\ notFound(OUTPUT, ID) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2)) > parse('variant`unify_=?_in_.['bubble[ARG1],'bubble[ARG2],'token[ARG3]]) = 
        if (PARSED-TERM1 :: Term)
        then
            if (PARSED-TERM2 :: Term)
            then
                if (subTerm?(M, PARSED-TERM1, T) or subTerm?(extModule(M), PARSED-TERM1, CTR) or
                    subTerm?(M, PARSED-TERM2, T) or subTerm?(extModule(M), PARSED-TERM2, CTR))
                then
                    if not (getVars((PARSED-TERM1, PARSED-TERM2)) in getVars((T, CTR)))
                    then < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(38))
                    else if hasVariantUnifierAbs(M, PARSED-TERM1, PARSED-TERM2)
                    then vunifyStep(OID, CID, ATS, M, LEMMAS, POS, CMD, 'subsumption, PARENTS, CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2,
                                    PARSED-TERM1, PARSED-TERM2, ID,
                                    getNextIndex((CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2), idmaxOf(ATS)),
                                    getNextVar((CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2), 0),
                                    subsObligation(M, CTR, PARSED-TERM1, PARSED-TERM2, LEMMAS))
                    else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, noUnifierMsg(M, PARSED-TERM1, PARSED-TERM2, ID))
                    fi fi
                else
                    < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(19))
                fi
            else
                    < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(17))
            fi
        else
            < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption), lastRes: (PARENTS || (CHILDREN1, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(16))
        fi
        if ID == rat(string(downTerm(ARG3, 'nil.QidList)),10)
        /\ PARSED-TERM1 := parseTerm(M, ARG1)
        /\ PARSED-TERM2 := parseTerm(M, ARG2) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > parse('variant`unify_=?_in_.['bubble[ARG1],'bubble[ARG2],'token[ARG3]]) = 
        if (PARSED-TERM1 :: Term)
        then
            if (PARSED-TERM2 :: Term)
            then
                if (subTerm?(M, PARSED-TERM1, T) or subTerm?(extModule(M), PARSED-TERM1, CTR) or
                    subTerm?(M, PARSED-TERM2, T) or subTerm?(extModule(M), PARSED-TERM2, CTR))
                then
                    if not (getVars((PARSED-TERM1, PARSED-TERM2)) in getVars((T, CTR)))
                    then < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(38))
                    else if hasVariantUnifierAbs(M, PARSED-TERM1, PARSED-TERM2)
                    then vunifyStep(OID, CID, ATS, M, LEMMAS, POS, CMD, 'invariant, PARENTS, CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2,
                                    PARSED-TERM1, PARSED-TERM2, ID,
                                    getNextIndex((CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2), idmaxOf(ATS)),
                                    getNextVar((CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2), 0),
                                    subsObligation(M, CTR, PARSED-TERM1, PARSED-TERM2, LEMMAS))
                    else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, noUnifierMsg(M, PARSED-TERM1, PARSED-TERM2, ID))
                    fi fi
                else
                    < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(19))
                fi
            else
                < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(17))
            fi
        else
            < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(16))
        fi
        if ID == rat(string(downTerm(ARG3, 'nil.QidList)),10)
        /\ PARSED-TERM1 := parseTerm(M, ARG1)
        /\ PARSED-TERM2 := parseTerm(M, ARG2) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > parse('variant`unify_=?_in_.['bubble[ARG1],'bubble[ARG2],'token[ARG3]]) = 
        if (PARSED-TERM1 :: Term)
        then
            if (PARSED-TERM2 :: Term)
            then
                if (subTerm?(M, PARSED-TERM1, T) or subTerm?(extModule(M), PARSED-TERM1, CTR) or
                    subTerm?(M, PARSED-TERM2, T) or subTerm?(extModule(M), PARSED-TERM2, CTR))
                then
                    if not (getVars((PARSED-TERM1, PARSED-TERM2)) in getVars((T, CTR)))
                    then < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(38))
                    else if hasVariantUnifierAbs(M, PARSED-TERM1, PARSED-TERM2)
                    then vunifyStep(OID, CID, ATS, M, LEMMAS, POS, CMD, 'generate, PARENTS, CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2,
                                    PARSED-TERM1, PARSED-TERM2, ID,
                                    getNextIndex((CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2), idmaxOf(ATS)),
                                    getNextVar((CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2), 0),
                                    subsObligation(M, CTR, PARSED-TERM1, PARSED-TERM2, LEMMAS))
                    else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, noUnifierMsg(M, PARSED-TERM1, PARSED-TERM2, ID))
                    fi fi
                else
                    < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(19))
                fi
            else
                < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(17))
            fi
        else
            < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) > write(stdout, oid, errorMsg(16))
        fi
        if ID == rat(string(downTerm(ARG3, 'nil.QidList)),10)
        /\ PARSED-TERM1 := parseTerm(M, ARG1)
        /\ PARSED-TERM2 := parseTerm(M, ARG2) .
    eq < OID : CID | ATS > parse('vunify_=?_in_.['bubble[ARG1],'bubble[ARG2],'token[ARG3]]) = < OID : CID | ATS > parse('variant`unify_=?_in_.['bubble[ARG1],'bubble[ARG2],'token[ARG3]]) .
    eq < OID : CID | ATS > parse('vunify`to_with_=?_.['token[ARG3],'bubble[ARG1],'bubble[ARG2]]) = < OID : CID | ATS > parse('variant`unify_=?_in_.['bubble[ARG1],'bubble[ARG2],'token[ARG3]]) . --- Temp
    eq < OID : CID | ATS > parse('variant`unify`to_with_=?_.['token[ARG3],'bubble[ARG1],'bubble[ARG2]]) = < OID : CID | ATS > parse('variant`unify_=?_in_.['bubble[ARG1],'bubble[ARG2],'token[ARG3]]) . --- Temp
    
    --- narrowing to CHILD on SUBTERM .
    eq < OID : CID | ATS, module: noModule > parse('narrowing_on_.['token[ARG1],'bubble[ARG2]]) = < OID : CID | ATS, module: noModule > write(stdout, oid, errorMsg(1)) .
