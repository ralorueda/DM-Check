                                CHILDREN''')} > parse('select`variable`abstraction_.['token[ARG]])
        = < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant),
                        lastRes: (PARENTS ||
                                  (CHILDREN, CHILDREN',
                                   applyVarAbs(M, [ ID', PID', T', CTR', RL', SB', ACSB', ML', N', ORIGIN' ], PARENTS,
                                               none, LEMMAS))) > showAux(OID, aux('va, ID, idmaxOf(ATS), 1), "")
        if ID' == rat(string(downTerm(ARG, 'nil.QidList)),10) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate),
                      lastRes: (PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                      vaSelect: true,
                      varAbs: {ID,
                               (CHILDREN'', [ ID', PID', T', CTR', RL', SB', ACSB', ML', N', ORIGIN' ],
                                CHILDREN''')} > parse('select`variable`abstraction_.['token[ARG]])
        = < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate),
                        lastRes: (PARENTS ||
                                  (CHILDREN, CHILDREN',
                                   applyVarAbs(M, [ ID', PID', T', CTR', RL', SB', ACSB', ML', N', ORIGIN' ], PARENTS,
                                               none, LEMMAS))) > showAux(OID, aux('va, ID, idmaxOf(ATS), 1), "")
        if ID' == rat(string(downTerm(ARG, 'nil.QidList)),10) .
    eq < OID : CID | ATS > parse('select`va_.['token[ARG]])
        = < OID : CID | ATS > parse('select`variable`abstraction_.['token[ARG]]) .
    ceq < OID : CID | ATS > parse('select`variable`abstraction_.['token[ARG]])
        = < OID : CID | ATS > write(stdout, oid, errorMsg(41))
        if not hasVaSel(ATS) .

    --- substitution to CHILD on VARIABLE with TERM .
    eq < OID : CID | ATS, module: noModule >
        parse('substitution`to_on_with_.['token[ARG],'token[ARG'],'bubble[ARG'']])
        = < OID : CID | ATS, module: noModule > write(stdout, oid, errorMsg(1)) .
    eq < OID : CID | ATS, module: M, lastCmd: (CMD | 'intersect), tmpCmd: TMP >
        parse('substitution`to_on_with_.['token[ARG],'token[ARG'],'bubble[ARG'']])
        = < OID : CID | ATS, module: M, lastCmd: (CMD | 'intersect), tmpCmd: TMP > write(stdout, oid, errorMsg(9)) .
    eq < OID : CID | ATS, module: M, lastCmd: ("" | 'noType) >
        parse('substitution`to_on_with_.['token[ARG],'token[ARG'],'bubble[ARG'']])
        = < OID : CID | ATS, module: M, lastCmd: ("" | 'noType) > write(stdout, oid, errorMsg(5)) .
    ceq < OID : CID | ATS, module: M, lastCmd: (CMD | LSTCMD), lastRes: OUTPUT >
        parse('substitution`to_on_with_.['token[ARG],'token[ARG'],'bubble[ARG'']])
        = < OID : CID | ATS, module: M, lastCmd: (CMD | LSTCMD), lastRes: OUTPUT > write(stdout, oid, errorMsg(6))
        if (LSTCMD == 'invariant or-else LSTCMD == 'generate or-else LSTCMD == 'subsumption) /\
           ID := rat(string(downTerm(ARG, 'nil.QidList)),10) /\
           notFound(OUTPUT, ID) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption),
                      lastRes: (PARENTS || (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')) >
        parse('substitution`to_on_with_.['token[ARG],'token[ARG'],'bubble[ARG'']])
        = if (PARSED-VAR :: Variable)
          then if (subTerm?(M, PARSED-VAR, T) or subTerm?(extModule(M), PARSED-VAR, CTR))
               then if (PARSED-SUBTERM :: Term)
                    then if sortLeq(M, leastSort(M, PARSED-SUBTERM), getType(PARSED-VAR))
                         then if PARSED-VAR in getVars(PARSED-SUBTERM)
                              then < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS,
                                                 lastCmd: (CMD | 'subsumption),
                                                 lastRes: (PARENTS ||
                                                           (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ],
                                                            CHILDREN')) > write(stdout, oid, errorMsg(15))
                              else if getVars(PARSED-SUBTERM) in getVars((T, CTR))
                                   then subsStep(OID, CID, ATS, M, LEMMAS, POS, CMD, 'subsumption, PARENTS, CHILDREN,
                                                 [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN', PARSED-VAR,
                                                 PARSED-SUBTERM, ID,
                                                 subsObligation(M, CTR, PARSED-VAR, PARSED-SUBTERM, LEMMAS))
                                   else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS,
                                                      lastCmd: (CMD | 'subsumption),
                                                      lastRes: (PARENTS ||
                                                                (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ],
                                                                 CHILDREN')) > write(stdout, oid, errorMsg(35))
                                   fi
                              fi
                         else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption),
                                            lastRes: (PARENTS ||
                                                      (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')) >
                              write(stdout, oid, errorMsg(30))
                         fi
                    else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption),
                                       lastRes: (PARENTS ||
                                                 (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')) >
                         write(stdout, oid, errorMsg(13))
                    fi
               else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption),
                                  lastRes: (PARENTS || (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')) >
                    write(stdout, oid, errorMsg(20))
               fi
          else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption),
                             lastRes: (PARENTS || (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')) >
               write(stdout, oid, errorMsg(10))
          fi
        if ID == rat(string(downTerm(ARG, 'nil.QidList)),10) /\
           PARSED-VAR := parseVariables(M, ARG', mt) /\
           PARSED-SUBTERM := parseTerm(M, ARG'') .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant),
                      lastRes: (PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')) >
        parse('substitution`to_on_with_.['token[ARG],'token[ARG'],'bubble[ARG'']])
        = if (PARSED-VAR :: Variable)
          then if (subTerm?(M, PARSED-VAR, T) or subTerm?(extModule(M), PARSED-VAR, CTR))
               then if (PARSED-SUBTERM :: Term)
                    then if sortLeq(M, leastSort(M, PARSED-SUBTERM), getType(PARSED-VAR))
                         then if PARSED-VAR in getVars(PARSED-SUBTERM)
                              then < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS,
                                                 lastCmd: (CMD | 'invariant),
                                                 lastRes: (PARENTS ||
                                                           (CHILDREN,
                                                            [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                            CHILDREN')) > write(stdout, oid, errorMsg(15))
                              else if getVars(PARSED-SUBTERM) in getVars((T, CTR))
                                   then subsStep(OID, CID, ATS, M, LEMMAS, POS, CMD, 'invariant, PARENTS, CHILDREN,
                                                 [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN',
                                                 PARSED-VAR, PARSED-SUBTERM, ID,
                                                 subsObligation(M, CTR, PARSED-VAR, PARSED-SUBTERM, LEMMAS))
                                   else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS,
                                                      lastCmd: (CMD | 'invariant),
                                                      lastRes: (PARENTS ||
                                                                (CHILDREN,
                                                                 [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                                 CHILDREN')) > write(stdout, oid, errorMsg(35))
                                   fi
                              fi
                         else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant),
                                            lastRes: (PARENTS ||
                                                      (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                       CHILDREN')) > write(stdout, oid, errorMsg(30))
                         fi
                    else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant),
                                       lastRes: (PARENTS ||
                                                 (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                  CHILDREN')) > write(stdout, oid, errorMsg(13))
                    fi
               else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant),
                                  lastRes: (PARENTS ||
                                            (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')) >
                    write(stdout, oid, errorMsg(20))
               fi
          else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant),
                             lastRes: (PARENTS ||
                                       (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')) >
               write(stdout, oid, errorMsg(10))
          fi
        if ID == rat(string(downTerm(ARG, 'nil.QidList)),10) /\
           PARSED-VAR := parseVariables(M, ARG', mt) /\
           PARSED-SUBTERM := parseTerm(M, ARG'') .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate),
                      lastRes: (PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')) >
        parse('substitution`to_on_with_.['token[ARG],'token[ARG'],'bubble[ARG'']])
        = if (PARSED-VAR :: Variable)
          then if (subTerm?(M, PARSED-VAR, T) or subTerm?(extModule(M), PARSED-VAR, CTR))
               then if (PARSED-SUBTERM :: Term)
                    then if sortLeq(M, leastSort(M, PARSED-SUBTERM), getType(PARSED-VAR))
                         then if PARSED-VAR in getVars(PARSED-SUBTERM)
                              then < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS,
                                                 lastCmd: (CMD | 'generate),
                                                 lastRes: (PARENTS ||
                                                           (CHILDREN,
                                                            [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                            CHILDREN')) > write(stdout, oid, errorMsg(15))
                              else if getVars(PARSED-SUBTERM) in getVars((T, CTR))
                                   then subsStep(OID, CID, ATS, M, LEMMAS, POS, CMD, 'generate, PARENTS, CHILDREN,
                                                 [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN',
                                                 PARSED-VAR, PARSED-SUBTERM, ID,
                                                 subsObligation(M, CTR, PARSED-VAR, PARSED-SUBTERM, LEMMAS))
                                   else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS,
                                                      lastCmd: (CMD | 'generate),
                                                      lastRes: (PARENTS ||
                                                                (CHILDREN,
                                                                 [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                                 CHILDREN')) > write(stdout, oid, errorMsg(35))
                                   fi
                              fi
                         else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate),
                                            lastRes: (PARENTS ||
                                                      (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                       CHILDREN')) > write(stdout, oid, errorMsg(30))
                         fi
                    else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate),
                                       lastRes: (PARENTS ||
                                                 (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                  CHILDREN')) > write(stdout, oid, errorMsg(13))
                    fi
               else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate),
                                  lastRes: (PARENTS ||
                                            (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')) >
                    write(stdout, oid, errorMsg(20))
               fi
          else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate),
                             lastRes: (PARENTS ||
                                       (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')) >
               write(stdout, oid, errorMsg(10))
          fi
        if ID == rat(string(downTerm(ARG, 'nil.QidList)),10) /\
           PARSED-VAR := parseVariables(M, ARG', mt) /\
           PARSED-SUBTERM := parseTerm(M, ARG'') .

    --- Rename a pattern apart before checking it
    op renamePattern : TermList Nat -> TermList .
    eq renamePattern(T, N) = applySub(T, rename(getVars(T), N)) .

    --- Sort of a term (also in constraints)
    op termSort : Module Term -> [Type] .
    ceq termSort(M, T) = leastSort(M, T)
        if leastSort(M, T) :: Type .
    eq termSort(M, T) = leastSort(extModule(M), T) [owise] .

    --- Sort checks for variable abstraction and case
    op vaSortOk : Module Term Term -> Bool .
    eq vaSortOk(M, T, V) = (termSort(M, T) :: Sort) and-then (termSort(M, T) == getType(V)) .

    --- Error for a rejected generator set
    op genSetErr : Module Term QidList Nat -> Nat .
    eq genSetErr(M, T, QL, N)
        = if genFullOk(M, getType(T), QL, nil, 0)
          then 39
          else N
          fi .

    --- Check if every piece of the generator set parses with the right sort
    op genFullOk : Module Type QidList QidList Nat -> Bool .
    eq genFullOk(M, TY, nil, QL, N) = genPieceOk(M, TY, QL) .
    eq genFullOk(M, TY, ';; QL, QL', 0)
        = genPieceOk(M, TY, QL') and-then genFullOk(M, TY, QL, nil, 0) .
    eq genFullOk(M, TY, '`( QL, QL', N) = genFullOk(M, TY, QL, QL' '`(, s N) .
    eq genFullOk(M, TY, '`) QL, QL', s N) = genFullOk(M, TY, QL, QL' '`), N) .
    eq genFullOk(M, TY, Q QL, QL', N) = genFullOk(M, TY, QL, QL' Q, N) [ owise ] .

    --- Check if a piece parses with the right sort
    op genPieceOk : Module Type QidList -> Bool .
    eq genPieceOk(M, TY, nil) = false .
    eq genPieceOk(M, TY, Q QL)
        = (metaParse(M, Q QL, anyType) :: ResultPair)
          and-then sortLeq(M, getType(metaParse(M, Q QL, anyType)), TY) .

    --- Check if the generators have the sort of the variable or a subsort
    op genSetSortOk : Module Term TermSet -> Bool .
    eq genSetSortOk(M, V, mt) = true .
    eq genSetSortOk(M, V, (T ;; TS))
        = (termSort(M, T) :: Sort) and-then sortLeq(M, termSort(M, T), getType(V))
          and-then genSetSortOk(M, V, TS) .

    --- Justification of a substitution (obligation if not proved)
    op subsObligation : Module Term Term Term TermSet -> TermSet .
    eq subsObligation(M, CTR, T, T', LEMMAS)
        = if isSat(callNuITP(M, '_->_[CTR, '_=_[T, T']], LEMMAS))
          then mt
          else '_->_[CTR, '_=_[T, T']]
          fi .

    --- Warning for a substitution added as an obligation
    op subsNotice : Module TermSet Nat -> String .
    eq subsNotice(M, mt, ID) = "" .
    eq subsNotice(M, IMPLICATION, ID)
        = errorMsg(58, string(ID, 10))
          + toStringLemmas(M, IMPLICATION) + "\n" .

    --- Verdict after an auxiliary command, by type of result
    op subsToString : Module Qid DMCOutput TermSet String -> String .
    eq subsToString(M, 'subsumption, OUTPUT, LEMMAS, POS) = toStringSub(M, OUTPUT, LEMMAS) .
    eq subsToString(M, 'invariant, OUTPUT, LEMMAS, POS) = toStringInv(M, OUTPUT, LEMMAS, POS) .
    eq subsToString(M, 'generate, OUTPUT, LEMMAS, POS) = toStringGen(M, OUTPUT, LEMMAS, POS) .

    --- Apply a substitution and report it
    op subsStep : Oid Cid AttributeSet Module TermSet String String Qid ParentNodeList ChildNodeList ChildNode
                  ChildNodeList Variable Term Nat TermSet -> Configuration .
    eq subsStep(OID, CID, ATS, M, LEMMAS, POS, CMD, TYPE, PARENTS, CHILDREN, CHILD, CHILDREN', V, T, ID, OBLS?)
        = subsStep'(OID, CID, ATS, M, (LEMMAS ;; markObl(OBLS?)), POS, CMD, TYPE,
                    (PARENTS || (CHILDREN,
                                 subsCommand(M, PARENTS, CHILD, V, T,
                                             getNextIndex((CHILDREN, CHILD, CHILDREN'), idmaxOf(ATS)),
                                             getNextVar((CHILDREN, CHILD, CHILDREN'), 0), none,
                                             (LEMMAS ;; markObl(OBLS?))),
                                 CHILDREN')),
                    aux('subst, ID, idmaxOf(ATS), 1), subsNotice(M, OBLS?, ID)) .

    --- Apply a variant unification and report it
    op vunifyStep : Oid Cid AttributeSet Module TermSet String String Qid ParentNodeList ChildNodeList ChildNode
                    ChildNodeList Term Term Nat Nat Nat TermSet -> Configuration .
    eq vunifyStep(OID, CID, ATS, M, LEMMAS, POS, CMD, TYPE, PARENTS, CHILDREN, CHILD, CHILDREN', T, T', ID,
                  N, N', OBLS?)
        = subsStep'(OID, CID, ATS, M, (LEMMAS ;; markObl(OBLS?)), POS, CMD, TYPE,
                    (PARENTS || (CHILDREN, CHILDREN',
                                 vunify(M, PARENTS, CHILD, T, T', N, N', none,
                                        (LEMMAS ;; markObl(OBLS?))))),
                    aux('vunify, ID, idmaxOf(ATS), vunifyCount(M, T, T')), vunifyNotice(M, OBLS?, ID)) .

    --- Coverage obligations of a case split
    sort CaseObl .

    --- Obligations and uncovered patterns of a case split
    op cobl : TermSet String -> CaseObl [ ctor ] .
    op coblObls : CaseObl -> TermSet .
    eq coblObls(cobl(TS, STR)) = TS .

    --- Obligations of the uncovered patterns
    op caseObligations : Module Term Variable TermSet TermSet -> CaseObl .
    eq caseObligations(M, CTR, V, mt, LEMMAS) = cobl(mt, "") .
    eq caseObligations(M, CTR, V, (PAT ;; TS), LEMMAS)
        = caseOblJoin(M, PAT,
                      if isSat(callNuITP(M, '_->_[applySub(CTR, V <- PAT), 'false.NuITP-Bool], LEMMAS))
                      then mt
                      else (if V in getVars(CTR)
                            then '_->_[applySub(CTR, V <- PAT), 'false.NuITP-Bool]
                            else '_->_[simpCtr('_/\_[CTR, '_=_[V, PAT]]), 'false.NuITP-Bool]
                            fi)
                      fi,
                      caseObligations(M, CTR, V, TS, LEMMAS)) .

    --- Rename the variables of the uncovered patterns
    op renameCov : TermSet Nat -> TermSet .
    eq renameCov(mt, N) = mt .
    eq renameCov((PAT ;; TS), N) = applySub(PAT, rename(getVars(PAT), N)) ;; renameCov(TS, N) .

    --- Add one uncovered pattern to the result
    op caseOblJoin : Module Term TermSet CaseObl -> CaseObl .
    eq caseOblJoin(M, PAT, mt, COBL) = COBL .
    eq caseOblJoin(M, PAT, T, cobl(TS, STR))
        = cobl(T ;; TS, "    " + toString(M, PAT) + "\n" + STR) .

    --- Warning for uncovered patterns of a case split
    op caseNotice : Module CaseObl Nat Variable -> String .
    eq caseNotice(M, cobl(mt, STR), ID, V) = "" .
    eq caseNotice(M, cobl(NTS, STR), ID, V)
        = errorMsg(59, toString(M, V), string(ID, 10), STR)
          + toStringLemmas(M, NTS) + "\n" + idCovNote(M, NTS) .

    --- Note when the coverage check is incomplete (assoc constructor with identity)
    op idCovNote : Module TermSet -> String .
    eq idCovNote(M, TS) = idCovNote'(M, idAssocOpsS(M, TS, none)) .
    op idCovNote' : Module QidSet -> String .
    eq idCovNote'(M, none) = "" .
    eq idCovNote'(M, NQS)
        = "\n  The coverage check is incomplete for associative constructors whose\n" +
          "  identity has their own sort: " + idOpsText(M, NQS) + ".\n" +
          "  These patterns may be covered by the generator set after all, and then\n" +
          "  the implication is false and cannot be proved. To avoid it, give the case\n" +
          "  variable a sort without the identity, such as a sort of non-empty\n" +
          "  multisets or lists (QLOCK uses NeMSet).\n" .

    --- Operators of the terms that are such constructors
    op idAssocOpsS : Module TermSet QidSet -> QidSet .
    eq idAssocOpsS(M, mt, QS) = QS .
    eq idAssocOpsS(M, (T ;; TS), QS) = idAssocOpsS(M, TS, idAssocOps(M, T, QS)) .
    op idAssocOps : Module TermList QidSet -> QidSet .
    eq idAssocOps(M, empty, QS) = QS .
    eq idAssocOps(M, (T, NTL), QS) = idAssocOps(M, NTL, idAssocOps(M, T, QS)) .
    eq idAssocOps(M, F[NTL], QS)
        = idAssocOps(M, NTL, if idAssocOp(M, getOps(M), F) then (F ; QS) else QS fi) .
    eq idAssocOps(M, T, QS) = QS [ owise ] .

    --- Check if an operator is an assoc constructor with an identity of a smaller sort
    op idAssocOp : Module OpDeclSet Qid -> Bool .
    ceq idAssocOp(M, (op F : TYL -> S [ ctor assoc id(T) ATTRS ] .) OPDS, F)
        = true
        if sortLeq(M, leastSort(M, T), S) .
    eq idAssocOp(M, OPDS, F) = false [ owise ] .

    --- Operators and their identities as a string
    op idOpsText : Module QidSet -> String .
    eq idOpsText(M, F) = string(F) + " (identity " + idText(M, idTerm(getOps(M), F)) + ")" .
    op idText : Module Term -> String .
    eq idText(M, C) = string(getName(C)) .
    eq idText(M, T) = toString(M, T) [ owise ] .
    eq idOpsText(M, (F ; NQS)) = idOpsText(M, F) + ", " + idOpsText(M, NQS) .

    --- Identity of a ctor declaration of the operator
    op idTerm : OpDeclSet Qid -> Term .
    eq idTerm((op F : TYL -> S [ ctor assoc id(T) ATTRS ] .) OPDS, F) = T .

    --- Apply a case split and report it
    op caseStep : Oid Cid AttributeSet Module TermSet String String Qid ParentNodeList ChildNodeList ChildNode
                  ChildNodeList Variable TermSet Nat Nat Nat CaseObl -> Configuration .
    eq caseStep(OID, CID, ATS, M, LEMMAS, POS, CMD, TYPE, PARENTS, CHILDREN, CHILD, CHILDREN', V, TS, ID,
                N, N', COBL?)
        = subsStep'(OID, CID, ATS, M, (LEMMAS ;; markObl(coblObls(COBL?))), POS, CMD, TYPE,
                    (PARENTS || (CHILDREN, CHILDREN',
                                 case(M, PARENTS, CHILD, V, TS, N, N', none,
                                      (LEMMAS ;; markObl(coblObls(COBL?)))))),
                    aux('case, ID, idmaxOf(ATS), tsSize(TS)), caseNotice(M, COBL?, ID, V)) .

    --- Warning for a variant unification added as an obligation
    op vunifyNotice : Module TermSet Nat -> String .
    eq vunifyNotice(M, mt, ID) = "" .
    eq vunifyNotice(M, IMPLICATION, ID)
        = errorMsg(60, string(ID, 10))
          + toStringLemmas(M, IMPLICATION) + "\n" .

    op subsStep' : Oid Cid AttributeSet Module TermSet String String Qid DMCOutput AuxSpec String -> Configuration .
    eq subsStep'(OID, CID, ATS, M, LEMMAS?, POS, CMD, TYPE, OUTPUT?, SPEC, NOTE?)
        = < OID : CID | ATS, module: M, lemmasui: LEMMAS?, pos: POS, lastCmd: (CMD | TYPE), lastRes: OUTPUT? >
          showAux(OID, SPEC, NOTE?) .

    --- Report of an auxiliary command
    sort AuxSpec .

    --- Summary of an auxiliary command (kind, source ids, last id, generated)
    op aux : Qid NatList Nat Nat -> AuxSpec [ ctor ] .
    op showAux : Oid AuxSpec String -> Msg [ ctor ] .
    ceq < OID : CID | module: M, lemmasui: LEMMAS?, pos: POS, lastCmd: (CMD | TYPE), lastRes: OUTPUT?, ATS >
       showAux(OID, SPEC, NOTE?)
        = < OID : CID | module: M, lemmasui: LEMMAS?, pos: POS, lastCmd: (CMD | TYPE), lastRes: OUTPUT?, ATS >
          write(stdout, OID, SUM + NOTE?
                             + "\n  " + subsToString(M, TYPE, OUTPUT?, LEMMAS?, POS) + "\n\n")
        if SUM := auxSummary(TYPE, SPEC, OUTPUT?) .
    eq < OID : CID | module: M, lemmasui: LEMMAS?, pos: POS, lastCmd: (CMD | TYPE), lastRes: OUTPUT?, ATS >
       showAux(OID, SPEC, NOTE?)
        = < OID : CID | module: M, lemmasui: LEMMAS?, pos: POS, lastCmd: (CMD | TYPE), lastRes: OUTPUT?, ATS >
          write(stdout, OID, NOTE? + "\n  " + subsToString(M, TYPE, OUTPUT?, LEMMAS?, POS) + "\n\n") [owise] .

    --- Summary line of an auxiliary command
    op auxSummary : Qid AuxSpec DMCOutput -> String .
    eq auxSummary(TYPE, aux(Q, NL, N, N'), PARENTS || CHILDREN)
        = "\n\033[1;32m  " + auxPhrase(Q) + " " + nodeWord(TYPE, nlLen(NL)) + " "
          + nlText(NL) + ": "
          + auxResult(TYPE, newChildIds(CHILDREN, N), N') + ".\033[0m\n" .

    --- Name of an auxiliary command in its summary
    op auxPhrase : Qid -> String .
    eq auxPhrase('case) = "Case split on" .
    eq auxPhrase('subst) = "Substitution in" .
    eq auxPhrase('gen) = "Generalization of" .
    eq auxPhrase('vunify) = "Variant unification in" .
    eq auxPhrase('va) = "Variable abstraction in" .
    eq auxPhrase('narrow) = "Narrowing of a subterm in" .
    eq auxPhrase('split) = "Boolean split of" .

    --- Child or term, as in each output
    op nodeWord : Qid Nat -> String .
    eq nodeWord(TYPE, N)
        = if TYPE == 'subsumption
          then (if N == 1 then "term" else "terms" fi)
          else (if N == 1 then "child" else "children" fi)
          fi .

    --- Nodes obtained by an auxiliary command, as a phrase
    op auxResult : Qid NatList Nat -> String .
    eq auxResult(TYPE, nil, N) = "every resulting case is closed" .
    eq auxResult(TYPE, NNL, N)
        = "new " + nodeWord(TYPE, nlLen(NNL)) + " " + nlText(NNL)
          + (if N > nlLen(NNL)
             then " (" + string(sd(N, nlLen(NNL)), 10)
                  + (if sd(N, nlLen(NNL)) == 1 then " case" else " cases" fi) + " closed)"
             else "" fi) .

    --- Ids of the children above the session counter before the command
    op newChildIds : ChildNodeList Nat -> NatList .
    eq newChildIds(noChildren, N) = nil .
    eq newChildIds(([ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN), N')
        = (if ID > N' then ID else nil fi) newChildIds(CHILDREN, N') .
    eq newChildIds(([ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN), N')
        = (if ID > N' then ID else nil fi) newChildIds(CHILDREN, N') .

    --- Length of a list of naturals
    op nlLen : NatList -> Nat .
    eq nlLen(nil) = 0 .
    eq nlLen(N NL) = s(nlLen(NL)) .

    --- Naturals as text: 7 / 7 and 8 / 7, 8 and 9
    op nlText : NatList -> String .
    eq nlText(nil) = "" .
    eq nlText(N) = string(N, 10) .
    eq nlText(N N') = string(N, 10) + " and " + string(N', 10) .
    eq nlText(N N' NNL) = nlText'(N N' NNL, "") .
    op nlText' : NatList String -> String .
    eq nlText'(N N' NNL, ACC) = nlText'(N' NNL, ACC + string(N, 10) + ", ") .
    eq nlText'(N N', ACC) = ACC + nlText(N N') .

    --- Number of terms in a set
    op tsSize : TermSet -> Nat .
    eq tsSize(mt) = 0 .
    eq tsSize((T ;; TS)) = s(tsSize(TS)) .

    --- Line printed by empty, lemma and contained
    op closeMsg : Qid Nat String -> String .
    eq closeMsg(TYPE, ID, STR)
        = "\n\033[1;32m  " + (if TYPE == 'subsumption or-else TYPE == 'intersect then "Term " else "Child " fi) +
          string(ID, 10) + " " + STR + ".\033[0m\n" .

    eq < OID : CID | ATS > parse('sb`to_on_with_.['token[ARG],'token[ARG'],'bubble[ARG'']])
        = < OID : CID | ATS > parse('substitution`to_on_with_.['token[ARG],'token[ARG'],'bubble[ARG'']]) .

    --- variant unify to CHILD with TERM1 =? TERM2 .
    eq < OID : CID | ATS, module: noModule > parse('variant`unify_=?_in_.['bubble[ARG],'bubble[ARG'],'token[ARG'']])
        = < OID : CID | ATS, module: noModule > write(stdout, oid, errorMsg(1)) .
    eq < OID : CID | ATS, module: M, lastCmd: (CMD | 'intersect), tmpCmd: TMP >
        parse('variant`unify_=?_in_.['bubble[ARG],'bubble[ARG'],'token[ARG'']])
        = < OID : CID | ATS, module: M, lastCmd: (CMD | 'intersect), tmpCmd: TMP > write(stdout, oid, errorMsg(9)) .
    eq < OID : CID | ATS, module: M, lastCmd: ("" | 'noType) >
        parse('variant`unify_=?_in_.['bubble[ARG],'bubble[ARG'],'token[ARG'']])
        = < OID : CID | ATS, module: M, lastCmd: ("" | 'noType) > write(stdout, oid, errorMsg(5)) .
    ceq < OID : CID | ATS, module: M, lastCmd: (CMD | LSTCMD), lastRes: OUTPUT >
        parse('variant`unify_=?_in_.['bubble[ARG],'bubble[ARG'],'token[ARG'']])
        = < OID : CID | ATS, module: M, lastCmd: (CMD | LSTCMD), lastRes: OUTPUT > write(stdout, oid, errorMsg(6))
        if (LSTCMD == 'invariant or-else LSTCMD == 'generate or-else LSTCMD == 'subsumption) /\
           ID := rat(string(downTerm(ARG'', 'nil.QidList)),10) /\
           notFound(OUTPUT, ID) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption),
                      lastRes: (PARENTS || (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')) >
        parse('variant`unify_=?_in_.['bubble[ARG],'bubble[ARG'],'token[ARG'']])
        = if (PARSED-TERM :: Term)
          then if (PARSED-TERM' :: Term)
               then if (subTerm?(M, PARSED-TERM, T) or subTerm?(extModule(M), PARSED-TERM, CTR) or subTerm?(M,
                        PARSED-TERM', T) or subTerm?(extModule(M), PARSED-TERM', CTR))
                    then if not (getVars((PARSED-TERM, PARSED-TERM')) in getVars((T, CTR)))
                         then < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption),
                                            lastRes: (PARENTS ||
                                                      (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')) >
                              write(stdout, oid, errorMsg(38))
                         else if hasVariantUnifierAbs(M, PARSED-TERM, PARSED-TERM')
                              then vunifyStep(OID, CID, ATS, M, LEMMAS, POS, CMD, 'subsumption, PARENTS, CHILDREN,
                                              [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN', PARSED-TERM,
                                              PARSED-TERM', ID,
                                              getNextIndex((CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN'),
                                                           idmaxOf(ATS)),
                                              getNextVar((CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN'),
                                                         0),
                                              subsObligation(M, CTR, PARSED-TERM, PARSED-TERM', LEMMAS))
                              else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS,
                                                 lastCmd: (CMD | 'subsumption),
                                                 lastRes: (PARENTS ||
                                                           (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ],
                                                            CHILDREN')) >
                                   write(stdout, oid, noUnifierMsg(M, PARSED-TERM, PARSED-TERM', ID))
                              fi
                         fi
                    else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption),
                                       lastRes: (PARENTS ||
                                                 (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')) >
                         write(stdout, oid, errorMsg(19))
                    fi
               else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption),
                                  lastRes: (PARENTS || (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')) >
                    write(stdout, oid, errorMsg(17))
               fi
          else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'subsumption),
                             lastRes: (PARENTS || (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')) >
               write(stdout, oid, errorMsg(16))
          fi
        if ID == rat(string(downTerm(ARG'', 'nil.QidList)),10) /\
           PARSED-TERM := parseTerm(M, ARG) /\
           PARSED-TERM' := parseTerm(M, ARG') .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant),
                      lastRes: (PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')) >
        parse('variant`unify_=?_in_.['bubble[ARG],'bubble[ARG'],'token[ARG'']])
        = if (PARSED-TERM :: Term)
          then if (PARSED-TERM' :: Term)
               then if (subTerm?(M, PARSED-TERM, T) or subTerm?(extModule(M), PARSED-TERM, CTR) or subTerm?(M,
                        PARSED-TERM', T) or subTerm?(extModule(M), PARSED-TERM', CTR))
                    then if not (getVars((PARSED-TERM, PARSED-TERM')) in getVars((T, CTR)))
                         then < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant),
                                            lastRes: (PARENTS ||
                                                      (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                       CHILDREN')) > write(stdout, oid, errorMsg(38))
                         else if hasVariantUnifierAbs(M, PARSED-TERM, PARSED-TERM')
                              then vunifyStep(OID, CID, ATS, M, LEMMAS, POS, CMD, 'invariant, PARENTS, CHILDREN,
                                              [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN',
                                              PARSED-TERM, PARSED-TERM', ID,
                                              getNextIndex((CHILDREN,
                                                            [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                            CHILDREN'), idmaxOf(ATS)),
                                              getNextVar((CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                          CHILDREN'), 0),
                                              subsObligation(M, CTR, PARSED-TERM, PARSED-TERM', LEMMAS))
                              else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS,
                                                 lastCmd: (CMD | 'invariant),
                                                 lastRes: (PARENTS ||
                                                           (CHILDREN,
                                                            [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                            CHILDREN')) >
                                   write(stdout, oid, noUnifierMsg(M, PARSED-TERM, PARSED-TERM', ID))
                              fi
                         fi
                    else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant),
                                       lastRes: (PARENTS ||
                                                 (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                  CHILDREN')) > write(stdout, oid, errorMsg(19))
                    fi
               else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant),
                                  lastRes: (PARENTS ||
                                            (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')) >
                    write(stdout, oid, errorMsg(17))
               fi
          else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant),
                             lastRes: (PARENTS ||
                                       (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')) >
               write(stdout, oid, errorMsg(16))
          fi
        if ID == rat(string(downTerm(ARG'', 'nil.QidList)),10) /\
           PARSED-TERM := parseTerm(M, ARG) /\
           PARSED-TERM' := parseTerm(M, ARG') .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate),
                      lastRes: (PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')) >
        parse('variant`unify_=?_in_.['bubble[ARG],'bubble[ARG'],'token[ARG'']])
        = if (PARSED-TERM :: Term)
          then if (PARSED-TERM' :: Term)
               then if (subTerm?(M, PARSED-TERM, T) or subTerm?(extModule(M), PARSED-TERM, CTR) or subTerm?(M,
                        PARSED-TERM', T) or subTerm?(extModule(M), PARSED-TERM', CTR))
                    then if not (getVars((PARSED-TERM, PARSED-TERM')) in getVars((T, CTR)))
                         then < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate),
                                            lastRes: (PARENTS ||
                                                      (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                       CHILDREN')) > write(stdout, oid, errorMsg(38))
                         else if hasVariantUnifierAbs(M, PARSED-TERM, PARSED-TERM')
                              then vunifyStep(OID, CID, ATS, M, LEMMAS, POS, CMD, 'generate, PARENTS, CHILDREN,
                                              [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN',
                                              PARSED-TERM, PARSED-TERM', ID,
                                              getNextIndex((CHILDREN,
                                                            [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                            CHILDREN'), idmaxOf(ATS)),
                                              getNextVar((CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                          CHILDREN'), 0),
                                              subsObligation(M, CTR, PARSED-TERM, PARSED-TERM', LEMMAS))
                              else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS,
                                                 lastCmd: (CMD | 'generate),
                                                 lastRes: (PARENTS ||
                                                           (CHILDREN,
                                                            [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                            CHILDREN')) >
                                   write(stdout, oid, noUnifierMsg(M, PARSED-TERM, PARSED-TERM', ID))
                              fi
                         fi
                    else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate),
                                       lastRes: (PARENTS ||
                                                 (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                  CHILDREN')) > write(stdout, oid, errorMsg(19))
                    fi
               else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate),
                                  lastRes: (PARENTS ||
                                            (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')) >
                    write(stdout, oid, errorMsg(17))
