    --- Parse Invariant
    op parseInvariant : Module QidList -> [TermList] .
    eq parseInvariant(M, QL) = parseDisj(M, getTerm(metaNormalize(upModule('DM-CHECK-DISJUNCTION, false), getTerm(metaParse(upModule('DM-CHECK-DISJUNCTION, false), none, QL, anyType))))) .
    --- The disjuncts of a parsed invariant
    op parseDisj : Module [TermList] -> [TermList] .
    eq parseDisj(M, '_\/_[NTL]) = parseInvariant'(M, NTL) .
    eq parseDisj(M, PDT:[TermList]) = parseInvariant'(M, PDT:[TermList]) [ owise ] .

    op parseInvariant' : Module TermList -> [TermList] .
    eq parseInvariant'(M, empty) = empty .
    eq parseInvariant'(M, ('_|_['bubble[T1],'true.Bool], TL)) = '_|_[getTerm(metaParse(M, downTerm(T1, (nil).QidList), anyType)),'true.NuITP-Bool], parseInvariant'(M, TL) .
    eq parseInvariant'(M, ('_|_['bubble[T],'_=_['bubble[T1],'bubble[T2]]], TL)) = '_|_[getTerm(metaParse(M, downTerm(T, (nil).QidList), anyType)),parseEq(M, downTerm(T1, (nil).QidList), downTerm(T2, (nil).QidList))], parseInvariant'(M, TL) .
    eq parseInvariant'(M, ('_|_['bubble[T],'_/\_[NTL]], TL)) = '_|_[getTerm(metaParse(M, downTerm(T, (nil).QidList), anyType)), '_/\_[parseInvariant''(M, NTL)]], parseInvariant'(M, TL) .
    eq parseInvariant'(M, ('_|_['bubble[T],'_\/_[NTL]], TL)) = '_|_[getTerm(metaParse(M, downTerm(T, (nil).QidList), anyType)), '_\/_[parseInvariant''(M, NTL)]], parseInvariant'(M, TL) .
    
    --- An equation of a constraint; an ambiguous side (true, false) takes the sort of the other side
    op parseEq : Module QidList QidList -> [Term] .
    eq parseEq(M, PQ1:QidList, PQ2:QidList)
        = parseEq'(M, PQ1:QidList, PQ2:QidList, metaParse(M, none, PQ1:QidList, anyType), metaParse(M, none, PQ2:QidList, anyType)) .
    op parseEq' : Module QidList QidList ResultPair? ResultPair? -> [Term] .
    eq parseEq'(M, PQ1:QidList, PQ2:QidList, {PT1:Term, PY1:Type}, {PT2:Term, PY2:Type}) = '_=_[PT1:Term, PT2:Term] .
    ceq parseEq'(M, PQ1:QidList, PQ2:QidList, PR1:ResultPair?, {PT2:Term, PY2:Type})
        = '_=_[getTerm(metaParse(M, none, PQ1:QidList, PY2:Type)), PT2:Term]
        if not (PR1:ResultPair? :: ResultPair) .
    ceq parseEq'(M, PQ1:QidList, PQ2:QidList, {PT1:Term, PY1:Type}, PR2:ResultPair?)
        = '_=_[PT1:Term, getTerm(metaParse(M, none, PQ2:QidList, PY1:Type))]
        if not (PR2:ResultPair? :: ResultPair) .
    eq parseEq'(M, PQ1:QidList, PQ2:QidList, PR1:ResultPair?, PR2:ResultPair?) = '_=_[getTerm(PR1:ResultPair?), getTerm(PR2:ResultPair?)] [ owise ] .

    op parseInvariant'' : Module TermList -> [TermList] .
    eq parseInvariant''(M, empty) = empty .
    eq parseInvariant''(M, '_=_['bubble[T1],'bubble[T2]]) = (parseEq(M, downTerm(T1, (nil).QidList), downTerm(T2, (nil).QidList))) .
    eq parseInvariant''(M, ('_=_['bubble[T1],'bubble[T2]], NTL)) = ((parseEq(M, downTerm(T1, (nil).QidList), downTerm(T2, (nil).QidList))),parseInvariant''(M, NTL)) .

    --- Parse a lemma written as an implication
    op parseLemma : Module QidList -> [Term] .
    ceq parseLemma(M, QL) = getTerm(metaNormalize(M, '_->_[GAMMA, DELTA]))
        if '_->_[GAMMA,DELTA] := getTerm(metaParse(M, none, QL, 'NuITP-Clause)) .
    ceq parseLemma(M, QL) = getTerm(metaNormalize(M, '_->_['true.NuITP-Bool, getTerm(metaParse(M, none, QL, 'NuITP-Clause))]))
        if getTerm(metaParse(M, none, QL, anyType)) :: Term .

    --- reset lemmas .
    eq < OID : CID | ATS, module: noModule > parse('reset`lemmas`..Command) = < OID : CID | ATS, module: noModule > write(stdout, oid, errorMsg(1)) .
    eq < OID : CID | ATS, module: M, lemmasui: LEMMAS, userlem: UL:TermSet, lastCmd: (CMD | LSTCMD) > parse('reset`lemmas`..Command) =
        < OID : CID | ATS, module: M, userlem: mt, lastCmd: (CMD | LSTCMD),
          lemmasui: proofLemmas(LSTCMD, LEMMAS) >
        write(stdout, OID, "\n\033[1;32m  Session lemmas cleared.\033[0m\n\n") .

    --- add lemma L .
    eq < OID : CID | ATS, module: noModule > parse('add`lemma_.['bubble[ARG1]]) = < OID : CID | ATS, module: noModule > write(stdout, oid, errorMsg(1)) .
    eq < OID : CID | ATS, module: M, lemmasui: LEMMAS, userlem: UL:TermSet, lastCmd: ("" | 'noType) > parse('add`lemma_.['bubble[ARG1]]) = 
        if parseLemma(M, downTerm(ARG1, (nil).QidList)) :: Term
        then < OID : CID | ATS, module: M, lemmasui: LEMMAS ;; parseLemma(M, downTerm(ARG1, (nil).QidList)), userlem: UL:TermSet ;; parseLemma(M, downTerm(ARG1, (nil).QidList)), lastCmd: ("" | 'noType) > write(stdout, OID, "\n\033[1;32m  Lemma added successfully.\033[0m\n\n")
        else < OID : CID | ATS, module: M, lemmasui: LEMMAS, userlem: UL:TermSet, lastCmd: ("" | 'noType) > write(stdout, oid, errorMsg(4))
        fi .
    eq < OID : CID | ATS, module: M, lemmasui: LEMMAS, userlem: UL:TermSet, lastCmd: (CMD | LSTCMD), tmpCmd: TMP > parse('add`lemma_.['bubble[ARG1]]) = 
        if parseLemma(M, downTerm(ARG1, (nil).QidList)) :: Term
        then < OID : CID | ATS, module: M, lemmasui: LEMMAS ;; parseLemma(M, downTerm(ARG1, (nil).QidList)), userlem: UL:TermSet ;; parseLemma(M, downTerm(ARG1, (nil).QidList)), lastCmd: (CMD | LSTCMD), tmpCmd: CMD > parseCommand(M, OID, CMD)
        else < OID : CID | ATS, module: M, lemmasui: LEMMAS, userlem: UL:TermSet, lastCmd: (CMD | LSTCMD), tmpCmd: TMP > write(stdout, oid, errorMsg(4))
        fi .  

    --- Proof history (save proof): was the command rejected?
    eq isWarning(STX:String)
        = startsWith(STX:String, "\n\033[1;31m  Error:")
          or startsWith(STX:String, "\n  \033[1;31mError:") .
    eq isRecordable(STX:String) = not (STX:String == "" or-else STX:String == "q" or-else STX:String == "h." or-else startsWith(STX:String, "h ") or-else startsWith(STX:String, "show") or-else startsWith(STX:String, "help") or-else startsWith(STX:String, "quit") or-else startsWith(STX:String, "load") or-else startsWith(STX:String, "save")) .
    eq histCmd(STX:String) = if isRecordable(trim(STX:String)) then prettyCmd(flatCmd(trim(STX:String))) else "" fi .
    --- A recorded command on a single line
    ceq flatCmd(STX:String) = flatCmd(substr(STX:String, 0, NN:Nat)) + flatCmd(substr(STX:String, NN:Nat, sd(length(STX:String), NN:Nat)))
        if length(STX:String) > 2 /\ NN:Nat := splitAt(STX:String, length(STX:String) quo 2) .
    ceq flatCmd(STX:String) = flatShort(STX:String) if length(STX:String) <= 2 .
    --- Never split between a backslash and the character that follows it
    eq splitAt(STX:String, NN:Nat) = if (NN:Nat + 1 < length(STX:String)) and-then (substr(STX:String, sd(NN:Nat, 1), 1) == "\\") then splitAt(STX:String, NN:Nat + 1) else NN:Nat fi .
    eq flatCh(STX:String) = if (STX:String == "\n" or-else STX:String == "\r") then " " else STX:String fi .
    eq flatShort(STX:String) =
        if length(STX:String) == 0 then ""
        else if length(STX:String) == 1 then flatCh(STX:String)
        else if (substr(STX:String, 0, 1) == "\\") and-then (substr(STX:String, 1, 1) == "\n" or-else substr(STX:String, 1, 1) == "\r") then " "
        else flatCh(substr(STX:String, 0, 1)) + flatCh(substr(STX:String, 1, 1))
        fi fi fi .
    --- Lay out a recorded command again
    eq prettyCmd(STX:String) = breakAt(breakAt(squeeze(STX:String), " \\/ ", " \\\n  \\/ "), " subsumed by ", " \\\n  subsumed by ") .
    eq squeeze(STX:String) = if find(STX:String, "  ", 0) :: Nat then squeeze(breakAt(STX:String, "  ", " ")) else STX:String fi .
    --- breakAt(S, P, R): replaces every occurrence of the (non-empty) pattern P in S by R
    ceq breakAt(STX:String, PP:String, RR:String) = substr(STX:String, 0, NN:Nat) + RR:String + breakAt(substr(STX:String, NN:Nat + length(PP:String), sd(length(STX:String), NN:Nat + length(PP:String))), PP:String, RR:String)
        if NN:Nat := find(STX:String, PP:String, 0) .
    eq breakAt(STX:String, PP:String, RR:String) = STX:String [ owise ] .
    ceq < OID : CID | ATS, history: HH:String, histPending: HP:String > write(stdout, OID, STX:String) =
        < OID : CID | histUpd(ATS, HH:String, HP:String, STX:String) > write(stdout, OID, STX:String)
        if not (HP:String == "") .
    --- Variable abstraction waiting for its selection
    op vaPend:_ : String -> Attribute [ ctor ] .
    op histUpd : AttributeSet String String String -> AttributeSet .
    eq histUpd(HA:AttributeSet, HH:String, HP:String, STX:String)
        = histUpd'(hasVaSel(HA:AttributeSet), getVaPend(HA:AttributeSet), dropVaPend(HA:AttributeSet), HH:String, HP:String, STX:String) .
    op histUpd' : Bool String AttributeSet String String String -> AttributeSet .
    eq histUpd'(true, VP:String, HA:AttributeSet, HH:String, HP:String, STX:String)
        = (HA:AttributeSet, history: HH:String, histPending: "", vaPend: (if isWarning(STX:String) then "" else HP:String fi)) .
    eq histUpd'(false, VP:String, HA:AttributeSet, HH:String, HP:String, STX:String)
        = (HA:AttributeSet, histPending: "",
           history: (if isWarning(STX:String) then HH:String
                     else HH:String + (if VP:String =/= "" and-then startsWith(trim(HP:String), "select") then VP:String + "\n\n" else "" fi) + HP:String + "\n\n" fi)) .
    --- Pending variable abstraction selection (for save proof)
    op hasVaSel : AttributeSet -> Bool .
    eq hasVaSel((vaSelect: true, HA:AttributeSet)) = true .
    eq hasVaSel(HA:AttributeSet) = false [ owise ] .
    op getVaPend : AttributeSet -> String .
    eq getVaPend((vaPend: VP:String, HA:AttributeSet)) = VP:String .
    eq getVaPend(HA:AttributeSet) = "" [ owise ] .
    op dropVaPend : AttributeSet -> AttributeSet .
    eq dropVaPend((vaPend: VP:String, HA:AttributeSet)) = HA:AttributeSet .
    eq dropVaPend(HA:AttributeSet) = HA:AttributeSet [ owise ] .

    --- save proof FILE .
    eq proofScript(HH:String) = "--- DM-Check proof script (" + DMC-VERSION + ")\n--- Replay it with: load <this file>, after loading the same Maude module.\n--- Lemmas added with add lemma are assumed; this script does not prove them.\n\n" + HH:String .
    eq saveWarning(NM:String, STX:String) = "\n\033[1;31m  Error:\033[0m cannot save proof script to " + NM:String + " (" + STX:String + ").\n" + (if STX:String == "File operations disabled." then "  Start Maude with the -allow-files or -trust flag to enable saving.\n" else "" fi) + "\n" .
    eq < OID : CID | ATS, history: "" > parse('save`proof_.['token[ARG1]]) =
        < OID : CID | ATS, history: "" > write(stdout, OID, "\n\033[1;31m  Error:\033[0m there are no commands to save.\n\n") .
    ceq < OID : CID | ATS, history: HH:String > parse('save`proof_.['token[ARG1]]) =
        < OID : CID | saving: saveOpening(string(downTerm(ARG1, 'noFile.Qid)), proofScript(HH:String)), ATS, history: HH:String >
        openFile(fileManager, OID, string(downTerm(ARG1, 'noFile.Qid)), "w")
        if not (HH:String == "") .
    eq < OID : CID | ATS, saving: saveOpening(NM:String, TXT:String) > openedFile(OID, fileManager, FH:Oid) =
        < OID : CID | ATS, saving: saveWriting(NM:String, FH:Oid) > write(FH:Oid, OID, TXT:String) .
    eq < OID : CID | ATS, saving: saveOpening(NM:String, TXT:String) > fileError(OID, FH:Oid, STX:String) =
        < OID : CID | ATS > write(stdout, OID, saveWarning(NM:String, STX:String)) .
    eq < OID : CID | ATS, saving: saveWriting(NM:String, FH:Oid) > wrote(OID, FH:Oid) =
        < OID : CID | ATS, saving: saveClosing("\n\033[1;32m  Proof script saved to " + NM:String + ".\033[0m\n\n") > closeFile(FH:Oid, OID) .
    eq < OID : CID | ATS, saving: saveWriting(NM:String, FH:Oid) > fileError(OID, FH:Oid, STX:String) =
        < OID : CID | ATS, saving: saveClosing(saveWarning(NM:String, STX:String)) > closeFile(FH:Oid, OID) .
    eq < OID : CID | ATS, saving: saveClosing(MSG:String) > closedFile(OID, FH:Oid) =
        < OID : CID | ATS > write(stdout, OID, MSG:String) .
endm

--- smt.maude (loaded by NuITP) leaves set include BOOLEAN on
set include BOOLEAN off .

set show command off .

erew in DM-CHECK-UI : init .
