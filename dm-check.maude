set show advisories off .

fmod DM-CHECK-META is
    pr META-MODULE .
    pr META-LEVEL .
    pr META-TERM .
    pr CONVERSION .
    pr STRING-OPS .

    var F : Qid .
    var V : Variable .
    var NTL : NeTermList .
    vars T T' : Term .
    var N : Nat .
    var TL : TermList .
    vars SB SB' : Substitution .
    var CO : Context .
    vars COL NCTL : NeCTermList .
    var C : Constant .
    vars TS SKO : TermSet .
    var NTS : NeTermSet .
    var GT : GroundTerm .
    var S : Sort .
    var COND : Condition .

    --- Define term sets
    sorts NeTermSet TermSet .
    subsort Term < NeTermSet < TermSet .

    --- Define term sets
    op mt : -> TermSet [ ctor ] .
    op _;;_ : TermSet TermSet -> TermSet [ assoc comm id: mt ] .
    op _;;_ : NeTermSet TermSet -> NeTermSet [ assoc comm id: mt ] .
    eq T ;; T = T .

    --- Get the variables of conditions, termlists and termsets
    op getVars : Condition -> TermSet .
    op getVars : TermList -> TermSet .
    op getVars : TermSet -> TermSet .
    eq getVars((nil).Condition) = mt .
    eq getVars(empty) = mt .
    eq getVars(mt) = mt .
    eq getVars(C) = mt .
    eq getVars(V) = V .
    eq getVars(F[NTL]) = getVars(NTL) .
    eq getVars((T, NTL)) = getVars(T) ;; getVars(NTL) .
    eq getVars((T ;; NTS)) = getVars(T) ;; getVars(NTS) .
    eq getVars((T : S) /\ COND) = getVars(T) ;; getVars(COND) .
    eq getVars((T = T') /\ COND) = getVars(T) ;; getVars(T') ;; getVars(COND) .
    eq getVars((T => T') /\ COND) = getVars(T) ;; getVars(T') ;; getVars(COND) .
    eq getVars((T' := T) /\ COND) = getVars(T) ;; getVars(T') ;; getVars(COND) .

    --- Get the variables of a substitution range
    op getRangeVars : Substitution -> TermSet .
    eq getRangeVars((none).Substitution) = mt .
    eq getRangeVars(V <- T ; SB) = getVars(T) ;; getRangeVars(SB) .

    --- Apply substitutions
    op applySub : TermSet Substitution -> TermSet .
    op applySub : TermList Substitution -> TermList .
    op applySub : Term Substitution -> Term .
    eq applySub((mt).TermSet, SB) = mt .
    eq applySub(empty, SB) = empty .
    eq applySub(V, (V <- T ; SB)) = T .
    eq applySub(F[NTL], SB) = F[applySub(NTL, SB)] .
    eq applySub((T, NTL), SB) = applySub(T, SB), applySub(NTL, SB) .
    eq applySub((T ;; NTS), SB) = applySub(T,SB) ;; applySub(NTS,SB) .
    eq applySub(T, SB) = T [ owise ] .

    op applySub : Condition Substitution -> TermList .
    eq applySub((nil).Condition, SB) = empty .
    eq applySub((T = T' /\ COND), SB) = applySub('_=_[T,T'], SB) , applySub(COND, SB) .
    eq applySub((T : S) /\ COND, SB) = applySub(COND, SB) .
    eq applySub((T => T') /\ COND, SB) = applySub(COND, SB) .
    eq applySub((T' := T) /\ COND, SB) = applySub(COND, SB) .

    op applySub : Substitution Substitution -> Substitution .
    eq applySub((none).Substitution, SB) = none .
    eq applySub(V <- T ; SB, SB') = V <- applySub(T, SB') ; applySub(SB, SB') .

    --- Remove repetitions from a variable set
    op disjunctVars : TermSet -> TermSet .
    eq disjunctVars(mt) = mt .
    eq disjunctVars(T) = T .
    eq disjunctVars(NTS ;; NTS ;; TS) = disjunctVars(NTS ;; TS) .
    eq disjunctVars(NTS) = NTS [owise] .

    --- Count the variables in a list or set
    op countVars : TermList -> Nat .
    op countVars : TermSet -> Nat .
    eq countVars(empty) = 0 .
    eq countVars(mt) = 0 .
    eq countVars(GT) = 0 .
    eq countVars(V) = 1 .
    eq countVars(F[NTL]) = countVars(NTL) .
    eq countVars(T ;; NTS) = countVars(T) + countVars(NTS) .
    eq countVars((T, NTL)) = countVars(T) + countVars(NTL) .

    --- Rename a set of variables to "$" notation
    op rename : TermSet Nat -> Substitution .
    eq rename(mt, N) = none .
    eq rename(V ;; TS, N) = V <- qid("$" + string(N,10) + ":" + string(getType(V))) ; rename(TS, N + 1) .

    --- Replace a hole in a term
    op replaceHole : Context Term -> Term .
    eq replaceHole([],T) = T .
    eq replaceHole(F[COL],T) = F[replaceHole(COL,T)] .
    eq replaceHole((CO,TL),T) = (replaceHole(CO,T),TL) [ owise ] .
    eq replaceHole((T,COL),T') = (T,replaceHole(COL,T')) [ owise ] .

    --- Turn the variables of a substitution into constants
    op freeze : Substitution -> Substitution .
    op freeze : TermSet -> TermSet .
    op freeze : TermList -> TermList .
    op freeze : Term -> Term .
    eq freeze((none).Substitution) = none .
    eq freeze((mt).TermSet) = mt .
    eq freeze(empty) = empty .
    eq freeze(C) = C .
    eq freeze(V) = qid(string(getName(V)) + "." + string(getType(V))) .
    eq freeze(F[NTL]) = F[freeze(NTL)] .
    eq freeze((T,NTL)) = (freeze(T),freeze(NTL)) .
    eq freeze(T ;; NTS) = freeze(T) ;; freeze(NTS) .
    eq freeze(V <- T ; SB) = (V <- freeze(T)) ; freeze(SB) .

    op freeze : NeCTermList -> NeCTermList .
    op freeze : Context -> Context .
    eq freeze([]) = [] .
    eq freeze(F[NCTL]) = F[freeze(NCTL)] .
    eq freeze((T,NCTL)) = freeze(T), freeze(NCTL) .
    eq freeze((CO,NTL)) = freeze(CO), freeze(NTL) .

    op freeze' : Substitution TermSet -> Substitution .
    op freeze' : TermSet TermSet -> TermSet .
    op freeze' : TermList TermSet -> TermList .
    op freeze' : Term TermSet -> Term .
    eq freeze'((none).Substitution, SKO) = none .
    eq freeze'((mt).TermSet, SKO) = mt .
    eq freeze'(empty, SKO) = empty .
    eq freeze'(C, SKO) = C .
    eq freeze'(V, SKO)
        = if (V in SKO) or-else (freeze(V) in SKO)
          then qid(string(getName(V)) + "." + string(getType(V)))
          else V
          fi .
    eq freeze'(F[NTL], SKO) = F[freeze'(NTL, SKO)] .
    eq freeze'((T,NTL), SKO) = (freeze'(T, SKO),freeze'(NTL, SKO)) .
    eq freeze'(T ;; NTS, SKO) = freeze'(T, SKO) ;; freeze'(NTS, SKO) .
    eq freeze'(V <- T ; SB, SKO) = (V <- freeze'(T, SKO)) ; freeze'(SB, SKO) .

    op freeze' : NeCTermList TermSet -> NeCTermList .
    op freeze' : Context TermSet -> Context .
    eq freeze'(CO, mt) = CO .
    eq freeze'([], SKO) = [] .
    eq freeze'(F[NCTL], SKO) = F[freeze'(NCTL, SKO)] .
    eq freeze'((T,NCTL), SKO) = freeze'(T, SKO), freeze'(NCTL, SKO) .
    eq freeze'((CO,NTL), SKO) = freeze'(CO, SKO), freeze'(NTL, SKO) .

    --- Turn back into variables the constants made by freeze
    op unfreeze : Substitution -> Substitution .
    op unfreeze : TermSet -> TermSet .
    op unfreeze : TermList -> TermList .
    op unfreeze : Term -> Term .
    eq unfreeze((none).Substitution) = none .
    eq unfreeze((mt).TermSet) = mt .
    eq unfreeze(empty) = empty .
    eq unfreeze(C)
        = if startsWith(string(C), "$")
          then qid(string(getName(C)) + ":" + string(getType(C)))
          else C
          fi .
    eq unfreeze(V) = V .
    eq unfreeze(F[NTL]) = F[unfreeze(NTL)] .
    eq unfreeze((T,NTL)) = (unfreeze(T),unfreeze(NTL)) .
    eq unfreeze(T ;; NTS) = unfreeze(T) ;; unfreeze(NTS) .
    eq unfreeze(V <- T ; SB) = (V <- unfreeze(T)) ; unfreeze(SB) .

    op unfreeze : NeCTermList -> NeCTermList .
    op unfreeze : Context -> Context .
    eq unfreeze([]) = [] .
    eq unfreeze(F[NCTL]) = F[unfreeze(NCTL)] .
    eq unfreeze((T,NCTL)) = unfreeze(T), unfreeze(NCTL) .
    eq unfreeze((CO,NTL)) = unfreeze(CO), unfreeze(NTL) .

    op unfreeze' : Substitution TermSet -> Substitution .
    op unfreeze' : TermSet TermSet -> TermSet .
    op unfreeze' : TermList TermSet -> TermList .
    op unfreeze' : Term TermSet -> Term .
    eq unfreeze'((none).Substitution, SKO) = none .
    eq unfreeze'(TS, mt) = TS .
    eq unfreeze'(TL, mt) = TL .
    eq unfreeze'((mt).TermSet, SKO) = mt .
    eq unfreeze'(empty, SKO) = empty .
    eq unfreeze'(C, SKO)
        = if (C in SKO) or-else (qid(string(getName(C)) + ":" + string(getType(C))) in SKO)
          then qid(string(getName(C)) + ":" + string(getType(C)))
          else C
          fi .
    eq unfreeze'(V, SKO) = V .
    eq unfreeze'(F[NTL], SKO) = F[unfreeze'(NTL, SKO)] .
    eq unfreeze'((T ;; NTS), SKO) = unfreeze'(T, SKO) ;; unfreeze'(NTS, SKO) .
    eq unfreeze'((T,NTL), SKO) = unfreeze'(T, SKO), unfreeze'(NTL, SKO) .
    eq unfreeze'(T, SKO) = T [ owise ] .
    eq unfreeze'(V <- T ; SB, SKO) = (V <- unfreeze'(T, SKO)) ; unfreeze'(SB, SKO) .

    op unfreeze' : NeCTermList TermSet -> NeCTermList .
    op unfreeze' : Context TermSet -> Context .
    eq unfreeze'(CO, mt) = CO .
    eq unfreeze'([], SKO) = [] .
    eq unfreeze'(F[NCTL], SKO) = F[unfreeze'(NCTL, SKO)] .
    eq unfreeze'((T,NCTL), SKO) = unfreeze'(T, SKO), unfreeze'(NCTL, SKO) .
    eq unfreeze'((CO,NTL), SKO) = unfreeze'(CO, SKO), unfreeze'(NTL, SKO) .
endfm

fmod DM-CHECK-MODS is
    pr DM-CHECK-META .

    vars MOD F Q Q' : Qid .
    var H : Header .
    var IL : ImportList .
    var SS : SortSet .
    vars RLS RLS' RLS'' : RuleSet .
    vars SUBSS SSDS : SubsortDeclSet .
    vars OPS OPS' OPDS : OpDeclSet .
    vars MBS MAS : MembAxSet .
    vars EQS EQS' : EquationSet .
    vars STTS STDS : StratDeclSet .
    vars STTD STDFS : StratDefSet .
    vars LHS RHS T T' CTR CTR' CTR'' : Term .
    var ATS : AttrSet .
    var S : Sort .
    var COND : Condition .
    var M : Module .
    var C : Constant .
    var TS : TermSet .
    var NTS : NeTermSet .
    vars NTL NTL' : NeTermList .
    var N : Nat .
    var QL : QidList .
    var HK : Hook .
    var HKL : NeHookList .
    var TYL : TypeList .
    var TY : Type .
    var QS : QidSet .
    var VAR : Variable .
    var B : Bool .
    vars KIND NAME STR : String .

    --- Add the necessary operators and modify rules for conditional narrowing.
    op transformMod : Module -> Module .
    eq transformMod(mod MOD is IL sorts SS . SUBSS OPS MBS EQS RLS endm)
                = mod MOD is IL sorts SS ; 'DMCBool . SUBSS (OPS addOpDecls(SS)) MBS EQS transformRules(RLS) endm .
    eq transformMod(th MOD is IL sorts SS . SUBSS OPS MBS EQS RLS endth)
                = th MOD is IL sorts SS ; 'DMCBool . SUBSS (OPS addOpDecls(SS)) MBS EQS transformRules(RLS) endth .
    eq transformMod(smod MOD is IL sorts SS . SUBSS OPS MBS EQS RLS STTS STTD endsm)
        = smod MOD is IL sorts SS ; 'DMCBool . SUBSS (OPS addOpDecls(SS)) MBS EQS transformRules(RLS) STTS STTD endsm .
    eq transformMod(sth MOD is IL sorts SS . SUBSS OPS MBS EQS RLS STTS STTD endsth)
        = sth MOD is IL sorts SS ; 'DMCBool . SUBSS (OPS addOpDecls(SS)) MBS EQS transformRules(RLS) STTS STTD endsth .

    --- Add the dmc/\, dmc> and = operators to handle conditions.
    op addOpDecls : SortSet -> OpDeclSet .
    eq addOpDecls(none) = none .
    eq addOpDecls(SS)
      = (op '_dmc/\_ : 'DMCBool 'DMCBool -> 'DMCBool [ assoc ctor ] .) addOpDecls'(SS) .

    --- Declare dmc/\, dmc> and = for each sort
    op addOpDecls' : SortSet -> OpDeclSet .
    eq addOpDecls'(none) = none .
    eq addOpDecls'(S ; SS)
      = (op '_dmc>_ : 'DMCBool S -> S [ ctor ] .)
        (op '_dmc=_ : S S -> 'DMCBool [ ctor ] .)
        addOpDecls'(SS) .

    --- Transform conditional rules and extract the constraints
    op transformRules : RuleSet -> RuleSet .
    eq transformRules(RLS) = transformNuITPConditions(RLS) .

    --- Move the first equational condition of a rule into its right-hand side
    op transformNuITPConditions : RuleSet -> RuleSet .
    eq transformNuITPConditions(RLS' (crl LHS => RHS if nil [ATS] .) RLS'')
                = transformNuITPConditions(RLS' RLS'') (rl LHS => RHS [ATS narrowing] .) .
    eq transformNuITPConditions(RLS' (crl LHS => RHS if (CTR = CTR') /\ COND [ATS] .) RLS'')
        = transformNuITPConditions(RLS' transformNuITPConditions'(crl LHS => '_dmc>_['_dmc=_[CTR,CTR'],
                                   RHS] if COND [ATS] .) RLS'') .
    eq transformNuITPConditions(RLS') = RLS' [owise] .

    --- Move the remaining conditions of a rule
    op transformNuITPConditions' : Rule -> Rule .
    eq transformNuITPConditions'(crl LHS => RHS if nil [ATS] .)
                =  (rl (LHS) => RHS [ATS narrowing] .) .
    eq transformNuITPConditions'(crl LHS => '_dmc>_[CTR,RHS] if (CTR' = CTR'') /\ COND [ATS] .)
                = transformNuITPConditions'(crl LHS => '_dmc>_['_dmc/\_[CTR,'_dmc=_[CTR',CTR'']],RHS] if COND [ATS] .) .
    eq transformNuITPConditions'(crl LHS => RHS if COND [ATS] .)
                = (crl LHS => RHS if COND [ATS] .) [owise] .

    --- Declare terms (variables) as fresh constants
    op toOps : TermList -> OpDeclSet .
    op toOps : TermSet -> OpDeclSet .
    eq toOps(empty) = none .
    eq toOps(mt) = none .
    eq toOps(C) = (op getName(C) : nil -> getType(C) [ metadata("skolem") ] .) .
    eq toOps((C, NTL)) = (op getName(C) : nil -> getType(C) [ metadata("skolem") ] .) toOps(NTL) .
    eq toOps((C ;; NTS)) = (op getName(C) : nil -> getType(C) [ metadata("skolem") ] .) toOps(NTS) .

    --- Add operators to a module
    op addOps : Module TermSet -> Module .
    eq addOps(M, TS) = addOps(M, toOps(TS)) .

    op addOps : Module OpDeclSet -> Module .
    eq addOps(mod MOD is IL sorts SS . SUBSS OPS MBS EQS RLS endm, OPS')
        = mod MOD is IL sorts SS . SUBSS OPS OPS' MBS EQS RLS endm .
    eq addOps(th MOD is IL sorts SS . SUBSS OPS MBS EQS RLS endth, OPS')
        = th MOD is IL sorts SS . SUBSS OPS OPS' MBS EQS RLS endth .
    eq addOps(smod MOD is IL sorts SS . SUBSS OPS MBS EQS RLS STTS STTD endsm, OPS')
        = smod MOD is IL sorts SS . SUBSS OPS OPS' MBS EQS RLS STTS STTD endsm .
    eq addOps(sth MOD is IL sorts SS . SUBSS OPS MBS EQS RLS STTS STTD endsth, OPS')
        = sth MOD is IL sorts SS . SUBSS OPS OPS' MBS EQS RLS STTS STTD endsth .
    eq addOps(M, OPS) = M [ owise ] .

    --- Remove the rules of a module and extend it with the NuITP clause syntax
    op noRlsExt : Module -> Module [ memo ] .
    eq noRlsExt(M) = extModule(setRls(M, none)) .

    --- Extend a module with the NuITP clause syntax
    op extModule : Qid -> Module .
    eq extModule(MOD) = extModule(upModule(MOD, true)) .

    op extModule : Module -> Module .
    eq extModule(mod MOD is IL sorts SS . SUBSS OPS MBS EQS RLS endm)
        = mod MOD is IL (protecting 'NuITP-CLAUSE .) sorts SS . SUBSS OPS MBS EQS RLS endm .
    eq extModule(th MOD is IL sorts SS . SUBSS OPS MBS EQS RLS endth)
        = th MOD is IL (protecting 'NuITP-CLAUSE .) sorts SS . SUBSS OPS MBS EQS RLS endth .
    eq extModule(smod MOD is IL sorts SS . SUBSS OPS MBS EQS RLS STTS STTD endsm)
        = smod MOD is IL (protecting 'NuITP-CLAUSE .) sorts SS . SUBSS OPS MBS EQS RLS STTS STTD endsm .
    eq extModule(sth MOD is IL sorts SS . SUBSS OPS MBS EQS RLS STTS STTD endsth)
        = sth MOD is IL (protecting 'NuITP-CLAUSE .) sorts SS . SUBSS OPS MBS EQS RLS STTS STTD endsth .

    --- Convert equations into narrowing rules
    op toRls : EquationSet Term Nat -> RuleSet .
    eq toRls((none).EquationSet, T, N) = none .
    eq toRls((eq LHS = RHS [ owise ATS ] .) EQS, T, N)
        = (rl LHS => RHS [ label(qid("DM-CHECK-RL#" + string(N,10)))] .) toRls(EQS, T, N + 1) .
    eq toRls((eq F[NTL] = RHS [ variant ATS ] .) EQS, F[NTL'], N)
        = (rl F[NTL] => RHS [ narrowing label(qid("DM-CHECK-RL#" + string(N,10))) ] .) toRls(EQS, F[NTL'], N + 1) .
    eq toRls((eq F[NTL] = RHS [ ATS ] .) EQS, F[NTL'], N)
        = (rl F[NTL] => RHS [ narrowing label(qid("DM-CHECK-RL#" + string(N,10))) ] .) toRls(EQS, F[NTL'],
              N + 1) [ owise ] .
    eq toRls((ceq F[NTL] = RHS if COND [ ATS ] .) EQS, F[NTL'], N)
        = (crl F[NTL] => RHS if COND [ ATS label(qid("DM-CHECK-RL#" + string(N,10)))] .) toRls(EQS, F[NTL'], N + 1) .
    eq toRls((eq C = RHS [ ATS ] .) EQS, C, N)
        = (rl C => RHS [ narrowing label(qid("DM-CHECK-RL#" + string(N,10))) ] .) toRls(EQS, C, N + 1) .
    eq toRls((ceq C = RHS if COND [ ATS ] .) EQS, C, N)
        = (crl C => RHS if COND [ ATS label(qid("DM-CHECK-RL#" + string(N,10)))] .) toRls(EQS, C, N + 1) .
    eq toRls(EQS, T, N) = none [ owise ] .

    --- Replace the rules of a module
    op setRls : Module RuleSet -> Module .
    eq setRls(mod MOD is IL sorts SS . SUBSS OPS MBS EQS RLS endm, RLS')
        = mod MOD is IL sorts SS . SUBSS OPS MBS EQS RLS' endm .
    eq setRls(th MOD is IL sorts SS . SUBSS OPS MBS EQS RLS endth, RLS')
        = th MOD is IL sorts SS . SUBSS OPS MBS EQS RLS' endth .
    eq setRls(smod MOD is IL sorts SS . SUBSS OPS MBS EQS RLS STTS STTD endsm, RLS')
        = smod MOD is IL sorts SS . SUBSS OPS MBS EQS RLS' STTS STTD endsm .
    eq setRls(sth MOD is IL sorts SS . SUBSS OPS MBS EQS RLS STTS STTD endsth, RLS')
        = sth MOD is IL sorts SS . SUBSS OPS MBS EQS RLS' STTS STTD endsth .
    eq setRls(M, RLS) = M [ owise ] .

    --- Replace the equations of a module
    op setEqs : Module EquationSet -> Module .
    eq setEqs(mod MOD is IL sorts SS . SUBSS OPS MBS EQS RLS endm, EQS')
        = mod MOD is IL sorts SS . SUBSS OPS MBS EQS' RLS endm .
    eq setEqs(th MOD is IL sorts SS . SUBSS OPS MBS EQS RLS endth, EQS')
        = th MOD is IL sorts SS . SUBSS OPS MBS EQS' RLS endth .
    eq setEqs(smod MOD is IL sorts SS . SUBSS OPS MBS EQS RLS STTS STTD endsm, EQS')
        = smod MOD is IL sorts SS . SUBSS OPS MBS EQS' RLS STTS STTD endsm .
    eq setEqs(sth MOD is IL sorts SS . SUBSS OPS MBS EQS RLS STTS STTD endsth, EQS')
        = sth MOD is IL sorts SS . SUBSS OPS MBS EQS' RLS STTS STTD endsth .
    eq setEqs(M, EQS) = M [ owise ] .

    --- Turn the equations of the top operator of a term into the rules of a module
    op euR : Module Term -> Module [ memo ] .
    eq euR(M, F[NTL]) = setRls(setEqs(M, (none).EquationSet), toRls(getEqs(M), F[NTL], 0)) .
    eq euR(M, C) = setRls(setEqs(M, (none).EquationSet), toRls(getEqs(M), C, 0)) .

    --- Build the narrowing module for a subterm
    op narrowMod : Module Term -> Module [ memo ] .
    eq narrowMod(M, T) = transformMod(euR(M, T)) .

    --- Count the unconditional rules without the narrowing attribute
    op countNarrowRls : Module -> Nat .
    eq countNarrowRls(mod MOD is IL sorts SS . SUBSS OPS MBS EQS RLS endm) = countNarrowRls'(RLS) .
    eq countNarrowRls(th MOD is IL sorts SS . SUBSS OPS MBS EQS RLS endth) = countNarrowRls'(RLS) .
    eq countNarrowRls(smod MOD is IL sorts SS . SUBSS OPS MBS EQS RLS STTS STTD endsm) = countNarrowRls'(RLS) .
    eq countNarrowRls(sth MOD is IL sorts SS . SUBSS OPS MBS EQS RLS STTS STTD endsth) = countNarrowRls'(RLS) .

    op countNarrowRls' : RuleSet -> Nat .
    eq countNarrowRls'(none) = 0 .
    eq countNarrowRls'((crl LHS => RHS if COND [ATS] .) RLS) = countNarrowRls'(RLS) .
    eq countNarrowRls'((rl LHS => RHS [ narrowing ATS ] .) RLS) = countNarrowRls'(RLS) .
    eq countNarrowRls'((rl LHS => RHS [ ATS ] .) RLS) = 1 + countNarrowRls'(RLS) [owise] .

    --- Check if some hook is that of the built-in equality
    op eqHook : NeHookList -> Bool .
    eq eqHook(id-hook('EqualitySymbol, QL)) = true .
    eq eqHook(HK HKL) = eqHook(HK) or eqHook(HKL) .
    eq eqHook(HK) = false [ owise ] .

    --- Get the operators of the built-in equality (_==_, _=/=_) of a module
    op unsafeOps : Module -> QidSet .
    eq unsafeOps(M) = unsafeOps(getOps(M)) .
    op unsafeOps : OpDeclSet -> QidSet .
    eq unsafeOps((op Q : TYL -> TY [special(HKL) ATS] .) OPS)
        = (if eqHook(HKL) then Q else (none).QidSet fi) ; unsafeOps(OPS) .
    eq unsafeOps(OPS) = (none).QidSet [ owise ] .

    --- Check if a term uses one of the given operators
    op usesOp : TermList QidSet -> Bool .
    eq usesOp(empty, QS) = false .
    eq usesOp(Q[NTL], (Q ; QS)) = true .
    eq usesOp(Q[NTL], QS) = usesOp(NTL, QS) [ owise ] .
    eq usesOp((T, NTL), QS) = usesOp(T, QS) or usesOp(NTL, QS) .
    eq usesOp(C, QS) = false .
    eq usesOp(VAR, QS) = false .

    --- Check if a condition uses one of the given operators
    op usesOpC : Condition QidSet -> Bool .
    eq usesOpC(nil, QS) = false .
    eq usesOpC((T = T') /\ COND, QS) = usesOp((T, T'), QS) or usesOpC(COND, QS) .
    eq usesOpC((T := T') /\ COND, QS) = usesOp((T, T'), QS) or usesOpC(COND, QS) .
    eq usesOpC((T => T') /\ COND, QS) = usesOp((T, T'), QS) or usesOpC(COND, QS) .
    eq usesOpC((T : S) /\ COND, QS) = usesOp(T, QS) or usesOpC(COND, QS) .

    --- Check if a condition has a fragment other than t = t'
    op nonEqCond : Condition -> Bool .
    eq nonEqCond(nil) = false .
    eq nonEqCond((T = T') /\ COND) = nonEqCond(COND) .
    eq nonEqCond(COND) = true [ owise ] .

    --- Name of a statement in a rejection message (label or text)
    op stmtName : Module AttrSet Term -> String .
    eq stmtName(M, (label(Q) ATS), T) = string(Q) .
    eq stmtName(M, ATS, T) = metaPrintToString(M, none, T, mixfix, none) [ owise ] .

    --- Reason texts for an unsupported statement
    op owiseReason : AttrSet -> String .
    eq owiseReason((owise ATS)) = " owise equation;" .
    eq owiseReason(ATS) = "" [ owise ] .

    op eqOpReason : Bool -> String .
    eq eqOpReason(B)
        = if B
          then " uses the built-in _==_ or _=/=_;"
          else ""
          fi .

    op condReason : Bool -> String .
    eq condReason(B)
        = if B
          then " condition other than t = t';"
          else ""
          fi .

    --- One line of the rejection message of set module
    op unsafeLine : String String String -> String .
    eq unsafeLine(KIND, NAME, STR)
        = if STR == ""
          then ""
          else "\n    - " + KIND + " " + NAME + ":" + substr(STR, 0, sd(length(STR), 1))
          fi .

    --- Statements that DM-Check cannot handle (empty if none)
    op unsafeStmts : Module -> String .
    eq unsafeStmts(M)
        = unsafeEqs(M, getEqs(M), unsafeOps(M)) + unsafeMbs(M, getMbs(M), unsafeOps(M))
          + unsafeRls(M, getRls(M), unsafeOps(M)) + unsafeIdem(idemOps(getOps(M)), "") .

    --- Unsupported equations
    op unsafeEqs : Module EquationSet QidSet -> String .
    eq unsafeEqs(M, EQS, QS) = unsafeEqs'(M, EQS, QS, "") .
    op unsafeEqs' : Module EquationSet QidSet String -> String .
    eq unsafeEqs'(M, (none).EquationSet, QS, STR) = STR .
    eq unsafeEqs'(M, (eq T = T' [ATS] .) EQS, QS, STR)
        = unsafeEqs'(M, EQS, QS, STR +
            unsafeLine("equation", stmtName(M, ATS, T),
                       owiseReason(ATS) + eqOpReason(usesOp((T, T'), QS)))) .
    eq unsafeEqs'(M, (ceq T = T' if COND [ATS] .) EQS, QS, STR)
        = unsafeEqs'(M, EQS, QS, STR +
            unsafeLine("equation", stmtName(M, ATS, T),
                       owiseReason(ATS)
                       + eqOpReason(usesOp((T, T'), QS) or usesOpC(COND, QS)))) .

    --- Memberships (unification ignores them)
    op unsafeMbs : Module MembAxSet QidSet -> String .
    eq unsafeMbs(M, MBS, QS) = unsafeMbs'(M, MBS, QS, "") .
    op unsafeMbs' : Module MembAxSet QidSet String -> String .
    eq unsafeMbs'(M, (none).MembAxSet, QS, STR) = STR .
    eq unsafeMbs'(M, (mb T : S [ATS] .) MBS, QS, STR)
        = unsafeMbs'(M, MBS, QS, STR +
            unsafeLine("membership", stmtName(M, ATS, T), " membership axiom;" + eqOpReason(usesOp(T, QS)))) .
    eq unsafeMbs'(M, (cmb T : S if COND [ATS] .) MBS, QS, STR)
        = unsafeMbs'(M, MBS, QS, STR +
            unsafeLine("membership", stmtName(M, ATS, T),
                       " membership axiom;" + eqOpReason(usesOp(T, QS) or usesOpC(COND, QS)))) .

    --- Unsupported rules
    op unsafeRls : Module RuleSet QidSet -> String .
    eq unsafeRls(M, RLS, QS) = unsafeRls'(M, RLS, QS, "") .
    op unsafeRls' : Module RuleSet QidSet String -> String .
    eq unsafeRls'(M, (none).RuleSet, QS, STR) = STR .
    eq unsafeRls'(M, (rl T => T' [ATS] .) RLS, QS, STR)
        = unsafeRls'(M, RLS, QS, STR +
            unsafeLine("rule", stmtName(M, ATS, T), eqOpReason(usesOp((T, T'), QS)))) .
    eq unsafeRls'(M, (crl T => T' if COND [ATS] .) RLS, QS, STR)
        = unsafeRls'(M, RLS, QS, STR +
            unsafeLine("rule", stmtName(M, ATS, T),
                       eqOpReason(usesOp((T, T'), QS) or usesOpC(COND, QS))
                       + condReason(nonEqCond(COND)))) .

    --- Operators with the idem attribute (no unification modulo idempotence)
    op idemOps : OpDeclSet -> QidSet .
    eq idemOps((op Q : TYL -> TY [idem ATS] .) OPS) = Q ; idemOps(OPS) .
    eq idemOps(OPS) = (none).QidSet [ owise ] .
    op unsafeIdem : QidSet String -> String .
    eq unsafeIdem((none).QidSet, STR) = STR .
    eq unsafeIdem((Q ; QS), STR)
        = unsafeIdem(QS, STR + unsafeLine("operator", string(Q), " idem attribute;")) .

    --- Check if a command writes the built-in equality
    op hasUnsafeToken : QidSet QidList -> Bool .
    eq hasUnsafeToken(QS, nil) = false .
    eq hasUnsafeToken(QS, Q QL) = opToken(QS, Q) or-else hasUnsafeToken(QS, QL) .

    --- Check if a token is one of the given operators, infix (==) or prefix (_==_)
    op opToken : QidSet Qid -> Bool .
    eq opToken((none).QidSet, Q) = false .
    eq opToken((Q' ; QS), Q)
        = (qid("_" + string(Q) + "_") == Q') or-else (Q == Q') or-else opToken(QS, Q) .

    --- Add a protecting import to a module
    op addImport : Module Qid -> Module .
    eq addImport(fmod H is IL sorts SS . SSDS OPDS MAS EQS endfm, Q')
        = fmod H is IL (protecting Q' .) sorts SS . SSDS OPDS MAS EQS endfm .
    eq addImport(mod H is IL sorts SS . SSDS OPDS MAS EQS RLS endm, Q')
        = mod H is IL (protecting Q' .) sorts SS . SSDS OPDS MAS EQS RLS endm .
    eq addImport(smod H is IL sorts SS . SSDS OPDS MAS EQS RLS STDS STDFS endsm, Q')
        = smod H is IL (protecting Q' .) sorts SS . SSDS OPDS MAS EQS RLS STDS STDFS endsm .
    eq addImport(fth Q is IL sorts SS . SSDS OPDS MAS EQS endfth, Q')
        = fth Q is IL (protecting Q' .) sorts SS . SSDS OPDS MAS EQS endfth .
    eq addImport(th Q is IL sorts SS . SSDS OPDS MAS EQS RLS endth, Q')
        = th Q is IL (protecting Q' .) sorts SS . SSDS OPDS MAS EQS RLS endth .
    eq addImport(sth H is IL sorts SS . SSDS OPDS MAS EQS RLS STDS STDFS endsth, Q')
        = sth H is IL (protecting Q' .) sorts SS . SSDS OPDS MAS EQS RLS STDS STDFS endsth .
    eq addImport(M, Q) = M [ owise ] .
endfm

load NuITP.maude

fmod DM-CHECK-PARSE is
    pr DM-CHECK-META .
    pr DM-CHECK-MODS .

    var M : Module .
    vars T T' : Term .
    var TL : TermList .
    var NTL : NeTermList .
    vars TS TS' : TermSet .
    var NEQL : NeQidList .
    var AT : Attr .
    var ATS : AttrSet .
    var F : Qid .

    --- Membership tests for attributes and subterms
    op _in_ : AttrSet AttrSet -> Bool .
    eq AT in AT ATS = true .
    eq AT in ATS = false [ owise ] .

    op _in_ : Term TermList -> Bool .
    eq T in T = true .
    eq T in F[NTL] = T in NTL .
    eq T in (T',NTL) = T in T' or-else T in NTL .
    eq T in TL = false [ owise ] .

    op _in_ : TermSet TermSet -> Bool .
    eq TS in (TS ;; TS') = true .
    eq TS in TS' = false [ owise ] .

    op _in_ : TermList TermSet -> Bool .
    eq empty in (TS) = true .
    eq (T,NTL) in TS = (T in TS) and-then (NTL in TS) .

    --- Parse a term (via NuITP)
    op parseTerm : Module NeTermList -> Term .
    eq parseTerm(M, NTL)
        = downTerm(getTerm(metaRewrite(upModule('NuITP-PARSE, false), 'parseTerm[upTerm(M), NTL], unbounded)),
                   'nil.QidList) .

    --- Parse variables (via NuITP)
    op parseVariables : Module NeTermList TermSet -> TermList .
    eq parseVariables(M, NTL, TS)
        = downTerm(getTerm(metaRewrite(upModule('NuITP-PARSE, false), 'parseVariables[upTerm(M), NTL, upTerm(TS)],
                                       unbounded)), 'nil.QidList) .

    --- Parse a generator set in the constructor signature (via NuITP)
    op parseGenSet : Module Term NeQidList -> TermSet .
    eq parseGenSet(M, T, NEQL)
        = downTerm(getTerm(metaRewrite(upModule('NuITP-PARSE, false),
                                       'parseGenSet[upTerm(setRls(M,none)), upTerm(getType(T)), upTerm(NEQL)],
                                       unbounded)), 'nil.QidList) .
endfm

mod DM-CHECK-SYNTAX is
    pr CONFIGURATION .
    pr NuITP-CLAUSE .
    pr DM-CHECK-PARSE .

    --- Proof states
    sort ProofState .
    ops sat unsat open : -> ProofState [ ctor ] .

    --- Matcher List
    sorts Matcher NeMatcherList MatcherList .
    subsort Matcher < NeMatcherList < MatcherList .

    --- A matcher: id, substitution, implication and its proof state
    op _,_,_,_ : Nat Substitution? Term ProofState -> Matcher .

    op noMatch : -> MatcherList .
    op _;_ : MatcherList MatcherList -> MatcherList [ ctor assoc id: noMatch ]  .
    op _;_ : NeMatcherList MatcherList -> NeMatcherList [ ditto ] .
    op _;_ : MatcherList NeMatcherList -> NeMatcherList [ ditto ] .

    --- Node types (initial/generated/subsumed)
    sort NodeType .
    ops iNode gNode sNode itNode : -> NodeType .

    --- Origin of the nodes
    sorts StepKind TraceDetail NodeOrigin .
    ops narrowingStep caseStep variableAbstractionStep substitutionStep
        splitStep variantUnificationStep generalizationStep
        auxiliaryNarrowingStep : -> StepKind [ctor] .
    op noDetail : -> TraceDetail [ctor] .
    op termDetail : Term -> TraceDetail [ctor] .
    op pairDetail : Term Term -> TraceDetail [ctor] .
    op rootOrigin : -> NodeOrigin [ctor] .

    --- State of the source node of a step and its origin
    op srcState : Term Term Substitution NodeOrigin -> NodeOrigin [ctor] .

    --- Origin of a step: source, kind, rule, substitutions, depth, data, matchers, previous origin
    op origin : Nat StepKind Qid Substitution Substitution Nat
                TraceDetail MatcherList NodeOrigin -> NodeOrigin [ctor] .

    op term:_ : Term -> Attribute [ ctor ] . --- Term related to the state
    op lterm:_ : Term -> Attribute [ ctor ] . --- Left term related to the state (Intersection node)
    op rterm:_ : Term -> Attribute [ ctor ] . --- Right term related to the state (Intersection node)
    op pid:_ : Nat -> Attribute [ ctor ] . --- Parent ID
    op ctr:_ : Term -> Attribute [ ctor ] . --- Constraint related to the state
    op type:_ : Type -> Attribute [ ctor ] . --- Narrowing step type
    op ctx:_ : Context -> Attribute [ ctor ] . --- Narrowing step context
    op rule:_ : Qid -> AttributeSet [ ctor ] . --- Applied rule
    op sub:_ : Substitution -> Attribute [ ctor ] . --- Narrowing step term substitution
    op lsub:_ : Substitution -> Attribute [ ctor ] . --- Left substitution related to the state (Intersection node)
    op rsub:_ : Substitution -> Attribute [ ctor ] . --- Right substitution related to the state (Intersection node)
    op rlsub:_ : Substitution -> Attribute [ ctor ] . --- Narrowing step rule substitution
    op acsub:_ : Substitution -> Attribute [ ctor ] . --- Accumulated substitution
    op match:_ : MatcherList -> Attribute [ ctor ] . --- Matcher list (folding)
    op ntype:_ : NodeType -> Attribute [ ctor ] . --- Node type
    op ndepth:_ : Nat -> Attribute [ ctor ] . --- Node depth
    op origin:_ : NodeOrigin -> Attribute [ ctor ] . --- Origin of the node
    op fold:_ : Bool -> Attribute [ ctor ] . --- Folded? (Meaning that a matcher was sat)

    sorts Node NeNodeList NodeList .
    subsort Node < NeNodeList < NodeList .
    op {_:_} : Nat AttributeSet -> Node [ ctor ] .

    op nil : -> NodeList [ ctor ] .
    op _;_ : NodeList NodeList -> NodeList [ assoc id: nil ] .
    op _;_ : NeNodeList NodeList -> NeNodeList [ ditto ] .
    op _;_ : NodeList NeNodeList -> NeNodeList [ ditto ] .

    op mod:_ : Module -> Attribute [ ctor ] .
    op prev:_ : NodeList -> Attribute [ ctor ] . --- Previous nodes
    op curr:_ : NodeList -> Attribute [ ctor ] . --- Current nodes
    op next:_ : NodeList -> Attribute [ ctor ] . --- Future nodes
    op init:_ : NodeList -> Attribute [ ctor ] . --- Initial nodes
    op init':_ : NodeList -> Attribute [ ctor ] . --- Initial nodes
    op inter:_ : NodeList -> Attribute [ ctor ] . --- Intersection nodes
    op depth:_ : Nat -> Attribute [ ctor ] . --- Max depth
    op cdepth:_ : Nat -> Attribute [ ctor ] . --- Current depth
    op vos:_ : VariantOptionSet -> Attribute [ ctor ] .
    op lemmas:_ : TermSet -> Attribute [ ctor ] .
    op idcount:_ : Nat -> Attribute [ ctor ] . --- ID counter
    op vcount:_ : Nat -> Attribute [ ctor ] . --- Variable counter

    --- State
    sort DMCState .
    op <_> : AttributeSet -> DMCState .
endm

mod DM-CHECK-OUTPUT is
    pr DM-CHECK-SYNTAX .

    sort ParentNode ParentNodeList .
    subsort ParentNode < ParentNodeList .

    op noParents : -> ParentNodeList .
    op _,_ : ParentNodeList ParentNodeList -> ParentNodeList [ ctor assoc id: noParents ] .
    op [_,_,_,_,_] : Nat Term Term Substitution Nat -> ParentNode [ ctor ] .
    op [_,_,_,_,_,_] : Nat Term Term Substitution Nat NodeOrigin -> ParentNode [ ctor ] . --- With origin

    sort ChildNode ChildNodeList .
    subsort ChildNode < ChildNodeList .

    op noChildren : -> ChildNodeList .
    op _,_ : ChildNodeList ChildNodeList -> ChildNodeList [ ctor assoc id: noChildren ] .
    op [_,_,_,_,_,_,_,_,_,_] : Nat Nat Term Term Qid Substitution Substitution MatcherList Nat NodeOrigin -> ChildNode
                               [ ctor ] . --- Check Invariant
    op [_,_,_,_,_,_,_] : Nat Term Term Substitution MatcherList Nat NodeOrigin -> ChildNode [ ctor ] . --- Check Subsumption
    op [_,_,_,_,_,_,_] : Nat Term Term Term Term Substitution Substitution -> ChildNode [ ctor ] . --- Check Intersection

    sort DMCOutput .
    op noSolution : -> DMCOutput [ ctor ] .
    op _||_ : ParentNodeList ChildNodeList -> DMCOutput [ ctor ] .

    --- Nodes whose narrowing steps or unifiers may be incomplete
    op incompleteNode : Qid Nat -> Node [ ctor ] .
    op incompleteResult : Qid String -> DMCOutput [ ctor ] .
    op incompleteChild : Qid String -> ChildNode [ ctor ] .
endm

mod DM-CHECK-CORE is
    pr DM-CHECK-OUTPUT .

    var M : Module .
    vars NODES NODES' NODES'' : NodeList .
    vars NENODES NENODES' : NeNodeList .
    vars NODE NODE' : Node .
    var NODE? : [Node] .
    vars ID ID' PID MID N IDCOUNT VCOUNT MCOUNT UCOUNT DEPTH : Nat .
    vars NL NL' : NatList .
    var QL : QidList .
    vars T T' T'' CTR CTR' : Term .
    vars LEMMAS TS : TermSet .
    var NELEMMAS : NeTermSet .
    vars TL TL' TL'' : TermList .
    var NTL : NeTermList .
    var VOS : VariantOptionSet .
    vars ACSB SB SB' SB'' MATCHER : Substitution .
    vars NATTRS NATTRS' : AttributeSet .
    var TP : Type .
    var CTX : Context .
    vars Q Q' F RL : Qid .
    vars MLIST MLIST' : MatcherList .
    var PROOF : ProofState .
    var UTRIPLE : UnificationTriple .
    var NAR : NarrowingApplyResult .
    vars ORIGIN ORIGIN' : NodeOrigin .
    var STEP : StepKind .
    var DETAIL : TraceDetail .
    var PARENTS : ParentNodeList .
    vars CHILDREN CHILDREN' : ChildNodeList .
    var CHILD : ChildNode .
    vars V V' : Variable .
    var C : Constant .
    var K : Kind .
    var S : Sort .
    var NAR? : NarrowingApplyResult? .
    var STR : String .
    var SB? : Substitution? .
    var PROOF? : [ProofState] .
    var UT? : UnificationTriple? .
    var OUTPUT : DMCOutput .

    --- NuITP could not process a formula
    op nuitpError : Term -> [ProofState] [ ctor ] .

    --- Get the proof state from the NuITP answer
    op nuitpState : ResultPair? Term -> [ProofState] .
    eq nuitpState({'true.Bool, TP}, CTR) = sat .
    eq nuitpState({'false.Bool, TP}, CTR) = unsat .
    eq nuitpState({T, K}, CTR) = nuitpError(CTR) .
    eq nuitpState({T, S}, CTR) = open [ owise ] .
    eq nuitpState((failure).ResultPair?, CTR) = nuitpError(CTR) .

    --- Check if a proof state is sat
    op isSat : ProofState -> Bool .
    eq isSat(sat) = true .
    eq isSat(unsat) = false .
    eq isSat(open) = false .

    --- Mark the generated obligations (not passed to NuITP)
    op markObl : TermSet -> TermSet .
    eq markObl(mt) = mt .
    eq markObl((T ;; TS)) = ('dmc$obl[T]) ;; markObl(TS) .

    --- Lemmas passed to NuITP (generated obligations excluded)
    op nuitpLemmas : TermSet -> TermSet .
    eq nuitpLemmas(mt) = mt .
    eq nuitpLemmas((('dmc$obl[T]) ;; TS)) = nuitpLemmas(TS) .
    eq nuitpLemmas((T ;; TS)) = T ;; nuitpLemmas(TS) [ owise ] .

    --- Call the theorem prover
    op callNuITP : Module Term TermSet -> ProofState .
    eq callNuITP(M, CTR, TS) = nuitpCall(M, CTR, nuitpLemmas(TS)) .
    op nuitpCall : Module Term TermSet -> ProofState [ memo ] .
    eq nuitpCall(M, CTR, mt)
        = nuitpState(metaRewrite(upModule('NuITP-EXT, false), 'metaNuITPCheck[upTerm(M), upTerm(CTR)], unbounded),
                     CTR) .
    eq nuitpCall(M, CTR, NELEMMAS)
        = nuitpState(metaRewrite(upModule('NuITP-EXT, false),
                                 'metaNuITPCheck[upTerm(M), upTerm(CTR), upTerm(NELEMMAS)], unbounded), CTR) .

    --- Count the nodes in a list
    op countNodes : NodeList -> Nat .
    eq countNodes(nil) = 0 .
    eq countNodes(NODE ; NODES) = s(countNodes(NODES)) .

    --- Count the children in a list
    op countChildren : ChildNodeList -> Nat .
    eq countChildren(noChildren) = 0 .
    eq countChildren(CHILD , CHILDREN) = s(countChildren(CHILDREN)) .

    --- Get the variables of children
    op getVars : ChildNodeList -> TermSet .
    eq getVars(noChildren) = mt .
    eq getVars([ ID, PID, T, CTR, RL, SB, ACSB, MLIST, DEPTH, ORIGIN ], CHILDREN)
        = getVars(T) ;; getVars(CTR) ;; getRangeVars(SB) ;;
          getRangeVars(ACSB) ;; getOriginVars(ORIGIN) ;; getVars(CHILDREN) .
    eq getVars([ ID, T, CTR, ACSB, MLIST, DEPTH, ORIGIN ], CHILDREN)
        = getVars(T) ;; getVars(CTR) ;; getRangeVars(ACSB) ;; getVars(CHILDREN) .

    --- Get the variables of a substitution (domain and range)
    op getSubstitutionVars : Substitution -> TermSet .
    eq getSubstitutionVars((none).Substitution) = mt .
    eq getSubstitutionVars(V <- T ; SB) = getVars(V) ;; getVars(T) ;; getSubstitutionVars(SB) .

    --- Get the variables of the origin of a node
    op getOriginVars : NodeOrigin -> TermSet .
    eq getOriginVars(rootOrigin) = mt .
    eq getOriginVars(srcState(T, CTR, ACSB, ORIGIN)) = getOriginVars(ORIGIN) .
    eq getOriginVars(origin(PID, STEP, RL, SB, ACSB, DEPTH,
                            DETAIL, MLIST, ORIGIN))
        = getSubstitutionVars(SB) ;; getSubstitutionVars(ACSB) ;;
          getDetailVars(DETAIL) ;; getMatcherVars(MLIST) ;;
          getOriginVars(ORIGIN) .

    --- Get the variables of a matcher list
    op getMatcherVars : MatcherList -> TermSet .
    eq getMatcherVars(noMatch) = mt .
    eq getMatcherVars((MID, MATCHER, CTR, PROOF) ; MLIST)
        = getSubstitutionVars(MATCHER) ;; getVars(CTR) ;;
          getMatcherVars(MLIST) .

    --- Get the variables of the data of a step
    op getDetailVars : TraceDetail -> TermSet .
    eq getDetailVars(noDetail) = mt .
    eq getDetailVars(termDetail(T)) = getVars(T) .
    eq getDetailVars(pairDetail(T, T')) = getVars((T, T')) .

    --- Count the variables in a list of nodes
    op countNodeVars : NodeList -> Nat .
    eq countNodeVars(nil) = 0 .
    eq countNodeVars({ID : term: T, acsub: ACSB, ctr: CTR, origin: ORIGIN, NATTRS} ; NODES)
        = countVars(disjunctVars(getVars((T, CTR)) ;; getRangeVars(ACSB) ;;
                                getOriginVars(ORIGIN))) + countNodeVars(NODES) .
    eq countNodeVars({ID : term: T, acsub: ACSB, ctr: CTR, NATTRS} ; NODES)
        = countVars(disjunctVars(getVars((T, CTR)) ;; getRangeVars(ACSB))) + countNodeVars(NODES) [owise] .

    --- Get the variables of the substitution of a trace node
    op traceNodeSubVars : Node -> TermSet .
    eq traceNodeSubVars({ID : sub: SB, NATTRS}) = getSubstitutionVars(SB) .
    eq traceNodeSubVars(NODE) = mt [owise] .

    --- Get the variables of the origin of a trace node
    op traceNodeOriginVars : Node -> TermSet .
    eq traceNodeOriginVars({ID : origin: ORIGIN, NATTRS}) = getOriginVars(ORIGIN) .
    eq traceNodeOriginVars(NODE) = mt [owise] .

    --- Get the variables of a trace node
    op traceNodeVars : Node -> TermSet .
    eq traceNodeVars({ID : term: T, ctr: CTR, acsub: ACSB, NATTRS})
        = getVars((T, CTR)) ;; getSubstitutionVars(ACSB) ;;
          traceNodeSubVars({ID : term: T, ctr: CTR, acsub: ACSB, NATTRS}) ;;
          traceNodeOriginVars({ID : term: T, ctr: CTR, acsub: ACSB, NATTRS}) .

    op traceNodeVars : NodeList -> TermSet .
    eq traceNodeVars(nil) = mt .
    eq traceNodeVars(NODE ; NODES) = traceNodeVars(NODE) ;; traceNodeVars(NODES) .

    --- Index n of a variable named $n (0 for any other name)
    op dollarIdx : Qid -> Nat .
    ceq dollarIdx(Q) = N
    if substr(string(Q), 0, 1) == "$"
    /\ N := rat(substr(string(Q), 1, length(string(Q))), 10) .
    eq dollarIdx(Q) = 0 [ owise ] .

    --- Largest $n index in a set of variables
    op maxTraceVarIndex : TermSet Nat -> Nat .
    eq maxTraceVarIndex(mt, N) = N .
    eq maxTraceVarIndex(V ;; TS, N)
        = if substr(string(getName(V)), 0, 1) == "$"
          then if dollarIdx(getName(V)) > N
               then maxTraceVarIndex(TS, dollarIdx(getName(V)))
               else maxTraceVarIndex(TS, N)
               fi
          else maxTraceVarIndex(TS, N)
          fi .

    --- Next free $n index for a list of trace nodes
    op nextTraceVarIndex : NodeList -> Nat .
    eq nextTraceVarIndex(NODES) = s(maxTraceVarIndex(disjunctVars(traceNodeVars(NODES)), 0)) .

    --- Check constraints for a list of nodes. Remove a node if its constraint is proved unsatisfiable
    op checkConstraints : Module NodeList TermSet -> NodeList .
    eq checkConstraints(M, nil, LEMMAS) = nil .
    eq checkConstraints(M, {ID : ctr: 'true.NuITP-Bool, NATTRS} ; NODES, LEMMAS)
        = {ID : ctr: 'true.NuITP-Bool, NATTRS} ; checkConstraints(M, NODES, LEMMAS) .
    eq checkConstraints(M, {ID : ctr: 'false.NuITP-Bool, NATTRS} ; NODES, LEMMAS)
        = checkConstraints(M, NODES, LEMMAS) .
    eq checkConstraints(M, {ID : ctr: CTR, NATTRS} ; NODES, LEMMAS)
        = if isSat(callNuITP(M, '_->_[CTR,'false.NuITP-Bool], LEMMAS))
          then checkConstraints(M, NODES, LEMMAS)
          else {ID : ctr: CTR, NATTRS} ; checkConstraints(M, NODES, LEMMAS)
          fi [ owise ] .

    --- Convert initial term pairs into nodes
    op initNodes : Module TermList Nat Nat -> NodeList .
    eq initNodes(M, empty, IDCOUNT, VCOUNT) = nil .
    eq initNodes(M, ('_|_[T, CTR], TL), IDCOUNT, VCOUNT)
        = {IDCOUNT : term: applySub(T, rename(getVars((T, CTR)), VCOUNT)),
           ctr: applySub(CTR, rename(getVars((T, CTR)), VCOUNT)),
           acsub: rename(getVars((T, CTR)), VCOUNT), ndepth: 0, ntype: iNode} ;
           initNodes(M, TL, s(IDCOUNT), VCOUNT + countVars(getVars((T, CTR)))) .

    --- Convert initial term pairs into nodes (left part of check subsumed by)
    op initNodes' : Module TermList Nat Nat -> NodeList .
    eq initNodes'(M, empty, IDCOUNT, VCOUNT) = nil .
    eq initNodes'(M, ('_|_[T, CTR], TL), IDCOUNT, VCOUNT)
        = {IDCOUNT : term: applySub(T, rename(getVars((T, CTR)), VCOUNT)),
           ctr: applySub(CTR, rename(getVars((T, CTR)), VCOUNT)),
           acsub: rename(getVars((T, CTR)), VCOUNT), ndepth: 0, ntype: sNode,
           match: noMatch, fold: false} ;
           initNodes'(M, TL, s(IDCOUNT), VCOUNT + countVars(getVars((T, CTR)))) .

    --- Convert initial term pairs into nodes (left and right parts of intersect)
    op initIntNodes : Module TermList Nat Nat -> NodeList .
    eq initIntNodes(M, empty, IDCOUNT, VCOUNT) = nil .
    eq initIntNodes(M, ('_|_[T, CTR], TL), IDCOUNT, VCOUNT)
        = {IDCOUNT : term: applySub(T, rename(getVars((T, CTR)), VCOUNT)),
           ctr: applySub(CTR, rename(getVars((T, CTR)), VCOUNT)),
           acsub: none, ndepth: 0, ntype: iNode} ;
           initIntNodes(M, TL, s(IDCOUNT), VCOUNT + countVars(getVars((T, CTR)))) .

    --- Deploy the children of a list of nodes
    op deployChildren : Module VariantOptionSet NodeList Nat -> NodeList .
    eq deployChildren(M, VOS, nil, IDCOUNT) = nil .
    eq deployChildren(M, VOS, NODES, IDCOUNT)
        = genIDs(deployChildren'(M, VOS, NODES), IDCOUNT) .

    op deployChildren' : Module VariantOptionSet NodeList -> NodeList .
    eq deployChildren'(M, VOS, nil) = nil .
    eq deployChildren'(M, VOS, ({ID : ndepth: 0, NATTRS} ; NODES))
        = deployNode(M, VOS, {ID : ndepth: 0, NATTRS}, 0) ; deployChildren'(M, VOS, NODES) .
    eq deployChildren'(M, VOS, ({ID : fold: true, NATTRS} ; NODES))
        = deployChildren'(M, VOS, NODES) .
    eq deployChildren'(M, VOS, ({ID : fold: false, NATTRS} ; NODES))
        = deployNode(M, VOS, {ID : fold: false, NATTRS}, 0) ; deployChildren'(M, VOS, NODES) [owise] .

    op deployNode : Module VariantOptionSet Node Nat -> NodeList .

    --- Reject a node whose term is a variable
    eq deployNode(M, VOS, {ID : term: V, NATTRS}, N) = incompleteNode('varterm, ID) .
    eq deployNode(M, VOS, {ID : term: T, ctr: CTR, acsub: ACSB, ndepth: DEPTH, NATTRS}, N)
        = deployNode'(M, VOS, {ID : term: T, ctr: CTR, acsub: ACSB, ndepth: DEPTH, NATTRS}, N,
                            metaNarrowingApply(M, T, empty, '@, VOS, N)) [owise] .

    --- Build the children from the narrowing steps of a node
    op deployNode' : Module VariantOptionSet Node Nat NarrowingApplyResult? -> NodeList .
    eq deployNode'(M, VOS, {ID : term: T, ctr: CTR, acsub: ACSB, ndepth: DEPTH, NATTRS}, N, NAR)
        = buildNode(M, NAR, ID, CTR, ACSB, s(DEPTH),
                    getNodeOrigin({ID : term: T, ctr: CTR, acsub: ACSB,
                                   ndepth: DEPTH, NATTRS})) ;
          deployNode(M, VOS, {ID : term: T, ctr: CTR, acsub: ACSB, ndepth: DEPTH, NATTRS}, s(N)) .
    eq deployNode'(M, VOS, {ID : NATTRS}, N, (failureIncomplete).NarrowingApplyResult?)
        = incompleteNode('narrowing, ID) .
    eq deployNode'(M, VOS, NODE, N, NAR?) = nil [owise] .

    --- Check if some generated node is incomplete
    op hasIncomplete : NodeList -> Bool .
    eq hasIncomplete(NODES ; incompleteNode(Q, ID) ; NODES') = true .
    eq hasIncomplete(NODES) = false [owise] .

    --- Kind of the first incomplete node
    op incompleteKind : NodeList -> Qid .
    eq incompleteKind(NODES ; incompleteNode(Q, ID) ; NODES') = Q .

    --- Ids of the incomplete nodes, without repetitions
    op incompleteIds : NodeList -> String .
    eq incompleteIds(NODES) = incompleteIds'(NODES, nil, "") .
    op incompleteIds' : NodeList NodeList String -> String .
    eq incompleteIds'(nil, NODES', STR) = STR .
    eq incompleteIds'(incompleteNode(Q, ID) ; NODES, NODES', STR)
        = if incompleteSeen(ID, NODES')
          then incompleteIds'(NODES, NODES', STR)
          else incompleteIds'(NODES, NODES' ; incompleteNode(Q, ID),
                              if STR == "" then string(ID, 10) else STR + ", " + string(ID, 10) fi)
          fi .
    eq incompleteIds'(NODE ; NODES, NODES', STR) = incompleteIds'(NODES, NODES', STR) [owise] .

    --- Check if an incomplete node is already listed
    op incompleteSeen : Nat NodeList -> Bool .
    eq incompleteSeen(ID, NODES ; incompleteNode(Q, ID) ; NODES') = true .
    eq incompleteSeen(ID, NODES) = false [owise] .

    --- Incomplete nodes of a given kind
    op kindNodes : Qid NodeList -> NodeList .
    eq kindNodes(Q, nil) = nil .
    eq kindNodes(Q, incompleteNode(Q, ID) ; NODES) = incompleteNode(Q, ID) ; kindNodes(Q, NODES) .
    eq kindNodes(Q, NODE ; NODES) = kindNodes(Q, NODES) [owise] .

    --- Generate new IDs for nodes starting from a number
    op genIDs : NodeList Nat -> NodeList .
    eq genIDs(nil, N) = nil .
    eq genIDs((incompleteNode(Q, ID) ; NODES), N) = incompleteNode(Q, ID) ; genIDs(NODES, N) .
    eq genIDs(({ID : NATTRS} ; NODES), N) = {N : NATTRS} ; genIDs(NODES, s(N)) .

    --- Origin given to a step applied to a node
    op getNodeOrigin : Node -> NodeOrigin .
    eq getNodeOrigin({ID : term: T, ctr: CTR, acsub: ACSB, origin: ORIGIN, NATTRS})
        = srcState(T, CTR, ACSB, ORIGIN) .
    eq getNodeOrigin({ID : term: T, ctr: CTR, acsub: ACSB, NATTRS})
        = srcState(T, CTR, ACSB, rootOrigin) [owise] .

    --- Build a new node coming from a narrowing step
    op buildNode : Module NarrowingApplyResult Nat Term Substitution Nat NodeOrigin -> Node .
    eq buildNode(M, {('_dmc>_[CTR, T]), TP, CTX, Q, SB, SB', Q'}, ID, CTR', ACSB,
                 DEPTH, ORIGIN)
        = {0 : pid: ID, term: T, ctr: simpCtr('_/\_[applySub(CTR', SB), buildCtr(CTR)]), type: TP, ctx: CTX, rule: Q,
           sub: SB, rlsub: SB', acsub: applySub(ACSB, SB),
           origin: origin(ID, narrowingStep, Q, SB, applySub(ACSB, SB), DEPTH,
                          noDetail, noMatch, ORIGIN),
           match: noMatch, ndepth: DEPTH, ntype: gNode, fold: false} .

    --- Move the condition of a rule applied below the root to the constraint
    ceq buildNode(M, {T, TP, CTX, Q, SB, SB', Q'}, ID, CTR, ACSB, DEPTH, ORIGIN)
        = {0 : pid: ID, term: getTerm(metaReduce(M, dmcTerm(T))),
           ctr: simpCtr('_/\_[applySub(CTR, SB), buildCtr(NTL)]), type: TP, ctx: CTX, rule: Q,
           sub: SB, rlsub: SB', acsub: applySub(ACSB, SB),
           origin: origin(ID, narrowingStep, Q, SB, applySub(ACSB, SB), DEPTH,
                          noDetail, noMatch, ORIGIN),
           match: noMatch, ndepth: DEPTH, ntype: gNode, fold: false}
    if not dmcAtTop(T) /\ NTL := dmcConds(T) .
    eq buildNode(M, {T, TP, CTX, Q, SB, SB', Q'}, ID, CTR, ACSB, DEPTH, ORIGIN)
        = {0 : pid: ID, term: T, ctr: applySub(CTR, SB), type: TP, ctx: CTX, rule: Q,
           sub: SB, rlsub: SB', acsub: applySub(ACSB, SB),
           origin: origin(ID, narrowingStep, Q, SB, applySub(ACSB, SB), DEPTH,
                          noDetail, noMatch, ORIGIN),
           match: noMatch, ndepth: DEPTH, ntype: gNode, fold: false} [owise] .

    --- Build a constraint coming from a conditional step
    op buildCtr : TermList -> TermList .
    eq buildCtr('_dmc/\_[TL, TL']) = '_/\_[buildCtr(TL), buildCtr(TL')] .
    eq buildCtr('_dmc=_[TL, TL']) = '_=_[TL, TL'] .
    eq buildCtr((TL, TL')) = (buildCtr(TL), buildCtr(TL')) .
    eq buildCtr(T) = T [owise] .

    --- Check if a term has a rule condition (C dmc> R) at the top
    op dmcAtTop : Term -> Bool .
    eq dmcAtTop('_dmc>_[CTR, T]) = true .
    eq dmcAtTop(T) = false [owise] .

    --- Get the conditions left by conditional rules in a term
    op dmcConds : NeTermList -> TermList .
    eq dmcConds('_dmc>_[CTR, T]) = (CTR, dmcConds(T)) .
    eq dmcConds(F[NTL]) = dmcConds(NTL) [owise] .
    eq dmcConds((T, NTL)) = (dmcConds(T), dmcConds(NTL)) .
    eq dmcConds(C) = empty .
    eq dmcConds(V) = empty .

    --- Remove the condition wrappers of a term
    op dmcTerm : Term -> Term .
    op dmcTerm : NeTermList -> NeTermList .
    eq dmcTerm('_dmc>_[CTR, T]) = dmcTerm(T) .
    eq dmcTerm(F[NTL]) = F[dmcTerm(NTL)] [owise] .
    eq dmcTerm((T, NTL)) = (dmcTerm(T), dmcTerm(NTL)) .
    eq dmcTerm(C) = C .
    eq dmcTerm(V) = V .

    --- Build a new intersection node coming from unifying two nodes
    op buildIntersectionNode : Term Term Term Term UnificationTriple -> Node .
    eq buildIntersectionNode(T, T', CTR, CTR', UTRIPLE)
        = {0 : lterm: T, rterm: T', lsub: getLhsSubstitution(UTRIPLE), rsub: getRhsSubstitution(UTRIPLE),
           ntype: itNode,
           ctr: simpCtr('_/\_[applySub(CTR, getLhsSubstitution(UTRIPLE)),
                              applySub(CTR', getRhsSubstitution(UTRIPLE))])} .

    --- Rename the variables in a list of nodes
    op renameOrigin : NodeOrigin Substitution -> NodeOrigin .
    eq renameOrigin(rootOrigin, SB') = rootOrigin .

    --- Rename the variables introduced by a step, not those of its source
    eq renameOrigin(origin(PID, STEP, RL, SB, ACSB, DEPTH,
                           DETAIL, MLIST, srcState(T, CTR, SB'', ORIGIN)), SB')
        = origin(PID, STEP, RL, renameDom(applySub(SB, SB'), dropVars(SB', getVars((T, CTR)))), applySub(ACSB, SB'),
                 DEPTH, applySubToDetail(DETAIL, dropVars(SB', getVars((T, CTR)))),
                 applySubToMatchers(MLIST, SB'), srcState(T, CTR, SB'', ORIGIN)) .
    eq renameOrigin(origin(PID, STEP, RL, SB, ACSB, DEPTH,
                           DETAIL, MLIST, ORIGIN), SB')
        = origin(PID, STEP, RL, applySub(SB, SB'), applySub(ACSB, SB'),
                 DEPTH, DETAIL, applySubToMatchers(MLIST, SB'), ORIGIN) [owise] .

    --- Rename the variables bound by a step that are new in the node
    op renameDom : Substitution Substitution -> Substitution .
    eq renameDom((none).Substitution, SB) = none .
    eq renameDom(((V <- T) ; SB), SB') = (renameVar(V, SB') <- T) ; renameDom(SB, SB') .
    op renameVar : Variable Substitution -> Variable .
    eq renameVar(V, ((V <- V') ; SB)) = V' .
    eq renameVar(V, SB) = V [ owise ] .

    --- Drop the bindings of the variables in a set
    op dropVars : Substitution TermSet -> Substitution .
    eq dropVars((none).Substitution, TS) = none .
    eq dropVars(((V <- T) ; SB), TS)
        = (if V in TS then none else (V <- T) fi) ;
          dropVars(SB, TS) .

    --- Apply a substitution to the data of a step
    op applySubToDetail : TraceDetail Substitution -> TraceDetail .
    eq applySubToDetail(noDetail, SB') = noDetail .
    eq applySubToDetail(termDetail(T), SB') = termDetail(applySub(T, SB')) .
    eq applySubToDetail(pairDetail(T, T'), SB') = pairDetail(applySub(T, SB'), applySub(T', SB')) .

    --- Apply a substitution to a matcher list
    op applySubToMatchers : MatcherList Substitution -> MatcherList .
    eq applySubToMatchers(noMatch, SB') = noMatch .
    eq applySubToMatchers((MID, MATCHER, CTR, PROOF) ; MLIST, SB')
        = (MID, applySub(MATCHER, SB'), applySub(CTR, SB'), PROOF) ;
          applySubToMatchers(MLIST, SB') .

    --- Store the matchers in the last step of an origin
    op setOriginMatchers : NodeOrigin MatcherList -> NodeOrigin .
    eq setOriginMatchers(rootOrigin, MLIST) = rootOrigin .
    eq setOriginMatchers(origin(PID, STEP, RL, SB, ACSB, DEPTH,
                                DETAIL, MLIST', ORIGIN), MLIST)
        = origin(PID, STEP, RL, SB, ACSB, DEPTH, DETAIL, MLIST, ORIGIN) .

    --- Rename the origin among the attributes of a node
    op renameOriginInAttrs : AttributeSet Substitution -> AttributeSet .
    eq renameOriginInAttrs((origin: ORIGIN, NATTRS), SB')
        = origin: renameOrigin(ORIGIN, SB'), NATTRS .
    eq renameOriginInAttrs(NATTRS, SB') = NATTRS [owise] .

    --- Rename the variables of a list of nodes to fresh $n
    op renameNodes : NodeList Nat -> NodeList .
    eq renameNodes(nil, VCOUNT) = nil .
    ceq renameNodes({ID : term: T, ctr: CTR, sub: SB, acsub: ACSB, NATTRS} ;
                     NODES, VCOUNT)
        = {ID : term: applySub(T, MATCHER),
               ctr: applySub(CTR, MATCHER),
               sub: applySub(SB, MATCHER),
               acsub: applySub(ACSB, MATCHER),
               renameOriginInAttrs(NATTRS, MATCHER)} ;
          renameNodes(NODES, VCOUNT + countVars(TS))
    if TS := disjunctVars(getVars((T, CTR)) ;; getRangeVars(SB) ;;
                          getRangeVars(ACSB)) /\
       MATCHER := rename(TS, VCOUNT) .
    ceq renameNodes({ID : term: T, ctr: CTR, acsub: ACSB, NATTRS} ;
                     NODES, VCOUNT)
        = {ID : term: applySub(T, MATCHER),
               ctr: applySub(CTR, MATCHER),
               acsub: applySub(ACSB, MATCHER),
               renameOriginInAttrs(NATTRS, MATCHER)} ;
          renameNodes(NODES, VCOUNT + countVars(TS))
    if TS := disjunctVars(getVars((T, CTR)) ;; getRangeVars(ACSB)) /\
       MATCHER := rename(TS, VCOUNT) [owise] .

    --- Check if a group of states is subsumed by others
    op checkSubsumption : Module NodeList NodeList VariantOptionSet TermSet -> NodeList .
    eq checkSubsumption(M, nil, NODES, VOS, LEMMAS) = nil .
    eq checkSubsumption(M, NODES, nil, VOS, LEMMAS) = NODES .
    eq checkSubsumption(M, NENODES, NENODES', VOS, LEMMAS)
        = checkSubsumption'(M, checkChildrenSubsumption(M, NENODES, NENODES, VOS, LEMMAS), NENODES', VOS, LEMMAS) .

    op checkSubsumption' : Module NodeList NodeList VariantOptionSet TermSet -> NodeList .
    eq checkSubsumption'(M, nil, NENODES, VOS, LEMMAS) = nil .
    eq checkSubsumption'(M, ({ID : fold: true, NATTRS} ; NODES), NENODES, VOS, LEMMAS)
        = {ID : fold: true, NATTRS} ; checkSubsumption'(M, NODES, NENODES, VOS, LEMMAS) .
    eq checkSubsumption'(M, (NODE ; NODES), NENODES, VOS, LEMMAS)
        = checkNodeSubsumption(M, NODE, NENODES, VOS, LEMMAS, 0) ;
          checkSubsumption'(M, NODES, NENODES, VOS, LEMMAS) [ owise ] .

    --- Check the subsumption of the children of a level
    op checkChildrenSubsumption : Module NodeList NodeList VariantOptionSet TermSet -> NodeList .
    eq checkChildrenSubsumption(M, nil, NENODES, VOS, LEMMAS) = nil .
    ceq checkChildrenSubsumption(M, (NODE ; NODES), (NODES' ; NODE ; NODES''), VOS, LEMMAS)
        = if isFolded(NODE?)
          then
            NODE? ; checkChildrenSubsumption(M, NODES, (NODES' ; NODES''), VOS, LEMMAS)
          else
            NODE? ; checkChildrenSubsumption(M, NODES, (NODES' ; NODE ; NODES''), VOS, LEMMAS)
          fi
    if NODE? := checkNodeSubsumption(M, NODE, (NODES' ; NODES''), VOS, LEMMAS, 0) .

    --- Check if a state is subsumed by others
    op checkNodeSubsumption : Module Node NodeList VariantOptionSet TermSet Nat -> Node .
    eq checkNodeSubsumption(M, NODE, nil, VOS, LEMMAS, MCOUNT) = NODE .
    ceq checkNodeSubsumption(M, {ID : term: T, ctr: CTR, match: MLIST, NATTRS},
                             ({ID' : term: T', ctr: CTR', NATTRS'} ; NODES), VOS, LEMMAS, MCOUNT)
        = checkNodeSubsumption'(M,
                                {ID : term: T, ctr: CTR,
                                 match: (MLIST ;
                                         matcherOf(M, ID', MATCHER, '_->_[CTR,applySub(CTR', MATCHER)],
                                                   callNuITP(M, '_->_[CTR,applySub(CTR', MATCHER)], LEMMAS))),
                                 NATTRS}, ({ID' : term: T', ctr: CTR', NATTRS'} ; NODES), VOS, LEMMAS, MCOUNT)
    if MATCHER := metaVariantMatch(M, T' <=? T, empty, '@, VOS, MCOUNT) .
    eq checkNodeSubsumption(M, {ID : term: T, ctr: CTR, match: MLIST, NATTRS},
                            ({ID' : term: T', ctr: CTR', NATTRS'} ; NODES), VOS, LEMMAS, MCOUNT)
        = checkNodeSubsumption(M, {ID : term: T, ctr: CTR, match: MLIST, NATTRS}, NODES, VOS, LEMMAS, 0) [ owise ] .

    op checkNodeSubsumption' : Module Node NodeList VariantOptionSet TermSet Nat -> Node .
    eq checkNodeSubsumption'(M, {ID : match: (MLIST ; (ID', SB, CTR, sat)), fold: false, NATTRS}, NODES, VOS, LEMMAS,
                             MCOUNT)
        = {ID : match: (MLIST ; (ID', SB, CTR, sat)), fold: true, NATTRS} .
    eq checkNodeSubsumption'(M, NODE, NODES, VOS, LEMMAS, MCOUNT)
        = checkNodeSubsumption(M, NODE, NODES, VOS, LEMMAS, s(MCOUNT)) [owise] .

    --- Build a matcher (the implication is normalized only if it is not proved)
    op matcherOf : Module Nat Substitution? Term [ProofState] -> [Matcher] .
    eq matcherOf(M, MID, SB?, CTR, sat) = (MID, SB?, CTR, sat) .
    eq matcherOf(M, MID, SB?, CTR, PROOF?)
        = (MID, SB?, getTerm(metaRewrite(noRlsExt(M), CTR, unbounded)), PROOF?) [ owise ] .

    --- Check if a node was folded
    op isFolded : Node -> Bool .
    eq isFolded({ID : fold: true, NATTRS}) = true .
    eq isFolded({ID : fold: false, NATTRS}) = false .
    eq isFolded(NODE) = false [owise] .

    --- Intersect two lists of nodes
    op intersectLists : Module NodeList NodeList VariantOptionSet Nat -> NodeList .
    eq intersectLists(M, nil, NODES', VOS, IDCOUNT) = nil .
    eq intersectLists(M, NODES, nil, VOS, IDCOUNT) = nil .
    eq intersectLists(M, NENODES, NENODES', VOS, IDCOUNT)
        =  genIDs(intersectLists'(M, NENODES, NENODES', VOS), IDCOUNT) .

    op intersectLists' : Module NodeList NodeList VariantOptionSet -> NodeList .
    eq intersectLists'(M, nil, NODES, VOS) = nil .
    eq intersectLists'(M, (NODE ; NODES), NENODES, VOS)
        = intersectNodeLists(M, NODE, NENODES, VOS) ; intersectLists'(M, NODES, NENODES, VOS) .

    --- Intersect a node with a list of nodes
    op intersectNodeLists : Module Node NodeList VariantOptionSet -> NodeList .
    eq intersectNodeLists(M, NODE, nil, VOS) = nil .
    eq intersectNodeLists(M, NODE, (NODE' ; NODES), VOS)
        = intersect(M, NODE, NODE', VOS, 0) ; intersectNodeLists(M, NODE, NODES, VOS)   .

    --- Get the intersection nodes between two nodes
    op intersect : Module Node Node VariantOptionSet Nat -> NodeList .
    eq intersect(M, {ID : term: T, ctr: CTR, NATTRS}, {ID' : term: T', ctr: CTR', NATTRS'}, VOS, UCOUNT)
        = intersect'(M, {ID : term: T, ctr: CTR, NATTRS}, {ID' : term: T', ctr: CTR', NATTRS'}, VOS, UCOUNT,
                     metaVariantDisjointUnify(M, T =? T', empty, '@, VOS, UCOUNT)) .

    --- Mark both nodes if unification may be incomplete
    op intersect' : Module Node Node VariantOptionSet Nat UnificationTriple? -> NodeList .
    eq intersect'(M, {ID : term: T, ctr: CTR, NATTRS}, {ID' : term: T', ctr: CTR', NATTRS'}, VOS, UCOUNT, UTRIPLE)
        = buildIntersectionNode(T, T', CTR, CTR', UTRIPLE) ;
          intersect(M, {ID : term: T, ctr: CTR, NATTRS}, {ID' : term: T', ctr: CTR', NATTRS'}, VOS, s(UCOUNT)) .
    eq intersect'(M, {ID : NATTRS}, {ID' : NATTRS'}, VOS, UCOUNT, (noUnifierIncomplete).UnificationTriple?)
        = incompleteNode('intersection, ID) ; incompleteNode('intersection, ID') .
    eq intersect'(M, NODE, NODE', VOS, UCOUNT, UT?) = nil [owise] .

    --- Rebuild parents using a ParentNodeList output
    op rebuildParents : ParentNodeList -> NodeList .
    eq rebuildParents(noParents) = nil .
    eq rebuildParents([ ID, T, CTR, ACSB, 0 ], PARENTS)
        = {ID : term: T, ctr: CTR, acsub: ACSB, ndepth: 0, ntype: iNode} ; rebuildParents(PARENTS) .
    eq rebuildParents([ ID, T, CTR, ACSB, 0, ORIGIN ], PARENTS)
        = {ID : term: T, ctr: CTR, acsub: ACSB, origin: ORIGIN,
           ndepth: 0, ntype: iNode} ; rebuildParents(PARENTS) .

    --- Rebuild children using a ChildNodeList output
    op rebuildChildren : ChildNodeList -> NodeList .
    eq rebuildChildren(noChildren) = nil .
    eq rebuildChildren([ ID, PID, T, CTR, RL, SB, ACSB, MLIST, DEPTH, ORIGIN ], CHILDREN)
        = {ID : pid: PID, term: T, ctr: CTR, rule: RL, sub: SB, acsub: ACSB,
           origin: ORIGIN, match: noMatch, ndepth: DEPTH, ntype: gNode,
           fold: false} ; rebuildChildren(CHILDREN) .
    eq rebuildChildren([ ID, T, CTR, ACSB, MLIST, DEPTH, ORIGIN ], CHILDREN)
        = {ID : term: T, ctr: CTR, acsub: ACSB, origin: ORIGIN, match: noMatch, ndepth: DEPTH, ntype: sNode,
           fold: false} ; rebuildChildren(CHILDREN) .

    --- Children kept by generalize, without their matchers to the generalized children
    op keepChildren : ChildNodeList NatList -> NodeList .
    eq keepChildren(noChildren, NL) = nil .
    eq keepChildren(([ ID, PID, T, CTR, RL, SB, ACSB, MLIST, DEPTH, ORIGIN ], CHILDREN), NL)
        = {ID : pid: PID, term: T, ctr: CTR, rule: RL, sub: SB, acsub: ACSB,
           origin: ORIGIN, match: dropTargets(MLIST, NL), ndepth: DEPTH, ntype: gNode,
           fold: false} ; keepChildren(CHILDREN, NL) .
    eq keepChildren(([ ID, T, CTR, ACSB, MLIST, DEPTH, ORIGIN ], CHILDREN), NL)
        = {ID : term: T, ctr: CTR, acsub: ACSB, origin: ORIGIN, match: dropTargets(MLIST, NL), ndepth: DEPTH,
           ntype: sNode, fold: false} ; keepChildren(CHILDREN, NL) .

    --- Apply a substitution to a node, with a new id
    op applySubToNode : Module Node Substitution Nat -> Node .
    eq applySubToNode(M, {ID : term: T, ctr: CTR, sub: SB, acsub: ACSB, NATTRS}, SB', IDCOUNT)
        = {IDCOUNT :
           term: getTerm(metaReduce(M, applySub(T, SB'))),
           ctr: reduceCtr(M, getTerm(metaReduce(M, applySub(CTR, SB')))),
           sub: reduceSub(M, applySub(SB, SB')),
           acsub: reduceSub(M, applySub(ACSB, SB')),
           NATTRS} .
    eq applySubToNode(M, {ID : term: T, ctr: CTR, acsub: SB, NATTRS}, SB', IDCOUNT)
        = {IDCOUNT :
           term: getTerm(metaReduce(M, applySub(T, SB'))),
           ctr: reduceCtr(M, applySub(CTR, SB')),
           acsub: reduceSub(M, applySub(SB, SB')), NATTRS} [owise] .

    --- Record a step in the origin of a node
    op setNodeOrigin : Node Nat StepKind Qid Substitution Nat
                       TraceDetail NodeOrigin -> Node .
    eq setNodeOrigin(
         {ID : pid: ID', term: T, ctr: CTR, rule: Q', sub: SB', acsub: ACSB,
               origin: ORIGIN', NATTRS},
         PID, STEP, RL, SB, DEPTH, DETAIL, ORIGIN)
        = {ID : pid: PID, term: T, ctr: CTR, rule: RL, sub: SB, acsub: ACSB,
                origin: origin(PID, STEP, RL, SB, ACSB, DEPTH,
                               DETAIL, noMatch, ORIGIN),
                NATTRS} .

    --- Subsumption nodes only record the step
    eq setNodeOrigin({ID : ntype: sNode, acsub: ACSB, origin: ORIGIN', NATTRS},
                     PID, STEP, RL, SB, DEPTH, DETAIL, ORIGIN)
        = {ID : ntype: sNode, acsub: ACSB,
                origin: origin(PID, STEP, RL, SB, ACSB, DEPTH, DETAIL, noMatch, ORIGIN),
                NATTRS} .
    eq setNodeOrigin({ID : ntype: sNode, acsub: ACSB, NATTRS},
                     PID, STEP, RL, SB, DEPTH, DETAIL, ORIGIN)
        = {ID : ntype: sNode, acsub: ACSB,
                origin: origin(PID, STEP, RL, SB, ACSB, DEPTH, DETAIL, noMatch, ORIGIN),
                NATTRS} [owise] .

    --- Replace a subterm in the term, constraint and substitutions of a node
    op replaceTermInNode  : Term Term Node -> Node .
    eq replaceTermInNode(T, T, NODE) = NODE .
    eq replaceTermInNode(T, T', {ID : term: T'', ctr: CTR, acsub: ACSB, sub: SB, NATTRS})
        = {ID : term: replaceSubTerm(T, T', T''), ctr: replaceSubTerm(T, T', CTR), acsub: replaceSubTerm(T, T', ACSB),
           sub: replaceSubTerm(T, T', SB), NATTRS} .
    eq replaceTermInNode(T, T', {ID : term: T'', ctr: CTR, acsub: ACSB, NATTRS})
        = {ID : term: replaceSubTerm(T, T', T''), ctr: replaceSubTerm(T, T', CTR),
           acsub: replaceSubTerm(T, T', ACSB), NATTRS} [ owise ] .

    --- Replace a subterm in a term list
    op replaceSubTerm : Term Term TermList -> TermList .
    eq replaceSubTerm(T, T', empty) = empty .
    eq replaceSubTerm(T, T', T) = T' .
    eq replaceSubTerm(T, T', F[TL]) = F[replaceSubTerm(T, T', TL)] [owise] .
    eq replaceSubTerm(T, T', (T, TL)) = (T', replaceSubTerm(T, T', TL)) .
    eq replaceSubTerm(T, T', (T'', NTL)) = (replaceSubTerm(T, T', T''), replaceSubTerm(T, T', NTL)) [owise] .
    eq replaceSubTerm(T, T', T'') = T'' [owise] .

    op replaceSubTerm : Term Term Substitution -> Substitution .
    eq replaceSubTerm(T, T', (none).Substitution) = none .
    eq replaceSubTerm(T, T', V <- T'' ; SB) = V <- replaceSubTerm(T, T', T'') ; replaceSubTerm(T, T', SB) .

    --- Abstract a subterm of a node (in the term or in the constraint)
    op applyMetaXMatchT : Module Node Term Variable Context TermSet Nat Qid -> Node .
    eq applyMetaXMatchT(M, {ID : term: T, ctr: CTR, NATTRS}, T', V, CTX, TS, IDCOUNT, 't)
        = {IDCOUNT :
           term: getTerm(metaReduce(M, replaceHole(unfreeze'(CTX, TS), V))),
           ctr: reduceCtr(M,'_/\_[CTR, '_=_[V, T']]),
           NATTRS} .
    eq applyMetaXMatchT(M, {ID : ctr: CTR, NATTRS}, T', V, CTX, TS, IDCOUNT, 'c)
        = {IDCOUNT :
           ctr: getTerm(metaReduce(M, '_/\_[replaceHole(unfreeze'(CTX, TS), V), '_=_[V, T']])),
           NATTRS} .

    --- Reduce a constraint and simplify it
    op reduceCtr : Module Term -> Term .
    eq reduceCtr(M, T) = simpCtr(reduceCtr'(M, T)) .

    op reduceCtr' : Module TermList -> Term .
    eq reduceCtr'(M, '_/\_[T, NTL]) = '_/\_[reduceCtr'(M, T), reduceCtr'(M, NTL)] .
    eq reduceCtr'(M, '_=_[T, T']) = '_=_[reduceCtr'(M, T), reduceCtr'(M, T')] .
    eq reduceCtr'(M, (T, NTL)) = (reduceCtr'(M, T), reduceCtr'(M, NTL)) .
    eq reduceCtr'(M, T) = getTerm(metaReduce(M, T)) [owise] .

    --- Simplify a constraint syntactically
    op simpCtr : Term -> Term .
    eq simpCtr(T) = mkConj(simpConj(conjArgs(T))) .

    --- Conjuncts of a flattened conjunction
    op conjArgs : TermList -> TermList .
    eq conjArgs(empty) = empty .
    eq conjArgs(('_/\_[NTL], TL)) = (conjArgs(NTL), conjArgs(TL)) .
    eq conjArgs(('_=_[T, T], TL)) = ('true.NuITP-Bool, conjArgs(TL)) .
    eq conjArgs((T, TL)) = (T, conjArgs(TL)) [owise] .

    --- Simplify a list of conjuncts
    op simpConj : TermList -> TermList .
    eq simpConj((TL, 'false.NuITP-Bool, TL')) = 'false.NuITP-Bool .
    eq simpConj((TL, 'true.NuITP-Bool, TL')) = simpConj((TL, TL')) .
    eq simpConj((TL, T, TL', T, TL'')) = simpConj((TL, T, TL', TL'')) .
    eq simpConj((TL, '_=_[T, T'], TL', '_=_[T', T], TL'')) = simpConj((TL, '_=_[T, T'], TL', TL'')) .
    eq simpConj(TL) = TL [owise] .

    --- Build the conjunction of a list of terms
    op mkConj : TermList -> Term .
    eq mkConj(empty) = 'true.NuITP-Bool .
    eq mkConj(T) = T .
    eq mkConj((T, NTL)) = '_/\_[T, NTL] .

    --- Reduce the terms of a substitution
    op reduceSub : Module Substitution -> Substitution .
    eq reduceSub(M, (none).Substitution) = (none).Substitution .
    eq reduceSub(M, (V <- T ; SB)) = V <- getTerm(metaReduce(M, T)) ; reduceSub(M, SB) .

    --- Convert qids (ids) into naturals
    op QLtoNL : QidList -> NatList .
    eq QLtoNL(nil) = nil .
    eq QLtoNL(Q) = rat(string(Q),10) .
    eq QLtoNL((Q QL)) = rat(string(Q),10) QLtoNL(QL) .

    --- Children with the given ids
    op selectChildren : ChildNodeList NatList -> ChildNodeList .
    eq selectChildren(CHILDREN, nil) = noChildren .
    eq selectChildren(noChildren, NL) = noChildren .
    eq selectChildren((CHILDREN,
                       [ ID, PID, T, CTR, RL, SB, ACSB, MLIST, N, ORIGIN ],
                       CHILDREN'), (NL ID NL'))
        = ([ ID, PID, T, CTR, RL, SB, ACSB, MLIST, N, ORIGIN ],
           selectChildren((CHILDREN, CHILDREN'), (NL NL'))) .

    --- Children without the given ids
    op rmvChildren : ChildNodeList NatList -> ChildNodeList .
    eq rmvChildren((CHILDREN,
                    [ ID, PID, T, CTR, RL, SB, ACSB, MLIST, N, ORIGIN ],
                    CHILDREN'), (NL ID NL'))
        = rmvChildren((CHILDREN, CHILDREN'), (NL NL')) .
    eq rmvChildren(CHILDREN, NL) = CHILDREN [owise] .

    --- Insert a node into an ordered node list
    op insertNode : Node NodeList -> NodeList .
    eq insertNode(NODE, nil) = NODE .
    eq insertNode({ID : NATTRS}, ({ID' : NATTRS'} ; NODES))
        = if ID <= ID'
          then {ID : NATTRS} ; {ID' : NATTRS'} ; NODES
          else {ID' : NATTRS'} ; insertNode({ID : NATTRS}, NODES)
          fi .

    --- Sort a node list by id
    op reorderNodes : NodeList -> NodeList .
    eq reorderNodes(nil) = nil .
    eq reorderNodes(NODE ; NODES) = insertNode(NODE, reorderNodes(NODES)) .

    --- Ids of the parents of a result
    op parIds : ParentNodeList -> NatList .
    eq parIds(noParents) = (nil).NatList .
    eq parIds(([ ID, T, CTR, SB, DEPTH ], PARENTS)) = ID parIds(PARENTS) .
    eq parIds(([ ID, T, CTR, SB, DEPTH, ORIGIN ], PARENTS)) = ID parIds(PARENTS) .
    op chIds : ChildNodeList -> NatList .
    eq chIds(noChildren) = (nil).NatList .
    eq chIds(([ ID, PID, T, CTR, RL, SB, ACSB, MLIST, DEPTH, ORIGIN ], CHILDREN)) = ID chIds(CHILDREN) .
    eq chIds(([ ID, T, CTR, ACSB, MLIST, DEPTH, ORIGIN ], CHILDREN)) = ID chIds(CHILDREN) .
    eq chIds(([ ID, T, T', T'', CTR, SB, SB' ], CHILDREN)) = ID chIds(CHILDREN) .
    eq chIds((CHILD, CHILDREN)) = chIds(CHILDREN) [ owise ] .

    --- Ids of the parents and children of a result
    op resIds : DMCOutput -> NatList .
    eq resIds(PARENTS || CHILDREN) = parIds(PARENTS) chIds(CHILDREN) .
    eq resIds(OUTPUT) = (nil).NatList [ owise ] .
    op inIds : Nat NatList -> Bool .
    eq inIds(ID, (NL ID NL')) = true .
    eq inIds(ID, NL) = false [ owise ] .

    --- Matchers of a node whose target is in a list and is not the node itself
    op liveML : MatcherList NatList Nat -> MatcherList .
    eq liveML(noMatch, NL, ID) = noMatch .
    eq liveML(((MID, SB?, T, PROOF) ; MLIST), NL, ID)
        = (if MID =/= ID and-then inIds(MID, NL) then (MID, SB?, T, PROOF) else noMatch fi)
          ; liveML(MLIST, NL, ID) .

    --- Keep in the children only the matchers that lemma may use
    op liveCh : ChildNodeList NatList -> ChildNodeList .
    eq liveCh(noChildren, NL) = noChildren .
    eq liveCh(([ ID, PID, T, CTR, RL, SB, ACSB, MLIST, DEPTH, ORIGIN ], CHILDREN), NL)
        = ([ ID, PID, T, CTR, RL, SB, ACSB, liveML(MLIST, NL, ID), DEPTH, ORIGIN ], liveCh(CHILDREN, NL)) .
    eq liveCh(([ ID, T, CTR, ACSB, MLIST, DEPTH, ORIGIN ], CHILDREN), NL)
        = ([ ID, T, CTR, ACSB, liveML(MLIST, NL, ID), DEPTH, ORIGIN ], liveCh(CHILDREN, NL)) .
    eq liveCh((CHILD, CHILDREN), NL) = (CHILD, liveCh(CHILDREN, NL)) [ owise ] .

    --- Drop the matchers to the nodes folded in the same batch
    op hiddenIds : NodeList -> NatList .
    eq hiddenIds(nil) = (nil).NatList .
    eq hiddenIds({ID : fold: true, NATTRS} ; NODES) = ID hiddenIds(NODES) .
    eq hiddenIds(NODE ; NODES) = hiddenIds(NODES) [ owise ] .
    op dropTargets : MatcherList NatList -> MatcherList .
    eq dropTargets(noMatch, NL) = noMatch .
    eq dropTargets(((MID, SB?, CTR, PROOF) ; MLIST), NL)
        = (if inIds(MID, NL) then noMatch else (MID, SB?, CTR, PROOF) fi)
          ; dropTargets(MLIST, NL) .
    op dropHidden : NodeList -> NodeList .
    eq dropHidden(NODES) = dropHidden'(NODES, hiddenIds(NODES)) .
    op dropHidden' : NodeList NatList -> NodeList .
    eq dropHidden'(nil, NL) = nil .
    eq dropHidden'(({ID : match: MLIST, NATTRS} ; NODES), NL)
        = {ID : match: dropTargets(MLIST, NL), NATTRS} ; dropHidden'(NODES, NL) .
    eq dropHidden'((NODE ; NODES), NL) = NODE ; dropHidden'(NODES, NL) [ owise ] .
endm

mod CHECK-INVARIANT is
    pr DM-CHECK-CORE .

    var NODES? : [NodeList] .
    var M : Module .
    var NTL : NeTermList .
    var VOS : VariantOptionSet .
    var LEMMAS : TermSet .
    vars N ID PID DEPTH DEPTH' VCOUNT IDCOUNT : Nat .
    vars NATTRS SATTRS : AttributeSet .
    vars NODES NODES' NODES'' : NodeList .
    var PARENTS : ParentNodeList .
    var CHILDREN : ChildNodeList .
    vars T CTR : Term .
    vars ACSB SB : Substitution .
    var RL : Qid .
    var MLIST : MatcherList .
    var ORIGIN : NodeOrigin .
    var OUTPUT : DMCOutput .

    --- Process the output for the check invariants command
    op outputInv : NodeList -> DMCOutput .
    eq outputInv(NODES) = outputInv'(noParents || noChildren, dropHidden(NODES)) .

    op outputInv' : DMCOutput NodeList -> DMCOutput .
    eq outputInv'(OUTPUT, nil) = OUTPUT .
    eq outputInv'((PARENTS || CHILDREN),
                  ({ID : term: T, ctr: CTR, acsub: ACSB, origin: ORIGIN,
                         ntype: iNode, ndepth: 0, NATTRS} ; NODES))
        = outputInv'((PARENTS , [ID, T, CTR, ACSB, 0, ORIGIN] || CHILDREN), NODES) .
    eq outputInv'((PARENTS || CHILDREN), ({ID : term: T, ctr: CTR, acsub: ACSB, ntype: iNode, ndepth: 0} ; NODES))
        = outputInv'((PARENTS , [ID, T, CTR, ACSB, 0, rootOrigin] || CHILDREN), NODES) .
    eq outputInv'((PARENTS || CHILDREN), ({ID : fold: true, NATTRS} ; NODES))
        = outputInv'((PARENTS || CHILDREN), NODES) .
    eq outputInv'((PARENTS || CHILDREN), ({ID : fold: false, pid: PID, term: T,
          ctr: CTR, rule: RL, sub: SB, acsub: ACSB, origin: ORIGIN,
          match: MLIST, ntype: gNode, ndepth: N, NATTRS} ; NODES))
        = outputInv'((PARENTS || CHILDREN,
          [ID, PID, T, CTR, RL, SB, ACSB, MLIST, N,
           setOriginMatchers(ORIGIN, MLIST)]), NODES) .

    --- Initialize the check invariants command
    op checkInvariant : Module NeTermList VariantOptionSet TermSet Nat -> DMCOutput .
    ceq checkInvariant(M, NTL, VOS, LEMMAS, DEPTH)
        = nextLevel(< mod: M, prev: nil, curr: NODES?,
                           next: nil, depth: DEPTH, cdepth: 0, vos: VOS, lemmas: LEMMAS,
                           idcount: (1 + countNodes(NODES)),
                           vcount: (1 + countNodeVars(NODES)) >)
    if NODES := initNodes(M, NTL, 1, 1) /\
       NODES? := checkConstraints(M, NODES, LEMMAS) .

    --- Generate the next level of the search space
    op nextLevel : DMCState -> DMCOutput .

    --- Stop if a node has a variable as term or its narrowing may be incomplete
    ceq nextLevel(< mod: M, vos: VOS, depth: DEPTH, cdepth: DEPTH', prev: NODES, curr: NODES', next: nil,
                  idcount: IDCOUNT, vcount: VCOUNT, SATTRS >)
        = if hasIncomplete(NODES'')
          then (if kindNodes('varterm, NODES'') =/= nil then
                incompleteResult('varterm, incompleteIds(kindNodes('varterm, NODES''))) else
                incompleteResult('narrowing, incompleteIds(NODES'')) fi)
          else nextLevel'(< mod: M, vos: VOS, depth: DEPTH, cdepth: DEPTH', prev: NODES, curr: NODES', next: nil,
                          idcount: IDCOUNT, vcount: VCOUNT, SATTRS >, renameNodes(NODES'', VCOUNT))
          fi
    if (DEPTH == 0 or-else DEPTH' < DEPTH) /\
       NODES'' := deployChildren(M, VOS, NODES', IDCOUNT) .

    op nextLevel' : DMCState NodeList -> DMCOutput .
    eq nextLevel'(< mod: M, vos: VOS, depth: DEPTH, cdepth: DEPTH', prev: NODES, curr: NODES', next: nil,
                  idcount: IDCOUNT, vcount: VCOUNT, SATTRS >, NODES'')
        = checkNewConstraints(< mod: M, vos: VOS, depth: DEPTH, cdepth: s(DEPTH'), prev: (NODES ; NODES'), curr: nil,
                              next: NODES'', idcount: (IDCOUNT + countNodes(NODES'')),
                              vcount: (VCOUNT + countNodeVars(NODES'')), SATTRS >) .
    ceq nextLevel(< depth: DEPTH, cdepth: DEPTH', prev: NODES, curr: NODES', SATTRS >)
        = outputInv(NODES ; NODES')
    if not (DEPTH == 0 or-else DEPTH' < DEPTH) .

    --- Check the constraints of new states
    op checkNewConstraints : DMCState -> DMCOutput .
    eq checkNewConstraints(< prev: NODES, next: nil, SATTRS >)
        = outputInv(NODES) .
    eq checkNewConstraints(< mod: M, next: NODES, lemmas: LEMMAS, SATTRS >)
        = checkFolding(< mod: M, next: checkConstraints(M, NODES, LEMMAS), lemmas: LEMMAS, SATTRS >) [owise] .

    --- Check folding for new states
    op checkFolding : DMCState -> DMCOutput .
    eq checkFolding(< prev: NODES, next: nil, SATTRS >)
        = outputInv(NODES) .
    eq checkFolding(< mod: M, vos: VOS, lemmas: LEMMAS, prev: NODES, curr: nil, next: NODES', SATTRS >)
        = nextLevel(< mod: M, vos: VOS, lemmas: LEMMAS, prev: NODES,
                      curr: checkSubsumption(M, NODES', NODES, VOS, LEMMAS),
                      next: nil, SATTRS >) [owise] .
endm

mod GEN-INVARIANT is
    pr CHECK-INVARIANT .

    var NODES? : [NodeList] .
    var M : Module .
    var NTL : NeTermList .
    vars T T' CTR CTR' : Term .
    var LEMMAS : TermSet .
    vars DEPTH IDCOUNT ID ID' PID N MCOUNT : Nat .
    var VOS : VariantOptionSet .
    vars NODES NODES' NODES'' : NodeList .
    vars NODE NODE' : Node .
    vars NATTRS NATTRS' : AttributeSet .
    var PARENTS : ParentNodeList .
    var CHILDREN : ChildNodeList .
    var RL : Qid .
    var MLIST : MatcherList .
    vars ACSB SB MATCHER : Substitution .
    var ORIGIN : NodeOrigin .
    var STEP : StepKind .
    var DETAIL : TraceDetail .

    --- Initialize the generate invariants command
    op genInvariant : Module NeTermList VariantOptionSet TermSet Nat -> DMCOutput .
    eq genInvariant(M, NTL, VOS, LEMMAS, DEPTH) = checkInvariant(M, NTL, VOS, LEMMAS, DEPTH) .

    --- Generate one more level keeping ids and origins (generate next level)
    op genInvariantNext : Module ParentNodeList ChildNodeList TermSet Nat -> DMCOutput .
    ceq genInvariantNext(M, PARENTS, CHILDREN, LEMMAS, IDCOUNT)
        = genInvariantNext'(M, orderTraceNodes(NODES?), LEMMAS,
                            s(if maxTraceNodeId(NODES) >= IDCOUNT then maxTraceNodeId(NODES) else IDCOUNT fi))
    if NODES := promoteForNextLevel(PARENTS, CHILDREN) /\
       NODES? := rmvSubsumedTraceNodes(M, NODES, LEMMAS) .

    op genInvariantNext' : Module NodeList TermSet Nat -> DMCOutput .
    ceq genInvariantNext'(M, NODES, LEMMAS, IDCOUNT)
        = nextLevel(< mod: M,
                      prev: tracePreviousNodes(NODES),
                      curr: NODES?,
                      next: nil,
                      depth: 1,
                      cdepth: 0,
                      vos: none,
                      lemmas: LEMMAS,
                      idcount: IDCOUNT,
                      vcount: nextTraceVarIndex(NODES) >)
    if NODES? := checkConstraints(M, promoteTraceChildren(NODES), LEMMAS) .

    --- Previous result as nodes, children first
    op promoteForNextLevel : ParentNodeList ChildNodeList -> NodeList .
    eq promoteForNextLevel(PARENTS, CHILDREN)
        = traceChildrenToNodes(CHILDREN) ; traceParentsToNodes(PARENTS) .

    --- Parents of the previous result as nodes
    op traceParentsToNodes : ParentNodeList -> NodeList .
    eq traceParentsToNodes(noParents) = nil .
    eq traceParentsToNodes([ ID, T, CTR, ACSB, 0 ], PARENTS)
        = {ID : term: T, ctr: CTR, acsub: ACSB, origin: rootOrigin,
           ndepth: 0, ntype: iNode} ;
          traceParentsToNodes(PARENTS) .
    eq traceParentsToNodes([ ID, T, CTR, ACSB, 0, ORIGIN ], PARENTS)
        = {ID : term: T, ctr: CTR, acsub: ACSB, origin: ORIGIN,
           ndepth: 0, ntype: iNode} ;
          traceParentsToNodes(PARENTS) .

    --- Children of the previous result as nodes
    op traceChildrenToNodes : ChildNodeList -> NodeList .
    eq traceChildrenToNodes(noChildren) = nil .
    eq traceChildrenToNodes([ ID, PID, T, CTR, RL, SB, ACSB, MLIST, N, ORIGIN ], CHILDREN)
        = {ID : pid: PID, term: T, ctr: CTR, rule: RL, sub: SB, acsub: ACSB,
           origin: ORIGIN, match: MLIST, ndepth: N, ntype: gNode, fold: false} ;
          traceChildrenToNodes(CHILDREN) .

    --- Initial nodes of a list
    op tracePreviousNodes : NodeList -> NodeList .
    eq tracePreviousNodes(nil) = nil .
    eq tracePreviousNodes(({ID : ntype: iNode, NATTRS} ; NODES))
        = {ID : ntype: iNode, NATTRS} ; tracePreviousNodes(NODES) .
    eq tracePreviousNodes(NODE ; NODES) = tracePreviousNodes(NODES) [owise] .

    --- Restore the parents-first order
    op orderTraceNodes : NodeList -> NodeList .
    eq orderTraceNodes(NODES) = tracePreviousNodes(NODES) ; traceGeneratedNodes(NODES) .

    --- Generated nodes of a list
    op traceGeneratedNodes : NodeList -> NodeList .
    eq traceGeneratedNodes(nil) = nil .
    eq traceGeneratedNodes(({ID : ntype: gNode, NATTRS} ; NODES))
        = {ID : ntype: gNode, NATTRS} ; traceGeneratedNodes(NODES) .
    eq traceGeneratedNodes(NODE ; NODES) = traceGeneratedNodes(NODES) [owise] .

    --- Turn the open children of the previous level into the next frontier
    op promoteTraceChildren : NodeList -> NodeList .
    eq promoteTraceChildren(nil) = nil .
    eq promoteTraceChildren(({ID : pid: PID, term: T, ctr: CTR, rule: RL, sub: SB,
                                    acsub: ACSB, origin: ORIGIN, match: MLIST, ndepth: N,
                                    ntype: gNode, fold: false, NATTRS} ; NODES))
        = {ID : pid: PID, term: T, ctr: CTR, rule: RL, sub: SB, acsub: ACSB,
           origin: ORIGIN,
           ndepth: 0, ntype: iNode} ;
          promoteTraceChildren(NODES) .
    eq promoteTraceChildren(NODE ; NODES) = promoteTraceChildren(NODES) [owise] .

    --- Remove the subsumed nodes, keeping whole nodes
    op rmvSubsumedTraceNodes : Module NodeList TermSet -> NodeList .
    eq rmvSubsumedTraceNodes(M, nil, LEMMAS) = nil .
    eq rmvSubsumedTraceNodes(M, NODE, LEMMAS) = NODE .
    eq rmvSubsumedTraceNodes(M, NODES, LEMMAS)
        = rmvSubsumedTraceNodes'(M, NODES, NODES, LEMMAS) [owise] .

    op rmvSubsumedTraceNodes' : Module NodeList NodeList TermSet -> NodeList .
    eq rmvSubsumedTraceNodes'(M, nil, NODES, LEMMAS) = nil .
    eq rmvSubsumedTraceNodes'(M, (NODE ; NODES), (NODES' ; NODE ; NODES''), LEMMAS)
        = if traceNodeSubsumed(M, NODE, (NODES' ; NODES''), LEMMAS, 0)
          then
            rmvSubsumedTraceNodes'(M, NODES, (NODES' ; NODES''), LEMMAS)
          else
            NODE ; rmvSubsumedTraceNodes'(M, NODES, (NODES' ; NODE ; NODES''), LEMMAS)
          fi .

    --- Check if a node is subsumed by some node of a list
    op traceNodeSubsumed : Module Node NodeList TermSet Nat -> Bool .
    eq traceNodeSubsumed(M, NODE, nil, LEMMAS, MCOUNT) = false .
    ceq traceNodeSubsumed(M, {ID : term: T, ctr: CTR, NATTRS},
                             ({ID' : term: T', ctr: CTR', NATTRS'} ; NODES),
                             LEMMAS, MCOUNT)
        = if isSat(callNuITP(M, '_->_[CTR, applySub(CTR', MATCHER)], LEMMAS))
          then
            true
          else
            traceNodeSubsumed(M, {ID : term: T, ctr: CTR, NATTRS},
                                ({ID' : term: T', ctr: CTR', NATTRS'} ; NODES),
                                LEMMAS, MCOUNT + 1)
          fi
    if MATCHER := metaVariantMatch(M, T' <=? T, empty, '@, none, MCOUNT) .
    eq traceNodeSubsumed(M, NODE, (NODE' ; NODES), LEMMAS, MCOUNT)
        = traceNodeSubsumed(M, NODE, NODES, LEMMAS, 0) [owise] .

    --- Largest node id in an origin
    op maxOriginId : NodeOrigin Nat -> Nat .
    eq maxOriginId(rootOrigin, N) = N .
    eq maxOriginId(srcState(T, CTR, ACSB, ORIGIN), N) = maxOriginId(ORIGIN, N) .
    eq maxOriginId(origin(PID, STEP, RL, SB, ACSB, DEPTH,
                          DETAIL, MLIST, ORIGIN), N)
        = if PID > N
          then maxOriginId(ORIGIN, PID)
          else maxOriginId(ORIGIN, N)
          fi .

    --- Largest node id in a list (including ids kept in origins)
    op maxTraceNodeId : NodeList -> Nat .
    eq maxTraceNodeId(NODES) = maxTraceNodeId'(NODES, 0) .

    op maxTraceNodeId' : NodeList Nat -> Nat .
    eq maxTraceNodeId'(nil, N) = N .
    eq maxTraceNodeId'(({ID : origin: ORIGIN, NATTRS} ; NODES), N)
        = maxTraceNodeId'(NODES,
            maxOriginId(ORIGIN, if ID > N then ID else N fi)) .
    eq maxTraceNodeId'(({ID : NATTRS} ; NODES), N)
        = maxTraceNodeId'(NODES, if ID > N then ID else N fi) [owise] .
endm

mod CHECK-SUBSUMED is
    pr DM-CHECK-CORE .

    var NODES? : [NodeList] .
    var M : Module .
    vars NTL NTL' : NeTermList .
    var VOS : VariantOptionSet .
    var LEMMAS : TermSet .
    var NODES : NodeList .
    vars ID IDCOUNT VCOUNT : Nat .
    vars SATTRS NATTRS : AttributeSet .
    var PARENTS : ParentNodeList .
    var CHILDREN : ChildNodeList .
    vars T CTR : Term .
    var ACSB : Substitution .
    var MLIST : MatcherList .
    var OUTPUT : DMCOutput .

    --- Process the output for the subsumed command
    op outputSub : NodeList -> DMCOutput .
    eq outputSub(NODES) = outputSub'(noParents || noChildren, dropHidden(NODES)) .

    op outputSub' : DMCOutput NodeList -> DMCOutput .
    eq outputSub'(OUTPUT, nil) = OUTPUT .
    eq outputSub'((PARENTS || CHILDREN), ({ID : term: T, ctr: CTR, acsub: ACSB, ntype: iNode, ndepth: 0} ; NODES))
        = outputSub'((PARENTS, [ID, T, CTR, ACSB, 0] || CHILDREN), NODES) .
    eq outputSub'((PARENTS || CHILDREN), ({ID : fold: true, NATTRS} ; NODES))
        = outputSub'((PARENTS || CHILDREN), NODES) .
    eq outputSub'((PARENTS || CHILDREN),
                  ({ID : fold: false, term: T, ctr: CTR, acsub: ACSB, match: MLIST, ntype: sNode, ndepth: 0} ; NODES))
        = outputSub'((PARENTS || CHILDREN, [ID, T, CTR, ACSB, MLIST, 0, rootOrigin]), NODES) .

    --- Initialize the check subsumed command
    op checkSubsumed : Module NeTermList NeTermList VariantOptionSet TermSet -> DMCOutput .
    ceq checkSubsumed(M, NTL, NTL', VOS, LEMMAS)
        = checkSubsumed'(< mod: M, vos: VOS, lemmas: LEMMAS, init: NODES?,
                           idcount: (1 + countNodes(NODES)), vcount: (1 + countNodeVars(NODES)) >, NTL)
    if NODES := initNodes(M, NTL', 1, 1) /\
       NODES? := checkConstraints(M, NODES, LEMMAS) .

    --- Initialize the rest of states and check subsumption
    op checkSubsumed' : DMCState NeTermList -> DMCOutput .
    eq checkSubsumed'(< mod: M, vos: VOS, lemmas: LEMMAS, init: NODES, idcount: IDCOUNT, vcount: VCOUNT, SATTRS >,
                      NTL)
        = outputSub( NODES ;
                     checkSubsumption(M, checkConstraints(M, initNodes'(M, NTL, IDCOUNT, VCOUNT), LEMMAS), NODES, VOS,
                                      LEMMAS)) .

endm

mod CHECK-INTERSECTION is
    pr DM-CHECK-CORE .

    var NODES? : [NodeList] .
    var M : Module .
    vars NTL NTL' : NeTermList .
    var VOS : VariantOptionSet .
    var LEMMAS : TermSet .
    var SATTRS : AttributeSet .
    vars ID IDCOUNT VCOUNT : Nat .
    vars NODES NODES' NODES'' : NodeList .
    vars T T' CTR : Term .
    vars LSB RSB ACSB : Substitution .
    var OUTPUT : DMCOutput .
    var PARENTS : ParentNodeList .
    var CHILDREN : ChildNodeList .

    --- Process the output for the intersection command
    op outputInt : NodeList -> DMCOutput .
    eq outputInt(NODES) = outputInt'(noParents || noChildren, NODES) .

    op outputInt' : DMCOutput NodeList -> DMCOutput .
    eq outputInt'(OUTPUT, nil) = OUTPUT .
    eq outputInt'(PARENTS || CHILDREN, {ID : term: T, ctr: CTR, acsub: ACSB, ndepth: 0, ntype: iNode} ; NODES)
        = outputInt'((PARENTS, [ID, T, CTR, ACSB, 0]) || CHILDREN, NODES) .
    eq outputInt'(PARENTS || CHILDREN, {ID : lterm: T, rterm: T', ctr: CTR, lsub: LSB, rsub: RSB, ntype: itNode} ;
                  NODES)
        = outputInt'(PARENTS || (CHILDREN, [ID, applySub(T, LSB), T, T', CTR, LSB, RSB]), NODES) .

    --- Check the intersection between two list of pair terms
    op checkIntersection : Module NeTermList NeTermList VariantOptionSet TermSet -> DMCOutput .
    ceq checkIntersection(M, NTL, NTL', VOS, LEMMAS)
        = checkIntersection'(< mod: M, vos: VOS, lemmas: LEMMAS, init: NODES?,
                               idcount: (1 + countNodes(NODES)),
                               vcount: (1 + countNodeVars(NODES)) >, NTL')
    if NODES := initIntNodes(M, NTL, 1, 1) /\
       NODES? := checkConstraints(M, NODES, LEMMAS) .

    op checkIntersection' : DMCState NeTermList -> DMCOutput .
    ceq checkIntersection'(< SATTRS, mod: M, lemmas: LEMMAS, idcount: IDCOUNT, vcount: VCOUNT >, NTL)
        = getIntersection(< SATTRS, mod: M, lemmas: LEMMAS, init': NODES?,
                            idcount: (IDCOUNT + countNodes(NODES)) >)
    if NODES := initIntNodes(M, NTL, IDCOUNT, VCOUNT) /\
       NODES? := checkConstraints(M, NODES, LEMMAS) .

    --- Unify the left and right patterns pairwise
    op getIntersection : DMCState -> DMCOutput .
    ceq getIntersection(< mod: M, vos: VOS, lemmas: LEMMAS, init: NODES, init': NODES', idcount: IDCOUNT >)
        = if hasIncomplete(NODES'')
          then incompleteResult('intersection, incompleteIds(NODES''))
          else checkIntersectionConstraints(< mod: M, vos: VOS, lemmas: LEMMAS, init: NODES, init': NODES',
                                            inter: NODES'', idcount: (IDCOUNT + countNodes(NODES'')) >)
          fi
    if NODES'' := intersectLists(M, NODES, NODES', VOS, IDCOUNT) .

    --- Drop the intersection nodes whose constraint is unsatisfiable
    op checkIntersectionConstraints : DMCState -> DMCOutput .
    eq checkIntersectionConstraints(< SATTRS, mod: M, lemmas: LEMMAS, init: NODES, init': NODES', inter: NODES'' >)
        = outputInt(NODES ; NODES' ; checkConstraints(M, NODES'', LEMMAS)) .
endm

mod AUX-COMMANDS is
    pr DM-CHECK-CORE .

    var M : Module .
    var PARENTS : ParentNodeList .
    var CHILD : ChildNode .
    var CHILDREN : ChildNodeList .
    vars V V' : Variable .
    var VOS : VariantOptionSet .
    vars GENSET LEMMAS PATS TS TS' ATOMS ATOMS' : TermSet .
    vars ID PID IDCOUNT VCOUNT N N' DEPTH : Nat .
    vars T T' CTR CTR' PAT GEN LHS RHS : Term .
    vars TL TL' TL'' TL''' : TermList .
    vars SB SB' ACSB : Substitution .
    vars RL Q Q' F F' : Qid .
    var MLIST : MatcherList .
    vars SATTRS NATTRS : AttributeSet .
    vars NODES NODES' NODES'' : NodeList .
    var NODE : Node .
    var NTS : NeTermSet .
    vars B B' : Bool .
    var QL : QidList .
    var TP : Type .
    var CTX : Context .
    vars NTL NTL' : NeTermList .
    var MATCHPAIR : MatchPair .
    var UPAIR : UnificationPair .
    var NAR : NarrowingApplyResult .
    var ORIGIN : NodeOrigin .
    var TYL : TypeList .
    var GROUPS : CovGroups .
    vars S S' S'' S''' : Sort .
    var RES : CovRes .
    vars SS SS' : SortSet .
    var ATS : AttrSet .
    var OPS : OpDeclSet .
    var NTYL : NeTypeList .
    var C : Constant .
    var EQS : EquationSet .
    var COND : Condition .
    var QS : QidSet .
    var UP? : UnificationPair? .
    var NAR? : NarrowingApplyResult? .
    var RLS : RuleSet .
    var STR : String .

    --- Check folding after an auxiliary command
    op checkAuxCommand : DMCState Nat -> ChildNodeList .
    eq checkAuxCommand(< next: nil, SATTRS >, VCOUNT)
        = outputAuxCommand(nil) .
    eq checkAuxCommand(< mod: M, vos: VOS, lemmas: LEMMAS, init: NODES, next: NODES', SATTRS >, VCOUNT)
        = outputAuxCommand(checkSubsumption(M, renameNodes(NODES', VCOUNT), NODES, VOS, LEMMAS)) .

    --- Process the output for the auxiliary commands
    op outputAuxCommand : NodeList -> ChildNodeList .
    eq outputAuxCommand(NODES) = outputAuxCommand'(reorderNodes(dropHidden(NODES))) .

    op outputAuxCommand' : NodeList -> ChildNodeList .
    eq outputAuxCommand'(nil) = noChildren .
    eq outputAuxCommand'({ID : fold: true, NATTRS} ; NODES) = outputAuxCommand'(NODES) .
    eq outputAuxCommand'({ID : fold: false, pid: PID, term: T, ctr: CTR,
          rule: RL, sub: SB, acsub: ACSB, origin: ORIGIN, match: MLIST,
          ndepth: N, ntype: gNode, NATTRS} ; NODES)
        = [ ID, PID, T, CTR, RL, SB, ACSB, MLIST, N,
            setOriginMatchers(ORIGIN, MLIST) ],
          outputAuxCommand'(NODES) .
    eq outputAuxCommand'({ID : fold: false, term: T, ctr: CTR, acsub: ACSB, match: MLIST, ndepth: N, ntype: sNode,
                          origin: ORIGIN, NATTRS} ; NODES)
        = [ ID, T, CTR, ACSB, MLIST, 0, ORIGIN ], outputAuxCommand'(NODES) .
    eq outputAuxCommand'({ID : fold: false, term: T, ctr: CTR, acsub: ACSB, match: MLIST, ndepth: N,
                          ntype: sNode, NATTRS} ; NODES)
        = [ ID, T, CTR, ACSB, MLIST, 0, rootOrigin ], outputAuxCommand'(NODES) [ owise ] .

    --- CASE command
    op case : Module ParentNodeList ChildNode Variable TermSet Nat Nat VariantOptionSet TermSet -> ChildNodeList .
    eq case(M, PARENTS, CHILD, V, GENSET, IDCOUNT, VCOUNT, VOS, LEMMAS)
        = checkAuxCommand(< mod: M, vos: VOS, lemmas: LEMMAS, init: rebuildParents(PARENTS),
                          next: checkConstraints(M, genCaseChildren(M, rebuildChildren(CHILD), V, GENSET, IDCOUNT),
                                                 LEMMAS) >, VCOUNT) .

    --- One child per generator term
    op genCaseChildren : Module Node Variable TermSet Nat -> NodeList .
    eq genCaseChildren(M, {ID : ndepth: DEPTH, NATTRS}, V, T, N)
        = setNodeOrigin(applySubToNode(M, {ID : ndepth: DEPTH, NATTRS}, V <- T, N),
                        ID, caseStep, 'none, V <- T, DEPTH,
                        pairDetail(V, T),
                        getNodeOrigin({ID : ndepth: DEPTH, NATTRS})) .
    eq genCaseChildren(M, {ID : ndepth: DEPTH, NATTRS}, V, (T ;; NTS), N)
        = setNodeOrigin(applySubToNode(M, {ID : ndepth: DEPTH, NATTRS}, V <- T, N),
                        ID, caseStep, 'none, V <- T, DEPTH,
                        pairDetail(V, T),
                        getNodeOrigin({ID : ndepth: DEPTH, NATTRS})) ;
          genCaseChildren(M, {ID : ndepth: DEPTH, NATTRS}, V, NTS, N + 1) .

    --- Coverage of case: constructor patterns not covered by the generator set
    sort CovRes .
    op cov : TermSet Nat Bool -> CovRes [ ctor ] . --- patterns, next index, some pattern was covered
    op noRefine : -> CovRes [ ctor ] .

    --- Maximum refinement depth of the coverage check
    op covDepth : -> Nat .
    eq covDepth = 6 .

    --- Fresh variables for coverage patterns
    op covVar : Type Nat -> Variable .
    eq covVar(TP, N) = qid("$$C" + string(N, 10) + ":" + string(TP)) .
    op covVars : TypeList Nat -> TermList .
    eq covVars(nil, N) = empty .
    eq covVars(TP TYL, N) = covVar(TP, N), covVars(TYL, s(N)) .

    --- Length of a type list
    op covLen : TypeList -> Nat .
    eq covLen(nil) = 0 .
    eq covLen(TP TYL) = s(covLen(TYL)) .

    --- Maximum number of reported uncovered patterns
    op covMax : -> Nat .
    eq covMax = 8 .

    --- Constructor patterns of the sort of a variable not covered by a generator set
    op uncoveredPats : Module Variable TermSet -> TermSet .
    eq uncoveredPats(M, V, GENSET) = covTop(M, GENSET, covVar(getType(V), 0)) .

    --- Coverage of the root pattern, limited to covMax reported patterns
    op covTop : Module TermSet Variable -> TermSet .
    eq covTop(M, GENSET, V)
        = if matchedBy(M, GENSET, V)
          then mt
          else covTop'(M, GENSET, V, refine(M, V, GENSET, 1))
          fi .
    op covTop' : Module TermSet Variable CovRes -> TermSet .
    eq covTop'(M, GENSET, V, noRefine) = V .
    eq covTop'(M, GENSET, V, cov(PATS, N, B)) = covLimit(V, covGroups(M, GENSET, PATS, N), mt, mt) .

    --- Each first-level pattern with its uncovered refinements
    sort CovGroup CovGroups .
    subsort CovGroup < CovGroups .
    op grp : Term TermSet -> CovGroup [ ctor ] .
    op noGroups : -> CovGroups [ ctor ] .
    op _&_ : CovGroups CovGroups -> CovGroups [ ctor assoc comm id: noGroups ] .
    op covGroups : Module TermSet TermSet Nat -> CovGroups .
    eq covGroups(M, GENSET, mt, N) = noGroups .
    eq covGroups(M, GENSET, (PAT ;; PATS), N)
        = grp(PAT, covPats(uncov(M, GENSET, PAT, sd(covDepth, 1), N))) & covGroups(M, GENSET, PATS, N) .

    --- Limit the reported patterns to covMax
    op covLimit : Variable CovGroups TermSet TermSet -> TermSet .
    eq covLimit(V, grp(PAT, mt) & GROUPS, TS, TS') = covLimit(V, GROUPS, TS, TS') .
    eq covLimit(V, grp(PAT, NTS) & GROUPS, TS, TS') = covLimit(V, GROUPS, TS ;; NTS, TS' ;; PAT) .
    eq covLimit(V, noGroups, TS, TS')
        = if covSize(TS) <= covMax
          then TS
          else if covSize(TS') <= covMax
               then TS'
               else V
               fi
          fi .

    --- Number of terms in a set
    op covSize : TermSet -> Nat .
    eq covSize(mt) = 0 .
    eq covSize(PAT ;; PATS) = s(covSize(PATS)) .

    --- Patterns of a coverage result
    op covPats : CovRes -> TermSet .
    eq covPats(cov(TS, N, B)) = TS .

    --- Uncovered refinements of a frontier of patterns
    op uncov : Module TermSet TermSet Nat Nat -> CovRes .
    eq uncov(M, GENSET, mt, DEPTH, N) = cov(mt, N, false) .
    eq uncov(M, GENSET, (PAT ;; PATS), DEPTH, N)
        = uncovJoin(M, GENSET, PATS, DEPTH, uncov1(M, GENSET, PAT, DEPTH, N)) .

    --- Join the coverage results of a set of patterns
    op uncovJoin : Module TermSet TermSet Nat CovRes -> CovRes .
    eq uncovJoin(M, GENSET, PATS, DEPTH, cov(TS, N, B))
        = covUnion(TS, B, uncov(M, GENSET, PATS, DEPTH, N)) .

    --- Union of coverage results
    op covUnion : TermSet Bool CovRes -> CovRes .
    eq covUnion(TS, B, cov(TS', N, B')) = cov(TS ;; TS', N, B or B') .

    --- Uncovered refinements of one pattern
    op uncov1 : Module TermSet Term Nat Nat -> CovRes .
    eq uncov1(M, GENSET, PAT, DEPTH, N) = uncov1'(M, GENSET, getTerm(metaNormalize(M, PAT)), DEPTH, N) .
    op uncov1' : Module TermSet Term Nat Nat -> CovRes .
    eq uncov1'(M, GENSET, PAT, DEPTH, N)
        = if matchedBy(M, GENSET, PAT)
          then cov(mt, N, true)
          else if DEPTH == 0
               then cov(PAT, N, false)
               else uncovRef(M, GENSET, PAT, sd(DEPTH, 1), N, refine(M, PAT, GENSET, N))
               fi
          fi .

    --- Coverage of a pattern from its refinements
    op uncovRef : Module TermSet Term Nat Nat CovRes -> CovRes .
    eq uncovRef(M, GENSET, PAT, DEPTH, N, noRefine) = cov(PAT, N, false) .

    --- Empty refinement: the pattern has no ground constructor instance
    eq uncovRef(M, GENSET, PAT, DEPTH, N, cov(mt, N', B)) = cov(mt, N', false) .
    eq uncovRef(M, GENSET, PAT, DEPTH, N, cov(NTS, N', B))
        = coarsen(PAT, uncov(M, GENSET, NTS, DEPTH, N')) .

    --- Report the pattern itself when a refinement is uncovered
    op coarsen : Term CovRes -> CovRes .
    eq coarsen(PAT, cov(TS, N, true)) = cov(TS, N, true) .
    eq coarsen(PAT, cov(TS, N, false)) = cov(PAT, N, false) .

    --- Check if a term is an instance of some generator
    op matchedBy : Module TermSet Term -> Bool .
    eq matchedBy(M, mt, T) = false .
    eq matchedBy(M, (GEN ;; GENSET), T)
        = (metaMatch(M, GEN, T, nil, 0) :: Substitution) or-else matchedBy(M, GENSET, T) .

    --- Patterns of a sort
    op leaves : Module Sort Nat -> CovRes .
    eq leaves(M, S, N)
        = leavesOps(getOps(M), S, leavesSorts(maxSubsorts(M, S), cov(mt, N, false))) .

    --- Patterns of the maximal subsorts
    op leavesSorts : SortSet CovRes -> CovRes .
    eq leavesSorts(none, RES) = RES .
    eq leavesSorts((S ; SS), cov(TS, N, B)) = leavesSorts(SS, cov(TS ;; covVar(S, N), s(N), B)) .

    --- Patterns of the constructor declarations of a sort
    op leavesOps : OpDeclSet Sort CovRes -> CovRes .
    eq leavesOps(none, S, RES) = RES .
    ceq leavesOps((op F : nil -> S [ ctor ATS ] .) OPS, S, cov(TS, N, B))
        = leavesOps(OPS, S, cov(TS ;; qid(string(F) + "." + string(S)), N, B))
        if not dmcOp(F) .
    ceq leavesOps((op F : NTYL -> S [ ctor ATS ] .) OPS, S, cov(TS, N, B))
        = leavesOps(OPS, S, cov(TS ;; (F[covVars(NTYL, N)]), N + covLen(NTYL), B))
        if not dmcOp(F) .
    eq leavesOps(OPS, S, RES) = RES [ owise ] .

    --- Maximal proper subsorts of a sort
    op maxSubsorts : Module Sort -> SortSet .
    eq maxSubsorts(M, S) = maxOf(M, properSubs(M, S, getSorts(M)), properSubs(M, S, getSorts(M))) .

    --- Proper subsorts of a sort
    op properSubs : Module Sort SortSet -> SortSet .
    eq properSubs(M, S, none) = none .
    eq properSubs(M, S, (S' ; SS))
        = (if S' =/= S and-then sortLeq(M, S', S) then S' else none fi) ; properSubs(M, S, SS) .

    --- Maximal elements of a set of sorts
    op maxOf : Module SortSet SortSet -> SortSet .
    eq maxOf(M, none, SS) = none .
    eq maxOf(M, (S ; SS), SS')
        = (if hasAbove(M, S, SS') then none else S fi) ; maxOf(M, SS, SS') .

    --- Check if some sort of a set is strictly above a sort
    op hasAbove : Module Sort SortSet -> Bool .
    eq hasAbove(M, S, none) = false .
    eq hasAbove(M, S, (S' ; SS))
        = (S' =/= S and-then sortLeq(M, S, S')) or-else hasAbove(M, S, SS) .

    --- Check if the kind of a sort has constructors
    op kindHasCtor : Module OpDeclSet Sort -> Bool .
    ceq kindHasCtor(M, (op F : TYL -> S [ ctor ATS ] .) OPS, S')
        = true
    if not dmcOp(F) /\ sameKind(M, S, S') .
    eq kindHasCtor(M, OPS, S) = false [ owise ] .

    --- Check if an operator was added by transformMod
    op dmcOp : Qid -> Bool .
    eq dmcOp(F) = substr(string(F), 0, 4) == "_dmc" .

    --- Check if a variable of a sort can be split into constructor patterns
    op splittable : Module Sort -> Bool .
    eq splittable(M, S) = kindHasCtor(M, getOps(M), S) and-then covPats(leaves(M, S, 0)) =/= mt .

    --- One refinement step of a pattern
    op refine : Module Term TermSet Nat -> CovRes .
    ceq refine(M, V, GENSET, N) = leaves(M, S, N)
    if S := getType(V) /\ splittable(M, S) .
    ceq refine(M, F[V, V'], GENSET, N)
        = atomSplit(F, V', atomsOfRes(M, F, leaves(M, S, N)))
        if S := getType(V) /\ getType(V') == S /\ atomOk(M, F, S) .
    eq refine(M, T, GENSET, N) = splitVar(M, T, chooseVar(M, T, GENSET), N) [ owise ] .

    --- Split a variable of a pattern
    op splitVar : Module Term TermList Nat -> CovRes .
    eq splitVar(M, T, empty, N) = noRefine .
    eq splitVar(M, T, V, N) = splitVar'(M, T, V, restOp(M, T, V), N) .
    op splitVar' : Module Term Variable Qid Nat -> CovRes .
    eq splitVar'(M, T, V, 'dmc$none, N) = substLeaves(T, V, leaves(M, getType(V), N)) .
    eq splitVar'(M, T, V, F, N) = restSplit(M, T, V, F, leaves(M, getType(V), N)) [ owise ] .

    --- Split a rest variable of an assoc operator
    op restSplit : Module Term Variable Qid CovRes -> CovRes .
    eq restSplit(M, T, V, F, RES) = restSplit'(M, T, V, F, atomsOfRes(M, F, RES)) .
    op restSplit' : Module Term Variable Qid CovRes -> CovRes .
    eq restSplit'(M, T, V, F, cov(ATOMS, N, B))
        = restPats(T, V, F, ATOMS,
                      atomsOfRes(M, F, leaves(M, getType(V), N))) .
    op restPats : Term Variable Qid TermSet CovRes -> CovRes .
    eq restPats(T, V, F, ATOMS, cov(ATOMS', N, B))
        = cov(substEach(T, V, ATOMS)
              ;; substEach(T, V, atomPats(F, covVar(getType(V), N), ATOMS')),
              s(N), false) .

    --- Atoms of an assoc operator (patterns not rooted by it)
    op atomsOfRes : Module Qid CovRes -> CovRes .
    eq atomsOfRes(M, F, cov(PATS, N, B)) = atomsOf(M, F, PATS, N) .

    --- Atoms of an assoc operator among a set of patterns
    op atomsOf : Module Qid TermSet Nat -> CovRes .
    eq atomsOf(M, F, mt, N) = cov(mt, N, false) .
    eq atomsOf(M, F, (T ;; PATS), N)
        = if rootedBy(T, F)
          then atomsOf(M, F, PATS, N)
          else if (T :: Variable) and-then admitsF(M, getOps(M), F, getType(T))
               then atomsJoin(M, F, PATS, atomsOfRes(M, F, leaves(M, getType(T), N)))
               else covAdd(T, atomsOf(M, F, PATS, N))
               fi
          fi .

    --- Join atom results
    op atomsJoin : Module Qid TermSet CovRes -> CovRes .
    eq atomsJoin(M, F, PATS, cov(ATOMS, N, B)) = covAddAll(ATOMS, atomsOf(M, F, PATS, N)) .

    --- Add patterns to a coverage result
    op covAdd : Term CovRes -> CovRes .
    eq covAdd(T, cov(PATS, N, B)) = cov(T ;; PATS, N, B) .
    op covAddAll : TermSet CovRes -> CovRes .
    eq covAddAll(ATOMS, cov(PATS, N, B)) = cov(ATOMS ;; PATS, N, B) .

    --- Check if some ctor declaration of an operator has a result sort below a sort
    op admitsF : Module OpDeclSet Qid Type -> Bool .
    ceq admitsF(M, (op F : TYL -> S [ ctor ATS ] .) OPS, F, S') = true
    if sortLeq(M, S, S') .
    eq admitsF(M, OPS, F, TP) = false [ owise ] .

    --- Operator of which a variable is a rest variable ('dmc$none if none)
    op restOp : Module TermList Variable -> Qid .
    eq restOp(M, empty, V) = 'dmc$none .
    eq restOp(M, V, V') = 'dmc$none .
    eq restOp(M, C, V) = 'dmc$none .
    eq restOp(M, F[NTL], V)
        = if directArg(V, NTL) and-then atomOk(M, F, getType(V))
          then F
          else restOp(M, NTL, V)
          fi .
    eq restOp(M, (T, NTL), V) = restOp'(restOp(M, T, V), M, NTL, V) .
    op restOp' : Qid Module NeTermList Variable -> Qid .
    eq restOp'('dmc$none, M, NTL, V) = restOp(M, NTL, V) .
    eq restOp'(F, M, NTL, V) = F [ owise ] .

    --- Check if a variable is a direct argument
    op directArg : Variable TermList -> Bool .
    eq directArg(V, (TL, V, TL')) = true .
    eq directArg(V, TL) = false [ owise ] .

    --- First rest variable
    op firstRest : Module TermList -> TermList .
    eq firstRest(M, empty) = empty .
    eq firstRest(M, V) = empty .
    eq firstRest(M, C) = empty .
    eq firstRest(M, F[NTL]) = pickFirst(restArg(M, F, NTL), firstRest(M, NTL)) .
    eq firstRest(M, (T, NTL)) = pickFirst(firstRest(M, T), firstRest(M, NTL)) .

    --- First argument that is a rest variable of the operator
    op restArg : Module Qid TermList -> TermList .
    eq restArg(M, F, empty) = empty .
    eq restArg(M, F, (V, TL))
        = if atomOk(M, F, getType(V))
          then V
          else restArg(M, F, TL)
          fi .
    eq restArg(M, F, (T, TL)) = restArg(M, F, TL) [ owise ] .

    --- First non-empty of two term lists
    op pickFirst : TermList TermList -> TermList .
    eq pickFirst(empty, TL) = TL .
    eq pickFirst(T, TL) = T .

    --- Variable chosen for the next refinement
    op chooseVar : Module Term TermSet -> TermList .
    eq chooseVar(M, T, GENSET)
        = pickFirst(guided(M, T, GENSET), pickFirst(firstRest(M, T), firstSV(M, T))) .

    --- Variable suggested by the generators that unify with the pattern
    op guided : Module Term TermSet -> TermList .
    eq guided(M, T, mt) = empty .
    eq guided(M, T, (GEN ;; GENSET))
        = pickFirst(if metaUnify(M, T =? GEN, '%, 0) :: UnificationPair then cand(M, T, GEN) else empty fi,
                    guided(M, T, GENSET)) .

    --- Variables where a generator has a non-variable subterm
    op cand : Module Term Term -> TermList .
    eq cand(M, T, V) = empty .
    eq cand(M, C, GEN) = empty .
    eq cand(M, V, C) = firstSV(M, V) .
    eq cand(M, V, F[NTL]) = firstSV(M, V) .
    eq cand(M, F[NTL], F[NTL'])
        = if acOp(getOps(M), F)
          then pickFirst(firstRest(M, F[NTL]), firstSV(M, F[NTL]))
          else candL(M, NTL, NTL')
          fi .
    eq cand(M, T, GEN) = empty [ owise ] .

    --- Candidates for a list of arguments
    op candL : Module TermList TermList -> TermList .
    eq candL(M, (T, TL), (GEN, TL')) = pickFirst(cand(M, T, GEN), candL(M, TL, TL')) .
    eq candL(M, TL, TL') = empty [ owise ] .

    --- Check if an operator is assoc
    op acOp : OpDeclSet Qid -> Bool .
    eq acOp((op F : TYL -> TP [ assoc ATS ] .) OPS, F) = true .
    eq acOp((op F : TYL -> TP [ comm ATS ] .) OPS, F) = true .
    eq acOp(OPS, F) = false [ owise ] .

    --- Split a rest variable by the atoms of an operator
    op atomSplit : Qid Variable CovRes -> CovRes .
    eq atomSplit(F, V, cov(PATS, N, B)) = cov(atomPats(F, V, PATS), N, false) .

    --- f(A, V) for each atom A not rooted by f
    op atomPats : Qid Variable TermSet -> TermSet .
    eq atomPats(F, V, mt) = mt .
    eq atomPats(F, V, (T ;; PATS))
        = (if rootedBy(T, F) then mt else F[T, V] fi) ;; atomPats(F, V, PATS) .

    --- Check if a term is rooted by an operator
    op rootedBy : Term Qid -> Bool .
    eq rootedBy(F[NTL], F) = true .
    eq rootedBy(T, F) = false [ owise ] .

    --- Check if f(Y1, Y2) can be split by its first element
    op atomOk : Module Qid Sort -> Bool .
    eq atomOk(M, F, S) = atomOk'(M, getOps(M), F, S) .
    op atomOk' : Module OpDeclSet Qid Sort -> Bool .
    ceq atomOk'(M, (op F : S S -> S [ ctor assoc ATS ] .) OPS, F, S)
        = idOk(M, ATS, S)
          and-then argsBelow(M, (op F : S S -> S [ ctor assoc ATS ] .) OPS, F, S)
        if not dmcOp(F) .
    eq atomOk'(M, OPS, F, S) = false [ owise ] .

    --- Check if the ctor declarations of an operator have arguments below a sort
    op argsBelow : Module OpDeclSet Qid Sort -> Bool .
    eq argsBelow(M, (op F : S S' -> S'' [ ctor ATS ] .) OPS, F, S''')
        = (not sortLeq(M, S'', S''') or-else (sortLeq(M, S, S''') and-then sortLeq(M, S', S''')))
          and-then argsBelow(M, OPS, F, S''') .
    eq argsBelow(M, OPS, F, S) = true [ owise ] .

    --- Check if the identity of an operator has a sort outside a sort
    op idOk : Module AttrSet Sort -> Bool .
    eq idOk(M, (id(T) ATS), S) = not sortLeq(M, leastSort(M, T), S) .
    eq idOk(M, (left-id(T) ATS), S) = false .
    eq idOk(M, (right-id(T) ATS), S) = false .
    eq idOk(M, ATS, S) = true [ owise ] .

    --- Replace the first splittable variable (left to right) by the patterns of its sort
    op firstSV : Module TermList -> TermList .
    eq firstSV(M, empty) = empty .
    eq firstSV(M, V)
        = if splittable(M, getType(V))
          then V
          else empty
          fi .
    eq firstSV(M, C) = empty .
    eq firstSV(M, F[NTL]) = firstSV(M, NTL) .
    eq firstSV(M, (T, NTL)) = firstSV'(M, firstSV(M, T), NTL) .
    op firstSV' : Module TermList NeTermList -> TermList .
    eq firstSV'(M, empty, NTL) = firstSV(M, NTL) .
    eq firstSV'(M, V, NTL) = V .

    --- Instantiate a variable of a pattern with each refinement
    op substLeaves : Term Variable CovRes -> CovRes .
    eq substLeaves(T, V, cov(PATS, N, B)) = cov(substEach(T, V, PATS), N, false) .
    op substEach : Term Variable TermSet -> TermSet .
    eq substEach(T, V, mt) = mt .
    eq substEach(T, V, (T' ;; PATS)) = applySub(T, V <- T') ;; substEach(T, V, PATS) .

    --- Initialize the variable abstraction command
    sort VarAbsPair .

    --- Variable abstraction candidates (id of the node, children)
    op {_,_} : Nat ChildNodeList -> VarAbsPair .

    --- VARIABLE ABSTRACTION command
    op variableAbstraction : Module ParentNodeList ChildNode Term Variable Nat Nat VariantOptionSet TermSet ->
                             VarAbsPair .
    eq variableAbstraction(M, PARENTS, CHILD, T, V, IDCOUNT, VCOUNT, VOS, LEMMAS)
        = variableAbstraction'(rebuildChildren(CHILD), < mod: M, vos: VOS, lemmas: LEMMAS,
                               init: rebuildParents(PARENTS),
                               next: checkConstraints(M,
                                                      genVarAbsChildren(M, rebuildChildren(CHILD), T, V, IDCOUNT, 0,
                                                                        't), LEMMAS) >, VCOUNT) .

    op variableAbstraction' : Node DMCState Nat -> VarAbsPair .
    eq variableAbstraction'({ID : NATTRS}, < next: NODES, SATTRS >, VCOUNT)
        = {ID, outputAuxCommand(renameNodes(NODES, VCOUNT))} .

    --- Child after abstracting the subterm
    op genVarAbsChildren : Module Node Term Variable Nat Nat Qid -> NodeList .
    ceq genVarAbsChildren(M, {ID : term: T, ndepth: DEPTH, NATTRS}, T', V, IDCOUNT, N, 't)
        = setNodeOrigin(applyMetaXMatchT(M, {ID : term: T, ndepth: DEPTH, NATTRS}, T', V, getContext(MATCHPAIR),
                                         (getVars(T) ;; getVars(T')), IDCOUNT, 't), ID, variableAbstractionStep,
                        'none, V <- T', DEPTH, pairDetail(T', V),
                        getNodeOrigin({ID : term: T, ndepth: DEPTH, NATTRS})) ;
          genVarAbsChildren(M, {ID : term: T, ndepth: DEPTH, NATTRS}, T', V, IDCOUNT + 1, N + 1, 't)
    if MATCHPAIR := metaXmatch(addOps(M, freeze(getVars(T) ;; getVars(T'))), freeze(T'), freeze(T), nil, 0, unbounded,
                               N) .
    eq genVarAbsChildren(M, {ID : term: T, ndepth: DEPTH, NATTRS}, T', V, IDCOUNT, N, 't)
        = genVarAbsChildren(extModule(M), {ID : term: T, ndepth: DEPTH, NATTRS},
                            T', V, IDCOUNT, N, 'c) [owise] .

    ceq genVarAbsChildren(M, {ID : ctr: CTR, ndepth: DEPTH, NATTRS}, T', V, IDCOUNT, N, 'c)
        = setNodeOrigin(applyMetaXMatchT(M, {ID : ctr: CTR, ndepth: DEPTH, NATTRS}, T', V, getContext(MATCHPAIR),
                                         (getVars(CTR) ;; getVars(T')), IDCOUNT, 'c), ID, variableAbstractionStep,
                        'none, V <- T', DEPTH, pairDetail(T', V),
                        getNodeOrigin({ID : ctr: CTR, ndepth: DEPTH, NATTRS})) ;
          genVarAbsChildren(M, {ID : ctr: CTR, ndepth: DEPTH, NATTRS}, T', V, IDCOUNT + 1, N + 1, 'c)
    if MATCHPAIR := metaXmatch(addOps(M, freeze(getVars(CTR) ;; getVars(T'))), freeze(T'), freeze(CTR), nil, 0,
                               unbounded, N) .
    eq genVarAbsChildren(M, {ID : ctr: CTR, ndepth: DEPTH, NATTRS}, T', V,
                         IDCOUNT, N, 'c)
        = nil [owise] .

    --- Check folding of the abstracted child
    op applyVarAbs : Module ChildNode ParentNodeList VariantOptionSet TermSet -> ChildNodeList .
    eq applyVarAbs(M, CHILD, PARENTS, VOS, LEMMAS)
        = outputAuxCommand(checkSubsumption(M, rebuildChildren(CHILD), rebuildParents(PARENTS), VOS, LEMMAS)) .

    --- Children of a candidate pair
    op getChildren : VarAbsPair -> ChildNodeList .
    eq getChildren({N, CHILDREN}) = CHILDREN .

    --- SUBSTITUTION command
    op subsCommand : Module ParentNodeList ChildNode Variable Term Nat Nat VariantOptionSet TermSet -> ChildNodeList .
    eq subsCommand(M, PARENTS, CHILD, V, T', IDCOUNT, VCOUNT, VOS, LEMMAS)
        = checkAuxCommand(< mod: M, vos: VOS, lemmas: LEMMAS, init: rebuildParents(PARENTS),
                          next: checkConstraints(M, subsCommandChild(M, rebuildChildren(CHILD), V, T', IDCOUNT),
                                                 LEMMAS) >, VCOUNT) .

    --- Child of a substitution (new id)
    op subsCommandChild : Module Node Variable Term Nat -> Node .
    eq subsCommandChild(M, {ID : ndepth: DEPTH, NATTRS}, V, T, IDCOUNT)
        = setNodeOrigin(applySubToNode(M, {ID : ndepth: DEPTH, NATTRS}, (V <- T), IDCOUNT),
                        ID, substitutionStep, 'none, V <- T, DEPTH,
                        pairDetail(V, T),
                        getNodeOrigin({ID : ndepth: DEPTH, NATTRS})) .

    --- VARIANT UNIFY command
    op vunify : Module ParentNodeList ChildNode Term Term Nat Nat VariantOptionSet TermSet  -> ChildNodeList .
    eq vunify(M, PARENTS, CHILD, T, T', IDCOUNT, VCOUNT, VOS, LEMMAS)
        = vunify'(M, PARENTS, CHILD, absTerms(nvOps(M), M, (T, T'), 1), IDCOUNT, VCOUNT, VOS, LEMMAS) .

    --- Abstract non-variant subterms before variant unification
    op vunify' : Module ParentNodeList ChildNode AbsResult Nat Nat VariantOptionSet TermSet -> ChildNodeList .
    eq vunify'(M, PARENTS, CHILD, absR((T, T'), TL, N), IDCOUNT, VCOUNT, VOS, LEMMAS)
        = finishAux(< mod: M, vos: VOS, lemmas: LEMMAS,
                      init: rebuildParents(PARENTS) >,
                    genVUnifyChildren(M, addAbsCtr(rebuildChildren(CHILD), TL), T, T', IDCOUNT, 0), VCOUNT) .

    --- Finish an auxiliary command (incomplete results are not applied)
    op finishAux : DMCState NodeList Nat -> ChildNodeList .
    eq finishAux(< mod: M, lemmas: LEMMAS, SATTRS >, NODES, VCOUNT)
        = if hasIncomplete(NODES)
          then incompleteChild(incompleteKind(NODES), incompleteIds(NODES))
          else checkAuxCommand(< mod: M, lemmas: LEMMAS, SATTRS,
                                 next: checkConstraints(M, NODES, LEMMAS) >, VCOUNT)
          fi .

    --- Number of variant unifiers
    op vunifyCount : Module Term Term -> Nat .
    eq vunifyCount(M, T, T') = vunifyCount'(M, absTerms(nvOps(M), M, (T, T'), 1), 0) .
    op vunifyCount' : Module AbsResult Nat -> Nat .
    eq vunifyCount'(M, absR((T, T'), TL, N'), N)
        = if metaVariantUnify(M, T =? T', empty, '@, filter delay, N) :: UnificationPair
          then s(vunifyCount'(M, absR((T, T'), TL, N'), s(N)))
          else 0
          fi .

    --- Add the equations of the abstracted subterms to the constraint
    op addAbsCtr : Node TermList -> Node .
    eq addAbsCtr(NODE, empty) = NODE .
    eq addAbsCtr({ID : ctr: CTR, NATTRS}, NTL) = {ID : ctr: simpCtr('_/\_[CTR, NTL]), NATTRS} .

    --- Operators with non-variant equations
    op nvOps : Module -> QidSet .
    eq nvOps(M) = nvOps(getEqs(M)) .
    op nvOps : EquationSet -> QidSet .
    eq nvOps((none).EquationSet) = (none).QidSet .
    eq nvOps((eq LHS = RHS [ ATS ] .) EQS)
        = (if hasVariantAttr(ATS) then (none).QidSet else topName(LHS) fi) ; nvOps(EQS) .
    eq nvOps((ceq LHS = RHS if COND [ ATS ] .) EQS) = topName(LHS) ; nvOps(EQS) .

    --- Check if an equation has the variant attribute
    op hasVariantAttr : AttrSet -> Bool .
    eq hasVariantAttr(variant ATS) = true .
    eq hasVariantAttr(ATS) = false [owise] .

    --- Top operator of a term
    op topName : Term -> Qid .
    eq topName(F[NTL]) = F .
    eq topName(C) = getName(C) .
    eq topName(V) = getName(V) .

    sort AbsResult .

    --- Result of absTerms: terms, equations, next index
    op absR : TermList TermList Nat -> AbsResult [ctor] .

    --- Abstract the subterms rooted by those operators
    op absTerms : QidSet Module TermList Nat -> AbsResult .
    eq absTerms(QS, M, empty, N) = absR(empty, empty, N) .
    eq absTerms(QS, M, T, N) = absTerm(QS, M, T, N) .
    eq absTerms(QS, M, (T, NTL), N) = absJoin(absTerm(QS, M, T, N), QS, M, NTL) .

    --- Abstraction of the arguments of a term
    op absJoin : AbsResult QidSet Module NeTermList -> AbsResult .
    eq absJoin(absR(TL, TL', N), QS, M, NTL) = absCons(TL, TL', absTerms(QS, M, NTL, N)) .

    --- Prepend a term and its equations to a result
    op absCons : TermList TermList AbsResult -> AbsResult .
    eq absCons(TL, TL', absR(TL'', TL''', N)) = absR((TL, TL''), (TL', TL'''), N) .

    --- Abstraction of one term
    op absTerm : QidSet Module Term Nat -> AbsResult .
    eq absTerm(QS, M, V, N) = absR(V, empty, N) .
    eq absTerm((Q ; QS), M, C, N)
        = if getName(C) == Q
          then absR(absVar(M, C, N), '_=_[absVar(M, C, N), C], s(N))
          else absTerm(QS, M, C, N)
          fi .
    eq absTerm(QS, M, C, N) = absR(C, empty, N) [owise] .
    eq absTerm((F ; QS), M, F[NTL], N)
        = absR(absVar(M, F[NTL], N), '_=_[absVar(M, F[NTL], N), F[NTL]], s(N)) .
    eq absTerm(QS, M, F[NTL], N) = absWrap(F, absTerms(QS, M, NTL, N)) [owise] .

    --- Rebuild a term over its abstracted arguments
    op absWrap : Qid AbsResult -> AbsResult .
    eq absWrap(F, absR(NTL, TL, N)) = absR(F[NTL], TL, N) .

    --- Fresh variable for an abstracted subterm
    op absVar : Module Term Nat -> Variable .
    eq absVar(M, T, N) = qid("$$A" + string(N, 10) + ":" + string(leastSort(M, T))) .

    --- Check if an equation has a variant unifier (after abstraction)
    op hasVariantUnifierAbs : Module Term Term -> Bool .
    eq hasVariantUnifierAbs(M, T, T') = hasVariantUnifierAbs'(M, absTerms(nvOps(M), M, (T, T'), 1)) .
    op hasVariantUnifierAbs' : Module AbsResult -> Bool .
    eq hasVariantUnifierAbs'(M, absR((T, T'), TL, N)) = hasVariantUnifier(M, T, T') .

    --- Check if an equation has a variant unifier
    op hasVariantUnifier : Module Term Term -> Bool .
    eq hasVariantUnifier(M, T, T')
        = hasVariantUnifier'(metaVariantUnify(M, T =? T', empty, '@, filter delay, 0)) .
    op hasVariantUnifier' : UnificationPair? -> Bool .
    eq hasVariantUnifier'(UPAIR) = true .
    eq hasVariantUnifier'((noUnifierIncomplete).UnificationPair?) = true .
    eq hasVariantUnifier'(UP?) = false [owise] .

    --- One child per variant unifier
    op genVUnifyChildren : Module Node Term Term Nat Nat -> NodeList .
    eq genVUnifyChildren(M, {ID : ndepth: DEPTH, NATTRS}, T, T', IDCOUNT, N)
        = genVUnifyChildren'(M, {ID : ndepth: DEPTH, NATTRS}, T, T', IDCOUNT, N,
                             metaVariantUnify(M, T =? T', empty, '@, filter delay, N)) .
    eq genVUnifyChildren(M, NODE, T, T', IDCOUNT, N) = nil [owise] .

    --- Mark the node if unification may be incomplete
    op genVUnifyChildren' : Module Node Term Term Nat Nat UnificationPair? -> NodeList .
    eq genVUnifyChildren'(M, {ID : ndepth: DEPTH, NATTRS}, T, T', IDCOUNT, N, UPAIR)
        = setNodeOrigin(applySubToNode(M, {ID : ndepth: DEPTH, NATTRS},
                                       getSubstitution(UPAIR), IDCOUNT),
                        ID, variantUnificationStep, 'none,
                        getSubstitution(UPAIR), DEPTH, pairDetail(T, T'),
                        getNodeOrigin({ID : ndepth: DEPTH, NATTRS})) ;
          genVUnifyChildren(M, {ID : ndepth: DEPTH, NATTRS}, T, T',
                            IDCOUNT + 1, N + 1) .
    eq genVUnifyChildren'(M, {ID : NATTRS}, T, T', IDCOUNT, N, (noUnifierIncomplete).UnificationPair?)
        = incompleteNode('unification, ID) .
    eq genVUnifyChildren'(M, NODE, T, T', IDCOUNT, N, UP?) = nil [owise] .

    --- NARROWING command
    op narrow : Module ParentNodeList ChildNode Term Nat Nat VariantOptionSet TermSet  -> ChildNodeList .
    eq narrow(M, PARENTS, CHILD, T, IDCOUNT, VCOUNT, VOS, LEMMAS)
        = finishAux(< mod: M, vos: VOS, lemmas: LEMMAS,
                      init: rebuildParents(PARENTS) >,
                    genNarrowChildren(M, rebuildChildren(CHILD), T, IDCOUNT, 0), VCOUNT) .

    --- One child per narrowing step on the subterm
    op genNarrowChildren : Module Node Term Nat Nat -> NodeList .
    eq genNarrowChildren(M, NODE, T, IDCOUNT, N)
        = genNarrowChildren'(M, NODE, T, IDCOUNT, N,
                             metaNarrowingApply(narrowMod(M, T), T, empty, '@, none, N)) .

    --- Number of narrowing steps of a subterm
    op narrowCount : Module Term -> Nat .
    eq narrowCount(M, T) = narrowCount'(narrowMod(M, T), T, 0) .
    op narrowCount' : Module Term Nat -> Nat .
    eq narrowCount'(M, T, N)
        = if metaNarrowingApply(M, T, empty, '@, none, N) :: NarrowingApplyResult
          then s(narrowCount'(M, T, s(N)))
          else 0
          fi .

    --- Mark the node if narrowing may be incomplete
    op genNarrowChildren' : Module Node Term Nat Nat NarrowingApplyResult? -> NodeList .
    eq genNarrowChildren'(M, NODE, T, IDCOUNT, N, NAR)
        = applyNarrowingResult(M, NODE, T, NAR, IDCOUNT);
          genNarrowChildren(M, NODE, T, IDCOUNT + 1, N + 1) .
    eq genNarrowChildren'(M, {ID : NATTRS}, T, IDCOUNT, N, (failureIncomplete).NarrowingApplyResult?)
        = incompleteNode('narrow, ID) .
    eq genNarrowChildren'(M, NODE, T, IDCOUNT, N, NAR?) = nil [owise] .

    --- Check if narrowing a term has a step
    op hasNarrowingStep : Module Term -> Bool .
    eq hasNarrowingStep(M, T)
        = hasNarrowingStep'(metaNarrowingApply(narrowMod(M, T), T, empty, '@, none, 0)) .
    op hasNarrowingStep' : NarrowingApplyResult? -> Bool .
    eq hasNarrowingStep'(NAR) = true .
    eq hasNarrowingStep'((failureIncomplete).NarrowingApplyResult?) = true .
    eq hasNarrowingStep'(NAR?) = false [owise] .

    --- Conditional rules of narrowMod (with := or membership conditions)
    op narrowCondRls : Module Term -> RuleSet .
    eq narrowCondRls(M, T) = condRls(getRls(narrowMod(M, T))) .
    op condRls : RuleSet -> RuleSet .
    eq condRls((crl T => T' if COND [ATS] .) RLS) = (crl T => T' if COND [ATS] .) condRls(RLS) .
    eq condRls(RLS) = none [owise] .

    --- Maximal subterms below the root whose operator has equations
    op narrowDefSubterms : Module Term -> TermList .
    eq narrowDefSubterms(M, F[NTL]) = defArgs(F, eqOps(getEqs(M)), NTL) .
    eq narrowDefSubterms(M, T) = empty [owise] .
    op defArgs : Qid QidSet TermList -> TermList .
    eq defArgs(F, QS, empty) = empty .
    eq defArgs(F, QS, (T, TL)) = defSub(F, QS, T), defArgs(F, QS, TL) .
    op defSub : Qid QidSet Term -> TermList .
    eq defSub(F, QS, V) = empty .
    eq defSub(F, QS, C)
        = if getName(C) =/= F and-then inQ(getName(C), QS)
          then C
          else empty
          fi .
    eq defSub(F, QS, F'[NTL])
        = if F' =/= F and-then inQ(F', QS)
          then F'[NTL]
          else defArgs(F, QS, NTL)
          fi .

    --- Operators at the top of the left-hand side of some equation
    op eqOps : EquationSet -> QidSet .
    eq eqOps((none).EquationSet) = (none).QidSet .
    eq eqOps((eq LHS = RHS [ATS] .) EQS) = topName(LHS) ; eqOps(EQS) .
    eq eqOps((ceq LHS = RHS if COND [ATS] .) EQS) = topName(LHS) ; eqOps(EQS) .
    op inQ : Qid QidSet -> Bool .
    eq inQ(Q, (Q ; QS)) = true .
    eq inQ(Q, QS) = false [owise] .

    --- Child of a narrowing step on a subterm
    op applyNarrowingResult : Module Node Term NarrowingApplyResult Nat -> Node .
    eq applyNarrowingResult(M, {ID : ctr: CTR, ndepth: DEPTH, NATTRS}, T,
                            {'_dmc>_[CTR', T'], TP, CTX, Q, SB, SB', Q'}, IDCOUNT)
        = setNodeOrigin(applySubToNode(M,
              replaceTermInNode(T, T',
                {ID : ctr: ('_/\_[CTR, buildCtr(CTR')]), ndepth: DEPTH, NATTRS}),
              SB, IDCOUNT),
            ID, auxiliaryNarrowingStep, Q, SB, DEPTH, termDetail(T),
            getNodeOrigin({ID : ctr: CTR, ndepth: DEPTH, NATTRS})) .

    --- Condition below the root of the narrowed subterm
    ceq applyNarrowingResult(M, {ID : ctr: CTR, ndepth: DEPTH, NATTRS}, T,
                            {T', TP, CTX, Q, SB, SB', Q'}, IDCOUNT)
        = setNodeOrigin(applySubToNode(M,
              replaceTermInNode(T, dmcTerm(T'),
                {ID : ctr: ('_/\_[CTR, buildCtr(NTL)]), ndepth: DEPTH, NATTRS}),
              SB, IDCOUNT),
            ID, auxiliaryNarrowingStep, Q, SB, DEPTH, termDetail(T),
            getNodeOrigin({ID : ctr: CTR, ndepth: DEPTH, NATTRS}))
    if not dmcAtTop(T') /\ NTL := dmcConds(T') .
    eq applyNarrowingResult(M, {ID : ndepth: DEPTH, NATTRS}, T,
                            {T', TP, CTX, Q, SB, SB', Q'}, IDCOUNT)
        = setNodeOrigin(applySubToNode(M,
              replaceTermInNode(T, T', {ID : ndepth: DEPTH, NATTRS}), SB, IDCOUNT),
            ID, auxiliaryNarrowingStep, Q, SB, DEPTH, termDetail(T),
            getNodeOrigin({ID : ndepth: DEPTH, NATTRS})) [owise] .

    --- GENERALIZE command
    op generalize : Module ParentNodeList ChildNodeList NeTermList Nat Nat VariantOptionSet TermSet QidList ->
                    ChildNodeList .
    eq generalize(M, PARENTS, CHILDREN, '_|_[T', CTR'], VCOUNT, IDCOUNT, VOS, LEMMAS, QL)
        = generalize'(< mod: M, vos: VOS, lemmas: LEMMAS, init: rebuildParents(PARENTS),
                      prev: keepChildren(rmvChildren(CHILDREN, QLtoNL(QL)), QLtoNL(QL)),
                      next: checkConstraints(M,
                                             applyGeneralize(selectChildren(CHILDREN, QLtoNL(QL)), '_|_[T', CTR'],
                                                             VCOUNT, IDCOUNT), LEMMAS) >) .

    op generalize' : DMCState -> ChildNodeList .
    eq generalize'(< prev: NODES, next: nil, SATTRS >)
        = outputAuxCommand(NODES) .
    eq generalize'(< mod: M, vos: VOS, lemmas: LEMMAS, init: NODES, prev: NODES', next: NODES'', SATTRS >)
        = outputAuxCommand(NODES' ; checkSubsumption(M, NODES'', NODES, VOS, LEMMAS)) .

    --- Check if a node is covered by the generalization pattern
    op nodeCovered : Module Term Term Term Term TermSet Nat -> Bool .
    ceq nodeCovered(M, T, CTR, T', CTR', LEMMAS, N)
        = if isSat(callNuITP(M, '_->_[CTR, applySub(CTR', SB')], LEMMAS))
          then true
          else nodeCovered(M, T, CTR, T', CTR', LEMMAS, N + 1)
          fi
    if SB' := metaVariantMatch(M, T' <=? T, empty, '@, none, N) .
    eq nodeCovered(M, T, CTR, T', CTR', LEMMAS, N) = false [owise] .

    --- Ids of the selected nodes not covered by the generalization pattern
    op uncoveredNodes : Module ChildNodeList NeTermList TermSet -> String .
    eq uncoveredNodes(M, CHILDREN, NTL, LEMMAS) = uncoveredNodes'(M, CHILDREN, NTL, LEMMAS, "") .
    op uncoveredNodes' : Module ChildNodeList NeTermList TermSet String -> String .
    eq uncoveredNodes'(M, noChildren, '_|_[T', CTR'], LEMMAS, STR) = STR .
    eq uncoveredNodes'(M, ([ ID, PID, T, CTR, RL, SB, ACSB, MLIST, N, ORIGIN ], CHILDREN),
                      '_|_[T', CTR'], LEMMAS, STR)
        = uncoveredNodes'(M, CHILDREN, '_|_[T', CTR'], LEMMAS, STR +
           (if nodeCovered(M, T, CTR, T', CTR', LEMMAS, 0)
            then ""
            else " " + string(ID, 10)
            fi)) .
    eq uncoveredNodes'(M, CHILDREN, NTL, LEMMAS, STR)
        = STR + " (the pattern must be a single constrained pattern)" [owise] .

    --- Children replaced by the generalization pattern
    op applyGeneralize : ChildNodeList NeTermList Nat Nat -> NodeList .

    --- Each generalized child gets a new id
    eq applyGeneralize(noChildren, TL, VCOUNT, IDCOUNT) = nil .
    eq applyGeneralize(([ ID, PID, T, CTR, RL, SB, ACSB, MLIST, N, ORIGIN ], CHILDREN),
                       '_|_[T', CTR'], VCOUNT, IDCOUNT)
        = {IDCOUNT : pid: ID,
           term: applySub(T', rename(getVars((T', CTR')), VCOUNT)),
           ctr: applySub(CTR', rename(getVars((T', CTR')), VCOUNT)),
           rule: 'none, sub: none, acsub: none,
           origin: origin(ID, generalizationStep, 'none, none, none, N,
                          pairDetail(
                            applySub(T', rename(getVars((T', CTR')), VCOUNT)),
                            applySub(CTR', rename(getVars((T', CTR')), VCOUNT))),
                          noMatch, srcState(T, CTR, ACSB, ORIGIN)),
           match: noMatch, ndepth: N, ntype: gNode, fold: false} ;
          applyGeneralize(CHILDREN, '_|_[T', CTR'],
                          VCOUNT + countVars(getVars((T', CTR'))), s(IDCOUNT)) .

    --- SPLIT command
    op split : Module ParentNodeList ChildNode Term Nat Nat VariantOptionSet TermSet  -> ChildNodeList .
    eq split(M, PARENTS, CHILD, T, IDCOUNT, VCOUNT, VOS, LEMMAS)
        = checkAuxCommand(< mod: M, vos: VOS, lemmas: LEMMAS, init: rebuildParents(PARENTS),
                          next: checkConstraints(M, splitPattern(M, rebuildChildren(CHILD), T, IDCOUNT), LEMMAS) >,
                          VCOUNT) .

    --- Children where the Boolean term is True and False
    op splitPattern : Module Node Term Nat -> NodeList .
    eq splitPattern(M, {ID : ctr: CTR, ndepth: DEPTH, NATTRS}, T, IDCOUNT)
        = setNodeOrigin(
            {IDCOUNT : ctr: getTerm(metaRewrite(noRlsExt(M),
                              '_/\_[CTR,'_=_[T,'True.Bool]], unbounded)),
                       ndepth: DEPTH, NATTRS},
            ID, splitStep, 'none, none, DEPTH, termDetail(T),
            getNodeOrigin({ID : ctr: CTR, ndepth: DEPTH, NATTRS})) ;
          setNodeOrigin(
            {IDCOUNT + 1 : ctr: getTerm(metaRewrite(noRlsExt(M),
                                  '_/\_[CTR,'_=_[T,'False.Bool]], unbounded)),
                           ndepth: DEPTH, NATTRS},
            ID, splitStep, 'none, none, DEPTH, termDetail(T),
            getNodeOrigin({ID : ctr: CTR, ndepth: DEPTH, NATTRS})) .
endm

mod DM-CHECK is
    pr CHECK-INVARIANT .
    pr GEN-INVARIANT .
    pr CHECK-SUBSUMED .
    pr CHECK-INTERSECTION .
    pr AUX-COMMANDS .
endm

mod DM-CHECK-DISJUNCTION is
    pr QID-LIST .
    pr TRUTH-VALUE .

    sorts Eq ConjEq ConstTerm Disjunction Bubble .
    subsort ConstTerm < Disjunction .
    subsorts Eq < ConjEq < Bool .

    --- Syntax of the disjunctions of constrained patterns
    op bubble : QidList -> Bubble [ special (id-hook Bubble (1 -1 `( `)) op-hook qidListSymbol (__ : QidList QidList ~> QidList) op-hook qidSymbol (<Qids> : ~> Qid) id-hook Exclude ( \/ /\ | = )) ] .

    op _\/_ : Disjunction Disjunction -> Disjunction [ ctor assoc prec 60 ] .
    op _|_ : Bubble Bool -> ConstTerm [ ctor prec 50 ] .
    op _=_ : Bubble Bubble -> Eq [ ctor prec 40 ] .
    op _/\_ : ConjEq ConjEq -> ConjEq [ ctor assoc prec 45 ] .
endm

mod DM-CHECK-STRING is
    pr DM-CHECK .
    pr LEXICAL .

    var M : Module .
    vars Q RL : Qid .
    var NTL : NeTermList .
    var LEMMAS? : TermSet .
    var LEMMAS : NeTermSet .
    vars T T' T'' CTR IMPLICATION LHS RHS : Term .
    var TL : TermList .
    vars ID ID' PID MID N : Nat .
    var PROOF : ProofState .
    vars MATCH SB SB' ACSB LSB RSB : Substitution .
    var V : Variable .
    var ML : MatcherList .
    var NML : NeMatcherList .
    vars POS STR STR' STR'' : String .
    vars PARENTS PARENTS' : ParentNodeList .
    vars CHILDREN CHILDREN' : ChildNodeList .
    vars CHILD CHILD' : ChildNode .
    var OUTPUT : DMCOutput .
    var ORIGIN : NodeOrigin .
    var STEP : StepKind .
    var DETAIL : TraceDetail .
    vars PARENT PARENT' : ParentNode .
    vars B B' : Bool .
    var ATS : AttrSet .
    var RLS : RuleSet .
    var RULE : Rule .
    var PIDS : NatList .

    --- Colors and banner
    ops GREEN BLUE YELLOW CYAN BW : -> String .
    eq CYAN = "\033[1;36m" .
    eq GREEN = "\033[1;32m" .
    eq BLUE = "\033[1;34m" .
    eq YELLOW = "\033[1;33m" .
    eq BW = "\033[0m" .

    --- Version and build date
    op DMC-VERSION : -> String .
    eq DMC-VERSION = "public alpha 12" .

    op DMC-BUILT : -> String .
    eq DMC-BUILT = "Oct 26th 2026" .

    --- Startup banner
    op DMC-BANNER : -> String .
    eq DMC-BANNER
        = BW +
          "\n" +
          "\n    ===========================================" +
          "\n                     " +
              BLUE + "DM-Check" + BW +
          "\n              Deductive Model Checker" +
          "\n            for Maude Rewrite Theories" +
          "\n" +
          "\n       " +
              YELLOW + "(" + DMC-VERSION +
              " built " + DMC-BUILT + ")" +
              BW +
          "\n    ===========================================" +
          "\n                 Copyright 2023-2026" +
          "\n         Universitat Politècnica de València" +
          "\n    ===========================================" +
          "\n\n\n" + BW .

    --- Help text
    op helpText : -> String .
    eq helpText
        = ("\n" +
           BLUE +
           "  ===========================================\n" +
           "              DM-Check Command Help\n" +
           "  ===========================================\n\n" +
           BW +

           BLUE + "  SESSION\n" + BW +
           "  -------------------------------------------\n" +
           GREEN + "  quit / q" + BW +
           "                                                  Exit DM-Check\n" +
           GREEN + "  load <file>" + BW +
           "                                               Run the commands of a script file\n" +
           GREEN + "  save proof <file> ." + BW +
           "                                       Save the accepted commands as a script\n" +
           GREEN + "  set module <M> ." + BW +
           "                                          Set the active verification module\n\n" +

           BLUE + "  INSPECTION\n" + BW +
           "  -------------------------------------------\n" +
           GREEN + "  show module ." + BW +
           "                                             Show the active module\n" +
           GREEN + "  show lemmas ." + BW +
           "                                             List the current lemmas\n" +
           GREEN + "  show last ." + BW +
           "                                               Show the last result or proof tree\n" +
           GREEN + "  show obligations ." + BW +
           "                                        Show pending proof obligations\n" +
           GREEN + "  show path <id> ." + BW +
           "                                          Show the steps from the initial pattern\n" +
           GREEN + "  show path states <id> ." + BW +
           "                                   Show only the nodes of that path\n\n" +

           BLUE + "  VERIFICATION\n" + BW +
           "  -------------------------------------------\n" +
           GREEN + "  check ind-invariant <φ> ." + BW +
           "                                 Check inductive invariant\n" +
           GREEN + "  generate ind-invariant <φ> ." + BW +
           "                              Initialize invariant generation\n" +
           GREEN + "  generate next level ." + BW +
           "                                     Generate the next symbolic frontier\n" +
           GREEN + "  check φ1 subsumed by φ2 ." + BW +
           "                                 Check symbolic containment\n" +
           GREEN + "  intersect φ1 with φ2 ." + BW +
           "                                    Compute symbolic intersection\n\n" +

           BLUE + "  PATTERN EQUIVALENCE AND GENERALIZATION\n" + BW +
           "  -------------------------------------------\n" +
           GREEN + "  case to <id> on <v> with <G> ." + BW +
           "                            Split on a generator set\n" +
           GREEN + "  variable abstraction <term> with <variable> in <id> ." + BW +
           "     Apply variable abstraction\n" +
           GREEN + "  split <id> with <term> ." + BW +
           "                                  Split on a Boolean term\n" +
           GREEN + "  variant unify <t1> =? <t2> in <id> ." + BW +
           "                      Apply variant unification\n" +
           GREEN + "  narrowing <id> on <term> ." + BW +
           "                                Apply a narrowing step\n" +
           GREEN + "  substitution to <id> on <v> with <t> ." + BW +
           "                    Apply an explicit substitution\n" +
           GREEN + "  generalize <id> to <pattern> ." + BW +
           "                            Generalize a constrained pattern\n\n" +

           BLUE + "  PROOF MANAGEMENT\n" + BW +
           "  -------------------------------------------\n" +
           GREEN + "  add lemma <lemma> ." + BW +
           "                                       Add an auxiliary lemma and rerun\n" +
           GREEN + "  reset lemmas ." + BW +
           "                                            Remove the added lemmas\n" +
           GREEN + "  empty <id> ." + BW +
           "                                              Mark a child or term as empty\n" +
           GREEN + "  lemma <id> ." + BW +
           "                                              Generate a proof obligation\n" +
           GREEN + "  lemma <id> match <matcher> ." + BW +
           "                              Select a matching obligation\n" +
           GREEN + "  contained <id> ." + BW +
           "                                          Mark a child as contained\n\n" +

           "  Arguments enclosed in <...> must be replaced by actual values.\n" +
           "  Commands must end with a period where shown.\n\n"
          ) .

    --- Error Messages
    op errorMsg : Nat -> String .
    op errorMsg : Nat Nat -> String .
    op errorMsg : Nat String -> String .
    op errorMsg : Nat String String -> String .
    op errorMsg : Nat String String String -> String .
    eq errorMsg(0) = "\n\033[1;31m  Error:\033[0m unexpected error.\n\n" .
    eq errorMsg(1) = "\n\033[1;31m  Error:\033[0m module not loaded.\n\n" .
    eq errorMsg(2) = "\n\033[1;31m  Error:\033[0m error while parsing invariant.\n\n" .
    eq errorMsg(3) = "\n\033[1;31m  Error:\033[0m error while parsing command.\n\n" .
    eq errorMsg(4) = "\n\033[1;31m  Error:\033[0m error while parsing lemma.\n\n" .
    eq errorMsg(5) = "\n\033[1;31m  Error:\033[0m no previous result available.\n\n" .
    eq errorMsg(6) = "\n\033[1;31m  Error:\033[0m no child nodes found.\n\n" .
    eq errorMsg(7) = "\n\033[1;31m  Error:\033[0m no matcher found.\n\n" .
    eq errorMsg(8) = "\n\033[1;31m  Error:\033[0m no lemma found.\n\n" .
    eq errorMsg(9) = "\n\033[1;31m  Error:\033[0m command not available for intersection results.\n\n" .
    eq errorMsg(10) = "\n\033[1;31m  Error:\033[0m error while parsing variable.\n\n" .
    eq errorMsg(11) = "\n\033[1;31m  Error:\033[0m error while parsing generator set.\n\n" .
    eq errorMsg(12) = "\n\033[1;31m  Error:\033[0m variable clash between generator set and child node.\n\n" .
    eq errorMsg(13) = "\n\033[1;31m  Error:\033[0m error while parsing subterm.\n\n" .
    eq errorMsg(14) = "\n\033[1;31m  Error:\033[0m variable clash between term and variable.\n\n" .
    eq errorMsg(15)
        = "\n\033[1;31m  Error:\033[0m the replacement term contains the selected variable (cyclic " +
          "substitution).\n" + "  The command was not applied.\n\n" .
    eq errorMsg(16) = "\n\033[1;31m  Error:\033[0m error while parsing left-hand unification term.\n\n" .
    eq errorMsg(17) = "\n\033[1;31m  Error:\033[0m error while parsing right-hand unification term.\n\n" .
    eq errorMsg(18) = "\n\033[1;31m  Error:\033[0m cannot apply narrowing to the selected operator.\n\n" .
    eq errorMsg(19) = "\n\033[1;31m  Error:\033[0m subterm not found.\n\n" .
    eq errorMsg(20) = "\n\033[1;31m  Error:\033[0m variable not found.\n\n" .
    eq errorMsg(21) = "\n\033[1;31m  Error:\033[0m invalid pattern for generalization.\n\n" .
    eq errorMsg(23)
        = "\n\033[1;31m  Error:\033[0m command only available for check or generate ind-invariant " + "results.\n" +
          "\n" .
    eq errorMsg(24)
        = "\n\033[1;31m  Error:\033[0m split adds the constraints <term> = True and <term> = False, " +
          "so the term must\n" +
          "  have sort Bool and the module must declare the constants True and False of sort Bool\n" +
          "  (NuITP convention, not the true/false of the Maude prelude).\n\n" .
    eq errorMsg(25)
        = "\n\033[1;31m  Error:\033[0m all variables in the expression to split must appear in the " +
          "selected pattern.\n" + "\n" .
    eq errorMsg(26, 1)
        = "\n\033[1;33m  Warning:\033[0m a non-conditional rule does not include the narrowing " + "label.\n" .
    eq errorMsg(26, N)
        = "\n\033[1;33m  Warning:\033[0m " + string(N, 10) +
          " non-conditional rules do not include the narrowing label.\n" [ owise ] .
    eq errorMsg(27)
        = "\n\033[1;33m  Warning:\033[0m command deprecated. " +
          "Recheck is now performed automatically when required.\n" + "\n" .
    eq errorMsg(29)
        = "\n\033[1;31m  Error:\033[0m the variable and the selected term do not have the same " + "sort.\n" +
          "  The command was not applied. With a variable of a smaller sort the\n" +
          "  abstraction would lose the instances outside that sort.\n\n" .
    eq errorMsg(30)
        = "\n\033[1;31m  Error:\033[0m the replacement term is not sort-compatible with the selected " +
          "variable.\n" + "\n" .
    eq errorMsg(31) = "\n\033[1;31m  Error:\033[0m node not found in the last result.\n\n" .
    eq errorMsg(33)
        = "\n\033[1;31m  Error:\033[0m the command produced an ill-formed result (internal error) " +
          "and was not applied.\n" + "\n" .
    eq errorMsg(34)
        = "\n\033[1;31m  Error:\033[0m the command uses the built-in _==_ or _=/=_.\n" +
          "  Maude evaluates them syntactically on terms with variables (N == 0\n" +
          "  reduces to false), so DM-Check cannot use them. Use a predicate defined\n" +
          "  with variant equations instead (e.g. eq N .=. N = True [variant] .).\n\n" .
    eq errorMsg(35)
        = "\n\033[1;31m  Error:\033[0m the replacement term has variables that do not occur in the " + "node.\n" +
          "  Such a substitution cannot follow from the constraint of the node, so it\n" +
          "  could lose states. The command was not applied. To introduce new variables,\n" +
          "  first name the subterm with variable abstraction (va), which records the\n" +
          "  defining equation in the constraint.\n\n" .
    eq errorMsg(36)
        = "\n\033[1;31m  Error:\033[0m every term of the generator set must have the sort of the " + "selected\n" +
          "  variable or one of its subsorts. The command was not applied.\n\n" .
    eq errorMsg(37)
        = "\n\033[1;31m  Error:\033[0m generalize takes a single constrained pattern (t | C); the " +
          "pattern given\n" +
          "  is a disjunction. Apply generalize once for each pattern, to the nodes it covers.\n" +
          "  The command was not applied.\n\n" .
    eq errorMsg(38)
        = "\n\033[1;31m  Error:\033[0m the equation has variables that do not occur in the node.\n" +
          "  Its justification (every state of the node satisfies the equation for SOME\n" +
          "  value of those variables) can be neither checked nor recorded as a proof\n" +
          "  obligation. The command was not applied. If one side, t1, has only variables\n" +
          "  of the node and the other, t2, is a constructor term, do the step in three\n" +
          "  commands:\n    1. va t1 with X in <id> .       (skip it if t1 is already a variable)\n" +
          "    2. case to <id2> on X with t2 . (checks that t2 covers every value of X)\n" +
          "    3. vunify t1 =? t2 in <id3> .   (now t2 only has variables of the node)\n\n" .
    eq errorMsg(39)
        = "\n\033[1;31m  Error:\033[0m the generator set must contain only constructor terms, " + "built from\n" +
          "  variables and operators declared with the ctor attribute.\n" + "  The command was not applied.\n\n" .
    eq errorMsg(40)
        = "\n\033[1;31m  Error:\033[0m generate next level only continues a result of\n" +
          "  generate ind-invariant.\n\n" .
    eq errorMsg(41) = "\n\033[1;31m  Error:\033[0m no variable abstraction is waiting for a selection.\n\n" .
    eq errorMsg(42, STR, STR', STR'')
        = "\n\033[1;31m  Error:\033[0m no unifier for " + STR + " =? " + STR'
          + ".\n  The command was not applied and node " + STR'' + " was kept. If the equation\n"
          + "  follows from the constraint of the node, the node is empty and can be\n"
          + "  closed with: empty " + STR'' + " .\n\n" .
    eq errorMsg(43, STR, STR')
        = "\n\033[1;31m  Error:\033[0m module " + STR +
          " was not activated.\n  DM-Check cannot reason soundly about these statements:" + STR' +
          "\n  Maude evaluates the built-in _==_ and _=/=_ and owise equations\n" +
          "  syntactically on terms with variables (N == 0 reduces to false), so\n" +
          "  narrowing and NuITP can lose states. Use predicates defined with\n" +
          "  variant equations instead (e.g. eq N .=. N = True [variant] .).\n" +
          "  Conditional rules may only have equational conditions (t = t').\n" +
          "  Unification ignores membership axioms (mb, cmb), so narrowing can also\n" +
          "  lose states: declare those sorts with operator declarations (mb f(X:S) : S'\n" +
          "  is op f : S -> S') or use a predicate in the constraints.\n" +
          "  Unification modulo idempotence (idem) is not supported, so narrowing would\n" +
          "  also lose states: declare the operator without idem. An equation that states\n" +
          "  idempotence may only have the variant attribute if the equations have the\n" +
          "  finite variant property.\n\n" .
    eq errorMsg(44, STR)
        = "\n\033[1;31m  Error:\033[0m the generalization pattern does not cover the selected " + "node(s):" + STR +
          ".\n  The generalization was not applied: the term must match the pattern and NuITP must " +
          "prove that the node constraint implies the pattern constraint (add lemmas if needed).\n" + "\n" .
    eq errorMsg(45)
        = "\n\n  " + YELLOW + "Warning:" + BW + " every constrained pattern is unsatisfiable, so the set of\n" +
          "  states is empty. The empty set is an inductive invariant, but it\n  contains no state." .
    eq errorMsg(46, STR)
        = "\033[1;31m  Error:\033[0m script " + STR +
          " aborted: the last command could not be parsed or executed.\n\n" .
    eq errorMsg(47)
        = "\n\033[1;31m  Error:\033[0m a script is already running; nested load is not supported.\n\n" .
    eq errorMsg(48, STR, STR')
        = "\n\033[1;31m  Error:\033[0m cannot open script file " + STR + " (" + STR' + ").\n" +
          (if STR' == "File operations disabled." then
           "  Start Maude with the -allow-files or -trust flag to enable script loading.\n" else "" fi) + "\n" .
    eq errorMsg(49, STR, STR')
        = "\n\033[1;31m  Error:\033[0m cannot read script file " + STR + " (" + STR' +
          "); the script was aborted.\n\n" .
    eq errorMsg(50, STR)
        = "\n\033[1;31m  Error:\033[0m the term of node(s) " + STR + " is a variable. Narrowing only\n"
          + "  takes steps at non-variable positions, so DM-Check cannot compute the\n"
          + "  successors of such a node, and the command was not applied. Write one\n"
          + "  pattern for each constructor of its sort instead (initial patterns are\n"
          + "  numbered from 1 in the order written) or, for a child of generate, split\n"
          + "  it first with case to <id> on <variable> with <constructor patterns> .\n\n" .
    eq errorMsg(51, STR)
        = "\n\033[1;31m  Error:\033[0m " + STR
          + "\n  may be incomplete: Maude reported that it could not compute all of them\n"
          + "  (unification modulo an associative operator without commutativity, for\n"
          + "  instance, is not always complete). Some cases could be missing, so the\n"
          + "  command was not applied.\n\n" .
    eq errorMsg(52, STR)
        = "\n\033[1;31m  Error:\033[0m NuITP could not process the following formula, " +
          "so the command was not applied:\n" + "  " + STR +
          "\n  Check that the formula and the current lemmas only use symbols and sorts of the " +
          "active module.\n" + "\n" .
    eq errorMsg(53, STR)
        = "\n\033[1;33m  Warning:\033[0m no operator declared with the ctor attribute has a result " +
          "sort below\n" + "  these sorts: " + STR +
          ".\n  DM-Check takes the ctor operators as the constructors, so case cannot check\n" +
          "  that a generator set covers these sorts: a case on one of them always adds\n" + "  proof obligations.\n" .
    eq errorMsg(54, STR)
        = "\n\033[1;31m  Error:\033[0m split replaces the node by the cases <term> = True and\n"
          + "  <term> = False, so True and False must be the only constructors of Bool\n"
          + "  (declared with ctor). Not covered by True and False:\n"
          + STR
          + "  With the Maude prelude BOOL, Bool also has true and false: start the\n"
          + "  specification with set include BOOL off. The command was not applied.\n\n" .
    eq errorMsg(55, STR)
        = "\n\033[1;31m  Error:\033[0m narrow cannot be applied to a term whose root operator "
          + STR + "\n  is a constructor or has an identity attribute: instances of the term that no\n"
          + "  equation of " + STR + " reduces at the root would be lost. The command was not\n  applied.\n\n" .
    eq errorMsg(56, STR, STR')
        = "\n\033[1;31m  Error:\033[0m narrow cannot use some equations of the root operator " + STR + ",\n"
          + "  because they have a matching (:=) or membership (:) condition:\n"
          + STR'
          + "  The cases they define would be lost. The command was not applied.\n\n" .
    eq errorMsg(57, STR, STR')
        = "\n\033[1;31m  Error:\033[0m narrow only uses the equations of the root operator " + STR + ",\n"
          + "  but below it the selected term has subterms whose operators have\n"
          + "  equations:\n"
          + STR'
          + "  Their cases would be lost. Abstract each of them first, for example with\n"
          + "  va <subterm> with <variable> in <id> ., and narrow the new term.\n"
          + "  The command was not applied.\n\n" .
    eq errorMsg(58, STR)
        = "\n\033[1;33m  Warning:\033[0m NuITP could not prove that the constraint of node " + STR +
          " implies the substitution.\n" +
          "  The substitution was applied and this implication was added to the proof\n" + "  obligations:\n\n" .
    eq errorMsg(59, STR, STR', STR'')
        = "\n\033[1;33m  Warning:\033[0m the generator set may not cover every value of\n  " + STR + " in node " +
          STR' + ". Not covered:\n" + STR'' + "  The case split was applied and this implication was added\n" +
          "  to the proof obligations for each pattern not covered:\n\n" .
    eq errorMsg(60, STR)
        = "\n\033[1;33m  Warning:\033[0m NuITP could not prove that the constraint of node " + STR +
          " implies the equation.\n" +
          "  The variant unification was applied and this implication was added to the\n" + "  proof obligations:\n\n" .
    eq errorMsg(61, STR, STR')
        = "\n\033[1;31m  Error:\033[0m cannot save proof script to " + STR + " (" + STR' + ").\n" +
          (if STR' == "File operations disabled." then
           "  Start Maude with the -allow-files or -trust flag to enable saving.\n" else "" fi) + "\n" .
    eq errorMsg(62) = "\n\033[1;31m  Error:\033[0m there are no commands to save.\n\n" .

    --- Error when variant unify has no unifier
    op noUnifierMsg : Module Term Term Nat -> String .
    eq noUnifierMsg(M, T, T', N) = errorMsg(42, toString(M, T), toString(M, T'), string(N, 10)) .

    --- Error when set module rejects a module
    op unsafeModuleMsg : Qid String -> String .
    eq unsafeModuleMsg(Q, STR) = errorMsg(43, string(Q), STR) .

    --- Terms as strings
    op toString : Module TermList -> String .
    eq toString(M, 'true.NuITP-Bool) = "true" .
    eq toString(M, 'false.NuITP-Bool) = "false" .
    eq toString(M, 'dmc$obl[T]) = toString(M, T) .
    eq toString(M, TL) = toString'(M, TL) [ owise ] .

    op toString' : Module TermList -> String .
    eq toString'(M, (empty).TermList) = "" .
    eq toString'(M, T) = metaPrintToString(M, none, T, mixfix, none) .
    eq toString'(M, (T,NTL)) = metaPrintToString(M, none, T, mixfix, none) + "\n" + toString(M,NTL) .

    op toString : Module Substitution -> String .
    eq toString(M, (none).Substitution) = "  none" .
    eq toString(M, V <- T) = "  " + toString(M, V) + " --> " + toString(M, T) .
    eq toString(M, V <- T ; SB) = "  " + toString(M, V) + " --> " + toString(M, T) + "\n" + toString(M, SB) [ owise ] .

    --- Parents as strings
    op toStringParents : Module ParentNodeList -> String .
    eq toStringParents(M, noParents) = "" .
    eq toStringParents(M, [ ID, T, CTR, ACSB, 0 ])
        = "\nParent " + string(ID, 10) + "\nTerm:\n  " + toString(M, T) + "\nConstraint:\n  " + toString(M, CTR) .
    eq toStringParents(M, [ ID, T, CTR, ACSB, 0, ORIGIN ])
        = "\nParent " + string(ID, 10) +
          "\nTerm:\n  " + toString(M, T) +
          "\nConstraint:\n  " + toString(M, CTR) .
    eq toStringParents(M, (PARENT, PARENT', PARENTS))
        = toStringParents'(M, (PARENT, PARENT', PARENTS), "") .
    op toStringParents' : Module ParentNodeList String -> String .
    eq toStringParents'(M, (PARENT, PARENT', PARENTS), STR)
        = toStringParents'(M, (PARENT', PARENTS), STR + toStringParents(M, PARENT) + "\n") .
    eq toStringParents'(M, PARENT, STR) = STR + toStringParents(M, PARENT) .

    --- Name of a kind of step
    op toStringStepKind : StepKind -> String .
    eq toStringStepKind(narrowingStep) = "narrowing" .
    eq toStringStepKind(caseStep) = "case" .
    eq toStringStepKind(variableAbstractionStep) = "variable abstraction" .
    eq toStringStepKind(substitutionStep) = "substitution" .
    eq toStringStepKind(splitStep) = "split" .
    eq toStringStepKind(variantUnificationStep) = "variant unification" .
    eq toStringStepKind(generalizationStep) = "generalization" .
    eq toStringStepKind(auxiliaryNarrowingStep) = "auxiliary narrowing" .

    --- Source of a child: parent (narrowing) or child (auxiliary command)
    op toStringChildSource : Nat StepKind -> String .
    eq toStringChildSource(PID, narrowingStep) = " (Parent " + string(PID, 10) + ")" .
    eq toStringChildSource(PID, STEP) = " (from child " + string(PID, 10) + ")" [owise] .

    --- Data of a step as a string
    op toStringTraceDetail : Module TraceDetail -> String .
    eq toStringTraceDetail(M, noDetail) = "" .
    eq toStringTraceDetail(M, termDetail(T)) = "\nOperation term:\n  " + toString(M, T) .
    eq toStringTraceDetail(M, pairDetail(T, T'))
        = "\nOperation data:\n" +
          "  1. " + toString(M, T) + "\n" +
          "  2. " + toString(M, T') .

    --- Last transformation of a child as a string
    op toStringCurrentOrigin : Module Nat NodeOrigin -> String .
    eq toStringCurrentOrigin(M, ID, rootOrigin) = "" .
    eq toStringCurrentOrigin(M, ID,
          origin(PID, STEP, RL, SB, ACSB, N, DETAIL, ML, ORIGIN))
        = toStringChildSource(PID, STEP) +
          "\nLast transformation: " + toStringStepKind(STEP) +
          "\nRule: " + string(RL) +
          "\nSubstitution:\n" + toString(M, SB) +
          toStringTraceDetail(M, DETAIL) .

    --- show path: nodes and steps from the initial pattern to a node
    op pathInfo : Module DMCOutput Nat Bool -> String .
    eq pathInfo(M, ((PARENTS, [ ID, T, CTR, ACSB, 0, ORIGIN ], PARENTS') || CHILDREN), ID, B)
        = pathHeader("parent " + string(ID, 10), pathLen(ORIGIN))
          + pathSteps(M, ORIGIN, false, B)
          + pathNode(M, parentTitle(ID, ORIGIN), T, CTR, initAcsb(ORIGIN, ACSB), B) + "\n" .
    eq pathInfo(M, (PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')), ID, B)
        = pathHeader("child " + string(ID, 10), pathLen(ORIGIN))
          + pathSteps(M, ORIGIN, false, B)
          + pathNode(M, "Child " + string(ID, 10), T, CTR, none, B) + "\n" .
    eq pathInfo(M, OUTPUT, ID, B) = errorMsg(31) [owise] .

    --- Header of show path
    op pathHeader : String Nat -> String .
    eq pathHeader(STR, N)
        = "\n" + CYAN + "  Path to " + STR
          + (if N == 0 then " (initial pattern, no steps):"
             else " (" + string(N, 10) + (if N == 1 then " step" else " steps" fi) + " from the initial pattern):" fi)
          + BW + "\n" .

    --- Number of steps of an origin
    op pathLen : NodeOrigin -> Nat .
    eq pathLen(rootOrigin) = 0 .
    eq pathLen(srcState(T, CTR, SB, ORIGIN)) = pathLen(ORIGIN) .
    eq pathLen(origin(PID, STEP, RL, SB, ACSB, N, DETAIL, ML, ORIGIN)) = s(pathLen(ORIGIN)) .

    --- Show the renamed variables only for an initial pattern
    op initAcsb : NodeOrigin Substitution -> Substitution .
    eq initAcsb(rootOrigin, ACSB) = ACSB .
    eq initAcsb(ORIGIN, ACSB) = none [owise] .

    --- Title of the first node of a path
    op parentTitle : Nat NodeOrigin -> String .
    eq parentTitle(ID, rootOrigin) = "Parent " + string(ID, 10) + " (initial pattern)" .
    eq parentTitle(ID, ORIGIN)
        = "Parent " + string(ID, 10) + " (child promoted by generate next level)" [owise] .

    --- Title of an intermediate node
    op stateTitle : Nat NodeOrigin StepKind Bool -> String .
    eq stateTitle(PID, rootOrigin, STEP, false) = parentTitle(PID, rootOrigin) .
    eq stateTitle(PID, ORIGIN, narrowingStep, false) = parentTitle(PID, ORIGIN) .
    eq stateTitle(PID, ORIGIN, STEP, false) = "Child " + string(PID, 10) [owise] .

    --- Nodes and steps recorded in an origin, oldest first
    op pathSteps : Module NodeOrigin Bool Bool -> String .
    eq pathSteps(M, rootOrigin, B, B') = "" .
    eq pathSteps(M, origin(PID, STEP, RL, SB, ACSB, N, DETAIL, ML,
                           srcState(T, CTR, SB', ORIGIN)), B, B')
        = pathSteps(M, ORIGIN, B, B')
          + pathNode(M, stateTitle(PID, ORIGIN, STEP, B), T, CTR,
                     initAcsb(ORIGIN, SB'), B')
          + pathStep(M, s(pathLen(ORIGIN)), STEP, RL, SB, DETAIL, B') .
    eq pathSteps(M, origin(PID, STEP, RL, SB, ACSB, N, DETAIL, ML, ORIGIN), B, B')
        = pathSteps(M, ORIGIN, B, B')
          + "\nNode " + string(PID, 10) + " (state not recorded)\n"
          + pathStep(M, s(pathLen(ORIGIN)), STEP, RL, SB, DETAIL, B') [owise] .
    eq pathSteps(M, srcState(T, CTR, SB, ORIGIN), B, B') = pathSteps(M, ORIGIN, B, B') .

    --- A node of a path
    op pathNode : Module String Term Term Substitution Bool -> String .
    eq pathNode(M, STR, T, CTR, SB, B)
        = "\n" + STR
          + "\n  Term:\n    " + toString(M, T)
          + "\n  Constraint:\n    " + toString(M, CTR)
          + (if SB == none or-else not B then ""
             else "\n  Renamed variables:\n" + indentStr(toString(M, SB), "  ") fi)
          + "\n" .

    --- A step of a path: number, kind and, with show path, its data
    op pathStep : Module Nat StepKind Qid Substitution TraceDetail Bool -> String .
    eq pathStep(M, N, STEP, RL, SB, DETAIL, B)
        = "\n  --> Step " + string(N, 10) + ": " + stepTitle(M, STEP, RL, DETAIL)
          + (if B then stepData(M, STEP, RL, SB, DETAIL) else "" fi) + "\n" .

    --- Title of a step in show path
    op stepTitle : Module StepKind Qid TraceDetail -> String .
    eq stepTitle(M, narrowingStep, RL, DETAIL) = "narrowing with rule " + string(RL) .
    eq stepTitle(M, auxiliaryNarrowingStep, RL, DETAIL) = "narrowing of a subterm" .
    eq stepTitle(M, caseStep, RL, pairDetail(T, T')) = "case split on " + toString(M, T) .
    eq stepTitle(M, variableAbstractionStep, RL, DETAIL) = "variable abstraction" .
    eq stepTitle(M, substitutionStep, RL, DETAIL) = "explicit substitution" .
    eq stepTitle(M, variantUnificationStep, RL, DETAIL) = "variant unification" .
    eq stepTitle(M, splitStep, RL, DETAIL) = "Boolean split" .
    eq stepTitle(M, generalizationStep, RL, DETAIL) = "generalization" .
    eq stepTitle(M, STEP, RL, DETAIL) = toStringStepKind(STEP) [owise] .

    --- Data of a step in show path
    op stepData : Module StepKind Qid Substitution TraceDetail -> String .
    eq stepData(M, narrowingStep, RL, SB, DETAIL) = stepSub(M, "Substitution", SB) .
    eq stepData(M, auxiliaryNarrowingStep, RL, SB, termDetail(T))
        = stepField(M, "Subterm", T) + "\n      Equation:\n        " + eqString(M, T, RL)
          + stepSub(M, "Substitution", SB) .
    eq stepData(M, caseStep, RL, SB, pairDetail(T, T')) = stepField(M, "Generator term", T') .
    eq stepData(M, variableAbstractionStep, RL, SB, pairDetail(T, T'))
        = stepField(M, "Abstracted term", T) + stepField(M, "New variable", T') .
    eq stepData(M, substitutionStep, RL, SB, pairDetail(T, T'))
        = stepField(M, "Variable", T) + stepField(M, "Replaced by", T') .
    eq stepData(M, variantUnificationStep, RL, SB, pairDetail(T, T'))
        = "\n      Equation:\n        " + toString(M, T) + " =? " + toString(M, T')
          + stepSub(M, "Unifier", SB) .
    eq stepData(M, splitStep, RL, SB, termDetail(T)) = stepField(M, "Boolean term", T) .
    eq stepData(M, STEP, RL, SB, DETAIL) = "" [owise] .

    --- One labelled field of a step
    op stepField : Module String Term -> String .
    eq stepField(M, STR, T) = "\n      " + STR + ":\n        " + toString(M, T) .

    --- A labelled substitution of a step
    op stepSub : Module String Substitution -> String .
    eq stepSub(M, STR, SB)
        = if SB == none
          then ""
          else "\n      " + STR + ":\n" + indentStr(toString(M, SB), "      ")
          fi .

    --- Prefix every line of a string
    op indentStr : String String -> String .
    eq indentStr(STR, STR')
        = if find(STR, "\n", 0) == notFound
          then STR' + STR
          else STR' + substr(STR, 0, find(STR, "\n", 0)) + "\n"
               + indentStr(substr(STR, find(STR, "\n", 0) + 1, length(STR)), STR')
          fi .

    --- Equation used by an auxiliary narrowing step
    op eqString : Module Term Qid -> String .
    ceq eqString(M, T, RL) = eqString'(M, (rl LHS => RHS [label(RL) ATS] .))
    if (rl LHS => RHS [label(RL) ATS] .) RLS := getRls(narrowMod(M, T)) .
    eq eqString(M, T, RL) = "rule [" + string(RL) + "]" [owise] .
    op eqString' : Module Rule -> String .
    eq eqString'(M, (rl LHS => '_dmc>_[CTR, RHS] [ATS] .))
        = "ceq " + toString(M, LHS) + " = " + toString(M, RHS)
          + " if " + toString(M, buildCtr(CTR)) .
    eq eqString'(M, (rl LHS => RHS [ATS] .))
        = "eq " + toString(M, LHS) + " = " + toString(M, RHS) [owise] .
    eq eqString'(M, RULE) = "equation" [owise] .

    --- Matchers as strings (the target is a parent or another child)
    op toStringMatcherListInv : Module MatcherList Nat NatList -> String .
    eq toStringMatcherListInv(M, ML, N, PIDS) = toStringMatcherListInv'(M, ML, N, PIDS, "") .
    op toStringMatcherListInv' : Module MatcherList Nat NatList String -> String .
    eq toStringMatcherListInv'(M, noMatch, N, PIDS, STR) = STR .
    eq toStringMatcherListInv'(M, (MID, MATCH, IMPLICATION, PROOF) ; ML, N, PIDS, STR)
        = toStringMatcherListInv'(M, ML, N + 1, PIDS, STR + "\nMatching " +
                                  (if inIds(MID, PIDS) then "parent" else "child" fi) + " #" + string(N, 10) + ": " +
                                  string(MID, 10) + "\nMatching substitution #" + string(N, 10) + ":\n" +
                                  toString(M, MATCH) + "\nNuITP implication #" + string(N, 10) + " (" +
                                  toStringProofState(PROOF) + "):\n  " + toString(M, IMPLICATION)) .

    --- Matchers of check ... subsumed by as strings
    op toStringMatcherListSub : Module MatcherList Nat NatList -> String .
    eq toStringMatcherListSub(M, ML, N, PIDS) = toStringMatcherListSub'(M, ML, N, PIDS, "") .
    op toStringMatcherListSub' : Module MatcherList Nat NatList String -> String .
    eq toStringMatcherListSub'(M, noMatch, N, PIDS, STR) = STR .
    eq toStringMatcherListSub'(M, (MID, MATCH, IMPLICATION, PROOF) ; ML, N, PIDS, STR)
        = toStringMatcherListSub'(M, ML, N + 1, PIDS, STR + "\nMatching " +
                                  (if inIds(MID, PIDS) then "right" else "left" fi) + " term #" + string(N, 10) +
                                  ": " + string(MID, 10) + "\nNuITP implication #" + string(N, 10) + " (" +
                                  toStringProofState(PROOF) + "):\n  " + toString(M, IMPLICATION)) .

    --- Proof state as a string
    op toStringProofState : ProofState -> String .
    eq toStringProofState(sat) = "sat" .
    eq toStringProofState(open) = "open" .
    eq toStringProofState(unsat) = "unsat" .

    --- Children of check and generate as strings
    op toStringChildrenInv : Module ChildNodeList NatList -> String .
    eq toStringChildrenInv(M, noChildren, PIDS) = "" .
    eq toStringChildrenInv(M,
          [ ID, PID, T, CTR, RL, SB, ACSB, noMatch, N,
            ORIGIN ], PIDS)
        = "\nChild " + string(ID, 10) + toStringCurrentOrigin(M, ID, ORIGIN) +
          "\nTerm:\n  " + toString(M, T) +
          "\nMatching: no matching found" +
          "\nConstraint:\n  " + toString(M, CTR) .
    eq toStringChildrenInv(M,
          [ ID, PID, T, CTR, RL, SB, ACSB, NML, N,
            ORIGIN ], PIDS)
        = "\nChild " + string(ID, 10) + toStringCurrentOrigin(M, ID, ORIGIN) +
          "\nTerm:\n  " + toString(M, T) +
          toStringMatcherListInv(M, NML, 1, PIDS) .
    eq toStringChildrenInv(M, noChildren, PIDS) = "" .
    eq toStringChildrenInv(M, (CHILD, CHILD', CHILDREN), PIDS)
        = toStringChildrenInv'(M, (CHILD, CHILD', CHILDREN), PIDS, "") .
    op toStringChildrenInv' : Module ChildNodeList NatList String -> String .
    eq toStringChildrenInv'(M, (CHILD, CHILD', CHILDREN), PIDS, STR)
        = toStringChildrenInv'(M, (CHILD', CHILDREN), PIDS,
            STR + toStringChildrenInv(M, CHILD, PIDS) + "\n") .
    eq toStringChildrenInv'(M, CHILD, PIDS, STR) = STR + toStringChildrenInv(M, CHILD, PIDS) .

    --- Children of check ... subsumed by as strings
    op toStringChildrenSub : Module ChildNodeList NatList -> String .
    eq toStringChildrenSub(M, noChildren, PIDS) = "" .
    eq toStringChildrenSub(M, [ ID, T, CTR, ACSB, noMatch, N, ORIGIN ], PIDS)
        = "\nTerm " + string(ID, 10) + ":\n  " + toString(M, T) +
          "\nMatching: no matching found" +
          "\nConstraint " + string(ID, 10) + ":\n  " + toString(M, CTR) .
    eq toStringChildrenSub(M, [ ID, T, CTR, ACSB, NML, N, ORIGIN ], PIDS)
        = "\nTerm " + string(ID, 10) + ":\n  " + toString(M, T) +
          "\nConstraint " + string(ID, 10) + ":\n  " + toString(M, CTR) +
          toStringMatcherListSub(M, NML, 1, PIDS) .
    eq toStringChildrenSub(M, noChildren, PIDS) = "" .
    eq toStringChildrenSub(M, (CHILD, CHILD', CHILDREN), PIDS)
        = toStringChildrenSub'(M, (CHILD, CHILD', CHILDREN), PIDS, "") .
    op toStringChildrenSub' : Module ChildNodeList NatList String -> String .
    eq toStringChildrenSub'(M, (CHILD, CHILD', CHILDREN), PIDS, STR)
        = toStringChildrenSub'(M, (CHILD', CHILDREN), PIDS,
            STR + toStringChildrenSub(M, CHILD, PIDS) + "\n") .
    eq toStringChildrenSub'(M, CHILD, PIDS, STR) = STR + toStringChildrenSub(M, CHILD, PIDS) .

    --- Intersection terms as strings
    op toStringChildrenInt : Module ChildNodeList -> String .
    eq toStringChildrenInt(M, CHILDREN) = toStringChildrenInt'(M, CHILDREN, "") .
    op toStringChildrenInt' : Module ChildNodeList String -> String .
    eq toStringChildrenInt'(M, noChildren, STR) = STR .
    eq toStringChildrenInt'(M, ([ ID, T, T', T'', CTR, LSB, RSB ], CHILDREN), STR)
        = toStringChildrenInt'(M, CHILDREN, STR +
          "\nIntersection Term " + string(ID, 10) + ":\n  " + toString(M, T) +
          "\nLeft Term:\n  " + toString(M, T') +
          "\nLeft Substitution:\n" + toString(M, LSB) +
          "\nRight Term:\n  " + toString(M, T'') +
          "\nRight Substitution:\n" + toString(M, RSB) +
          "\nConstraint:\n  " + toString(M, CTR) +
          "\n") .

    --- Qids as strings
    op toString : Module Qid -> String .
    eq toString(M, Q) = string(Q) .

    --- Lemmas and obligations, one per line
    op toStringLemmas : Module TermSet -> String .
    eq toStringLemmas(M, mt) = "" .
    eq toStringLemmas(M, T) = "    " + toString(M, T) .
    eq toStringLemmas(M, (T ;; LEMMAS)) = toStringLemmas'(M, (T ;; LEMMAS), "") .
    op toStringLemmas' : Module TermSet String -> String .
    eq toStringLemmas'(M, T, STR) = STR + "    " + toString(M, T) .
    eq toStringLemmas'(M, (T ;; LEMMAS), STR) = toStringLemmas'(M, LEMMAS, STR + "    " + toString(M, T) + "\n") .

    --- Verdict of check ind-invariant
    op toStringInv : Module DMCOutput TermSet String -> String .

    --- Every disjunct is unsatisfiable: the invariant is the empty set
    eq toStringInv(M, noParents || noChildren, LEMMAS?, POS) = invSat(M, LEMMAS?, POS) + errorMsg(45) .
    eq toStringInv(M,
          PARENTS || ([ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN),
          LEMMAS?, POS)
        = "\033[1;33mInvariant could not be proved.\033[0m\n" +
          toStringParents(M, PARENTS) + "\n" +
          toStringChildrenInv(M,
            liveCh(([ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN),
                   resIds(PARENTS || ([ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN))),
            parIds(PARENTS)) .
    eq toStringInv(M, (PARENT, PARENTS) || noChildren, LEMMAS?, POS) = invSat(M, LEMMAS?, POS) .

    --- Verdict when nothing is left open
    op invSat : Module TermSet String -> String .
    eq invSat(M, mt, POS)
        = if (POS == "")
          then "\033[1;32mInvariant satisfied.\033[0m"
          else "\033[1;32mInvariant satisfied with the following proof obligations:\033[0m\n\n" + POS
          fi .
    eq invSat(M, LEMMAS, POS)
        = "\033[1;32mInvariant satisfied with the following proof obligations:\033[0m\n\n" +
          toStringLemmas(M, LEMMAS) + (if (POS == "") then "" else "\n" + POS fi) .

    --- Verdict of generate ind-invariant
    op toStringGen : Module DMCOutput TermSet String -> String .

    --- Every initial disjunct is unsatisfiable: the invariant is the empty set
    eq toStringGen(M, noParents || noChildren, LEMMAS?, POS) = invSat(M, LEMMAS?, POS) + errorMsg(45) .
    eq toStringGen(M,
          PARENTS || ([ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN),
          LEMMAS?, POS)
        = "\033[1;33mInvariant could not be proved.\033[0m\n" +
          toStringParents(M, PARENTS) + "\n" +
          toStringChildrenInv(M,
            liveCh(([ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN),
                   resIds(PARENTS || ([ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN))),
            parIds(PARENTS)) .
    eq toStringGen(M, (PARENT, PARENTS) || noChildren, mt, POS)
        = if (POS == "")
          then "\033[1;32mThe following invariant is satisfied:\033[0m\n\n" + parentsToInv(M, (PARENT, PARENTS))
          else "\033[1;32mThe following invariant is satisfied:\033[0m\n\n" + parentsToInv(M, (PARENT, PARENTS)) +
               "\n\n  \033[1;36mwith the following proof obligations:\033[0m\n\n" + POS
          fi .
    eq toStringGen(M, (PARENT, PARENTS) || noChildren, LEMMAS, POS)
        = "\033[1;32mThe following invariant is satisfied:\033[0m\n\n" + parentsToInv(M, (PARENT, PARENTS)) +
          "\n\n  \033[1;36mwith the following proof obligations:\033[0m\n\n" + toStringLemmas(M, LEMMAS) +
          (if (POS == "") then "" else "\n" + POS fi) .

    --- Generated invariant as a disjunction
    op parentsToInv : Module ParentNodeList -> String .
    eq parentsToInv(M, noParents) = "" .
    eq parentsToInv(M, [ ID, T, CTR, ACSB, 0 ])
        = "    ((" + toString(M, T) + ") | (" + toString(M, CTR) + "))" .
    eq parentsToInv(M, [ ID, T, CTR, ACSB, 0, ORIGIN ])
        = "    ((" + toString(M, T) + ") | (" + toString(M, CTR) + "))" .
    eq parentsToInv(M, (PARENT, PARENT', PARENTS))
        = parentsToInv'(M, (PARENT, PARENT', PARENTS), "") .
    op parentsToInv' : Module ParentNodeList String -> String .
    eq parentsToInv'(M, (PARENT, PARENT', PARENTS), STR)
        = parentsToInv'(M, (PARENT', PARENTS), STR + parentsToInv(M, PARENT) + " \\/\n") .
    eq parentsToInv'(M, PARENT, STR) = STR + parentsToInv(M, PARENT) .

    --- Verdict of check ... subsumed by
    op toStringSub : Module DMCOutput TermSet -> String .
    eq toStringSub(M, PARENTS || noChildren, mt) = "\033[1;32mSubsumption satisfied.\033[0m" .
    eq toStringSub(M, PARENTS || noChildren, LEMMAS)
        = "\033[1;32mSubsumption satisfied with the following proof obligations:\033[0m\n\n" +
          toStringLemmas(M, LEMMAS) .
    eq toStringSub(M, PARENTS || ([ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN), LEMMAS?)
        = "\033[1;33mConstrained terms on the left that could not be subsumed:\033[0m\n" +
          toStringChildrenSub(M,
                              liveCh(([ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN),
                                     resIds(PARENTS || ([ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN))),
                              parIds(PARENTS)) .

    --- Verdict of intersect
    op toStringInt' : Module DMCOutput -> String .
    eq toStringInt'(M, PARENTS || noChildren) = "\033[1;32mNo intersection.\033[0m" .

    --- Verdict of intersect with the obligations of empty
    op toStringInt : Module DMCOutput TermSet -> String .
    eq toStringInt(M, PARENTS || noChildren, LEMMAS)
        = "\033[1;32mNo intersection with the following proof obligations:\033[0m\n\n" + toStringLemmas(M, LEMMAS) .
    eq toStringInt(M, OUTPUT, LEMMAS?) = toStringInt'(M, OUTPUT) [ owise ] .
    eq toStringInt'(M, PARENTS || ([ ID, T, T', T'', CTR, LSB, RSB ], CHILDREN))
        = "\033[1;33mIntersection of constrained terms:\033[0m\n" +
          toStringChildrenInt(M, ([ ID, T, T', T'', CTR, LSB, RSB ], CHILDREN)) .

    --- Variable abstraction candidates as strings
    op toStringCtxs : Module VarAbsPair -> String .
    eq toStringCtxs(M,
          {ID, ([ ID', PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN)})
        = "\n  " + string(ID', 10) + "." +
          "\n  Term:\n    " + toString(M, T) +
          "\n  Constraint:\n    " + toString(M, CTR) +
          toStringCtxs(M, {ID, CHILDREN}) .
    eq toStringCtxs(M, {ID, noChildren}) = "" .
    eq toStringCtxs(M, {ID, ([ ID', T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN)})
        = "\nTerm " + string(ID', 10) + ":\n  " + toString(M, T) +
          "\nConstraint " + string(ID', 10) + ":\n  " + toString(M, CTR) +
          "\n" + toStringCtxs(M, {ID, CHILDREN}) .
endm

mod DM-CHECK-UI-SYNTAX is
    pr QID-LIST .

    sorts Token Bubble Command .

    --- Tokens and bubbles
    op token : Qid -> Token [ special (id-hook Bubble (1 1) op-hook qidSymbol (<Qids> : ~> Qid)) ] .
    op bubble : QidList -> Bubble [ special (id-hook Bubble (1 -1 `( `)) op-hook qidListSymbol (__ : QidList QidList ~> QidList) op-hook qidSymbol (<Qids> : ~> Qid) id-hook Exclude (.)) ] .

    --- Interface commands
    op q : -> Command .
    op quit : -> Command .
    op h`. : -> Command .
    op help`. : -> Command .
    op show`module`. : -> Command .
    op show`lemmas`. : -> Command .
    op show`last`. : -> Command .
    op show`obligations`. : -> Command .
    op show`path_. : Token -> Command .
    op show`path`states_. : Token -> Command .

    --- Session and lemma commands
    op set`module_. : Token -> Command .
    op load_ : Token -> Command .
    op save`proof_. : Token -> Command .
    op add`lemma_. : Bubble -> Command .
    op reset`lemmas`. : -> Command .

    --- Proof and auxiliary commands
    op check`invariant_. : Bubble -> Command .
    op check`ind-invariant_. : Bubble -> Command .
    op generate`ind-invariant_. : Bubble -> Command .
    op gen`ind-invariant_. : Bubble -> Command .
    op generate`next`level`. : -> Command .
    op gen`next`level`. : -> Command .
    op check_subsumed`by_. : Bubble Bubble -> Command .
    op intersect_with_. : Bubble Bubble -> Command .
    op empty_. : Token -> Command .
    op lemma_. : Token -> Command .
    op lemma_match_. : Token Token -> Command .
    op contained_. : Token -> Command .
    op recheck`. : -> Command .
    op case`to_on_with_. : Token Token Bubble -> Command .
    op variable`abstraction_with_in_. : Bubble Token Token -> Command .
    op va_with_in_. : Bubble Token Token -> Command .
    op select`variable`abstraction_. : Token -> Command .
    op select`va_. : Token -> Command .
    op substitution`to_on_with_. : Token Token Bubble -> Command .
    op sb`to_on_with_. : Token Token Bubble -> Command .
    op variant`unify_=?_in_. : Bubble Bubble Token -> Command .
    op vunify_=?_in_. : Bubble Bubble Token -> Command .
    op narrowing_on_. : Token Bubble -> Command .
    op narrow_on_. : Token Bubble -> Command .
    op generalize_to_. : Bubble Bubble -> Command .
    op split_with_. : Token Bubble -> Command .

    op variant`unify`to_with_=?_. : Token Bubble Bubble -> Command . --- Temp
    op vunify`to_with_=?_. : Token Bubble Bubble -> Command . --- Temp
    op narrowing`to_on_. : Token Bubble -> Command . --- Temp
    op narrow`to_on_. : Token Bubble -> Command . --- Temp
    op variable`abstraction`to_on_with_. : Token Bubble Token -> Command . --- Temp
    op va`to_on_with_. : Token Bubble Token -> Command . --- Temp
endm

mod DM-CHECK-UI is
    pr DM-CHECK-STRING .
    pr DM-CHECK .
    pr STD-STREAM .
    pr FILE .

    var CID : Cid .
    vars OID FH : Oid .
    vars ATS ATS' : AttributeSet .
    var M : Module .
    vars Q Q' TYPE RL RL' LSTCMD F : Qid .
    vars SS SS' : SortSet .
    var OPDS : OpDeclSet .
    var RLS : RuleSet .
    vars N N' ID ID' PID PID' MID : Nat .
    var NZ : NzNat .
    vars STR STR' CMD TMP POS NAME PROMPT ACC PEND SUM OLD NEW HIST VAPEND TEXT MSG : String .
    vars M? M'? M''? : [Module] .
    vars T? PARSED-VAR PARSED-SUBTERM PARSED-EXP : [Term] .
    var TL : TermList .
    vars TS TS' LEMMAS ULEMMAS : TermSet .
    vars NTL NTL' ARG ARG' ARG'' : NeTermList .
    vars GAMMA DELTA CTR CTR' IMPLICATION T T' T'' PAT PARSED-TERM PARSED-TERM' : Term .
    vars QL QL' : QidList .
    vars ML ML' : MatcherList .
    var SC : ScriptMode .
    vars MATCH SB SB' ACSB ACSB' LSB RSB : Substitution .
    var PROOF : ProofState .
    var CO : Context .
    vars TY TY' : Type .
    var V : Variable .
    var NTS : NeTermSet .
    var VABSPAIR : VarAbsPair .
    vars ORIGIN ORIGIN' : NodeOrigin .
    vars PARSED-GENSET OBLS? LEMMAS? : [TermSet] .
    var PARENTS : ParentNodeList .
    vars CHILDREN CHILDREN' CHILDREN'' CHILDREN''' : ChildNodeList .
    var OUTPUT : DMCOutput .
    var ATS? : [AttributeSet] .
    vars STR? NOTE? : [String] .
    var C : Constant .
    var SB? : Substitution? .
    vars S S' : Sort .
    var TYL : TypeList .
    var ATTRS : AttrSet .
    var NSS : NeSortSet .
    var VAP? : [VarAbsPair] .
    var COND : Condition .
    var CHILD : ChildNode .
    var COBL : CaseObl .
    var NQS : NeQidSet .
    var QS : QidSet .
    var COBL? : [CaseObl] .
    var OUTPUT? : [DMCOutput] .
    var SPEC : AuxSpec .
    var NL : NatList .
    var NNL : NeNatList .
    vars TL? TL'? : [TermList] .
    vars RP? RP'? : ResultPair? .

    sorts StringQid ScriptMode SaveMode .

    --- Last command and its type
    op _|_ : String Qid -> StringQid [ ctor ] .

    --- Interface object
    op oid : -> Oid .
    op cid : -> Cid .

    --- Attributes of the interface object
    op module:_ : [Module] -> Attribute [ ctor prec 20 gather (&) ] .
    op pos:_ : String -> Attribute [ ctor prec 20 gather (&) ] .
    op lemmasui:_ : TermSet -> Attribute [ ctor prec 20 gather (&) ] .
    op userlem:_ : TermSet -> Attribute [ ctor prec 20 gather (&) ] . --- Lemmas added with add lemma
    op lastRes:_ : DMCOutput -> Attribute [ ctor prec 20 gather (&) ] .
    op lastCmd:_ : StringQid -> Attribute [ ctor prec 20 gather (&) ] .
    op tmpCmd:_ : String -> Attribute [ ctor prec 20 gather (&) ] .
    op vaSelect:_ : Bool -> Attribute [ ctor prec 20 gather (&) ] .
    op varAbs:_ : VarAbsPair -> Attribute [ ctor prec 20 gather (&) ] .
    op history:_ : String -> Attribute [ ctor prec 20 gather (&) ] .
    op histPending:_ : String -> Attribute [ ctor prec 20 gather (&) ] .
    op saving:_ : SaveMode -> Attribute [ ctor prec 20 gather (&) ] .

    --- Script being run by load
    op script:_ : ScriptMode -> Attribute [ ctor prec 20 gather (&) ] .
    op scriptOpening : String -> ScriptMode [ ctor ] .                 --- file name
    op scriptRunning : String Oid String String -> ScriptMode [ ctor ] . --- name, handle, prompt, continued line
    op scriptPending : String Oid String -> ScriptMode [ ctor ] .      --- name, handle, command to run
    op scriptAborting : String Oid -> ScriptMode [ ctor ] .            --- name, handle
    op scriptClosing : String -> ScriptMode [ ctor ] .                 --- final message
    op scriptQuitting : -> ScriptMode [ ctor ] . --- q in a script: close the file, then quit

    --- Node ids given in the session
    op maxid:_ : Nat -> Attribute [ ctor prec 20 gather (&) ] .
    op idMax : Nat Nat -> Nat .
    op idmaxOf : AttributeSet -> Nat .
    op syncId : AttributeSet -> AttributeSet .
    op resetId : AttributeSet -> AttributeSet .
    op maxResId : DMCOutput -> Nat .
    op maxParId : ParentNodeList Nat -> Nat .
    op maxChId : ChildNodeList Nat -> Nat .

    --- Scripts and proof history
    op cmtDepth : String Nat -> Nat .
    op cmtMark : Nat -> String .
    op cmtLevel : String -> Nat .
    op failScript : AttributeSet -> AttributeSet .
    op saveOpening : String String -> SaveMode [ ctor ] .
    op saveWriting : String Oid -> SaveMode [ ctor ] .
    op saveClosing : String -> SaveMode [ ctor ] .
    op histCmd : String -> String .
    op isRecordable : String -> Bool .
    op isWarning : String -> Bool .
    op flatCmd : String -> String .
    op flatShort : String -> String .
    op flatCh : String -> String .
    op splitAt : String Nat -> Nat .
    op breakAt : String String String -> String .
    op squeeze : String -> String .
    op prettyCmd : String -> String .
    op proofScript : String -> String .
    op hasScript : AttributeSet -> Bool .
    op endsWithBackslash : String -> Bool .
    op dropLast : String -> String .

    op parse : Term -> Msg [ ctor ] .
    op checkInvariant : Module TermList -> Msg [ ctor ] .
    op genInvariant : Module TermList -> Msg [ ctor ] .
    op checkSubsumed : Module TermList TermList -> Msg [ ctor ] .
    op checkIntersect : Module TermList TermList -> Msg [ ctor ] .
    op noModule : -> [Module] [ ctor ] .

    --- Initial configuration
    op init : -> Configuration .
    eq init
        = <> < oid : cid | module: noModule, lemmasui: mt, userlem: mt, lastRes: noSolution, lastCmd: ("" | 'noType),
                           tmpCmd: "", pos: "", history: "", histPending: "", maxid: 0 >
             write(stdout, oid, DMC-BANNER) .

    --- parse command
    op parseCommand : [Module] Oid String -> Msg .
    eq parseCommand(M?, OID, STR)
        = parseCommand'(M?, OID,
                        getTerm(metaParse(upModule('DM-CHECK-UI-SYNTAX, false), none, tokenize(STR), 'Command))) .

    --- Proof commands need a module
    op parseCommand' : [Module] Oid [Term] -> Msg .
    eq parseCommand'(noModule, OID, 'check_subsumed`by_.['bubble[ARG],'bubble[ARG']])
        = write(stdout, OID, errorMsg(1)) .
    eq parseCommand'(noModule, OID, 'check`ind-invariant_.['bubble[ARG]]) = write(stdout, OID, errorMsg(1)) .
    eq parseCommand'(noModule, OID, 'generate`ind-invariant_.['bubble[ARG]]) = write(stdout, OID, errorMsg(1)) .
    eq parseCommand'(noModule, OID, 'gen`ind-invariant_.['bubble[ARG]]) = write(stdout, OID, errorMsg(1)) .
    eq parseCommand'(noModule, OID, 'intersect_with_.['bubble[ARG],'bubble[ARG']]) = write(stdout, OID, errorMsg(1)) .
    eq parseCommand'(noModule, OID, 'check`invariant_.['bubble[ARG]]) = write(stdout, OID, errorMsg(1)) .
    eq parseCommand'(noModule, OID, 'generate`next`level`..Command) = write(stdout, OID, errorMsg(1)) .
    eq parseCommand'(noModule, OID, 'gen`next`level`..Command) = write(stdout, OID, errorMsg(1)) .
    eq parseCommand'(M?, OID, T?) = parse(T?) [ owise ] .

    --- Reject the commands that write the built-in equality
    op checkInput : [Module] Oid String -> Msg .
    op unsafeInput : Oid -> Msg [ ctor ] .
    ceq checkInput(M, OID, STR) = unsafeInput(OID)
        if hasUnsafeToken(unsafeOps(M), tokenize(STR)) .
    eq checkInput(M?, OID, STR) = parseCommand(M?, OID, STR) [ owise ] .
    eq < OID : CID | ATS > unsafeInput(OID) = < OID : CID | failScript(ATS) > write(stdout, OID, errorMsg(34)) .

    --- quit
    op byeText : -> String .
    eq byeText = "\n\033[1;37m  Bye.\033[0m\n\n" .

    --- Inside a script, close the file before quitting
    eq < OID : CID | ATS, script: scriptRunning(NAME, FH, PROMPT, ACC) > parse('q.Command)
        = < OID : CID | ATS, script: scriptQuitting > closeFile(FH, OID) .
    eq < OID : CID | ATS, script: scriptRunning(NAME, FH, PROMPT, ACC) > parse('quit.Command)
        = < OID : CID | ATS, script: scriptQuitting > closeFile(FH, OID) .
    eq < OID : CID | ATS > parse('q.Command) = (none).Configuration write(stdout, OID, byeText) [ owise ] .
    eq < OID : CID | ATS > parse('quit.Command) = (none).Configuration write(stdout, OID, byeText) [ owise ] .
    eq < OID : CID | ATS > parse(T?) = < OID : CID | failScript(ATS) > write(stdout, OID, errorMsg(3)) [ owise ] .

    --- help
    eq < OID : CID | ATS > parse('h`..Command) = < OID : CID | ATS > write(stdout, OID, helpText) .
    eq < OID : CID | ATS > parse('help`..Command) = < OID : CID | ATS > write(stdout, OID, helpText) .

    --- Replies of the external objects, consumed by rules (one request pending at a time)
    op ioNext : Oid -> Msg [ ctor ] .                  --- an output was written: issue the next request
    op ioLine : Oid String -> Msg [ ctor ] .           --- a line of the standard input
    op ioScriptLine : Oid String -> Msg [ ctor ] .     --- a line of the script
    rl [io-wrote] : < OID : CID | ATS > wrote(OID, stdout) => < OID : CID | ATS > ioNext(OID) .
    rl [io-stdout-error] : < OID : CID | ATS > streamError(OID, stdout, STR) => < OID : CID | ATS > ioNext(OID) .
    rl [io-line] : < OID : CID | ATS > gotLine(OID, stdin, STR) => < OID : CID | ATS > ioLine(OID, STR) .
    rl [io-stdin-error] : < OID : CID | ATS > streamError(OID, stdin, STR) => < OID : CID | ATS > ioLine(OID, "") .
    rl [io-script-line] : < OID : CID | ATS, script: scriptRunning(NAME, FH, PROMPT, ACC) > gotLine(OID, FH, STR)
        => < OID : CID | ATS, script: scriptRunning(NAME, FH, PROMPT, ACC) > ioScriptLine(OID, STR) .

    --- Prompt of the next line
    op ioPrompt : AttributeSet -> String .
    eq ioPrompt(ATS)
        = if hasVaSel(ATS)
          then "Select variable abstraction> "
          else "DM-Check> "
          fi .

    --- Next request after an output: the next line of the script, or of the standard input
    eq < OID : CID | ATS, script: scriptRunning(NAME, FH, PROMPT, ACC) > ioNext(OID)
        = < OID : CID | ATS, script: scriptRunning(NAME, FH, ioPrompt(ATS), ACC) > getLine(FH, OID) .

    --- Run a command read from the script (an Error aborts the script)
    eq < OID : CID | ATS, module: M?, tmpCmd: TMP, histPending: PEND, script: scriptPending(NAME, FH, CMD) >
        ioNext(OID)
        = < OID : CID | chkWarn,
                        withUndo((syncId(cancelVa(ATS, CMD)), module: M?, tmpCmd: CMD, histPending: histCmd(CMD),
                                  script: scriptRunning(NAME, FH, "DM-Check> ", "")), TMP) > checkInput(M?, OID, CMD) .
    eq < OID : CID | ATS, script: scriptAborting(NAME, FH) > ioNext(OID)
        = < OID : CID | ATS, script: scriptClosing(errorMsg(46, NAME)) > closeFile(FH, OID) .
    eq < OID : CID | ATS > ioNext(OID) = < OID : CID | ATS > getLine(stdin, OID, ioPrompt(ATS)) [ owise ] .
    op cancelVa : AttributeSet String -> AttributeSet .
    eq cancelVa((vaSelect: true, varAbs: VABSPAIR, ATS), STR)
        = if keepsSelect(trim(STR))
          then (vaSelect: true, varAbs: VABSPAIR, ATS)
          else ATS
          fi .
    eq cancelVa(ATS, STR) = ATS [ owise ] .

    --- A line of the standard input (the empty string ends the session)
    eq < OID : CID | ATS > ioLine(OID, "") = (none).Configuration write(stdout, OID, byeText) .
    ceq < OID : CID | ATS, vaSelect: true, module: M?, tmpCmd: TMP, histPending: PEND > ioLine(OID, STR)
        = < OID : CID |
              withUndo((syncId(ATS), vaSelect: true, module: M?, tmpCmd: STR, histPending: histCmd(STR)), TMP) >
          checkInput(M?, OID, STR)
        if keepsSelect(trim(STR)) .

    --- Any other command cancels the pending selection
    ceq < OID : CID | ATS, vaSelect: true, varAbs: VABSPAIR, module: M?, tmpCmd: TMP, histPending: PEND >
        ioLine(OID, STR)
        = < OID : CID | withUndo((syncId(ATS), module: M?, tmpCmd: STR, histPending: histCmd(STR)), TMP) >
          checkInput(M?, OID, STR)
        if not keepsSelect(trim(STR)) /\
           STR =/= "" .
    eq < OID : CID | ATS, module: M?, tmpCmd: TMP, histPending: PEND > ioLine(OID, STR)
        = < OID : CID | withUndo((syncId(ATS), module: M?, tmpCmd: STR, histPending: histCmd(STR)), TMP) >
          checkInput(M?, OID, STR) [ owise ] .

    --- Commands that keep a pending va selection: select, show and help
    op keepsSelect : String -> Bool .
    eq keepsSelect(STR)
        = startsWith(STR, "select") or-else startsWith(STR, "show") or-else startsWith(STR, "help") or-else
          STR == "h." or-else startsWith(STR, "h ") .

    --- load FILE
    eq hasScript((script: SC, ATS)) = true .
    eq hasScript(ATS) = false [ owise ] .
    eq endsWithBackslash(STR) = (length(STR) > 0) and-then (substr(STR, sd(length(STR), 1), 1) == "\\") .
    eq dropLast(STR) = substr(STR, 0, sd(length(STR), 1)) .

    eq < OID : CID | ATS > parse('load_['token[ARG]])
        = if hasScript(ATS)
          then < OID : CID | ATS > write(stdout, OID, errorMsg(47))
          else < OID : CID | script: scriptOpening(string(downTerm(ARG, 'noFile.Qid))), ATS >
               openFile(fileManager, OID, string(downTerm(ARG, 'noFile.Qid)), "r")
          fi .

    rl [io-script-opened] : < OID : CID | ATS, script: scriptOpening(NAME) > openedFile(OID, fileManager, FH)
        => < OID : CID | ATS, script: scriptRunning(NAME, FH, "DM-Check> ", "") >
           write(stdout, OID, "\n\033[1;36m  Begin running script " + NAME + ".\033[0m\n\n") .
    rl [io-script-open-error] : < OID : CID | ATS, script: scriptOpening(NAME) > fileError(OID, fileManager, STR)
        => < OID : CID | ATS >
           write(stdout, OID, errorMsg(48, NAME, STR)) .

    --- A read error aborts the script
    rl [io-script-read-error] : < OID : CID | ATS, script: scriptRunning(NAME, FH, PROMPT, ACC) >
                                fileError(OID, FH, STR)
        => < OID : CID | ATS, script: scriptClosing(errorMsg(49, NAME, STR)) > closeFile(FH, OID) .

    --- A line of the script: comments, continuation lines and commands
    eq < OID : CID | ATS, script: scriptRunning(NAME, FH, PROMPT, ACC) > ioScriptLine(OID, STR)
        = if STR == ""
          then < OID : CID | ATS, script: scriptClosing("\n\033[1;32m  End running script " + NAME + ".\033[0m\n\n") >
               closeFile(FH, OID)
          else if startsWith(ACC, "\001")
               then < OID : CID | ATS,
                                  script: scriptRunning(NAME, FH, PROMPT, cmtMark(cmtDepth(STR, cmtLevel(ACC)))) >
                    getLine(FH, OID)
               else if (ACC == "") and-then startsWith(trim(STR), "***(")
                    then < OID : CID | ATS,
                                       script: scriptRunning(NAME, FH, PROMPT,
                                                             cmtMark(cmtDepth(substr(trim(STR), 4, length(trim(STR))),
                                                                              1))) > getLine(FH, OID)
                    else if (ACC == "") and-then
                            ((trim(STR) == "") or-else startsWith(trim(STR), "#") or-else
                             startsWith(trim(STR), "---") or-else
                             (startsWith(trim(STR), "***") and-then not startsWith(trim(STR), "***(")))
                         then < OID : CID | ATS, script: scriptRunning(NAME, FH, PROMPT, ACC) > getLine(FH, OID)
                         else if endsWithBackslash(trim(STR))
                              then < OID : CID | ATS,
                                                 script: scriptRunning(NAME, FH, PROMPT, ACC + dropLast(trim(STR)) +
                                                                       " ") > getLine(FH, OID)
                              else < OID : CID | ATS, script: scriptPending(NAME, FH, ACC + trim(STR)) >
                                   write(stdout, OID, PROMPT + ACC + trim(STR) + "\n")
                              fi
                         fi
                    fi
               fi
          fi .

    --- Nesting depth of block comments in scripts
    eq cmtDepth(STR, 0) = 0 .
    eq cmtDepth("", N) = N .
    eq cmtDepth(STR, N)
        = cmtDepth(substr(STR, 1, length(STR)),
                   if substr(STR, 0, 1) == "(" then s(N)
                   else if substr(STR, 0, 1) == ")" then sd(N, 1) else N fi fi) [ owise ] .
    eq cmtMark(0) = "" .
    eq cmtMark(NZ) = "\001" + string(NZ, 10) .
    ceq cmtLevel(STR) = N
        if N := rat(substr(STR, 1, length(STR)), 10) .

    --- Abort a script when a command is rejected
    op chkWarn : -> Attribute [ ctor ] .
    ceq < OID : CID | chkWarn, ATS > write(stdout, OID, STR)
        = < OID : CID | if isWarning(STR) then failScript(ATS) else ATS fi > write(stdout, OID, STR)
        if upTerm(STR) :: Constant .

    eq failScript((script: scriptRunning(NAME, FH, PROMPT, ACC), ATS))
        = (script: scriptAborting(NAME, FH), ATS) .
    eq failScript(ATS) = ATS [ owise ] .

    --- Undo a command that fails while computing
    op undo : AttributeSet -> Attribute [ ctor ] .
    op noUndo : AttributeSet -> AttributeSet .
    eq noUndo((undo(ATS), ATS')) = ATS' .
    eq noUndo(ATS) = ATS [ owise ] .

    --- Remember the command being run
    op setTmp : AttributeSet String -> AttributeSet .
    eq setTmp((tmpCmd: STR, ATS), STR') = (tmpCmd: STR', ATS) .
    eq setTmp(ATS, STR) = ATS [ owise ] .

    --- Keep the state before a command to undo it if it fails
    op withUndo : AttributeSet String -> AttributeSet .
    eq withUndo(ATS, STR) = (noUndo(ATS), undo(setTmp(noUndo(ATS), STR))) .

    ceq < OID : CID | undo(ATS), ATS? > write(stdout, OID, STR?)
        = < OID : CID | failScript(ATS), undo(ATS) >
          write(stdout, OID, commandError(ATS, (upTerm(ATS?), upTerm(STR?))))
        if not (upTerm(STR?) :: Constant and-then ATS? :: AttributeSet) .

    --- Error message of a command that failed while computing
    op commandError : AttributeSet TermList -> String .
    ceq commandError((module: M, ATS), TL)
        = nuitpWarning(M, downTerm(T, 'noFormula.Bool))
        if T := findNuitpError(TL) .
    ceq commandError(ATS, TL)
        = incompleteWarning(downTerm(T, 'none), downTerm(T', ""))
        if (T, T') := findIncomplete(TL) .
    eq commandError(ATS, TL) = errorMsg(33) [ owise ] .

    --- First incomplete result in a meta-term
    op findIncomplete : TermList -> TermList .
    eq findIncomplete(empty) = empty .
    eq findIncomplete('incompleteResult[NTL]) = NTL .
    eq findIncomplete('incompleteChild[NTL]) = NTL .
    eq findIncomplete(Q[NTL]) = findIncomplete(NTL) [ owise ] .
    eq findIncomplete((T, NTL)) = firstIncomplete(findIncomplete(T), NTL) .
    eq findIncomplete(C) = empty .
    eq findIncomplete(V) = empty .

    --- First incomplete result in a list of terms
    op firstIncomplete : TermList NeTermList -> TermList .
    eq firstIncomplete(empty, NTL) = findIncomplete(NTL) .
    eq firstIncomplete(NTL, NTL') = NTL .

    --- Error for an incomplete set of steps or unifiers
    op incompleteWarning : Qid String -> String .

    --- Error for a node whose term is a variable
    eq incompleteWarning('varterm, STR) = errorMsg(50, STR) .
    eq incompleteWarning(Q, STR) = errorMsg(51, incompleteWhat(Q, STR)) [ owise ] .

    --- Text naming what may be incomplete
    op incompleteWhat : Qid String -> String .
    eq incompleteWhat('narrowing, STR) = "the set of narrowing steps from node(s) " + STR .
    eq incompleteWhat('narrow, STR) = "the set of narrowing steps of the subterm in node " + STR .
    eq incompleteWhat('unification, STR) = "the set of variant unifiers for the equation in node " + STR .
    eq incompleteWhat('intersection, STR) = "the set of unifiers between patterns " + STR .
    eq incompleteWhat(Q, STR) = "a set of steps or unifiers for node(s) " + STR [ owise ] .

    --- Error when NuITP cannot process a formula
    op nuitpWarning : Module Term -> String .
    eq nuitpWarning(M, T) = errorMsg(52, printFormula(M, T)) .

    --- Formula of a NuITP error as a string
    op printFormula : Module Term -> String .
    eq printFormula(M, T)
        = if toString(M, T) :: String
          then toString(M, T)
          else metaPrintToString(upModule('META-LEVEL, false), none, upTerm(T), mixfix, none)
          fi .

    --- First NuITP error in a meta-term
    op findNuitpError : TermList -> TermList .
    eq findNuitpError(empty) = empty .
    eq findNuitpError('nuitpError[T]) = T .
    eq findNuitpError(Q[NTL]) = findNuitpError(NTL) [ owise ] .
    eq findNuitpError((T, NTL)) = firstNuitpError(findNuitpError(T), NTL) .
    eq findNuitpError(C) = empty .
    eq findNuitpError(V) = empty .

    --- First NuITP error in a list of terms
    op firstNuitpError : TermList NeTermList -> TermList .
    eq firstNuitpError(empty, NTL) = findNuitpError(NTL) .
    eq firstNuitpError(T, NTL) = T .

    --- Session node-id counter
    eq idMax(N, ID)
        = if N >= ID
          then N
          else ID
          fi .
    eq idmaxOf((maxid: N, ATS)) = N .
    eq idmaxOf(ATS) = 0 [ owise ] .
    eq syncId((maxid: N, lastRes: OUTPUT, ATS))
        = (maxid: idMax(N, maxResId(OUTPUT)), lastRes: OUTPUT, ATS) .
    eq syncId(ATS) = ATS [ owise ] .
    eq resetId((maxid: N, ATS)) = (maxid: 0, ATS) .
    eq resetId(ATS) = ATS [ owise ] .
    eq maxResId(noSolution) = 0 .
    eq maxResId(PARENTS || CHILDREN) = maxChId(CHILDREN, maxParId(PARENTS, 0)) .
    eq maxResId(OUTPUT) = 0 [ owise ] .
    eq maxParId(noParents, N) = N .
    eq maxParId(([ ID, T, CTR, SB, N ], PARENTS), N') = maxParId(PARENTS, idMax(ID, N')) .
    eq maxParId(([ ID, T, CTR, SB, N, ORIGIN ], PARENTS), N') = maxParId(PARENTS, idMax(ID, N')) .
    eq maxParId(PARENTS, N) = N [ owise ] .
    eq maxChId(noChildren, N) = N .
    eq maxChId(([ ID, PID, T, CTR, Q, SB, SB', ML, N, ORIGIN ], CHILDREN), N')
        = maxChId(CHILDREN, idMax(ID, maxMatchId(ML, N'))) .
    eq maxChId(([ ID, T, CTR, SB, ML, N, ORIGIN ], CHILDREN), N')
        = maxChId(CHILDREN, idMax(ID, maxMatchId(ML, N'))) .
    eq maxChId(CHILDREN, N) = N [ owise ] .

    --- Largest id of a matcher target (never given again)
    op maxMatchId : MatcherList Nat -> Nat .
    eq maxMatchId(noMatch, N) = N .
    eq maxMatchId(((ID, SB?, T, PROOF) ; ML), N) = maxMatchId(ML, idMax(ID, N)) .
    rl [io-script-closed] : < OID : CID | ATS, script: scriptClosing(STR) > closedFile(OID, FH)
        => < OID : CID | ATS > write(stdout, OID, STR) .
    rl [io-script-quit] : < OID : CID | ATS, script: scriptQuitting > closedFile(OID, FH)
        => (none).Configuration write(stdout, OID, byeText) .

    eq getTerm(ambiguity({'true.Bool,'Bool}, {'true.NuITP-Bool,'NuITP-Bool})) = 'true.Bool .
    eq getTerm(ambiguity({T, 'Disjunction}, {T', 'Disjunction})) = T .

    --- Sorts without constructors (set module warning)
    op noCtorSorts : Module -> SortSet .
    eq noCtorSorts(M) = noCtorSorts'(M, getSorts(M), preludeSorts) .

    --- Prelude sorts without constructors (not reported)
    op preludeSorts : -> SortSet [ memo ] .
    eq preludeSorts
        = noCtorSorts'(upModule('QID, true), getSorts(upModule('QID, true)), none)
          ; noCtorSorts'(upModule('CONVERSION, true), getSorts(upModule('CONVERSION, true)), none) .
    op noCtorSorts' : Module SortSet SortSet -> SortSet .
    eq noCtorSorts'(M, none, SS) = none .
    eq noCtorSorts'(M, (S ; SS), SS')
        = (if sortIn(S, SS') or-else hasCtorBelow(M, getOps(M), S) then none else S fi)
          ; noCtorSorts'(M, SS, SS') .

    --- Check if a sort is in a set
    op sortIn : Sort SortSet -> Bool .
    eq sortIn(S, (S ; SS)) = true .
    eq sortIn(S, SS) = false [ owise ] .

    --- Check if there is a constructor below a sort
    op hasCtorBelow : Module OpDeclSet Sort -> Bool .
    ceq hasCtorBelow(M, (op F : TYL -> S [ ctor ATTRS ] .) OPDS, S') = true
        if sortLeq(M, S, S') .
    eq hasCtorBelow(M, OPDS, S) = false [ owise ] .

    --- Warning for sorts without constructors
    op noCtorWarning : SortSet -> String .
    eq noCtorWarning(none) = "" .
    eq noCtorWarning(NSS) = errorMsg(53, sortNames(NSS)) .

    --- Sort names as a string
    op sortNames : SortSet -> String .
    eq sortNames(none) = "" .
    eq sortNames(S) = string(S) .
    eq sortNames((S ; NSS)) = string(S) + ", " + sortNames(NSS) .

    --- set module MODNAME .
    ceq < OID : CID | ATS, module: M?, tmpCmd: TMP, lastCmd: (CMD | TYPE), lastRes: OUTPUT, lemmasui: LEMMAS,
                      userlem: ULEMMAS, pos: POS > parse('set`module_.['token[T]])
        = if M'? :: Module
          then if unsafeStmts(M''?) =/= ""
               then < OID : CID | failScript(ATS), module: M?, tmpCmd: TMP, lastCmd: (CMD | TYPE), lastRes: OUTPUT,
                                  lemmasui: LEMMAS, userlem: ULEMMAS, pos: POS >
                    write(stdout, OID, unsafeModuleMsg(downTerm(T, 'noModule.Qid), unsafeStmts(M''?)))
               else < OID : CID | resetId(ATS), module: addImport(M'?, 'NuITP-CLAUSE), tmpCmd: "",
                                  lastCmd: ("" | 'noType), lastRes: (noParents || noChildren), lemmasui: mt,
                                  userlem: mt, pos: "" >
                    write(stdout, OID, "\n\033[1;32m  Module " + string(downTerm(T, 'noModule.Qid)) +
                          " is now active.\033[0m\n" +
                          (if countNarrowRls(M''?) == 0 then "" else errorMsg(26, countNarrowRls(M''?)) fi) +
                          noCtorWarning(noCtorSorts(M''?)) + "\n")
               fi
          else < OID : CID | ATS, module: M?, tmpCmd: TMP, lastCmd: (CMD | TYPE), lastRes: OUTPUT, lemmasui: LEMMAS,
                             userlem: ULEMMAS, pos: POS > write(stdout, oid, errorMsg(1))
          fi
        if M''? := upModule(downTerm(T, 'noModule.Qid), true) /\
           M'? := transformMod(M''?) .

    --- recheck (DEPRECATED).
    eq < OID : CID | ATS, module: noModule > parse('recheck`..Command)
        = < OID : CID | ATS, module: noModule > write(stdout, oid, errorMsg(1)) .
    eq < OID : CID | ATS, module: M > parse('recheck`..Command)
        = < OID : CID | ATS, module: M > write(stdout, oid, errorMsg(27)) .

    --- show module .
    eq < OID : CID | ATS, module: M > parse('show`module`..Command)
        = < OID : CID | ATS, module: M >
          write(stdout, OID, "\n\033[1;32m  Module " + string(getName(M)) + " is active.\033[0m\n\n") .
    eq < OID : CID | ATS, module: noModule > parse('show`module`..Command)
        = < OID : CID | ATS, module: noModule > write(stdout, oid, errorMsg(1)) .

    --- show lemmas .
    eq < OID : CID | ATS, module: M, lemmasui: LEMMAS, userlem: ULEMMAS, lastCmd: (CMD | LSTCMD) >
        parse('show`lemmas`..Command)
        = < OID : CID | ATS, module: M, lemmasui: LEMMAS, userlem: ULEMMAS, lastCmd: (CMD | LSTCMD) >
          write(stdout, OID, "\n\033[1;36m  Current lemmas:\033[0m\n\n" +
                (if (ULEMMAS == mt) then "    No lemmas saved." else toStringLemmas(M, ULEMMAS) fi) +
                (if tsMinus(nuitpLemmas(proofLemmas(LSTCMD, LEMMAS)), ULEMMAS) == mt then "" else
                 "\n\n\033[1;36m  Lemmas still used by the current proof (removed with reset " + "lemmas):\033[0m\n" +
                 "\n" + toStringLemmas(M, tsMinus(nuitpLemmas(proofLemmas(LSTCMD, LEMMAS)), ULEMMAS)) fi) + "\n\n") .

    --- Lemmas and obligations of the current proof
    op proofLemmas : Qid TermSet -> TermSet .
    eq proofLemmas(LSTCMD, LEMMAS)
        = if LSTCMD == 'noType
          then mt
          else LEMMAS
          fi .

    --- Difference of term sets
    op tsMinus : TermSet TermSet -> TermSet .
    eq tsMinus(mt, TS) = mt .
    eq tsMinus((T ;; TS), TS') = (if T in TS' then mt else T fi) ;; tsMinus(TS, TS') .
    eq < OID : CID | ATS, module: noModule > parse('show`lemmas`..Command)
        = < OID : CID | ATS, module: noModule > write(stdout, oid, errorMsg(1)) .

    --- show obligations .
    eq < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | LSTCMD) >
        parse('show`obligations`..Command)
        = < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | LSTCMD) >
          write(stdout, OID, "\n\033[1;36m  Current proof obligations:\033[0m\n\n" +
                if ((proofLemmas(LSTCMD, LEMMAS) == mt) and-then
                    (LSTCMD == 'noType or-else LSTCMD == 'intersect or-else POS == "")) then
                "    No proof obligations pending.\n\n" else toStringLemmas(M, proofLemmas(LSTCMD, LEMMAS)) + "\n" +
                (if LSTCMD == 'intersect then "" else POS fi) + "\n" fi) .
    eq < OID : CID | ATS, module: noModule > parse('show`obligations`..Command)
        = < OID : CID | ATS, module: noModule > write(stdout, oid, errorMsg(1)) .

    --- show last .
    eq < OID : CID | ATS, module: M?, lastRes: OUTPUT, lastCmd: (CMD | 'noType) > parse('show`last`..Command)
        = < OID : CID | ATS, module: M?, lastRes: OUTPUT, lastCmd: (CMD | 'noType) > write(stdout, oid, errorMsg(5)) .
    eq < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: OUTPUT, lastCmd: (CMD | 'invariant), pos: POS >
        parse('show`last`..Command)
        = < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: OUTPUT, lastCmd: (CMD | 'invariant), pos: POS >
          write(stdout, OID, "\n  " + toStringInv(M, OUTPUT, LEMMAS, POS) + "\n\n") .
    eq < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: OUTPUT, lastCmd: (CMD | 'generate), pos: POS >
        parse('show`last`..Command)
        = < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: OUTPUT, lastCmd: (CMD | 'generate), pos: POS >
          write(stdout, OID, "\n  " + toStringGen(M, OUTPUT, LEMMAS, POS) + "\n\n") .
    eq < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: OUTPUT, lastCmd: (CMD | 'subsumption) >
        parse('show`last`..Command)
        = < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: OUTPUT, lastCmd: (CMD | 'subsumption) >
          write(stdout, OID, "\n  " + toStringSub(M, OUTPUT, LEMMAS) + "\n\n") .
    eq < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: OUTPUT, lastCmd: (CMD | 'intersect) >
        parse('show`last`..Command)
        = < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: OUTPUT, lastCmd: (CMD | 'intersect) >
          write(stdout, OID, "\n  " + toStringInt(M, OUTPUT, LEMMAS) + "\n\n") .

    --- show path N . and show path states N .
    eq < OID : CID | ATS, module: noModule > parse('show`path_.['token[ARG]])
        = < OID : CID | ATS, module: noModule > write(stdout, OID, errorMsg(1)) .
    eq < OID : CID | ATS, module: noModule > parse('show`path`states_.['token[ARG]])
        = < OID : CID | ATS, module: noModule > write(stdout, OID, errorMsg(1)) .
    eq < OID : CID | ATS, module: M, lastCmd: ("" | 'noType) > parse('show`path_.['token[ARG]])
        = < OID : CID | ATS, module: M, lastCmd: ("" | 'noType) > write(stdout, OID, errorMsg(5)) .
    eq < OID : CID | ATS, module: M, lastCmd: ("" | 'noType) > parse('show`path`states_.['token[ARG]])
        = < OID : CID | ATS, module: M, lastCmd: ("" | 'noType) > write(stdout, OID, errorMsg(5)) .
    eq < OID : CID | ATS, module: M, lastCmd: (CMD | 'subsumption) > parse('show`path_.['token[ARG]])
        = < OID : CID | ATS, module: M, lastCmd: (CMD | 'subsumption) > write(stdout, OID, errorMsg(23)) .
    eq < OID : CID | ATS, module: M, lastCmd: (CMD | 'subsumption) > parse('show`path`states_.['token[ARG]])
        = < OID : CID | ATS, module: M, lastCmd: (CMD | 'subsumption) > write(stdout, OID, errorMsg(23)) .
    eq < OID : CID | ATS, module: M, lastCmd: (CMD | 'intersect) > parse('show`path_.['token[ARG]])
        = < OID : CID | ATS, module: M, lastCmd: (CMD | 'intersect) > write(stdout, OID, errorMsg(9)) .
    eq < OID : CID | ATS, module: M, lastCmd: (CMD | 'intersect) > parse('show`path`states_.['token[ARG]])
        = < OID : CID | ATS, module: M, lastCmd: (CMD | 'intersect) > write(stdout, OID, errorMsg(9)) .
    ceq < OID : CID | ATS, module: M, lastCmd: (CMD | LSTCMD), lastRes: OUTPUT > parse('show`path_.['token[ARG]])
        = < OID : CID | ATS, module: M, lastCmd: (CMD | LSTCMD), lastRes: OUTPUT >
          write(stdout, OID, pathInfo(M, OUTPUT, ID, true))
        if (LSTCMD == 'invariant or-else LSTCMD == 'generate) /\
           ID := rat(string(downTerm(ARG, 'nil.QidList)), 10) .
    ceq < OID : CID | ATS, module: M, lastCmd: (CMD | LSTCMD), lastRes: OUTPUT >
        parse('show`path`states_.['token[ARG]])
        = < OID : CID | ATS, module: M, lastCmd: (CMD | LSTCMD), lastRes: OUTPUT >
          write(stdout, OID, pathInfo(M, OUTPUT, ID, false))
        if (LSTCMD == 'invariant or-else LSTCMD == 'generate) /\
           ID := rat(string(downTerm(ARG, 'nil.QidList)), 10) .

    --- Check if an id is missing from the last result
    op notFound : DMCOutput Nat -> Bool .
    eq notFound((PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')), ID) = false .
    eq notFound((PARENTS || (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')), ID) = false .
    eq notFound((PARENTS || (CHILDREN, [ ID, T, T', T'', CTR, LSB, RSB ], CHILDREN')), ID) = false .
    eq notFound(OUTPUT, ID) = true [ owise ] .

    op notFound : ChildNodeList Nat -> Bool .
    eq notFound((CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN'), ID) = false .
    eq notFound((CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN'), ID) = false .
    eq notFound(CHILDREN, ID) = true [ owise ] .

    op notFound : DMCOutput QidList -> Bool .
    eq notFound(OUTPUT, (nil).QidList) = false .
    ceq notFound((PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')), (Q QL))
        = notFound((PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')), QL)
    if ID == rat(string(Q),10) .
    ceq notFound((PARENTS || (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')), (Q QL))
        = notFound((PARENTS || (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')), QL)
    if ID == rat(string(Q),10) .
    eq notFound(OUTPUT, QL) = true [ owise ] .

    --- Check if all the given ids are in the list of children
    op allFound : ChildNodeList QidList -> Bool .
    eq allFound(CHILDREN, (nil).QidList) = true .
    ceq allFound((CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN'), (Q QL))
        = allFound((CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN'), QL)
    if ID == rat(string(Q),10) .
    ceq allFound((CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN'), (Q QL))
        = allFound((CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN'), QL)
    if ID == rat(string(Q),10) .
    eq allFound(CHILDREN, QL) = false [ owise ] .

    --- Apply a substitution to a narrowing result
    op applySub : NarrowingApplyResult Substitution -> NarrowingApplyResult .
    eq applySub({ T', TY, CO, Q, SB, SB', Q' }, V <- T)
        = { applySub(T', V <- T), TY, CO, Q, applySub(SB, V <- T), applySub(SB', V <- T), Q' } .

    op applySub : MatcherList Substitution -> MatcherList .
    eq applySub((MID, MATCH, IMPLICATION, PROOF), SB) = (MID, applySub(MATCH, SB), applySub(IMPLICATION, SB), PROOF) .
    eq applySub((MID, MATCH, IMPLICATION, PROOF) ; ML, SB)
        = (MID, applySub(MATCH, SB), applySub(IMPLICATION, SB), PROOF) ; applySub(ML, SB) .
    eq applySub(ML, SB) = ML [ owise ] .

    --- Next free node id
    op getNextIndex : ChildNodeList Nat -> Nat .
    eq getNextIndex((CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN'), N')
        = if (ID >= N')
          then getNextIndex((CHILDREN, CHILDREN'), ID)
          else getNextIndex((CHILDREN, CHILDREN'), N')
          fi .
    eq getNextIndex((CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN'), N')
        = if (ID >= N')
          then getNextIndex((CHILDREN, CHILDREN'), ID)
          else getNextIndex((CHILDREN, CHILDREN'), N')
          fi .
    eq getNextIndex(CHILDREN, N) = s(N) [ owise ] .

    --- Variables of a child, including its history
    op childVars : ChildNode -> TermSet .
    eq childVars([ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ])
        = getVars((T, CTR)) ;; getRangeVars(SB) ;; getRangeVars(ACSB) ;;
          getOriginVars(ORIGIN) .
    eq childVars([ ID, T, CTR, ACSB, ML, N, ORIGIN ]) = getVars((T, CTR)) ;; getRangeVars(ACSB) .

    --- Variables a new variable must not clash with: the current state of the child
    op clashVars : ChildNode -> TermSet .
    eq clashVars([ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ])
        = getVars((T, CTR)) ;; getRangeVars(SB) ;; getRangeVars(ACSB) .

    --- Next free $n index for a list of children
    op getNextVar : ChildNodeList Nat -> Nat .
    eq getNextVar((CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN'), N')
        = if getNextVar(childVars([ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ]), 0) >= N'
          then getNextVar((CHILDREN, CHILDREN'),
                          getNextVar(childVars([ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ]), 0))
          else getNextVar((CHILDREN, CHILDREN'), N')
          fi .
    eq getNextVar((CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN'), N')
        = if getNextVar(childVars([ ID, T, CTR, ACSB, ML, N, ORIGIN ]), 0) >= N'
          then getNextVar((CHILDREN, CHILDREN'), getNextVar(childVars([ ID, T, CTR, ACSB, ML, N, ORIGIN ]), 0))
          else getNextVar((CHILDREN, CHILDREN'), N')
          fi .
    eq getNextVar(CHILDREN, N) = s(N) [ owise ] .

    op getNextVar : TermSet Nat -> Nat .
    eq getNextVar(mt, N) = N .
    eq getNextVar((V ;; TS), N)
        = if substr(string(getName(V)), 0, 1) == "$"
          then if dollarIdx(getName(V)) >= N
               then getNextVar(TS, dollarIdx(getName(V)))
               else getNextVar(TS, N)
               fi
          else getNextVar(TS, N)
          fi .

    --- Show the candidates of variable abstraction or apply the only one
    op finishVariableAbstraction : Configuration VarAbsPair -> Configuration .

    --- The abstraction could not be computed: undo the command
    ceq finishVariableAbstraction(< OID : CID | undo(ATS), ATS? >, VAP?)
        = < OID : CID | failScript(ATS), undo(ATS) >
          write(stdout, OID, commandError(ATS, (upTerm(VAP?), upTerm(ATS?))))
        if not (VAP? :: VarAbsPair) .

    --- Check if a new variable clashes with the variables of a child
    op variableClash? : TermSet ChildNode -> Bool .
    eq variableClash?(TS, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ])
        = variableClash?'(getVars(TS), clashVars([ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ])) .

    eq variableClash?(TS, [ ID, T, CTR, ACSB, ML, N, ORIGIN ])
        = variableClash?'(getVars(TS), childVars([ ID, T, CTR, ACSB, ML, N, ORIGIN ])) .

    op variableClash?' : TermSet TermSet -> Bool .
    eq variableClash?'(V ;; TS, V ;; TS') = true .
    eq variableClash?'(TS, TS') = false [ owise ] .

    --- split needs the constants True and False of sort Bool
    op splitBoolOk : Module -> Bool .
    eq splitBoolOk(M) = wellFormed(M, 'True.Bool) and-then wellFormed(M, 'False.Bool) .

    --- Check that True and False are the only constructors of Bool
    op splitBoolOnly : Module -> Bool .
    eq splitBoolOnly(M) = uncoveredPats(M, 'B:Bool, ('True.Bool ;; 'False.Bool)) == mt .
    op splitBoolMsg : Module -> String .
    eq splitBoolMsg(M)
        = errorMsg(54, splitCovList(M, uncoveredPats(M, 'B:Bool, ('True.Bool ;; 'False.Bool)))) .
    op splitCovList : Module TermSet -> String .
    eq splitCovList(M, TS) = splitCovList'(M, TS, "") .
    op splitCovList' : Module TermSet String -> String .
    eq splitCovList'(M, mt, ACC) = ACC .
    eq splitCovList'(M, (PAT ;; TS), ACC)
        = splitCovList'(M, TS, ACC +
                        (if PAT :: Variable then "    values of sort " + string(getType(PAT)) +
                         " not covered by True and False\n" else "    " + toString(M, PAT) + "\n" fi)) .

    --- Check if the root operator is a constructor or has an identity
    op narrowRootBad : Qid OpDeclSet -> Bool .
    eq narrowRootBad(Q, (op Q : TYL -> TY [ ATTRS ] .) OPDS)
        = narrowRootAttr(ATTRS) or-else narrowRootBad(Q, OPDS) .
    eq narrowRootBad(Q, OPDS) = false [ owise ] .
    op narrowRootAttr : AttrSet -> Bool .
    eq narrowRootAttr(ctor ATTRS) = true .
    eq narrowRootAttr(id(T) ATTRS) = true .
    eq narrowRootAttr(left-id(T) ATTRS) = true .
    eq narrowRootAttr(right-id(T) ATTRS) = true .
    eq narrowRootAttr(ATTRS) = false [ owise ] .

    --- Error when narrow would lose cases (empty otherwise)
    op narrowMsg : Module Term -> String .
    eq narrowMsg(M, V) = "" .
    eq narrowMsg(M, T)
        = if getRls(narrowMod(M, T)) == (none).RuleSet
          then ""
          else if narrowRootBad(topName(T), getOps(M))
               then errorMsg(55, string(topName(T)))
               else if narrowCondRls(M, T) =/= (none).RuleSet
                    then errorMsg(56, string(topName(T)), narrowLhsList(M, narrowCondRls(M, T)))
                    else if narrowDefSubterms(M, T) =/= empty
                         then errorMsg(57, string(topName(T)), narrowTermList(M, narrowDefSubterms(M, T)))
                         else ""
                         fi
                    fi
               fi
          fi [owise] .
    op narrowLhsList : Module RuleSet -> String .
