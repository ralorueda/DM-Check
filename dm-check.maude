    ceq [do-check-inv] : < OID : CID | ATS, module: M, lemmasui: LEMMAS, userlem: UL:TermSet, lastRes: OUTPUT, lastCmd: (CMD | Q), tmpCmd: TMP, pos: POS > checkInvariant(M, ARG) = 
