                                                        getNextVar((CHILDREN,
                                                                    [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                                    CHILDREN'), 0), none, LEMMAS))) >
                         showAux(OID, aux('split, ID, idmaxOf(ATS), 2), "")
                    else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant),
                                       lastRes: (PARENTS ||
                                                 (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                  CHILDREN')) > write(stdout, oid, errorMsg(25))
                    fi
               fi
          else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant),
                             lastRes: (PARENTS ||
                                       (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')) >
               write(stdout, oid, errorMsg(24))
          fi
        if ID == rat(string(downTerm(ARG, 'nil.QidList)),10) /\
           PARSED-EXP := parseTerm(M, ARG') .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate),
                      lastRes: (PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')) >
        parse('split_with_.['token[ARG],'bubble[ARG']])
        = if (leastSort(M, PARSED-EXP) == 'Bool) and-then splitBoolOk(M)
          then if not splitBoolOnly(M)
               then < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate),
                                  lastRes: (PARENTS ||
                                            (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')) >
                    write(stdout, oid, splitBoolMsg(M))
               else if (getVars(PARSED-EXP) in getVars(T) ;; getVars(CTR))
                    then < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate),
                                       lastRes: (PARENTS ||
                                                 (CHILDREN, CHILDREN',
                                                  split(M, PARENTS, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                        PARSED-EXP,
                                                        getNextIndex((CHILDREN,
                                                                      [ ID, PID, T, CTR, RL, SB, ACSB, ML, N,
                                                                        ORIGIN ], CHILDREN'), idmaxOf(ATS)),
                                                        getNextVar((CHILDREN,
                                                                    [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                                    CHILDREN'), 0), none, LEMMAS))) >
                         showAux(OID, aux('split, ID, idmaxOf(ATS), 2), "")
                    else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate),
                                       lastRes: (PARENTS ||
                                                 (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ],
                                                  CHILDREN')) > write(stdout, oid, errorMsg(25))
                    fi
               fi
          else < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate),
                             lastRes: (PARENTS ||
                                       (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')) >
               write(stdout, oid, errorMsg(24))
          fi
        if ID == rat(string(downTerm(ARG, 'nil.QidList)),10) /\
           PARSED-EXP := parseTerm(M, ARG') .

    --- empty CHILD .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                      lastRes: (PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                      lastCmd: (CMD | 'invariant), pos: POS > parse('empty_.['token[ARG]])
        = < OID : CID | ATS, module: M, lemmasui: (LEMMAS ;; markObl('_->_[CTR,'false.NuITP-Bool])),
                        lastRes: (PARENTS || (CHILDREN,CHILDREN')), lastCmd: (CMD | 'invariant), pos: POS >
          write(stdout, OID, closeMsg('invariant, ID, "closed as empty (obligation added: its constraint -> false)") +
                "\n  " +
                toStringInv(M, (PARENTS || (CHILDREN,CHILDREN')), (LEMMAS ;; markObl('_->_[CTR,'false.NuITP-Bool])),
                            POS) + "\n\n")
        if ID == rat(string(downTerm(ARG, 'nil.QidList)),10) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                      lastRes: (PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                      lastCmd: (CMD | 'generate), pos: POS > parse('empty_.['token[ARG]])
        = < OID : CID | ATS, module: M, lemmasui: (LEMMAS ;; markObl('_->_[CTR,'false.NuITP-Bool])),
                        lastRes: (PARENTS || (CHILDREN,CHILDREN')), lastCmd: (CMD | 'generate), pos: POS >
          write(stdout, OID, closeMsg('generate, ID, "closed as empty (obligation added: its constraint -> false)") +
                "\n  " +
                toStringGen(M, (PARENTS || (CHILDREN,CHILDREN')), (LEMMAS ;; markObl('_->_[CTR,'false.NuITP-Bool])),
                            POS) + "\n\n")
        if ID == rat(string(downTerm(ARG, 'nil.QidList)),10) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                      lastRes: (PARENTS || (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')),
                      lastCmd: (CMD | 'subsumption) > parse('empty_.['token[ARG]])
        = < OID : CID | ATS, module: M, lemmasui: (LEMMAS ;; markObl('_->_[CTR,'false.NuITP-Bool])),
                        lastRes: (PARENTS || (CHILDREN,CHILDREN')), lastCmd: (CMD | 'subsumption) >
          write(stdout, OID,
                closeMsg('subsumption, ID, "closed as empty (obligation added: its constraint -> false)") + "\n  " +
                toStringSub(M, (PARENTS || (CHILDREN,CHILDREN')), (LEMMAS ;; markObl('_->_[CTR,'false.NuITP-Bool]))) +
                "\n\n")
        if ID == rat(string(downTerm(ARG, 'nil.QidList)),10) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                      lastRes: (PARENTS || (CHILDREN, [ ID, T, T', T'', CTR, LSB, RSB ], CHILDREN')),
                      lastCmd: (CMD | 'intersect) > parse('empty_.['token[ARG]])
        = < OID : CID | ATS, module: M, lemmasui: (LEMMAS ;; markObl('_->_[CTR,'false.NuITP-Bool])),
                        lastRes: (PARENTS || (CHILDREN,CHILDREN')), lastCmd: (CMD | 'intersect) >
          write(stdout, OID, closeMsg('intersect, ID, "closed as empty (obligation added: its constraint -> false)") +
                "\n  " +
                toStringInt(M, (PARENTS || (CHILDREN,CHILDREN')), (LEMMAS ;; markObl('_->_[CTR,'false.NuITP-Bool]))) +
                "\n\n")
        if ID == rat(string(downTerm(ARG, 'nil.QidList)),10) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: OUTPUT, lastCmd: (CMD | LSTCMD) >
        parse('empty_.['token[ARG]])
        = < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: OUTPUT, lastCmd: (CMD | LSTCMD) >
          write(stdout, oid, errorMsg(6))
        if (LSTCMD == 'invariant or-else LSTCMD == 'generate or-else LSTCMD == 'subsumption or-else
            LSTCMD == 'intersect) /\
           ID := rat(string(downTerm(ARG, 'nil.QidList)),10) /\
           notFound(OUTPUT, ID) .

    --- Implication of the n-th matcher
    op getLemma : MatcherList Nat -> TermSet .
    eq getLemma((MID, MATCH, IMPLICATION, PROOF) ; ML, s(0)) = IMPLICATION .
    eq getLemma((MID, MATCH, IMPLICATION, PROOF) ; ML, s(NZ)) = getLemma(ML, NZ) .
    eq getLemma(ML, N) = mt [ owise ] .

    --- lemma CHILD .
    eq < OID : CID | ATS, module: M, lastCmd: (CMD | 'intersect) > parse('lemma_.['token[ARG]])
        = < OID : CID | ATS, module: M, lastCmd: (CMD | 'intersect) > write(stdout, oid, errorMsg(9)) .
    eq < OID : CID | ATS, module: M, lastCmd: (CMD | 'intersect) > parse('lemma_match_.['token[ARG],'token[ARG']])
        = < OID : CID | ATS, module: M, lastCmd: (CMD | 'intersect) > write(stdout, oid, errorMsg(9)) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                      lastRes: (PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                      lastCmd: (CMD | 'invariant), pos: POS > parse('lemma_.['token[ARG]])
        = if ML' == noMatch
          then < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                             lastRes: (PARENTS ||
                                       (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                             lastCmd: (CMD | 'invariant), pos: POS > write(stdout, oid, errorMsg(7))
          else < OID : CID | ATS, module: M, lemmasui: (LEMMAS ;; markObl(getLemma(ML', 1))),
                             lastRes: (PARENTS || (CHILDREN,CHILDREN')), lastCmd: (CMD | 'invariant), pos: POS >
               write(stdout, OID, closeMsg('invariant, ID, "closed (obligation added: its open implication)") +
                     "\n  " +
                     toStringInv(M, (PARENTS || (CHILDREN,CHILDREN')), (LEMMAS ;; markObl(getLemma(ML', 1))), POS) +
                     "\n\n")
          fi
        if ID == rat(string(downTerm(ARG, 'nil.QidList)), 10) /\
           ML' := liveML(ML,
                         resIds(PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                         ID) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                      lastRes: (PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                      lastCmd: (CMD | 'generate), pos: POS > parse('lemma_.['token[ARG]])
        = if ML' == noMatch
          then < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                             lastRes: (PARENTS ||
                                       (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                             lastCmd: (CMD | 'generate), pos: POS > write(stdout, oid, errorMsg(7))
          else < OID : CID | ATS, module: M, lemmasui: (LEMMAS ;; markObl(getLemma(ML', 1))),
                             lastRes: (PARENTS || (CHILDREN,CHILDREN')), lastCmd: (CMD | 'generate), pos: POS >
               write(stdout, OID, closeMsg('generate, ID, "closed (obligation added: its open implication)") +
                     "\n  " +
                     toStringGen(M, (PARENTS || (CHILDREN,CHILDREN')), (LEMMAS ;; markObl(getLemma(ML', 1))), POS) +
                     "\n\n")
          fi
        if ID == rat(string(downTerm(ARG, 'nil.QidList)), 10) /\
           ML' := liveML(ML,
                         resIds(PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                         ID) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                      lastRes: (PARENTS || (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')),
                      lastCmd: (CMD | 'subsumption) > parse('lemma_.['token[ARG]])
        = if ML' == noMatch
          then < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                             lastRes: (PARENTS || (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')),
                             lastCmd: (CMD | 'subsumption) > write(stdout, oid, errorMsg(7))
          else < OID : CID | ATS, module: M, lemmasui: (LEMMAS ;; markObl(getLemma(ML', 1))),
                             lastRes: (PARENTS || (CHILDREN,CHILDREN')), lastCmd: (CMD | 'subsumption) >
               write(stdout, OID, closeMsg('subsumption, ID, "closed (obligation added: its open implication)") +
                     "\n  " +
                     toStringSub(M, (PARENTS || (CHILDREN,CHILDREN')), (LEMMAS ;; markObl(getLemma(ML', 1)))) +
                     "\n\n")
          fi
        if ID == rat(string(downTerm(ARG, 'nil.QidList)), 10) /\
           ML' := liveML(ML, resIds(PARENTS || (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')), ID) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: OUTPUT, lastCmd: (CMD | LSTCMD) >
        parse('lemma_.['token[ARG]])
        = < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: OUTPUT, lastCmd: (CMD | LSTCMD) >
          write(stdout, oid, errorMsg(6))
        if LSTCMD =/= 'intersect /\
           ID := rat(string(downTerm(ARG, 'nil.QidList)), 10) /\
           notFound(OUTPUT, ID) .

    --- lemma CHILD match MATCHER .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                      lastRes: (PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                      lastCmd: (CMD | 'invariant), pos: POS > parse('lemma_match_.['token[ARG],'token[ARG']])
        = if ML' == noMatch
          then < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                             lastRes: (PARENTS ||
                                       (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                             lastCmd: (CMD | 'invariant), pos: POS > write(stdout, oid, errorMsg(7))
          else if getLemma(ML', MID) == mt
               then < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                                  lastRes: (PARENTS ||
                                            (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                                  lastCmd: (CMD | 'invariant), pos: POS > write(stdout, oid, errorMsg(8))
               else < OID : CID | ATS, module: M, lemmasui: (LEMMAS ;; markObl(getLemma(ML', MID))),
                                  lastRes: (PARENTS || (CHILDREN,CHILDREN')), lastCmd: (CMD | 'invariant), pos: POS >
                    write(stdout, OID,
                          closeMsg('invariant, ID, "closed with matcher " + string(MID, 10) +
                                   " (obligation added: its implication)") + "\n  " +
                          toStringInv(M, (PARENTS || (CHILDREN,CHILDREN')), (LEMMAS ;; markObl(getLemma(ML', MID))),
                                      POS) + "\n\n")
               fi
          fi
        if ID == rat(string(downTerm(ARG, 'nil.QidList)), 10) /\
           MID := rat(string(downTerm(ARG', 'nil.QidList)), 10) /\
           ML' := liveML(ML,
                         resIds(PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                         ID) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                      lastRes: (PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                      lastCmd: (CMD | 'generate), pos: POS > parse('lemma_match_.['token[ARG],'token[ARG']])
        = if ML' == noMatch
          then < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                             lastRes: (PARENTS ||
                                       (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                             lastCmd: (CMD | 'generate), pos: POS > write(stdout, oid, errorMsg(7))
          else if getLemma(ML', MID) == mt
               then < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                                  lastRes: (PARENTS ||
                                            (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                                  lastCmd: (CMD | 'generate), pos: POS > write(stdout, oid, errorMsg(8))
               else < OID : CID | ATS, module: M, lemmasui: (LEMMAS ;; markObl(getLemma(ML', MID))),
                                  lastRes: (PARENTS || (CHILDREN,CHILDREN')), lastCmd: (CMD | 'generate), pos: POS >
                    write(stdout, OID,
                          closeMsg('generate, ID, "closed with matcher " + string(MID, 10) +
                                   " (obligation added: its implication)") + "\n  " +
                          toStringGen(M, (PARENTS || (CHILDREN,CHILDREN')), (LEMMAS ;; markObl(getLemma(ML', MID))),
                                      POS) + "\n\n")
               fi
          fi
        if ID == rat(string(downTerm(ARG, 'nil.QidList)), 10) /\
           MID := rat(string(downTerm(ARG', 'nil.QidList)), 10) /\
           ML' := liveML(ML,
                         resIds(PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                         ID) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                      lastRes: (PARENTS || (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')),
                      lastCmd: (CMD | 'subsumption) > parse('lemma_match_.['token[ARG],'token[ARG']])
        = if ML' == noMatch
          then < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                             lastRes: (PARENTS || (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')),
                             lastCmd: (CMD | 'subsumption) > write(stdout, oid, errorMsg(7))
          else if getLemma(ML', MID) == mt
               then < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                                  lastRes: (PARENTS || (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')),
                                  lastCmd: (CMD | 'subsumption) > write(stdout, oid, errorMsg(8))
               else < OID : CID | ATS, module: M, lemmasui: (LEMMAS ;; markObl(getLemma(ML', MID))),
                                  lastRes: (PARENTS || (CHILDREN,CHILDREN')), lastCmd: (CMD | 'subsumption) >
                    write(stdout, OID,
                          closeMsg('subsumption, ID, "closed with matcher " + string(MID, 10) +
                                   " (obligation added: its implication)") + "\n  " +
                          toStringSub(M, (PARENTS || (CHILDREN,CHILDREN')), (LEMMAS ;; markObl(getLemma(ML', MID)))) +
                          "\n\n")
               fi
          fi
        if ID == rat(string(downTerm(ARG, 'nil.QidList)), 10) /\
           MID := rat(string(downTerm(ARG', 'nil.QidList)), 10) /\
           ML' := liveML(ML, resIds(PARENTS || (CHILDREN, [ ID, T, CTR, ACSB, ML, N, ORIGIN ], CHILDREN')), ID) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: OUTPUT, lastCmd: (CMD | LSTCMD) >
        parse('lemma_match_.['token[ARG],'token[ARG']])
        = < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: OUTPUT, lastCmd: (CMD | LSTCMD) >
          write(stdout, oid, errorMsg(6))
        if (LSTCMD == 'invariant or-else LSTCMD == 'generate or-else LSTCMD == 'subsumption) /\
           ID := rat(string(downTerm(ARG, 'nil.QidList)), 10) /\
           notFound(OUTPUT, ID) .

    --- Build PO
    op buildPO : Module Term Term ParentNodeList -> String .
    eq buildPO(M, T, T', noParents) = "" .
    eq buildPO(M, T, T', PARENTS)
        = "    check (" + toString(M, T) + " | " + toString(M, T') + ") subsumed by " +
          buildPO'(M, PARENTS) + " .\n" [ owise ] .

    op buildPO' : Module ParentNodeList -> String .
    eq buildPO'(M, noParents) = "" .
    eq buildPO'(M, [ ID, T, CTR, ACSB, 0 ]) = "(" + toString(M, T) + " | " + toString(M, CTR) + ")" .
    eq buildPO'(M, [ ID, T, CTR, ACSB, 0, ORIGIN ]) = "(" + toString(M, T) + " | " + toString(M, CTR) + ")" .
    eq buildPO'(M, ([ ID, T, CTR, ACSB, 0 ], PARENTS))
        = "(" + toString(M, T) + " | " + toString(M, CTR) + ") \\/ " + buildPO'(M, PARENTS) .
    eq buildPO'(M, ([ ID, T, CTR, ACSB, 0, ORIGIN ], PARENTS))
        = "(" + toString(M, T) + " | " + toString(M, CTR) + ") \\/ " + buildPO'(M, PARENTS) .

    --- contained CHILD .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                      lastRes: (PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                      lastCmd: (CMD | 'invariant), pos: POS > parse('contained_.['token[ARG]])
        = < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: (PARENTS || (CHILDREN, CHILDREN')),
                        lastCmd: (CMD | 'invariant),
                        pos: (POS + (if POS == "" then "" else "\n" fi) + buildPO(M, T, CTR, PARENTS)) >
          write(stdout, OID, closeMsg('invariant, ID, "marked as contained (a pending subsumption check was added)") +
                "\n  " +
                toStringInv(M, (PARENTS || (CHILDREN, CHILDREN')), LEMMAS,
                            (POS + (if POS == "" then "" else "\n" fi) + buildPO(M, T, CTR, PARENTS))) + "\n\n")
        if ID == rat(string(downTerm(ARG, 'nil.QidList)),10) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS,
                      lastRes: (PARENTS || (CHILDREN, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN')),
                      lastCmd: (CMD | 'generate), pos: POS > parse('contained_.['token[ARG]])
        = < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: (PARENTS || (CHILDREN, CHILDREN')),
                        lastCmd: (CMD | 'generate),
                        pos: (POS + (if POS == "" then "" else "\n" fi) + buildPO(M, T, CTR, PARENTS)) >
          write(stdout, OID, closeMsg('generate, ID, "marked as contained (a pending subsumption check was added)") +
                "\n  " +
                toStringGen(M, (PARENTS || (CHILDREN, CHILDREN')), LEMMAS,
                            (POS + (if POS == "" then "" else "\n" fi) + buildPO(M, T, CTR, PARENTS))) + "\n\n")
        if ID == rat(string(downTerm(ARG, 'nil.QidList)),10) .
    ceq < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: OUTPUT, lastCmd: (CMD | LSTCMD) >
        parse('contained_.['token[ARG]])
        = < OID : CID | ATS, module: M, lemmasui: LEMMAS, lastRes: OUTPUT, lastCmd: (CMD | LSTCMD) >
          write(stdout, oid, errorMsg(6))
        if (LSTCMD == 'invariant or-else LSTCMD == 'generate) /\
           ID := rat(string(downTerm(ARG, 'nil.QidList)),10) /\
           notFound(OUTPUT, ID) .

    --- check INVARIANT .
    ceq < OID : CID | ATS, module: M > parse('check`ind-invariant_.['bubble[ARG]])
        = if TL? :: TermList
          then < OID : CID | resetId(ATS), module: M > checkInvariant(M, TL?)
          else < OID : CID | ATS, module: M > write(stdout, oid, errorMsg(2))
          fi
        if TL? := parseInvariant(M, downTerm(ARG, 'nil.QidList)) .
    eq < OID : CID | ATS, module: M > parse('check`invariant_.['bubble[ARG]])
        = < OID : CID | ATS, module: M > parse('check`ind-invariant_.['bubble[ARG]]) .

    --- Each run starts from the user lemmas
    ceq [do-check-inv] : < OID : CID | ATS, module: M, lemmasui: LEMMAS, userlem: ULEMMAS, lastRes: OUTPUT,
                                       lastCmd: (CMD | Q), tmpCmd: TMP, pos: POS > checkInvariant(M, ARG)
        = < OID : CID | ATS, module: M, lemmasui: ULEMMAS, userlem: ULEMMAS, lastRes: OUTPUT?,
                        lastCmd: (TMP | 'invariant), tmpCmd: TMP, pos: "" > if STR? :: String then
          write(stdout, OID, "\n  " + STR? + "\n\n") else write(stdout, OID, errorMsg(0)) fi
        if OUTPUT? := checkInvariant(M, ARG, none, ULEMMAS, 1) /\
           STR? := toStringInv(M, OUTPUT?, ULEMMAS, "") .

    --- generate INVARIANT .
    ceq < OID : CID | ATS, module: M > parse('generate`ind-invariant_.['bubble[ARG]])
        = if TL? :: TermList
          then < OID : CID | resetId(ATS), module: M > genInvariant(M, TL?)
          else < OID : CID | ATS, module: M > write(stdout, oid, errorMsg(2))
          fi
        if TL? := parseInvariant(M, downTerm(ARG, 'nil.QidList)) .
    eq < OID : CID | ATS, module: M > parse('gen`ind-invariant_.['bubble[ARG]])
        = < OID : CID | ATS, module: M > parse('generate`ind-invariant_.['bubble[ARG]]) .

    --- Each run starts from the user lemmas
    ceq [do-gen-inv] : < OID : CID | ATS, module: M, lemmasui: LEMMAS, userlem: ULEMMAS, lastRes: OUTPUT,
                                     lastCmd: (CMD | Q), tmpCmd: TMP, pos: POS > genInvariant(M, ARG)
        = < OID : CID | ATS, module: M, lemmasui: ULEMMAS, userlem: ULEMMAS, lastRes: OUTPUT?,
                        lastCmd: (TMP | 'generate), tmpCmd: TMP, pos: "" > if STR? :: String then
          write(stdout, OID, "\n  " + STR? + "\n\n") else write(stdout, OID, errorMsg(0)) fi
        if OUTPUT? := genInvariant(M, ARG, none, ULEMMAS, 1) /\
           STR? := toStringGen(M, OUTPUT?, ULEMMAS, "") .

    --- check INVARIANT1 subsumed by INVARIANT2 .
    ceq < OID : CID | ATS, module: M > parse('check_subsumed`by_.['bubble[ARG],'bubble[ARG']])
        = if (TL? :: TermList) and-then (TL'? :: TermList)
          then < OID : CID | resetId(ATS), module: M > checkSubsumed(M, TL?, TL'?)
          else < OID : CID | ATS, module: M > write(stdout, oid, errorMsg(2))
          fi
        if TL? := parseInvariant(M, downTerm(ARG, 'nil.QidList))
        /\ TL'? := parseInvariant(M, downTerm(ARG', 'nil.QidList)) .

    --- Each run starts from the user lemmas
    ceq [do-check-sub] : < OID : CID | ATS, module: M, lemmasui: LEMMAS, userlem: ULEMMAS, lastRes: OUTPUT,
                                       lastCmd: (CMD | Q), tmpCmd: TMP > checkSubsumed(M, ARG, ARG')
        = < OID : CID | ATS, module: M, lemmasui: ULEMMAS, userlem: ULEMMAS, lastRes: OUTPUT?,
                        lastCmd: (TMP | 'subsumption), tmpCmd: TMP > if STR? :: String then
          write(stdout, OID, "\n  " + STR? + "\n\n") else write(stdout, OID, errorMsg(0)) fi
        if OUTPUT? := checkSubsumed(M, ARG, ARG', none, ULEMMAS) /\
           STR? := toStringSub(M, OUTPUT?, ULEMMAS) .

    --- intersect INVARIANT1 with INVARIANT2 .
    ceq < OID : CID | ATS, module: M > parse('intersect_with_.['bubble[ARG],'bubble[ARG']])
        = if (TL? :: TermList) and-then (TL'? :: TermList)
          then < OID : CID | ATS, module: M > checkIntersect(M, TL?, TL'?)
          else < OID : CID | ATS, module: M > write(stdout, oid, errorMsg(2))
          fi
        if TL? := parseInvariant(M, downTerm(ARG, 'nil.QidList))
        /\ TL'? := parseInvariant(M, downTerm(ARG', 'nil.QidList)) .

    --- Each run starts from the user lemmas
    ceq [do-check-int] : < OID : CID | ATS, module: M, lemmasui: LEMMAS, userlem: ULEMMAS, lastRes: OUTPUT,
                                       lastCmd: (CMD | Q), tmpCmd: TMP > checkIntersect(M, ARG, ARG')
        = < OID : CID | ATS, module: M, lemmasui: ULEMMAS, userlem: ULEMMAS, lastRes: OUTPUT?,
                        lastCmd: (TMP | 'intersect), tmpCmd: TMP > if STR? :: String then
          write(stdout, OID, "\n  " + STR? + "\n\n") else write(stdout, OID, errorMsg(0)) fi
        if OUTPUT? := checkIntersection(M, ARG, ARG', none, ULEMMAS) /\
           STR? := toStringInt(M, OUTPUT?, ULEMMAS) .

    --- Parse Invariant
    op parseInvariant : Module QidList -> [TermList] .
    eq parseInvariant(M, QL)
        = parseDisj(M,
                    getTerm(metaNormalize(upModule('DM-CHECK-DISJUNCTION, false),
                                          getTerm(metaParse(upModule('DM-CHECK-DISJUNCTION, false), none, QL,
                                                            anyType))))) .

    --- The disjuncts of a parsed invariant
    op parseDisj : Module [TermList] -> [TermList] .
    eq parseDisj(M, '_\/_[NTL]) = parseInvariant'(M, NTL) .
    eq parseDisj(M, TL?) = parseInvariant'(M, TL?) [ owise ] .

    op parseInvariant' : Module TermList -> [TermList] .
    eq parseInvariant'(M, empty) = empty .
    eq parseInvariant'(M, ('_|_['bubble[T],'true.Bool], TL))
        = '_|_[getTerm(metaParse(M, downTerm(T, (nil).QidList), anyType)),'true.NuITP-Bool], parseInvariant'(M, TL) .
    eq parseInvariant'(M, ('_|_['bubble[T],'_=_['bubble[T'],'bubble[T'']]], TL))
        = '_|_[getTerm(metaParse(M, downTerm(T, (nil).QidList), anyType)),
               parseEq(M, downTerm(T', (nil).QidList), downTerm(T'', (nil).QidList))], parseInvariant'(M, TL) .
    eq parseInvariant'(M, ('_|_['bubble[T],'_/\_[NTL]], TL))
        = '_|_[getTerm(metaParse(M, downTerm(T, (nil).QidList), anyType)), '_/\_[parseEqs(M, NTL)]],
          parseInvariant'(M, TL) .
    eq parseInvariant'(M, ('_|_['bubble[T],'_\/_[NTL]], TL))
        = '_|_[getTerm(metaParse(M, downTerm(T, (nil).QidList), anyType)), '_\/_[parseEqs(M, NTL)]],
          parseInvariant'(M, TL) .

    --- Parse an equation of a constraint (true and false take the sort of the other side)
    op parseEq : Module QidList QidList -> [Term] .
    eq parseEq(M, QL, QL')
        = parseEq'(M, QL, QL', metaParse(M, none, QL, anyType), metaParse(M, none, QL', anyType)) .
    op parseEq' : Module QidList QidList ResultPair? ResultPair? -> [Term] .
    eq parseEq'(M, QL, QL', {T, TY}, {T', TY'}) = '_=_[T, T'] .
    ceq parseEq'(M, QL, QL', RP?, {T, TY})
        = '_=_[getTerm(metaParse(M, none, QL, TY)), T]
        if not (RP? :: ResultPair) .
    ceq parseEq'(M, QL, QL', {T, TY}, RP?)
        = '_=_[T, getTerm(metaParse(M, none, QL', TY))]
        if not (RP? :: ResultPair) .
    eq parseEq'(M, QL, QL', RP?, RP'?) = '_=_[getTerm(RP?), getTerm(RP'?)] [ owise ] .

    op parseEqs : Module TermList -> [TermList] .
    eq parseEqs(M, empty) = empty .
    eq parseEqs(M, '_=_['bubble[T],'bubble[T']])
        = (parseEq(M, downTerm(T, (nil).QidList), downTerm(T', (nil).QidList))) .
    eq parseEqs(M, ('_=_['bubble[T],'bubble[T']], NTL))
        = ((parseEq(M, downTerm(T, (nil).QidList), downTerm(T', (nil).QidList))),parseEqs(M, NTL)) .

    --- Parse a lemma written as an implication
    op parseLemma : Module QidList -> [Term] .
    ceq parseLemma(M, QL) = getTerm(metaNormalize(M, '_->_[GAMMA, DELTA]))
        if '_->_[GAMMA,DELTA] := getTerm(metaParse(M, none, QL, 'NuITP-Clause)) .
    ceq parseLemma(M, QL)
        = getTerm(metaNormalize(M, '_->_['true.NuITP-Bool, getTerm(metaParse(M, none, QL, 'NuITP-Clause))]))
        if getTerm(metaParse(M, none, QL, anyType)) :: Term .

    --- reset lemmas .
    eq < OID : CID | ATS, module: noModule > parse('reset`lemmas`..Command)
        = < OID : CID | ATS, module: noModule > write(stdout, oid, errorMsg(1)) .
    eq < OID : CID | ATS, module: M, lemmasui: LEMMAS, userlem: ULEMMAS, lastCmd: (CMD | LSTCMD) >
        parse('reset`lemmas`..Command)
        = < OID : CID | ATS, module: M, userlem: mt, lastCmd: (CMD | LSTCMD), lemmasui: proofLemmas(LSTCMD, LEMMAS) >
          write(stdout, OID, "\n\033[1;32m  Session lemmas cleared.\033[0m\n\n") .

    --- Add Lemma
    eq < OID : CID | ATS, module: noModule > parse('add`lemma_.['bubble[ARG]])
        = < OID : CID | ATS, module: noModule > write(stdout, oid, errorMsg(1)) .
    eq < OID : CID | ATS, module: M, lemmasui: LEMMAS, userlem: ULEMMAS, lastCmd: ("" | 'noType) >
        parse('add`lemma_.['bubble[ARG]])
        = if parseLemma(M, downTerm(ARG, (nil).QidList)) :: Term
          then < OID : CID | ATS, module: M, lemmasui: LEMMAS ;; parseLemma(M, downTerm(ARG, (nil).QidList)),
                             userlem: ULEMMAS ;; parseLemma(M, downTerm(ARG, (nil).QidList)),
                             lastCmd: ("" | 'noType) >
               write(stdout, OID, "\n\033[1;32m  Lemma added successfully.\033[0m\n\n")
          else < OID : CID | ATS, module: M, lemmasui: LEMMAS, userlem: ULEMMAS, lastCmd: ("" | 'noType) >
               write(stdout, oid, errorMsg(4))
          fi .
    eq < OID : CID | ATS, module: M, lemmasui: LEMMAS, userlem: ULEMMAS, lastCmd: (CMD | LSTCMD), tmpCmd: TMP >
        parse('add`lemma_.['bubble[ARG]])
        = if parseLemma(M, downTerm(ARG, (nil).QidList)) :: Term
          then < OID : CID | ATS, module: M, lemmasui: LEMMAS ;; parseLemma(M, downTerm(ARG, (nil).QidList)),
                             userlem: ULEMMAS ;; parseLemma(M, downTerm(ARG, (nil).QidList)), lastCmd: (CMD | LSTCMD),
                             tmpCmd: CMD > parseCommand(M, OID, CMD)
          else < OID : CID | ATS, module: M, lemmasui: LEMMAS, userlem: ULEMMAS, lastCmd: (CMD | LSTCMD),
                             tmpCmd: TMP > write(stdout, oid, errorMsg(4))
          fi .

    --- Proof history for save proof
    eq isWarning(STR)
        = startsWith(STR, "\n\033[1;31m  Error:")
          or startsWith(STR, "\n  \033[1;31mError:") .
    eq isRecordable(STR)
        = not (STR == "" or-else STR == "q" or-else STR == "h." or-else startsWith(STR, "h ") or-else
               startsWith(STR, "show") or-else startsWith(STR, "help") or-else startsWith(STR, "quit") or-else
               startsWith(STR, "load") or-else startsWith(STR, "save")) .
    eq histCmd(STR)
        = if isRecordable(trim(STR))
          then prettyCmd(flatCmd(trim(STR)))
          else ""
          fi .

    --- A recorded command on a single line
    ceq flatCmd(STR)
        = flatCmd(substr(STR, 0, N)) + flatCmd(substr(STR, N, sd(length(STR), N)))
        if length(STR) > 2 /\ N := splitAt(STR, length(STR) quo 2) .
    ceq flatCmd(STR) = flatShort(STR)
        if length(STR) <= 2 .

    --- Never split between a backslash and the character that follows it
    eq splitAt(STR, N)
        = if (N + 1 < length(STR)) and-then (substr(STR, sd(N, 1), 1) == "\\")
          then splitAt(STR, N + 1)
          else N
          fi .
    eq flatCh(STR)
        = if (STR == "\n" or-else STR == "\r")
          then " "
          else STR
          fi .
    eq flatShort(STR)
        = if length(STR) == 0
          then ""
          else if length(STR) == 1
               then flatCh(STR)
               else if (substr(STR, 0, 1) == "\\") and-then
                       (substr(STR, 1, 1) == "\n" or-else substr(STR, 1, 1) == "\r")
                    then " "
                    else flatCh(substr(STR, 0, 1)) + flatCh(substr(STR, 1, 1))
                    fi
               fi
          fi .

    --- Lay out a recorded command again
    eq prettyCmd(STR) = breakAt(breakAt(squeeze(STR), " \\/ ", " \\\n  \\/ "), " subsumed by ", " \\\n  subsumed by ") .
    eq squeeze(STR)
        = if find(STR, "  ", 0) :: Nat
          then squeeze(breakAt(STR, "  ", " "))
          else STR
          fi .

    --- Replace every occurrence of a pattern in a string
    eq breakAt(STR, OLD, NEW) = breakAt'(STR, OLD, NEW, "") .
    op breakAt' : String String String String -> String .
    ceq breakAt'(STR, OLD, NEW, ACC)
        = breakAt'(substr(STR, N + length(OLD), sd(length(STR), N + length(OLD))),
                  OLD, NEW, ACC + substr(STR, 0, N) + NEW)
        if N := find(STR, OLD, 0) .
    eq breakAt'(STR, OLD, NEW, ACC) = ACC + STR [ owise ] .
    ceq < OID : CID | ATS, history: HIST, histPending: PEND > write(stdout, OID, STR)
        = < OID : CID | histUpd(ATS, HIST, PEND, STR) > write(stdout, OID, STR)
        if not (PEND == "") .

    --- Variable abstraction waiting for its selection
    op vaPend:_ : String -> Attribute [ ctor ] .
    op histUpd : AttributeSet String String String -> AttributeSet .
    eq histUpd(ATS, HIST, PEND, STR)
        = histUpd'(hasVaSel(ATS), getVaPend(ATS), dropVaPend(ATS), HIST, PEND, STR) .
    op histUpd' : Bool String AttributeSet String String String -> AttributeSet .
    eq histUpd'(true, VAPEND, ATS, HIST, PEND, STR)
        = (ATS, history: HIST, histPending: "", vaPend: (if isWarning(STR) then "" else PEND fi)) .
    eq histUpd'(false, VAPEND, ATS, HIST, PEND, STR)
        = (ATS, histPending: "",
           history: (if isWarning(STR) then HIST else HIST +
                     (if VAPEND =/= "" and-then startsWith(trim(PEND), "select") then VAPEND + "\n\n" else "" fi) +
                     PEND + "\n\n" fi)) .

    --- Pending variable abstraction selection (for save proof)
    op hasVaSel : AttributeSet -> Bool .
    eq hasVaSel((vaSelect: true, ATS)) = true .
    eq hasVaSel(ATS) = false [ owise ] .
    op getVaPend : AttributeSet -> String .
    eq getVaPend((vaPend: VAPEND, ATS)) = VAPEND .
    eq getVaPend(ATS) = "" [ owise ] .
    op dropVaPend : AttributeSet -> AttributeSet .
    eq dropVaPend((vaPend: VAPEND, ATS)) = ATS .
    eq dropVaPend(ATS) = ATS [ owise ] .

    --- save proof FILE .
    eq proofScript(HIST)
        = "--- DM-Check proof script (" + DMC-VERSION +
          ")\n--- Replay it with: load <this file>, after loading the same Maude module.\n" +
          "--- Lemmas added with add lemma are assumed; this script does not prove them.\n\n" + HIST .
    eq < OID : CID | ATS, history: "" > parse('save`proof_.['token[ARG]])
        = < OID : CID | ATS, history: "" > write(stdout, OID, errorMsg(62)) .
    ceq < OID : CID | ATS, history: HIST > parse('save`proof_.['token[ARG]])
        = < OID : CID | saving: saveOpening(string(downTerm(ARG, 'noFile.Qid)), proofScript(HIST)), ATS, history: HIST >
          openFile(fileManager, OID, string(downTerm(ARG, 'noFile.Qid)), "w")
        if not (HIST == "") .

    --- File replies, consumed by rules
    rl [io-save-opened] : < OID : CID | ATS, saving: saveOpening(NAME, TEXT) > openedFile(OID, fileManager, FH)
        => < OID : CID | ATS, saving: saveWriting(NAME, FH) > write(FH, OID, TEXT) .
    rl [io-save-open-error] : < OID : CID | ATS, saving: saveOpening(NAME, TEXT) > fileError(OID, fileManager, STR)
        => < OID : CID | ATS > write(stdout, OID, errorMsg(61, NAME, STR)) .
    rl [io-save-wrote] : < OID : CID | ATS, saving: saveWriting(NAME, FH) > wrote(OID, FH)
        => < OID : CID | ATS, saving: saveClosing("\n\033[1;32m  Proof script saved to " + NAME + ".\033[0m\n\n") >
           closeFile(FH, OID) .
    rl [io-save-write-error] : < OID : CID | ATS, saving: saveWriting(NAME, FH) > fileError(OID, FH, STR)
        => < OID : CID | ATS, saving: saveClosing(errorMsg(61, NAME, STR)) > closeFile(FH, OID) .
    rl [io-save-closed] : < OID : CID | ATS, saving: saveClosing(MSG) > closedFile(OID, FH)
        => < OID : CID | ATS > write(stdout, OID, MSG) .
endm

--- smt.maude (loaded by NuITP) leaves set include BOOLEAN on
set include BOOLEAN off .

set show command off .

erew in DM-CHECK-UI : init .
