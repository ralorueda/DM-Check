    --- Build PO
    op buildPO : Module Term Term ParentNodeList -> String .
    eq buildPO(M, T1, T2, noParents) = "" .
    eq buildPO(M, T1, T2, PARENTS) = "    check (" + toString(M, T1) + " | " + toString(M, T2) + ") subsumed by " + buildPO'(M, PARENTS) + " .\n" [ owise ] .

