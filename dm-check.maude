          else
              < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'invariant), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)), vaSelect: true, varAbs: VABSPAIR >
              write(stdout, OID, "\n\033[1;36m  Possible variable abstractions:\033[0m\n  " + toStringCtxs(M, VABSPAIR) + "\n\n  Choose one with select va <n> . (any other command cancels the choice)\n\n")
          fi .

    eq finishVariableAbstraction(
           < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)) >,
           VABSPAIR)
        = if countChildren(getChildren(VABSPAIR)) == 1
          then
              < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, CHILDREN2, applyVarAbs(M, getChildren(VABSPAIR), PARENTS, none, LEMMAS))) >
              showAux(OID, aux('va, ID, idmaxOf(ATS), 1), "")
          else
              < OID : CID | ATS, module: M, lemmasui: LEMMAS, pos: POS, lastCmd: (CMD | 'generate), lastRes: (PARENTS || (CHILDREN1, [ ID, PID, T, CTR, RL, SB, ACSB, ML, N, ORIGIN ], CHILDREN2)), vaSelect: true, varAbs: VABSPAIR >
              write(stdout, OID, "\n\033[1;36m  Possible variable abstractions:\033[0m\n  " + toStringCtxs(M, VABSPAIR) + "\n\n  Choose one with select va <n> . (any other command cancels the choice)\n\n")
          fi .

    eq < OID : CID | ATS > parse('va_with_in_.['bubble[ARG1],'token[ARG2],'token[ARG3]]) = < OID : CID | ATS > parse('variable`abstraction_with_in_.['bubble[ARG1],'token[ARG2],'token[ARG3]]) .
    eq < OID : CID | ATS > parse('variable`abstraction`to_on_with_.['token[ARG1],'bubble[ARG2],'token[ARG3]]) = < OID : CID | ATS > parse('variable`abstraction_with_in_.['bubble[ARG2],'token[ARG3],'token[ARG1]]) . --- Temp
    eq < OID : CID | ATS > parse('va`to_on_with_.['token[ARG1],'bubble[ARG2],'token[ARG3]]) = < OID : CID | ATS > parse('variable`abstraction_with_in_.['bubble[ARG2],'token[ARG3],'token[ARG1]]) . --- Temp

    --- Variable abstraction selection
    eq < OID : CID | ATS, vaSelect: true, varAbs: {ID, CHILDREN}, module: noModule > parse('select`variable`abstraction_.['token[ARG1]]) = < OID : CID | ATS, module: noModule > write(stdout, oid, errorMsg(1)) .
    eq < OID : CID | ATS, vaSelect: true, varAbs: {ID, CHILDREN}, module: M, lastCmd: ("" | 'noType) > parse('select`variable`abstraction_.['token[ARG1]]) = < OID : CID | ATS, module: M, lastCmd: ("" | 'noType) > write(stdout, oid, errorMsg(5)) .
    ceq < OID : CID | ATS, vaSelect: true, varAbs: {ID, CHILDREN}, module: M, lastCmd: (CMD | LSTCMD), lastRes: OUTPUT > parse('select`variable`abstraction_.['token[ARG1]]) = < OID : CID | ATS, module: M, lastCmd: (CMD | LSTCMD), lastRes: OUTPUT > write(stdout, oid, errorMsg(6))
        if (LSTCMD == 'invariant or-else LSTCMD == 'generate or-else LSTCMD == 'subsumption)
